---
/**
 * AIレースコメントコンポーネント
 * 予想ページ・結果ページの各レースにAI解説を表示
 *
 * Props:
 * - type: 'prediction' | 'result'
 * - raceData: レースデータ（JSON文字列でdata属性に埋め込み）
 */
interface Props {
  type: 'prediction' | 'result';
  raceData: string;
}

const { type, raceData } = Astro.props;
const label = type === 'prediction' ? 'AI予想解説' : 'AI振り返り';
---

<div class="ai-comment-section" data-type={type} data-race={raceData}>
  <div class="ai-comment-header">
    <span class="ai-comment-icon">🤖</span>
    <span class="ai-comment-label">{label}</span>
    <button class="ai-comment-toggle" aria-label="AI解説を表示">
      <span class="toggle-text">解説を見る</span>
      <span class="toggle-arrow">▼</span>
    </button>
  </div>
  <div class="ai-comment-body" style="display: none;">
    <div class="ai-comment-loading" style="display: none;">
      <div class="ai-dots"><span></span><span></span><span></span></div>
      <span>AIが分析中...</span>
    </div>
    <div class="ai-comment-text"></div>
  </div>
</div>

<style>
  .ai-comment-section {
    margin: 12px 0;
    border-radius: 8px;
    border: 1px solid rgba(59, 130, 246, 0.2);
    background: rgba(59, 130, 246, 0.05);
    overflow: hidden;
  }

  .ai-comment-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    cursor: pointer;
  }

  .ai-comment-icon {
    font-size: 1.1rem;
  }

  .ai-comment-label {
    font-size: 0.85rem;
    font-weight: 700;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-comment-toggle {
    margin-left: auto;
    background: none;
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 14px;
    padding: 4px 12px;
    color: #60a5fa;
    font-size: 0.75rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: all 0.2s ease;
  }

  .ai-comment-toggle:hover {
    background: rgba(59, 130, 246, 0.1);
  }

  .ai-comment-toggle.open .toggle-arrow {
    transform: rotate(180deg);
  }

  .toggle-arrow {
    font-size: 0.65rem;
    transition: transform 0.2s ease;
  }

  .ai-comment-body {
    padding: 0 14px 14px;
  }

  .ai-comment-loading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    padding: 8px 0;
  }

  .ai-dots {
    display: inline-flex;
    gap: 3px;
  }

  .ai-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3b82f6;
    animation: aiDot 1.4s infinite ease-in-out both;
  }

  .ai-dots span:nth-child(1) { animation-delay: -0.32s; }
  .ai-dots span:nth-child(2) { animation-delay: -0.16s; }

  @keyframes aiDot {
    0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  .ai-comment-text {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .ai-comment-text p {
    margin-bottom: 6px;
  }

  .ai-comment-text p:last-child {
    margin-bottom: 0;
  }

  .ai-comment-text.error {
    color: var(--text-secondary);
    font-style: italic;
  }
</style>

<script is:inline>
  // イベント委譲で全AIコメントセクションに対応（1回だけ登録）
  if (!window._aiCommentInitialized) {
    window._aiCommentInitialized = true;
    window._aiCommentCache = {};
    window._aiCommentLoaded = new Set();

    document.addEventListener('click', async (e) => {
      const header = e.target.closest('.ai-comment-header');
      if (!header) return;

      const section = header.closest('.ai-comment-section');
      if (!section) return;

      const body = section.querySelector('.ai-comment-body');
      const toggle = section.querySelector('.ai-comment-toggle');
      const toggleText = toggle.querySelector('.toggle-text');
      const loading = section.querySelector('.ai-comment-loading');
      const textEl = section.querySelector('.ai-comment-text');
      const type = section.dataset.type;

      let raceData;
      try { raceData = JSON.parse(section.dataset.race); } catch(ex) { return; }

      const cacheKey = `${type}-${raceData.date}-${raceData.venue}-${raceData.raceNumber}`;
      const isOpen = body.style.display !== 'block';

      body.style.display = isOpen ? 'block' : 'none';
      toggle.classList.toggle('open', isOpen);
      toggleText.textContent = isOpen ? '閉じる' : '解説を見る';

      if (isOpen && !window._aiCommentLoaded.has(cacheKey)) {
        // キャッシュチェック
        if (window._aiCommentCache[cacheKey]) {
          renderAIComment(textEl, window._aiCommentCache[cacheKey]);
          window._aiCommentLoaded.add(cacheKey);
          return;
        }

        loading.style.display = 'flex';
        textEl.textContent = '';

        try {
          const res = await fetch('/.netlify/functions/gemini-race-analysis', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type, raceData })
          });
          const data = await res.json();
          loading.style.display = 'none';

          if (data.success && data.comment) {
            window._aiCommentCache[cacheKey] = data.comment;
            renderAIComment(textEl, data.comment);
          } else {
            textEl.textContent = 'AI解説を取得できませんでした。';
            textEl.classList.add('error');
          }
        } catch (err) {
          loading.style.display = 'none';
          textEl.textContent = 'AI解説を取得できませんでした。';
          textEl.classList.add('error');
        }
        window._aiCommentLoaded.add(cacheKey);
      }
    });

    function renderAIComment(el, comment) {
      el.innerHTML = '';
      comment.split('\n').filter(l => l.trim()).forEach(line => {
        const p = document.createElement('p');
        p.textContent = line;
        el.appendChild(p);
      });
    }
  }
</script>
