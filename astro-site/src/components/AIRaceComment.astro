---
/**
 * AIレースコメントコンポーネント
 * 予想ページ・結果ページの各レースにAI解説を表示
 *
 * Props:
 * - type: 'prediction' | 'result'
 * - raceData: レースデータ（JSON文字列でdata属性に埋め込み）
 */
interface Props {
  type: 'prediction' | 'result';
  raceData: string;
  masked?: boolean;
}

const { type, raceData, masked = false } = Astro.props;
const label = type === 'prediction' ? 'AI予想解説' : 'AI振り返り';
---

<div class="ai-comment-section" data-type={type} data-race={raceData} data-masked={masked ? 'true' : 'false'}>
  <div class="ai-comment-header">
    <div class="ai-comment-header-left">
      <div class="ai-comment-badge">
        <span class="ai-pulse"></span>
        <span class="ai-badge-text">AI</span>
      </div>
      <div class="ai-comment-title-area">
        <span class="ai-comment-label">{label}</span>
        <span class="ai-comment-sub">Powered by Keiba Intelligence</span>
      </div>
    </div>
    <button class="ai-comment-toggle" aria-label="AI解説を表示">
      <span class="toggle-text">解説を見る</span>
      <span class="toggle-arrow">▼</span>
    </button>
  </div>
  <div class="ai-comment-body" style="display: none;">
    <div class="ai-comment-loading" style="display: none;">
      <div class="ai-loading-bar">
        <div class="ai-loading-progress"></div>
      </div>
      <span class="ai-loading-text">AIがレースを分析中...</span>
    </div>
    <div class="ai-comment-text"></div>
  </div>
</div>

<style>
  .ai-comment-section {
    margin: 16px 0;
    border-radius: 12px;
    border: 2px solid rgba(59, 130, 246, 0.4);
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%);
    overflow: visible;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .ai-comment-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899, #8b5cf6, #3b82f6);
    background-size: 200% 100%;
    animation: gradientSlide 3s linear infinite;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }

  @keyframes gradientSlide {
    0% { background-position: 0% 0%; }
    100% { background-position: 200% 0%; }
  }

  .ai-comment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ai-comment-header:hover {
    background: rgba(59, 130, 246, 0.05);
  }

  .ai-comment-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-comment-badge {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px rgba(59, 130, 246, 0.4);
    flex-shrink: 0;
  }

  .ai-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 14px;
    border: 2px solid rgba(59, 130, 246, 0.5);
    animation: aiBadgePulse 2s ease-in-out infinite;
  }

  @keyframes aiBadgePulse {
    0%, 100% { opacity: 0; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .ai-badge-text {
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .ai-comment-title-area {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-comment-label {
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-comment-sub {
    font-size: 0.7rem;
    color: rgba(139, 92, 246, 0.7);
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .ai-comment-toggle {
    /* AI 判断 / 詳細: 紫 → 桃。旧は淡い青紫の地に薄い青文字で 1.6:1 前後だった。 */
    background: var(--grad-conclusion-btn);
    background-size: 180% 180%;
    background-position: 0% 0%;
    border: none;
    border-radius: 20px;
    padding: 8px 18px;
    color: var(--btn-ink); /* 7.17 / 7.15 */
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .ai-comment-toggle:hover {
    background-position: 100% 100%;
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(109, 40, 217, 0.35);
  }

  .ai-comment-toggle.open {
    background: var(--grad-conclusion-btn);
    background-position: 100% 100%;
    color: var(--btn-ink);
    border-color: transparent;
  }

  .ai-comment-toggle.open .toggle-arrow {
    transform: rotate(180deg);
  }

  .toggle-arrow {
    font-size: 0.7rem;
    transition: transform 0.2s ease;
  }

  .ai-comment-body {
    padding: 0 20px 20px;
  }

  /* ローディング */
  .ai-comment-loading {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 0;
  }

  .ai-loading-bar {
    width: 100%;
    height: 4px;
    background: rgba(59, 130, 246, 0.15);
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-loading-progress {
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
    border-radius: 4px;
    animation: loadingProgress 1.5s ease-in-out infinite;
  }

  @keyframes loadingProgress {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(350%); }
  }

  .ai-loading-text {
    font-size: 0.85rem;
    color: #60a5fa;
    font-weight: 500;
  }

  /* テキスト */
  .ai-comment-text {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--text-primary);
    padding: 16px;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    border-left: 3px solid;
    border-image: linear-gradient(180deg, #3b82f6, #8b5cf6) 1;
  }

  .ai-comment-text p {
    margin-bottom: 8px;
  }

  .ai-comment-text p:last-child {
    margin-bottom: 0;
  }

  .ai-comment-text.error {
    color: var(--text-secondary);
    font-style: italic;
    border-image: none;
    border-left-color: rgba(239, 68, 68, 0.5);
  }

  /* マスク（無料版） */
  :global(.ai-comment-masked) {
    position: relative;
    margin-top: 14px;
    padding: 20px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    border: 1px dashed rgba(251, 191, 36, 0.35);
    overflow: hidden;
    min-height: 220px;
  }

  /* 🔴 本文は入れない。案内の下地としての高さだけを持つ */
  :global(.ai-comment-masked-blur) {
    min-height: 120px;
    filter: blur(6px);
    user-select: none;
    pointer-events: none;
    color: var(--text-primary);
    line-height: 1.85;
    font-size: 0.95rem;
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.ai-comment-masked-overlay) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: radial-gradient(ellipse at center, rgba(15, 23, 42, 0.82) 0%, rgba(15, 23, 42, 0.94) 100%);
    padding: 20px;
    text-align: center;
  }

  :global(.ai-comment-masked-lock) {
    font-size: 2rem;
    filter: drop-shadow(0 2px 8px rgba(251, 191, 36, 0.4));
  }

  :global(.ai-comment-masked-title) {
    font-size: 1.1rem;
    font-weight: 800;
    color: #fbbf24;
    line-height: 1.4;
    letter-spacing: 0.5px;
  }

  :global(.ai-comment-masked-sub) {
    font-size: 0.85rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  :global(.ai-comment-masked-buttons) {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }

  :global(.ai-comment-masked-cta) {
    display: inline-block;
    padding: 10px 22px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }

  /* 主要 CTA: 青 → 紫（旧 #3b82f6→#2563eb は青の同系色の濃淡） */
  :global(.ai-comment-masked-cta.primary) {
    background: var(--grad-nav-btn);
    color: var(--btn-ink); /* 8.84 / 6.96 */
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
  }

  /* 登録 / 強い行動: 桃 → 橙（旧 #fbbf24→#f59e0b は黄の同系色の濃淡） */
  :global(.ai-comment-masked-cta.secondary) {
    background: var(--grad-action-btn);
    color: var(--btn-ink); /* 7.15 / 11.34 */
    box-shadow: 0 4px 14px rgba(194, 65, 12, 0.35);
  }

  :global(.ai-comment-masked-cta:hover) {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }

  @media (max-width: 480px) {
    :global(.ai-comment-masked-buttons) {
      flex-direction: column;
      width: 100%;
    }
    :global(.ai-comment-masked-cta) {
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .ai-comment-header {
      padding: 12px 14px;
    }

    .ai-comment-badge {
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }

    .ai-badge-text {
      font-size: 0.75rem;
    }

    .ai-comment-label {
      font-size: 0.95rem;
    }

    .ai-comment-toggle {
      padding: 6px 12px;
      font-size: 0.75rem;
    }

    .ai-comment-body {
      padding: 0 14px 14px;
    }

    .ai-comment-text {
      font-size: 0.9rem;
      padding: 12px;
    }
  }
</style>

<script is:inline>
  /*
   * 🔴 マスク解除のクライアント処理は廃止した（2026-09-02）。
   *    以前は `sessionStorage` の自己申告で `data-masked` を外していたが、
   *    そもそも **有料本文がサーバーから全員に返っていた** ため、
   *    ぼかしても HTTP 応答・localStorage・DOM に残っていた。
   *    いまは `gemini-race-analysis` が Cookie を見て、
   *    未権限には **可視範囲しか返さない**。ここで隠す／出すことはしない。
   *
   * 表示キャッシュを権限ごとに分けるためだけに、1 度だけ状態を問い合わせる。
   * 🔴 これは認可ではない（認可はサーバーの応答そのもの）。
   */
  let viewerKindPromise = null;
  function viewerKind() {
    if (!viewerKindPromise) {
      viewerKindPromise = fetch('/.netlify/functions/get-session', { credentials: 'include' })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => (d && d.showBetting === true ? 'p' : 'f'))
        .catch(() => 'f');
    }
    return viewerKindPromise;
  }

  // イベント委譲で全AIコメントセクションに対応（1回だけ登録）
  if (!window._aiCommentInitialized) {
    window._aiCommentInitialized = true;
    window._aiCommentCache = {};
    window._aiCommentLoaded = new Set();
    window._aiCommentInflight = {};

    const STORAGE_PREFIX = 'aiComment:v1:';
    const STORAGE_TTL_MS = 24 * 60 * 60 * 1000;

    function readPersistedComment(cacheKey) {
      try {
        const raw = localStorage.getItem(STORAGE_PREFIX + cacheKey);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed.comment !== 'string' || typeof parsed.timestamp !== 'number') return null;
        if (typeof parsed.truncated !== 'boolean') return null;
        if (Date.now() - parsed.timestamp > STORAGE_TTL_MS) {
          try { localStorage.removeItem(STORAGE_PREFIX + cacheKey); } catch (e) {}
          return null;
        }
        return { comment: parsed.comment, truncated: parsed.truncated };
      } catch (e) {
        return null;
      }
    }

    function writePersistedComment(cacheKey, entry) {
      try {
        localStorage.setItem(STORAGE_PREFIX + cacheKey, JSON.stringify({
          comment: entry.comment,
          truncated: entry.truncated,
          timestamp: Date.now()
        }));
      } catch (e) {
        // QuotaExceededError等は無視（次回fetchで取得し直す）
      }
    }

    document.addEventListener('click', async (e) => {
      const header = e.target.closest('.ai-comment-header');
      if (!header) return;

      const section = header.closest('.ai-comment-section');
      if (!section) return;

      const body = section.querySelector('.ai-comment-body');
      const toggle = section.querySelector('.ai-comment-toggle');
      const toggleText = toggle.querySelector('.toggle-text');
      const loading = section.querySelector('.ai-comment-loading');
      const textEl = section.querySelector('.ai-comment-text');
      const type = section.dataset.type;

      let raceData;
      try { raceData = JSON.parse(section.dataset.race); } catch(ex) { return; }

      // cacheKey に raceData.generatedAt を含める。
      // 予想JSONが再生成（再import）されると generatedAt が変わるため、
      // cacheKey も変わり古い localStorage キャッシュは自動的に無視される。
      // generatedAt が無い場合（古いJSONや result 系で verifiedAt も無いケース）
      // は空文字となり、従来通り日付+会場+R番号で一意化される。
      const cacheVersion = raceData.generatedAt || '';
      // 🔴 権限が変わると返ってくる本文も変わるのでキーを分ける
      const kind = await viewerKind();
      const cacheKey = `${type}-${raceData.date}-${raceData.venue}-${raceData.raceNumber}-${cacheVersion}-${kind}`;
      const isOpen = body.style.display !== 'block';

      body.style.display = isOpen ? 'block' : 'none';
      toggle.classList.toggle('open', isOpen);
      toggleText.textContent = isOpen ? '閉じる' : '解説を見る';

      if (isOpen && !window._aiCommentLoaded.has(cacheKey)) {
        // L1: メモリキャッシュ
        if (window._aiCommentCache[cacheKey]) {
          renderAIComment(textEl, window._aiCommentCache[cacheKey], type);
          window._aiCommentLoaded.add(cacheKey);
          return;
        }

        // L2: localStorage 永続キャッシュ（24h TTL）
        const persisted = readPersistedComment(cacheKey);
        if (persisted) {
          window._aiCommentCache[cacheKey] = persisted;
          renderAIComment(textEl, persisted, type);
          window._aiCommentLoaded.add(cacheKey);
          return;
        }

        loading.style.display = 'flex';
        textEl.textContent = '';

        // L3: in-flight ガード（同cacheKeyの並行fetchを共有）
        let promise = window._aiCommentInflight[cacheKey];
        if (!promise) {
          promise = (async () => {
            try {
              // 🔴 Cookie を送る。返ってくる本文は権限に応じてサーバーが決める
              const res = await fetch('/.netlify/functions/gemini-race-analysis', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ type, raceData })
              });
              const data = await res.json();
              if (data.success && data.comment) {
                const entry = { comment: data.comment, truncated: data.truncated === true };
                window._aiCommentCache[cacheKey] = entry;
                writePersistedComment(cacheKey, entry);
                return entry;
              }
              return null;
            } catch (err) {
              return null;
            } finally {
              delete window._aiCommentInflight[cacheKey];
            }
          })();
          window._aiCommentInflight[cacheKey] = promise;
        }

        const entry = await promise;
        loading.style.display = 'none';
        if (entry) {
          renderAIComment(textEl, entry, type);
        } else {
          textEl.textContent = 'AI解説を取得できませんでした。';
          textEl.classList.add('error');
        }
        window._aiCommentLoaded.add(cacheKey);
      }
    });

    /**
     * サーバーが返した本文をそのまま描く。
     *
     * 🔴 **ここで本文を切らない。** 未権限に見せない部分は
     *    `gemini-race-analysis` が応答に含めていない。
     * 🔴 続きがある場合（`truncated`）も、隠れている本文を
     *    DOM へ入れてぼかすことはしない。案内だけを出す。
     */
    function renderAIComment(el, entry, type) {
      el.innerHTML = '';
      const text = (entry && entry.comment) || '';
      const truncated = !!(entry && entry.truncated);
      const lines = text.split('\n').filter((l) => l.trim());

      lines.forEach((line, i) => {
        const p = document.createElement('p');
        p.textContent = (truncated && i === lines.length - 1) ? line + '…' : line;
        el.appendChild(p);
      });

      if (!truncated) return;

      const maskWrap = document.createElement('div');
      maskWrap.className = 'ai-comment-masked';

      // 🔴 見出しだけの飾り。ここに本文は入れない
      const blur = document.createElement('div');
      blur.className = 'ai-comment-masked-blur';
      blur.setAttribute('aria-hidden', 'true');
      maskWrap.appendChild(blur);

      const overlay = document.createElement('div');
      overlay.className = 'ai-comment-masked-overlay';
      overlay.innerHTML = `
        <div class="ai-comment-masked-lock">🔒</div>
        <div class="ai-comment-masked-title">プレミアムで全文表示</div>
        <div class="ai-comment-masked-sub">各馬の詳細解説・買い目・期待値分析をご覧いただけます</div>
        <div class="ai-comment-masked-buttons">
          <a href="/pricing" class="ai-comment-masked-cta primary">料金プランを見る</a>
        </div>
      `;
      maskWrap.appendChild(overlay);
      el.appendChild(maskWrap);
    }
  }
</script>
