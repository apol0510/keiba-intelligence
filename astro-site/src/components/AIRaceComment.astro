---
/**
 * AIレースコメントコンポーネント
 * 予想ページ・結果ページの各レースにAI解説を表示
 *
 * Props:
 * - type: 'prediction' | 'result'
 * - raceData: レースデータ（JSON文字列でdata属性に埋め込み）
 */
interface Props {
  type: 'prediction' | 'result';
  raceData: string;
  masked?: boolean;
}

const { type, raceData, masked = false } = Astro.props;
const label = type === 'prediction' ? 'AI予想解説' : 'AI振り返り';
---

<div class="ai-comment-section" data-type={type} data-race={raceData} data-masked={masked ? 'true' : 'false'}>
  <div class="ai-comment-header">
    <div class="ai-comment-header-left">
      <div class="ai-comment-badge">
        <span class="ai-pulse"></span>
        <span class="ai-badge-text">AI</span>
      </div>
      <div class="ai-comment-title-area">
        <span class="ai-comment-label">{label}</span>
        <span class="ai-comment-sub">Powered by Keiba Intelligence</span>
      </div>
    </div>
    <button class="ai-comment-toggle" aria-label="AI解説を表示">
      <span class="toggle-text">解説を見る</span>
      <span class="toggle-arrow">▼</span>
    </button>
  </div>
  <div class="ai-comment-body" style="display: none;">
    <div class="ai-comment-loading" style="display: none;">
      <div class="ai-loading-bar">
        <div class="ai-loading-progress"></div>
      </div>
      <span class="ai-loading-text">AIがレースを分析中...</span>
    </div>
    <div class="ai-comment-text"></div>
  </div>
</div>

<style>
  .ai-comment-section {
    margin: 16px 0;
    border-radius: 12px;
    border: 2px solid rgba(59, 130, 246, 0.4);
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%);
    overflow: visible;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .ai-comment-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899, #8b5cf6, #3b82f6);
    background-size: 200% 100%;
    animation: gradientSlide 3s linear infinite;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }

  @keyframes gradientSlide {
    0% { background-position: 0% 0%; }
    100% { background-position: 200% 0%; }
  }

  .ai-comment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ai-comment-header:hover {
    background: rgba(59, 130, 246, 0.05);
  }

  .ai-comment-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-comment-badge {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px rgba(59, 130, 246, 0.4);
    flex-shrink: 0;
  }

  .ai-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 14px;
    border: 2px solid rgba(59, 130, 246, 0.5);
    animation: aiBadgePulse 2s ease-in-out infinite;
  }

  @keyframes aiBadgePulse {
    0%, 100% { opacity: 0; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .ai-badge-text {
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .ai-comment-title-area {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-comment-label {
    font-size: 1.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-comment-sub {
    font-size: 0.7rem;
    color: rgba(139, 92, 246, 0.7);
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .ai-comment-toggle {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.15));
    border: 1px solid rgba(59, 130, 246, 0.4);
    border-radius: 20px;
    padding: 8px 18px;
    color: #60a5fa;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .ai-comment-toggle:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(139, 92, 246, 0.25));
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
  }

  .ai-comment-toggle.open {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
    border-color: transparent;
  }

  .ai-comment-toggle.open .toggle-arrow {
    transform: rotate(180deg);
  }

  .toggle-arrow {
    font-size: 0.7rem;
    transition: transform 0.2s ease;
  }

  .ai-comment-body {
    padding: 0 20px 20px;
  }

  /* ローディング */
  .ai-comment-loading {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 0;
  }

  .ai-loading-bar {
    width: 100%;
    height: 4px;
    background: rgba(59, 130, 246, 0.15);
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-loading-progress {
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
    border-radius: 4px;
    animation: loadingProgress 1.5s ease-in-out infinite;
  }

  @keyframes loadingProgress {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(350%); }
  }

  .ai-loading-text {
    font-size: 0.85rem;
    color: #60a5fa;
    font-weight: 500;
  }

  /* テキスト */
  .ai-comment-text {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--text-primary);
    padding: 16px;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    border-left: 3px solid;
    border-image: linear-gradient(180deg, #3b82f6, #8b5cf6) 1;
  }

  .ai-comment-text p {
    margin-bottom: 8px;
  }

  .ai-comment-text p:last-child {
    margin-bottom: 0;
  }

  .ai-comment-text.error {
    color: var(--text-secondary);
    font-style: italic;
    border-image: none;
    border-left-color: rgba(239, 68, 68, 0.5);
  }

  /* マスク（無料版） */
  .ai-comment-masked {
    position: relative;
    margin-top: 12px;
    padding: 14px 16px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    border: 1px dashed rgba(139, 92, 246, 0.4);
    overflow: hidden;
  }

  .ai-comment-masked-blur {
    filter: blur(5px);
    user-select: none;
    pointer-events: none;
    color: var(--text-primary);
    line-height: 1.85;
    font-size: 0.95rem;
  }

  .ai-comment-masked-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(15, 23, 42, 0.88) 100%);
    padding: 16px;
    text-align: center;
  }

  .ai-comment-masked-lock {
    font-size: 1.6rem;
  }

  .ai-comment-masked-message {
    font-size: 0.9rem;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.5;
  }

  .ai-comment-masked-cta {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 999px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ai-comment-masked-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(139, 92, 246, 0.45);
  }

  @media (max-width: 768px) {
    .ai-comment-header {
      padding: 12px 14px;
    }

    .ai-comment-badge {
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }

    .ai-badge-text {
      font-size: 0.75rem;
    }

    .ai-comment-label {
      font-size: 0.95rem;
    }

    .ai-comment-toggle {
      padding: 6px 12px;
      font-size: 0.75rem;
    }

    .ai-comment-body {
      padding: 0 14px 14px;
    }

    .ai-comment-text {
      font-size: 0.9rem;
      padding: 12px;
    }
  }
</style>

<script is:inline>
  // イベント委譲で全AIコメントセクションに対応（1回だけ登録）
  if (!window._aiCommentInitialized) {
    window._aiCommentInitialized = true;
    window._aiCommentCache = {};
    window._aiCommentLoaded = new Set();

    document.addEventListener('click', async (e) => {
      const header = e.target.closest('.ai-comment-header');
      if (!header) return;

      const section = header.closest('.ai-comment-section');
      if (!section) return;

      const body = section.querySelector('.ai-comment-body');
      const toggle = section.querySelector('.ai-comment-toggle');
      const toggleText = toggle.querySelector('.toggle-text');
      const loading = section.querySelector('.ai-comment-loading');
      const textEl = section.querySelector('.ai-comment-text');
      const type = section.dataset.type;

      let raceData;
      try { raceData = JSON.parse(section.dataset.race); } catch(ex) { return; }

      const cacheKey = `${type}-${raceData.date}-${raceData.venue}-${raceData.raceNumber}`;
      const isOpen = body.style.display !== 'block';

      body.style.display = isOpen ? 'block' : 'none';
      toggle.classList.toggle('open', isOpen);
      toggleText.textContent = isOpen ? '閉じる' : '解説を見る';

      if (isOpen && !window._aiCommentLoaded.has(cacheKey)) {
        const isMasked = section.dataset.masked === 'true';
        // キャッシュチェック
        if (window._aiCommentCache[cacheKey]) {
          renderAIComment(textEl, window._aiCommentCache[cacheKey], isMasked);
          window._aiCommentLoaded.add(cacheKey);
          return;
        }

        loading.style.display = 'flex';
        textEl.textContent = '';

        try {
          const res = await fetch('/.netlify/functions/gemini-race-analysis', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type, raceData })
          });
          const data = await res.json();
          loading.style.display = 'none';

          if (data.success && data.comment) {
            console.log('[AI Comment] API response length:', data.comment.length, 'chars');
            window._aiCommentCache[cacheKey] = data.comment;
            const isMasked = section.dataset.masked === 'true';
            renderAIComment(textEl, data.comment, isMasked);
          } else {
            textEl.textContent = 'AI解説を取得できませんでした。';
            textEl.classList.add('error');
          }
        } catch (err) {
          loading.style.display = 'none';
          textEl.textContent = 'AI解説を取得できませんでした。';
          textEl.classList.add('error');
        }
        window._aiCommentLoaded.add(cacheKey);
      }
    });

    function renderAIComment(el, comment, masked) {
      el.innerHTML = '';
      const lines = comment.split('\n').filter(l => l.trim());

      if (!masked) {
        lines.forEach(line => {
          const p = document.createElement('p');
          p.textContent = line;
          el.appendChild(p);
        });
        return;
      }

      // 無料版: 最初の1〜2文のみ表示、残りをマスク
      const fullText = lines.join('\n');
      // 最初の「。」までを可視範囲とする（ただし短すぎる場合は2文目まで）
      let cutIdx = fullText.indexOf('。');
      if (cutIdx !== -1 && cutIdx < 40) {
        const next = fullText.indexOf('。', cutIdx + 1);
        if (next !== -1) cutIdx = next;
      }
      if (cutIdx === -1) cutIdx = Math.min(80, fullText.length - 1);
      const visible = fullText.slice(0, cutIdx + 1);
      const hidden = fullText.slice(cutIdx + 1);

      const visibleLines = visible.split('\n').filter(l => l.trim());
      visibleLines.forEach((line, i) => {
        const p = document.createElement('p');
        p.textContent = i === visibleLines.length - 1 ? line + '…' : line;
        el.appendChild(p);
      });

      if (hidden.trim()) {
        const maskWrap = document.createElement('div');
        maskWrap.className = 'ai-comment-masked';

        const blur = document.createElement('div');
        blur.className = 'ai-comment-masked-blur';
        blur.textContent = hidden.replace(/\n+/g, ' ').slice(0, 200);
        maskWrap.appendChild(blur);

        const overlay = document.createElement('div');
        overlay.className = 'ai-comment-masked-overlay';
        overlay.innerHTML = `
          <div class="ai-comment-masked-lock">🔒</div>
          <div class="ai-comment-masked-message">続きは有料会員で<br>全文ご覧いただけます</div>
          <a href="/pricing" class="ai-comment-masked-cta">料金プランを見る →</a>
        `;
        maskWrap.appendChild(overlay);
        el.appendChild(maskWrap);
      }
    }
  }
</script>
