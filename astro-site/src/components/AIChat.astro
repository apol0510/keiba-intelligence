---
// AI Chat Widget Component
---

<div id="ai-chat-widget">
  <!-- チャットボタン -->
  <button id="chat-toggle-btn" class="chat-toggle-btn" aria-label="AIチャットを開く">
    <svg class="icon-chat" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2C6.48 2 2 6.48 2 12C2 13.93 2.63 15.71 3.7 17.17L2.09 21.49C1.96 21.88 2.07 22.31 2.37 22.6C2.66 22.89 3.09 23 3.48 22.87L7.83 21.29C9.29 22.37 11.07 23 12.99 23C18.51 23 22.99 18.52 22.99 13C22.99 7.48 18.52 2 12 2Z" fill="currentColor"/>
    </svg>
    <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z" fill="currentColor"/>
    </svg>
  </button>

  <!-- チャットウィンドウ -->
  <div id="chat-window" class="chat-window">
    <div class="chat-header">
      <div class="chat-title">
        <div class="ai-badge">🤖 AI</div>
        <span>KEIBA Intelligence サポート</span>
      </div>
      <button id="chat-close-btn" class="chat-header-close" aria-label="閉じる">×</button>
    </div>

    <div id="chat-messages" class="chat-messages">
      <div class="message bot-message">
        <div class="message-avatar">🤖</div>
        <div class="message-content">
          <p>こんにちは！KEIBA Intelligenceのサポート担当AIです。</p>
          <p>サービスや料金プラン、予想・結果について、お気軽にご質問ください。</p>
        </div>
      </div>
    </div>

    <!-- クイック質問ボタン -->
    <div id="quick-questions" class="quick-questions">
      <button class="quick-btn" data-question="料金プランを教えてください">料金プラン</button>
      <button class="quick-btn" data-question="無料会員でできることは？">無料会員の特典</button>
      <button class="quick-btn" data-question="的中率はどのくらいですか？">的中率について</button>
      <button class="quick-btn" data-question="どうやって登録しますか？">登録方法</button>
    </div>

    <div class="chat-input-container">
      <input
        type="text"
        id="chat-input"
        class="chat-input"
        placeholder="メッセージを入力..."
        maxlength="500"
      />
      <button id="chat-send-btn" class="chat-send-btn" aria-label="送信">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.01 21L23 12L2.01 3L2 10L17 12L2 14L2.01 21Z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* チャットトグルボタン */
  .chat-toggle-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border: none;
    color: white;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    transition: all 0.3s ease;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-toggle-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 16px rgba(59, 130, 246, 0.6);
  }

  .chat-toggle-btn .icon-close { display: none; }
  .chat-toggle-btn.active .icon-chat { display: none; }
  .chat-toggle-btn.active .icon-close { display: block; }

  /* チャットウィンドウ */
  .chat-window {
    position: fixed;
    bottom: 100px;
    right: 24px;
    width: 380px;
    height: 550px;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    display: none;
    flex-direction: column;
    z-index: 9998;
    overflow: hidden;
  }

  .chat-window.active {
    display: flex;
  }

  /* チャットヘッダー */
  .chat-header {
    padding: var(--spacing-md);
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2));
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }

  .chat-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.9rem;
  }

  .ai-badge {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 1.25rem;
  }

  .chat-header-close {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .chat-header-close:hover {
    color: var(--text-primary);
  }

  /* メッセージエリア */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .message {
    display: flex;
    gap: var(--spacing-sm);
    animation: messageSlideIn 0.3s ease-out;
  }

  @keyframes messageSlideIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .message-content {
    flex: 1;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .message-content p { margin-bottom: var(--spacing-xs); }
  .message-content p:last-child { margin-bottom: 0; }

  .bot-message .message-content {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: var(--text-primary);
  }

  .user-message {
    flex-direction: row-reverse;
  }

  .user-message .message-content {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(139, 92, 246, 0.3));
    border: 1px solid rgba(59, 130, 246, 0.5);
    color: var(--text-primary);
  }

  /* エラーメッセージ */
  .error-message .message-content {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  /* お問い合わせリンク */
  .contact-link {
    display: inline-block;
    margin-top: 8px;
    padding: 6px 12px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white !important;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .contact-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
  }

  /* フォローアップUI */
  .followup-container {
    animation: messageSlideIn 0.3s ease-out;
    padding: 10px 0 4px;
  }

  .followup-question {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
    text-align: center;
  }

  .followup-buttons {
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .followup-btn {
    padding: 6px 14px;
    border-radius: 16px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .followup-btn.yes {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
  }

  .followup-btn.yes:hover {
    background: rgba(16, 185, 129, 0.25);
  }

  .followup-btn.no {
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.4);
    color: #fbbf24;
  }

  .followup-btn.no:hover {
    background: rgba(251, 191, 36, 0.25);
  }

  .followup-btn.contact {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
    text-decoration: none;
    display: inline-block;
  }

  .followup-btn.contact:hover {
    background: rgba(239, 68, 68, 0.2);
  }

  /* ページリンクボタン */
  .page-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .page-link-btn {
    display: inline-block;
    padding: 5px 10px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 6px;
    color: #60a5fa;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .page-link-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
  }

  /* 解決済みメッセージ */
  .resolved-msg {
    text-align: center;
    font-size: 0.8rem;
    color: #34d399;
    padding: 6px;
    animation: messageSlideIn 0.3s ease-out;
  }

  /* クイック質問ボタン */
  .quick-questions {
    padding: 8px var(--spacing-md);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    border-top: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .quick-questions.hidden {
    display: none;
  }

  .quick-btn {
    padding: 5px 10px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 16px;
    color: #60a5fa;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .quick-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
  }

  /* ローディング */
  .typing-indicator {
    display: flex;
    gap: var(--spacing-sm);
    animation: messageSlideIn 0.3s ease-out;
  }

  .loading-dots {
    display: inline-flex;
    gap: 4px;
    padding: var(--spacing-sm) var(--spacing-md);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: var(--radius-md);
  }

  .loading-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3b82f6;
    animation: loadingDot 1.4s infinite ease-in-out both;
  }

  .loading-dots span:nth-child(1) { animation-delay: -0.32s; }
  .loading-dots span:nth-child(2) { animation-delay: -0.16s; }

  @keyframes loadingDot {
    0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* 入力エリア */
  .chat-input-container {
    padding: var(--spacing-md);
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: var(--spacing-sm);
    flex-shrink: 0;
  }

  .chat-input {
    flex: 1;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 0.875rem;
  }

  .chat-input:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }

  .chat-send-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border: none;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .chat-send-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
  }

  .chat-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* レスポンシブ */
  @media (max-width: 768px) {
    .chat-window {
      width: calc(100% - 32px);
      height: calc(100vh - 140px);
      bottom: 90px;
      right: 16px;
      left: 16px;
    }

    .chat-toggle-btn {
      bottom: 16px;
      right: 16px;
    }
  }
</style>

<script is:inline>
  let conversationHistory = [];
  let isOpen = false;
  let isSending = false;

  const toggleBtn = document.getElementById('chat-toggle-btn');
  const closeBtn = document.getElementById('chat-close-btn');
  const chatWindow = document.getElementById('chat-window');
  const chatInput = document.getElementById('chat-input');
  const sendBtn = document.getElementById('chat-send-btn');
  const messagesContainer = document.getElementById('chat-messages');
  const quickQuestions = document.getElementById('quick-questions');

  // チャットウィンドウの開閉
  function toggleChat() {
    isOpen = !isOpen;
    toggleBtn.classList.toggle('active');
    chatWindow.classList.toggle('active');
    if (isOpen) chatInput.focus();
  }

  toggleBtn.addEventListener('click', toggleChat);
  closeBtn.addEventListener('click', toggleChat);

  // クイック質問ボタン
  document.querySelectorAll('.quick-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const question = btn.getAttribute('data-question');
      chatInput.value = question;
      sendMessage();
    });
  });

  // メッセージ送信
  async function sendMessage() {
    const message = chatInput.value.trim();
    if (!message || isSending) return;

    isSending = true;
    addMessage(message, 'user');
    chatInput.value = '';
    sendBtn.disabled = true;

    // クイック質問を非表示
    quickQuestions.classList.add('hidden');

    conversationHistory.push({ role: 'user', content: message });

    // ローディング表示
    const loadingEl = showTypingIndicator();

    try {
      const response = await fetch('/.netlify/functions/gemini-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message, conversationHistory })
      });

      const data = await response.json();

      // ローディング削除
      loadingEl.remove();

      if (data.success && data.message) {
        addMessage(data.message, 'bot');
        conversationHistory.push({ role: 'assistant', content: data.message });
        showFollowup(data.message);
      } else if (data.message) {
        // エラーだがメッセージがある場合（フォールバック）
        addMessage(data.message, 'bot', true);
      } else {
        throw new Error(data.error || 'エラーが発生しました');
      }
    } catch (error) {
      console.error('Chat Error:', error);
      if (loadingEl.parentNode) loadingEl.remove();
      addMessage('申し訳ございません。一時的にエラーが発生しています。\nお手数ですが、お問い合わせフォームよりご連絡ください。', 'bot', true);
    } finally {
      isSending = false;
      sendBtn.disabled = false;
      chatInput.focus();
    }
  }

  // タイピングインジケーター
  function showTypingIndicator() {
    const div = document.createElement('div');
    div.className = 'typing-indicator';
    div.innerHTML = `
      <div class="message-avatar">🤖</div>
      <div class="loading-dots"><span></span><span></span><span></span></div>
    `;
    messagesContainer.appendChild(div);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    return div;
  }

  // メッセージを追加
  function addMessage(text, type, isError) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${type}-message${isError ? ' error-message' : ''}`;

    const avatar = document.createElement('div');
    avatar.className = 'message-avatar';
    avatar.textContent = type === 'bot' ? '🤖' : '👤';

    const content = document.createElement('div');
    content.className = 'message-content';

    const paragraphs = text.split('\n').filter(p => p.trim());
    paragraphs.forEach(p => {
      const pElement = document.createElement('p');
      pElement.textContent = p;
      content.appendChild(pElement);
    });

    // エラー時はお問い合わせリンクを追加
    if (isError) {
      const link = document.createElement('a');
      link.href = '/contact';
      link.className = 'contact-link';
      link.textContent = 'お問い合わせフォームへ';
      content.appendChild(link);
    }

    messageDiv.appendChild(avatar);
    messageDiv.appendChild(content);
    messagesContainer.appendChild(messageDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  // 回答内容からページリンクを判定
  function getRelatedLinks(aiMessage) {
    const links = [];
    const msg = aiMessage.toLowerCase();
    if (msg.includes('料金') || msg.includes('プラン') || msg.includes('価格')) {
      links.push({ text: '料金プランを見る', href: '/pricing' });
    }
    if (msg.includes('無料会員') || msg.includes('登録')) {
      links.push({ text: '無料会員登録', href: '/register' });
    }
    if (msg.includes('的中') || msg.includes('実績') || msg.includes('回収率')) {
      links.push({ text: '的中実績を見る', href: '/archive/' });
    }
    if (msg.includes('予想') || msg.includes('買い目')) {
      links.push({ text: '無料予想を見る', href: '/free-prediction' });
    }
    if (msg.includes('ログイン') || msg.includes('マイページ')) {
      links.push({ text: 'ログイン', href: '/login' });
    }
    return links;
  }

  // フォローアップUI表示
  function showFollowup(aiMessage) {
    // 既存のフォローアップを削除
    const existing = messagesContainer.querySelectorAll('.followup-container');
    existing.forEach(el => el.remove());

    const container = document.createElement('div');
    container.className = 'followup-container';

    // 関連ページリンク
    const links = getRelatedLinks(aiMessage);
    if (links.length > 0) {
      const linksDiv = document.createElement('div');
      linksDiv.className = 'page-links';
      links.forEach(link => {
        const a = document.createElement('a');
        a.href = link.href;
        a.className = 'page-link-btn';
        a.textContent = link.text;
        linksDiv.appendChild(a);
      });
      container.appendChild(linksDiv);
    }

    // 「解決しましたか？」
    const questionDiv = document.createElement('div');
    questionDiv.className = 'followup-question';
    questionDiv.textContent = 'この回答で解決しましたか？';
    container.appendChild(questionDiv);

    const buttonsDiv = document.createElement('div');
    buttonsDiv.className = 'followup-buttons';

    const yesBtn = document.createElement('button');
    yesBtn.className = 'followup-btn yes';
    yesBtn.textContent = '解決した';
    yesBtn.addEventListener('click', () => {
      container.remove();
      const resolved = document.createElement('div');
      resolved.className = 'resolved-msg';
      resolved.textContent = 'ご利用ありがとうございます！他にご質問があればお気軽にどうぞ。';
      messagesContainer.appendChild(resolved);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      // クイック質問を再表示
      quickQuestions.classList.remove('hidden');
    });

    const moreBtn = document.createElement('button');
    moreBtn.className = 'followup-btn no';
    moreBtn.textContent = '続けて質問する';
    moreBtn.addEventListener('click', () => {
      container.remove();
      chatInput.focus();
    });

    const contactLink = document.createElement('a');
    contactLink.href = '/contact';
    contactLink.className = 'followup-btn contact';
    contactLink.textContent = 'お問い合わせフォームへ';

    buttonsDiv.appendChild(yesBtn);
    buttonsDiv.appendChild(moreBtn);
    buttonsDiv.appendChild(contactLink);
    container.appendChild(buttonsDiv);

    messagesContainer.appendChild(container);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  // イベントリスナー
  sendBtn.addEventListener('click', sendMessage);
  chatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });
</script>
