---
/**
 * DisplayedBasisStats — 表示買い目基準の成績（的中率・AI選定の組数・回収率）
 *
 * 2026-10-06 MK: 旧 5 点基準の回収率は撤去し、**実際に会員へ表示した買い目（AI全選定）**を基準に再表示する。
 *   - 正本: data/stats/displayedSummary.json（scripts/recomputeDisplayedReturn.mjs が build 前に生成）
 *   - 入力: 公開時に凍結した表示買い目（data/displayedBets）× 確定した馬単の払戻（archive）
 *   - 集計の起点: 買い目パネル公開日（PUBLIC_FROM）以降。結果ページの日別の数字と同じ定義
 */
import summary from '../../data/stats/displayedSummary.json';

interface Props {
  markets: Array<'jra' | 'nankan'>;
  compact?: boolean;
}
const { markets, compact = false } = Astro.props;
const label = { jra: '中央競馬', nankan: '南関競馬' } as const;
const fmtDate = (d: string | null) => (d ? d.replace(/-/g, '/') : '—');
const rows = markets
  .map((m) => ({ m, s: (summary as any)[m] }))
  .filter(({ s }) => s && s.races > 0);
---
{rows.length > 0 && (
  <section class:list={['dbs', { 'dbs-compact': compact }]} aria-label="表示買い目基準の成績">
    <p class="dbs-title">表示買い目基準の成績</p>
    <div class="dbs-grid">
      {rows.map(({ m, s }) => (
        <div class="dbs-card">
          {markets.length > 1 && <p class="dbs-market">{label[m]}</p>}
          <dl class="dbs-figs">
            <div><dt>的中率</dt><dd>{s.hitRate}%</dd><dd class="dbs-sub">{s.hits}/{s.races}レース</dd></div>
            <div><dt>AI選定</dt><dd>平均{s.avgCombos}組</dd><dd class="dbs-sub">1レースあたり</dd></div>
            <div><dt>回収率</dt><dd>{s.returnRate}%</dd><dd class="dbs-sub">AI全選定を各100円</dd></div>
          </dl>
          <p class="dbs-period">{fmtDate(s.from)}〜{fmtDate(s.to)}</p>
        </div>
      ))}
    </div>
    <p class="dbs-note">
      公開時に記録したAI全選定（会員に表示した馬単の組み合わせのすべて）を、各組100円ずつ購入したと仮定した集計です。
      着順と払戻の記録が食い違うレースは含めていません。過去の結果は将来の結果を保証するものではありません。
    </p>
  </section>
)}

<style>
  .dbs { margin: 1.25rem auto; max-width: 960px; padding: 1rem 1.25rem; border-radius: 12px;
    background: rgba(127, 127, 127, 0.08); border: 1px solid rgba(127, 127, 127, 0.25); text-align: left; }
  .dbs-title { font-weight: 700; font-size: 0.95rem; margin: 0 0 0.6rem; }
  .dbs-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .dbs-card { padding: 0.6rem 0.75rem; border-radius: 10px; background: rgba(127, 127, 127, 0.08); }
  .dbs-market { font-weight: 700; font-size: 0.85rem; margin: 0 0 0.35rem; }
  .dbs-figs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin: 0; }
  .dbs-figs dt { font-size: 0.75rem; opacity: 0.8; }
  .dbs-figs dd { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
  .dbs-figs dd.dbs-sub { font-size: 0.7rem; font-weight: 400; opacity: 0.75; }
  .dbs-period { margin: 0.4rem 0 0; font-size: 0.72rem; opacity: 0.75; }
  .dbs-note { margin: 0.6rem 0 0; font-size: 0.72rem; line-height: 1.55; opacity: 0.8; }
  .dbs-compact { padding: 0.75rem 1rem; }
  .dbs-compact .dbs-figs dd { font-size: 1.05rem; }
  @media (max-width: 480px) {
    .dbs { padding: 0.75rem; }
    .dbs-figs dd { font-size: 1.05rem; }
  }
</style>
