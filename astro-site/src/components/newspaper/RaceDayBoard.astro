---
/**
 * RaceDayBoard.astro — 開催 1 日ぶんの紙面（会場タブ ＋ レースタブ）
 *
 * 正本: docs/RENEWAL_2026_08.md §4
 *
 * 🔴 全経路（JRA/南関 × guest/free/paid）がこの 1 コンポーネントを共有する。
 *    片肺修正による退行を構造的に防ぐ（docs/ui-cross-plan-regression-policy.md）。
 *
 * 🔴 tier による出し分けは RaceNewspaper が担当する。ここでは view をそのまま渡すだけ。
 *
 * 🔴 2026-08-29 修正（重大・merge 前）:
 *    旧実装はレース一覧を **ページ内アンカー（`#race-v-rn`）へのジャンプ**で行い、
 *    全レースを縦に積んでいた。JRA は 3 会場 36 レースで文書高が 24,000px を超えるため、
 *    `html { scroll-behavior: smooth }`（global.scss）配下でジャンプが成立せず、
 *    **`scrollY` が 0 のまま動かない**（Chrome で再現。`auto` に切ると 19,097px へ正常移動）。
 *    結果として「11R を選んだのに 1R が表示されたまま」に見えていた。
 *
 *    → **レースもタブ化し、選択したレースだけを表示する**。
 *      スクロール距離に依存しなくなるため、この不一致は原理的に起こらない。
 *      会場タブと同じ操作体系に揃う。
 *
 * 🔴 表示の一致は「同じ `rn` からタブとパネルの両方を作る」ことで担保する。
 *    タブのラベル・`data-race-tab`・パネルの `data-race-panel`・`id` はすべて
 *    同一の `venueIndex` / `rn` から生成し、取り違えの余地を作らない。
 */

import RaceNewspaper from './RaceNewspaper.astro';
import {
  racesOf, racesResolverFor, featuresResolverForRace, statsResolver,
} from '../../lib/prediction/loadRaceDay.js';
import { isMainRace } from '../../utils/mainRaceBetting.js';
import { verifiedRaceDay } from '../../lib/prediction/raceDayContract.js';
import { formatRaceDate } from '../../lib/prediction/raceDayDate.js';

interface Props {
  day: { category: string; date: string | null; venues: any[]; error: string | null };
  view: { tier?: string; showMarks?: boolean; showBetting?: boolean; authenticated?: boolean };
  category: 'nankan' | 'jra';
}

const { day: rawDay, view, category } = Astro.props;

/**
 * 🔴 描画前に venue / date / raceNumber の整合性を検証する（fail-closed）。
 *    契約を満たさないレースは **描画しない**。
 *    別レースの予想をそのレースのものとして見せるより、出さない方が安全である。
 *    契約は `src/lib/prediction/raceDayContract.js`。
 */
const { day, dropped } = verifiedRaceDay(rawDay);

const resolveRaces = racesResolverFor(category);
const resolveStats = statsResolver();

const venues = Array.isArray(day?.venues) ? day.venues : [];
const isMulti = venues.length > 1;

/** 買い目は形が 2 種類ある（配列 / { umatan: [...] }）。どちらも受ける。 */
function bettingLinesOf(race: any): string[] {
  const b = race?.bettingLines;
  if (Array.isArray(b)) return b.filter((x) => typeof x === 'string');
  if (b && Array.isArray(b.umatan)) return b.umatan.filter((x: any) => typeof x === 'string');
  return [];
}

const formatDate = formatRaceDate;

const categoryLabel = category === 'jra' ? '中央競馬' : '南関東';

/**
 * 会場ごとに「レース番号の一覧」を先に確定させる。
 * タブとパネルはこの同一配列から作るため、取り違えが起きない。
 */
const venueViews = venues.map((venue: any, venueIndex: number) => {
  const races = racesOf(venue);
  const total = races.length;
  return {
    venue,
    venueIndex,
    venueName: venue?.venueName ?? '—',
    total,
    entries: races.map((race: any) => {
      const rn = race?.raceInfo?.raceNumber ?? null;
      return {
        race,
        rn,
        key: `${venueIndex}-${rn}`,
        isMain: rn != null && isMainRace(rn, total),
      };
    }),
  };
});
---

{day?.error && venues.length === 0 ? (
  <div class="rdb-empty">
    <p class="rdb-empty-title">本日の予想はまだ公開されていません</p>
    <p class="rdb-empty-desc">開催前日の夜に更新されます。過去の的中実績はいつでもご覧いただけます。</p>
    <a class="rdb-empty-link" href={category === 'jra' ? '/archive/jra' : '/archive/nankan'}>的中実績を見る</a>
  </div>
) : (
  <div class="raceday" data-category={category} data-tier={view?.tier}>
    <!-- 日付・会場ヘッダー -->
    <header class="rdb-head">
      <div class="rdb-date">
        <span class="rdb-cat">{categoryLabel}</span>
        <strong>{formatDate(day?.date)}</strong>
      </div>
      <p class="rdb-lead">
        全レースの馬柱・過去走・AI短評・展開予想を<b>無料で公開</b>しています。
      </p>
      {dropped.length > 0 && (
        <p class="rdb-dropped">
          データの整合性を確認できなかったレースが {dropped.length} 件あり、表示していません。
        </p>
      )}
    </header>

    <!-- 会場タブ（複数会場開催のときだけ） -->
    {isMulti && (
      <nav class="rdb-tabs" role="tablist" aria-label="開催会場">
        {venueViews.map((v) => (
          <button
            class={`rdb-tab ${v.venueIndex === 0 ? 'is-active' : ''}`}
            type="button"
            role="tab"
            aria-selected={v.venueIndex === 0 ? 'true' : 'false'}
            aria-controls={`venue-${v.venueIndex}`}
            data-venue-tab={String(v.venueIndex)}
          >
            <span class="rdb-tab-name">{v.venueName}</span>
            <span class="rdb-tab-sub">{v.total}R</span>
          </button>
        ))}
      </nav>
    )}

    {venueViews.map((v) => (
      <section
        class="rdb-venue"
        id={`venue-${v.venueIndex}`}
        data-venue={v.venueName}
        data-venue-panel={String(v.venueIndex)}
        hidden={isMulti && v.venueIndex !== 0}
      >
        <!-- レースタブ（選択したレースだけを表示する） -->
        {v.entries.length > 1 && (
          <nav class="rdb-races" role="tablist" aria-label={`${v.venueName} レース`}>
            {v.entries.map((e, i) => (
              <button
                class={`rdb-race-tab ${e.isMain ? 'is-main' : ''} ${i === 0 ? 'is-active' : ''}`}
                type="button"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`race-${e.key}`}
                data-race-tab={e.key}
                data-venue-index={String(v.venueIndex)}
              >
                {e.rn ?? '—'}<i>R</i>
              </button>
            ))}
          </nav>
        )}

        {v.entries.map((e, i) => (
          <div
            id={`race-${e.key}`}
            class="rdb-race-panel"
            data-race-panel={e.key}
            data-venue-index={String(v.venueIndex)}
            data-race-number={e.rn == null ? '' : String(e.rn)}
            hidden={v.entries.length > 1 && i !== 0}
          >
            <RaceNewspaper
              race={e.race}
              view={view}
              venue={category}
              resolveRaces={resolveRaces}
              resolveFeatures={featuresResolverForRace(e.race, v.venue.featureScores)}
              resolveStats={resolveStats}
              bettingLines={bettingLinesOf(e.race)}
              betType="馬単"
              isMain={!!e.isMain}
              badge={e.isMain ? 'メインレース' : null}
            />
          </div>
        ))}
      </section>
    ))}
  </div>
)}

<script>
  /*
   * 会場タブ / レースタブの切り替え（表示のみ。認可には一切関与しない）。
   *
   * 🔴 スクロールでの移動は行わない。
   *    長大ページ + `scroll-behavior: smooth` ではアンカージャンプが成立せず、
   *    「選んだレースと表示されているレースが違う」状態を生むため
   *    （2026-08-29 に Chrome で再現・修正）。
   */
  function initRaceDayBoard() {
    const board = document.querySelector('.raceday');
    if (!board) return;

    const venueTabs = Array.from(board.querySelectorAll('[data-venue-tab]')) as HTMLElement[];
    const venuePanels = Array.from(board.querySelectorAll('[data-venue-panel]')) as HTMLElement[];
    const raceTabs = Array.from(board.querySelectorAll('[data-race-tab]')) as HTMLElement[];
    const racePanels = Array.from(board.querySelectorAll('[data-race-panel]')) as HTMLElement[];

    function show(el: HTMLElement, on: boolean) {
      if (on) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    }

    function selectRace(key: string, updateHash: boolean) {
      const target = racePanels.find((p) => p.getAttribute('data-race-panel') === key);
      if (!target) return false;
      const venueIndex = target.getAttribute('data-venue-index');

      racePanels.forEach((p) => {
        if (p.getAttribute('data-venue-index') !== venueIndex) return;
        show(p, p.getAttribute('data-race-panel') === key);
      });
      raceTabs.forEach((t) => {
        if (t.getAttribute('data-venue-index') !== venueIndex) return;
        const on = t.getAttribute('data-race-tab') === key;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      if (updateHash && window.history && window.history.replaceState) {
        window.history.replaceState(null, '', `#race-${key}`);
      }
      return true;
    }

    function selectVenue(index: string) {
      venueTabs.forEach((t) => {
        const on = t.getAttribute('data-venue-tab') === index;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      venuePanels.forEach((p) => show(p, p.getAttribute('data-venue-panel') === index));
    }

    venueTabs.forEach((t) => {
      t.addEventListener('click', () => {
        const idx = t.getAttribute('data-venue-tab');
        if (idx != null) selectVenue(idx);
      });
    });

    raceTabs.forEach((t) => {
      t.addEventListener('click', () => {
        const key = t.getAttribute('data-race-tab');
        if (key) selectRace(key, true);
      });
    });

    // 直リンク（#race-{venueIndex}-{raceNumber}）に対応する
    function applyHash() {
      const m = /^#race-(\d+)-(\d+)$/.exec(window.location.hash || '');
      if (!m) return;
      selectVenue(m[1]);
      selectRace(`${m[1]}-${m[2]}`, false);
    }

    applyHash();
    window.addEventListener('hashchange', applyHash);
  }

  initRaceDayBoard();
  document.addEventListener('astro:page-load', initRaceDayBoard);
</script>

<style>
  /* 会場タブ */
  .rdb-tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
    padding: 5px;
    background: var(--bg-muted);
    border-radius: var(--radius-pill);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .rdb-tab {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    flex: 1 0 auto;
    justify-content: center;
    padding: 9px 18px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-secondary);
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 140ms ease;
  }

  .rdb-tab:hover { color: var(--text-primary); }

  .rdb-tab.is-active {
    background: var(--bg-secondary);
    box-shadow: var(--shadow-sm);
  }

  /* 会場タブの選択中も 青→紫（文字だけをグラデーションで塗る） */
  .rdb-tab.is-active .rdb-tab-name {
    background: var(--grad-nav);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .rdb-tab-name { font-family: var(--font-serif); }

  .rdb-tab-sub {
    font-family: var(--font-num);
    font-size: 0.7rem;
    color: var(--text-tertiary);
    font-weight: 700;
  }

  .rdb-tab.is-active .rdb-tab-sub { color: #8b5cf6; }

  /* レースタブ */
  .rdb-races {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 14px;
    padding: 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }

  .rdb-race-tab {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    min-width: 44px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: var(--bg-muted);
    color: var(--text-secondary);
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .rdb-race-tab i {
    font-style: normal;
    font-size: 0.62rem;
    margin-left: 1px;
    color: var(--text-tertiary);
  }

  .rdb-race-tab:hover {
    background: var(--bg-secondary);
    border-color: var(--primary-start);
    color: var(--primary-start);
  }

  /* 🔴 メインレースのタブに見た目の差を付けない（2026-09-05 指示）。
     もとは金色（#fff7e0 / #8a6a00 / #f0d68a）、次に淡い 空→藤 ＋ 藤のリングに
     したが、いずれも他のタブと違って見えるため撤去した。
     `is-main` クラスはマークアップ側に残っているが、色は他のタブと同じ。
     🔴 ここに再びメイン専用の配色を足さないこと。 */

  /* 🔴 現在位置は 青→紫 のグラデーション（2026-08-31） */
  .rdb-race-tab.is-active {
    /* 白文字が AA を満たす濃いストップへ（青→紫は維持） */
    background: var(--grad-nav-btn);
    color: var(--btn-ink);
    border-color: transparent;
    box-shadow: 0 3px 12px rgba(124, 106, 246, 0.35);
  }

  /* 🔴 選択中の地は明るい 空→藤 になったので、白のままだと R が読めない */
  .rdb-race-tab.is-active i { color: var(--btn-ink); opacity: 0.75; }

  .rdb-head {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 3px double var(--text-primary);
  }

  .rdb-date {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  /*
   * 会場の分類ラベル（南関東 / 中央競馬）。
   * 🔴 2026-08-31: ブルーはナビゲーション（レースタブの選択中）に譲り、
   *    分類ラベルはスレートにした。青が並びすぎて現在位置が読めなかったため。
   */
  .rdb-cat {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--tool-gradient);
    color: var(--text-inverse);
  }

  .rdb-date strong {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--text-primary);
  }

  .rdb-lead {
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .rdb-lead b { color: var(--secondary-start); }

  .rdb-dropped {
    margin: 8px 0 0;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    background: rgba(217, 119, 6, 0.10);
    color: #92400e;
    font-size: 0.78rem;
  }

  .rdb-venue { margin-bottom: 32px; }

  /* データなし */
  .rdb-empty {
    text-align: center;
    padding: 56px 20px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
  }

  .rdb-empty-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--text-primary);
  }

  .rdb-empty-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin: 0 0 18px;
  }

  /* 主要 CTA: 青 → 紫（--primary-gradient は青→青の同系色） */
  .rdb-empty-link {
    display: inline-block;
    padding: 10px 24px;
    border-radius: var(--radius-pill);
    background: var(--grad-nav-btn);
    color: var(--btn-ink);
    font-weight: 700;
  }

  .rdb-empty-link:hover { color: var(--btn-ink); }
</style>
