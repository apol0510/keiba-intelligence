---
/**
 * RaceEntryTable.astro — 出馬表（基本 UI）
 *
 * 正本: docs/RENEWAL_2026_08.md §4
 *
 * 構成:
 *   枠 | 馬番 | 馬名＋AI短評1行 | 印 | AI指数 | 基礎指数 | 性齢 | 斤量 | 騎手 | 厩舎 | 詳細
 *   行をクリック/タップすると、**その馬の直下**に詳細アコーディオンが開く。
 *
 * 🔴 2026-08-29 変更:
 *   - **閉じた状態でも AI短評の 1 文目を出す**。文章は本改修の中心であり、
 *     アコーディオンに畳んで見えなくしてはいけない。
 *   - 「詳細 ▾」ボタンを置き、開けることを明示する（気づかない問題の解消）。
 *   - 各レースで 1 頭だけ既定で開く（操作を学習させる）。
 *   - 「コンピ」は裏側の呼称。表では **基礎指数** と表示する。
 *   - KI 自身のスコアは **AI指数**（旧「総合pt」。旧 JRA 画面では総合pt が
 *     コンピ指数の表示名だったため、名称の衝突を避けて改称した）。
 *
 * 🔴 tier による出し分けは **描画そのものを止める**（CSS で隠さない）:
 *    - 印・AI指数 … `view.showMarks` が false なら **列ごと出さない**
 *    - 買い目 … このコンポーネントは扱わない
 *
 * 🔴 存在しない情報を埋めない。値が 1 頭も無い列は出さない。
 *    枠番だけは **馬番と頭数から一意に決まる規則**で算出する（`frameNumber.js`）。
 */

import HorseDetailPanel from './HorseDetailPanel.astro';
import { getRoleMark } from '../../utils/sortHorsesByRole.js';
import { toComputerIndex } from '../../utils/computerIndexContract.js';
import { resolveFrameNumber } from '../../utils/frameNumber.js';

interface Props {
  horses: any[];
  view: { showMarks?: boolean; showBetting?: boolean; tier?: string };
  raceKey: string;
  narrativeOf: (horse: any) => any;
  featuresOf?: (horse: any) => any;
  pastRacesOf: (horse: any) => any[];
  statsOf?: (horse: any) => any;
  /** 既定で開いておく馬番（1 頭だけ。操作に気づいてもらうため） */
  defaultOpenHorseNumber?: number | null;
}

const {
  horses = [], view, raceKey,
  narrativeOf, featuresOf, pastRacesOf, statsOf,
  defaultOpenHorseNumber = null,
} = Astro.props;

const showMarks = !!view?.showMarks;
const fieldSize = horses.length;

function markClass(role: string | undefined) {
  switch (role) {
    case '本命': return 'mk-honmei';
    case '対抗': return 'mk-taiko';
    case '単穴': return 'mk-tana';
    default: return 'mk-renka';
  }
}

/**
 * 閉じた行に出す抜粋。
 *
 * 🔴 役割語（「本命に推す。」「ヒモまで。」）は **抜粋に使わない**。
 *    それだけだと無料会員のほうが未登録より情報が乏しくなるため
 *    （役割は名前の横のタグで別途示している）。
 *    `narrative.sentences` は役割語を含まない本文だけなのでそこから取る。
 */
function excerptOf(narrative: any) {
  const body = Array.isArray(narrative?.sentences) ? narrative.sentences : [];
  const first = body.find((x: any) => typeof x === 'string' && x.trim());
  const s = first || (typeof narrative?.text === 'string' ? narrative.text : '');
  if (!s.trim()) return null;
  return s.length > 60 ? `${s.slice(0, 59)}…` : s;
}

const rows = horses.map((h: any) => {
  const frame = resolveFrameNumber(h, fieldSize);
  const weightNum = typeof h?.weight === 'number' ? h.weight : (h?.weight ? Number(h.weight) : null);
  const narrative = narrativeOf ? narrativeOf(h) : null;
  return {
    horse: h,
    narrative,
    excerpt: excerptOf(narrative),
    frame,
    frameClass: frame && frame >= 1 && frame <= 8 ? `waku-${frame}` : 'waku-none',
    number: h?.horseNumber ?? null,
    name: h?.horseName || '—',
    mark: showMarks && h?.role ? getRoleMark(h.role) : null,
    markClass: markClass(h?.role),
    role: showMarks ? (h?.role || null) : null,
    pt: showMarks && typeof h?.pt === 'number' && Number.isFinite(h.pt) ? h.pt : null,
    age: h?.age || null,
    weight: Number.isFinite(weightNum) ? weightNum : null,
    jockey: h?.jockey || null,
    trainer: h?.trainer || null,
    // 裏側の呼称は computerIndex。表示名は「基礎指数」。契約（10–99）外は表示しない
    baseIndex: toComputerIndex(h?.computerIndex),
  };
});

const hasBaseIndex = rows.some((r) => r.baseIndex != null);
const hasAge = rows.some((r) => r.age);
const hasWeight = rows.some((r) => r.weight != null);
const hasJockey = rows.some((r) => r.jockey);
const hasTrainer = rows.some((r) => r.trainer);

const colCount = 3 // 枠 / 馬番 / 馬名
  + (showMarks ? 2 : 0)
  + (hasBaseIndex ? 1 : 0)
  + (hasAge ? 1 : 0)
  + (hasWeight ? 1 : 0)
  + (hasJockey ? 1 : 0)
  + (hasTrainer ? 1 : 0)
  + 1; // 詳細
---

<div class="ret" data-race-key={raceKey}>
  <table class="ret-table">
    <thead>
      <tr>
        <th class="c-waku"><span class="sr">枠</span></th>
        <th class="c-num">馬番</th>
        <th class="c-name">馬名 ／ AI短評</th>
        {showMarks && <th class="c-mark">印</th>}
        {showMarks && <th class="c-pt">AI指数</th>}
        {hasBaseIndex && <th class="c-base">基礎指数</th>}
        {hasAge && <th class="c-age">性齢</th>}
        {hasWeight && <th class="c-weight">斤量</th>}
        {hasJockey && <th class="c-jockey">騎手</th>}
        {hasTrainer && <th class="c-trainer">厩舎</th>}
        <th class="c-more"><span class="sr">詳細</span></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => {
        const rowId = `${raceKey}-h${r.number ?? i}`;
        const isOpen = defaultOpenHorseNumber != null && r.number === defaultOpenHorseNumber;
        return (
          <>
            <tr
              class={`ret-row ${r.frameClass} ${showMarks && r.horse?.role === '本命' ? 'is-honmei' : ''} ${isOpen ? 'is-open' : ''}`}
              data-row={rowId}
              tabindex="0"
              role="button"
              aria-expanded={isOpen ? 'true' : 'false'}
              aria-controls={`detail-${rowId}`}
            >
              <td class="c-waku"><span class="waku-chip">{r.frame ?? ''}</span></td>
              <td class="c-num"><span class="uma-badge">{r.number ?? ''}</span></td>
              <td class="c-name">
                <span class="horse-name">{r.name}</span>
                {r.role && <span class={`role-tag ${r.markClass}`}>{r.role}</span>}
                {r.excerpt && <span class="horse-excerpt">{r.excerpt}</span>}
              </td>
              {showMarks && (
                <td class="c-mark">
                  {r.mark ? <span class={`mark ${r.markClass}`} title={r.horse?.role}>{r.mark}</span> : ''}
                </td>
              )}
              {showMarks && <td class="c-pt">{r.pt != null ? <span class="num-pill num-pt">{r.pt}</span> : ''}</td>}
              {hasBaseIndex && (
                <td class="c-base">{r.baseIndex != null ? <span class="num-pill num-base">{r.baseIndex}</span> : ''}</td>
              )}
              {hasAge && <td class="c-age">{r.age ?? ''}</td>}
              {hasWeight && <td class="c-weight">{r.weight ?? ''}</td>}
              {hasJockey && <td class="c-jockey">{r.jockey ?? ''}</td>}
              {hasTrainer && <td class="c-trainer">{r.trainer ?? ''}</td>}
              <td class="c-more">
                <span class="more-btn">
                  <span class="more-label">詳細</span>
                  <span class="more-caret" aria-hidden="true">▾</span>
                </span>
              </td>
            </tr>
            <tr class="ret-detail" id={`detail-${rowId}`} data-detail={rowId} hidden={!isOpen}>
              <td colspan={colCount}>
                <HorseDetailPanel
                  horse={r.horse}
                  view={view}
                  narrative={r.narrative}
                  features={featuresOf ? featuresOf(r.horse) : null}
                  pastRaces={pastRacesOf ? pastRacesOf(r.horse) : []}
                  stats={statsOf ? statsOf(r.horse) : null}
                />
              </td>
            </tr>
          </>
        );
      })}
    </tbody>
  </table>
</div>

<script>
  // 行クリックで直下の詳細を開閉する（表示のみ。認可には一切関与しない）
  function toggleRow(row: HTMLElement) {
    const key = row.getAttribute('data-row');
    if (!key) return;
    const detail = document.querySelector(`tr[data-detail="${key}"]`) as HTMLElement | null;
    if (!detail) return;
    const open = !detail.hasAttribute('hidden');
    if (open) {
      detail.setAttribute('hidden', '');
      row.setAttribute('aria-expanded', 'false');
      row.classList.remove('is-open');
    } else {
      detail.removeAttribute('hidden');
      row.setAttribute('aria-expanded', 'true');
      row.classList.add('is-open');
    }
  }

  document.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement)?.closest?.('.ret-row') as HTMLElement | null;
    if (!row) return;
    toggleRow(row);
  });

  document.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key !== 'Enter' && ke.key !== ' ') return;
    const row = (ke.target as HTMLElement)?.closest?.('.ret-row') as HTMLElement | null;
    if (!row) return;
    ke.preventDefault();
    toggleRow(row);
  });
</script>

<style>
  .sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  .ret {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .ret-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  /* ── ヘッダー: 紙の茶色をやめ、静かなラベル行にする ── */
  .ret-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg-secondary);
    color: var(--text-tertiary);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: none;
    padding: 10px 8px 8px;
    white-space: nowrap;
    border-bottom: 1px solid var(--border-color);
  }

  /* ── 行 ── */
  .ret-row {
    cursor: pointer;
    transition: background-color 120ms ease, box-shadow 120ms ease;
  }

  .ret-row > td {
    padding: 12px 8px;
    font-size: 0.86rem;
    color: var(--text-primary);
    vertical-align: middle;
    text-align: center;
    white-space: nowrap;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }

  .ret-row:hover > td { background: #f7faff; }
  .ret-row:focus-visible { outline: 2px solid var(--primary-start); outline-offset: -2px; }

  .ret-row.is-open > td {
    background: #eff5ff;
    border-bottom-color: transparent;
  }

  /* 本命は左端に色を差す（背景全体は塗らない＝一覧の静けさを保つ） */
  .ret-row.is-honmei .horse-name { color: var(--mark-honmei); }

  /* ── 枠色チップ ── */
  .c-waku { width: 30px; padding-left: 10px !important; padding-right: 0 !important; }

  .waku-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 0.78rem;
    border: 1px solid transparent;
  }

  .waku-1 .waku-chip { background: var(--waku-1-bg); color: var(--waku-1-fg); border-color: #d5dbe3; }
  .waku-2 .waku-chip { background: var(--waku-2-bg); color: var(--waku-2-fg); }
  .waku-3 .waku-chip { background: var(--waku-3-bg); color: var(--waku-3-fg); }
  .waku-4 .waku-chip { background: var(--waku-4-bg); color: var(--waku-4-fg); }
  .waku-5 .waku-chip { background: var(--waku-5-bg); color: var(--waku-5-fg); }
  .waku-6 .waku-chip { background: var(--waku-6-bg); color: var(--waku-6-fg); }
  .waku-7 .waku-chip { background: var(--waku-7-bg); color: var(--waku-7-fg); }
  .waku-8 .waku-chip { background: var(--waku-8-bg); color: var(--waku-8-fg); }
  .waku-none .waku-chip { background: var(--bg-muted); color: var(--text-tertiary); }

  .c-num { width: 40px; }

  .uma-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 5px;
    border-radius: 50%;
    background: var(--bg-muted);
    color: var(--text-primary);
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 0.88rem;
  }

  /* ── 馬名 ＋ 短評 ── */
  .c-name {
    text-align: left !important;
    white-space: normal !important;
    min-width: 11em;
    line-height: 1.35;
  }

  .horse-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--text-primary);
    letter-spacing: 0.01em;
  }

  .role-tag {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    font-size: 0.62rem;
    font-weight: 800;
    vertical-align: 2px;
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  .role-tag.mk-honmei { background: rgba(220, 38, 38, 0.10); color: var(--mark-honmei); }
  .role-tag.mk-taiko  { background: rgba(37, 99, 235, 0.10); color: var(--mark-taiko); }
  .role-tag.mk-tana   { background: rgba(249, 115, 22, 0.12); color: #b45309; }

  /* 🔴 閉じた状態でも短評を見せる（文章は本改修の中心） */
  .horse-excerpt {
    display: block;
    margin-top: 3px;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 34em;
  }

  /* ── 数値 ── */
  .num-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6em;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 0.82rem;
  }

  .num-pt { background: rgba(37, 99, 235, 0.10); color: var(--primary-start); }
  .num-base { background: rgba(124, 58, 237, 0.10); color: #6d28d9; }

  .mark { font-size: 1.25rem; font-weight: 700; line-height: 1; }
  .mk-honmei { color: var(--mark-honmei); }
  .mk-taiko  { color: var(--mark-taiko); }
  .mk-tana   { color: var(--mark-tana); }
  .mk-renka  { color: var(--mark-renka); }

  .c-age, .c-weight { font-family: var(--font-num); color: var(--text-secondary); font-size: 0.8rem; }
  .c-jockey, .c-trainer { font-size: 0.8rem; color: var(--text-secondary); }

  /* ── 詳細ボタン（開けることを明示する） ── */
  .c-more { width: 68px; padding-right: 10px !important; }

  .more-btn {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--primary-start);
    font-size: 0.7rem;
    font-weight: 800;
    transition: all 120ms ease;
  }

  .ret-row:hover .more-btn {
    background: var(--primary-start);
    border-color: var(--primary-start);
    color: var(--text-inverse);
  }

  .more-caret { display: inline-block; transition: transform 150ms ease; }
  .ret-row.is-open .more-caret { transform: rotate(180deg); }
  .ret-row.is-open .more-btn { background: var(--primary-start); border-color: var(--primary-start); color: var(--text-inverse); }

  .ret-detail > td {
    padding: 0 !important;
    border-bottom: 1px solid var(--border-color);
  }

  /* ── スマホ: 一覧性を保ちつつ短評は残す ── */
  @media (max-width: 780px) {
    .ret-row > td, .ret-table thead th { padding: 10px 5px; }
    .c-trainer { display: none; }
    .horse-name { font-size: 0.95rem; }
    .horse-excerpt { font-size: 0.72rem; }
  }

  @media (max-width: 560px) {
    .c-jockey, .c-age { display: none; }
    .more-label { display: none; }
    .c-more { width: 40px; }
    .more-btn { padding: 6px 8px; }
  }
</style>
