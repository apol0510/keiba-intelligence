---
/**
 * RaceEntryTable.astro — 出馬表（基本 UI）
 *
 * 正本: docs/RENEWAL_2026_08.md §4
 *
 * 構成:
 *   枠 | 馬番 | 馬名＋AI短評1行 | 印 | AI指数 | 基礎指数 | 性齢 | 斤量 | 騎手 | 厩舎 | 詳細
 *   行をクリック/タップすると、**その馬の直下**に詳細アコーディオンが開く。
 *
 * 🔴 2026-08-29 仕様確定（順位を推測させない）:
 *   1. **役割バッジ（本命 / 対抗 / 単穴 / 連下 …）を全 tier で出さない。HTML にも残さない。**
 *   2. **並びは常に馬番昇順**。AI 評価による並べ替えを行わない。
 *   3. **無料会員の印は「印」1 列に複数を重複付与する**（`attentionMarks.js`）。
 *      ◎3〜5 / ○3〜5 / ▲3〜5 / △約10 頭を重ねて付け、該当しない馬は空欄。
 *      評価順 1 位と 2 位は **必ず同じ印の組み合わせ**になるため、
 *      印から本命を一意に特定できない。ランダム・ダミーは使わない。
 *   4. **AI指数（pt）も無料会員には出さない**。数値があれば順位が完全に復元できるため。
 *   → 序列のある詳細な印と AI指数は **有料 tier（買い目が見える会員）だけ**に描画する。
 *
 * 🔴 tier による出し分けは **描画そのものを止める**（CSS で隠さない）:
 *    - 印（無料の重複印） … `view.showMarks` が false なら **列ごと出さない**
 *    - ◎○▲△・AI指数 … `view.showBetting` が false なら **列ごと出さない**
 *    - 買い目 … このコンポーネントは扱わない
 *
 * 🔴 存在しない情報を埋めない。値が 1 頭も無い列は出さない。
 *    枠番だけは **馬番と頭数から一意に決まる規則**で算出する（`frameNumber.js`）。
 */

import HorseDetailPanel from './HorseDetailPanel.astro';
import { assignFreeMarks } from '../../utils/attentionMarks.js';

/** 印の記号 → CSS クラス（新聞と同じく ◎ を最も目立たせる）。 */
const MARK_CLASS: Record<string, string> = { '◎': 'd', '○': 'c', '▲': 'f', '△': 't' };
import { toComputerIndex } from '../../utils/computerIndexContract.js';
import { resolveFrameNumber } from '../../utils/frameNumber.js';

interface Props {
  horses: any[];
  raceInfo?: any;
  /** 🔴 買い目に出てくる馬番。**有料 tier のときだけ**渡すこと（free には渡さない）。 */
  betHorses?: number[];
  view: { showMarks?: boolean; showBetting?: boolean; tier?: string };
  raceKey: string;
  narrativeOf: (horse: any) => any;
  featuresOf?: (horse: any) => any;
  pastRacesOf: (horse: any) => any[];
  statsOf?: (horse: any) => any;
}

const {
  horses = [], view, raceKey, raceInfo = null, betHorses = [],
  narrativeOf, featuresOf, pastRacesOf, statsOf,
} = Astro.props;

/**
 * 🔴 詳細アコーディオンは **既定ですべて閉じる**（2026-08-29 仕様確定）。
 *    1 頭を自動で開くと一覧性が落ち、どの馬が開いているかで評価を推測させる余地も残る。
 *    開けることは「AI短評の 1 行表示」と「詳細 ▾」ボタンで示す。
 */

/** 無料会員以上か。 */
const showAttention = !!view?.showMarks;
/** 有料 tier か（AI指数の実数値・結論・買い目が見える）。 */
const showRanked = !!view?.showBetting;

/** 🔴 印の列は **無料会員だけ**に出す（有料では非表示。R-8）。 */
const showMarkColumn = showAttention && !showRanked;
/** AI指数の列は無料会員以上に出す。無料は値を伏せる。 */
const showScoreColumn = showAttention;
/** 🔴 無料はモザイク。**実数値を HTML に入れない**。 */
const maskScore = showAttention && !showRanked;

const fieldSize = horses.length;

/**
 * 🔴 並べ替え・抽出ボタンは **有料 tier だけ**に描画する（R-9）。
 *    free/guest には HTML ごと出さない。理由:
 *      - 「AI指数順」は並びから評価順位が完全に読める（R-2 で禁止している情報）
 *      - 「買い目の馬だけ」は買い目そのもの（有料の中核）
 *    CSS で隠すのではなく、描画しない。
 */
const showTools = showRanked;

/** 買い目に出てくる馬番。有料 tier 以外では空にする（HTML に痕跡を残さない）。 */
const betSet = new Set<number>(showRanked && Array.isArray(betHorses) ? betHorses : []);
const hasBetHorses = betSet.size > 0;

/**
 * 無料会員向けの印（馬番 → '◎◎○▲' のような文字列）。
 * 🔴 **実在する指数だけ**から決定論的に算出する（新聞の総合印と同じ作り方）。
 *    指数 1 本 = 記者 1 人。データが無い指数は軸にしない。
 * 有料 tier では印を出さないため作らない。
 */
const freeMarks = showMarkColumn
  ? assignFreeMarks(horses, { pastRacesOf, raceInfo })
  : new Map<number, string>();

/**
 * 閉じた行に出す抜粋。
 *
 * 🔴 役割語（「本命に推す。」「ヒモまで。」）は **抜粋に使わない**。
 *    それだけだと無料会員のほうが未登録より情報が乏しくなるため
 *    （役割は名前の横のタグで別途示している）。
 *    `narrative.sentences` は役割語を含まない本文だけなのでそこから取る。
 */
function excerptOf(narrative: any) {
  const body = Array.isArray(narrative?.sentences) ? narrative.sentences : [];
  const first = body.find((x: any) => typeof x === 'string' && x.trim());
  const s = first || (typeof narrative?.text === 'string' ? narrative.text : '');
  if (!s.trim()) return null;
  return s.length > 60 ? `${s.slice(0, 59)}…` : s;
}

const rows = horses.map((h: any) => {
  const frame = resolveFrameNumber(h, fieldSize);
  const weightNum = typeof h?.weight === 'number' ? h.weight : (h?.weight ? Number(h.weight) : null);
  const narrative = narrativeOf ? narrativeOf(h) : null;
  return {
    horse: h,
    narrative,
    excerpt: excerptOf(narrative),
    frame,
    frameClass: frame && frame >= 1 && frame <= 8 ? `waku-${frame}` : 'waku-none',
    number: h?.horseNumber ?? null,
    name: h?.horseName || '—',
    // 🔴 印は無料会員のみ。複数を重複付与した文字列（例: '◎△' / '○▲△' / ''）
    freeMark: freeMarks.get(h?.horseNumber) || '',
    // 🔴 AI指数の実数値は有料 tier のみ。無料はここで null にし HTML に値を出さない
    pt: showRanked && typeof h?.pt === 'number' && Number.isFinite(h.pt) ? h.pt : null,
    age: h?.age || null,
    weight: Number.isFinite(weightNum) ? weightNum : null,
    jockey: h?.jockey || null,
    trainer: h?.trainer || null,
    // 裏側の呼称は computerIndex。表示名は「基礎指数」。契約（10–99）外は表示しない
    baseIndex: toComputerIndex(h?.computerIndex),
    // 🔴 買い目に出てくる馬か。有料 tier のときだけ true になりうる
    inBet: betSet.has(Number(h?.horseNumber)),
  };
});

const hasBaseIndex = rows.some((r) => r.baseIndex != null);
const hasAge = rows.some((r) => r.age);
const hasWeight = rows.some((r) => r.weight != null);
const hasJockey = rows.some((r) => r.jockey);
const hasTrainer = rows.some((r) => r.trainer);

const colCount = 3 // 枠 / 馬番 / 馬名
  + (showMarkColumn ? 1 : 0)
  + (showScoreColumn ? 1 : 0)
  + (hasBaseIndex ? 1 : 0)
  + (hasAge ? 1 : 0)
  + (hasWeight ? 1 : 0)
  + (hasJockey ? 1 : 0)
  + (hasTrainer ? 1 : 0)
  + 1; // 詳細
---

<div class="ret" data-race-key={raceKey}>
  {showTools && (
    <div class="ret-tools" role="group" aria-label="出馬表の並べ替え・抽出">
      <button
        class="ret-tool"
        type="button"
        data-tool="sort"
        aria-pressed="false"
        title="AI指数の高い順に並べ替えます"
      >
        <span class="ret-tool-icon" aria-hidden="true">⇅</span>
        <span class="ret-tool-on">AI指数順</span>
        <span class="ret-tool-off">馬番順に戻す</span>
      </button>

      {hasBetHorses && (
        <button
          class="ret-tool"
          type="button"
          data-tool="bet"
          aria-pressed="false"
          title="買い目に入っている馬だけを残します"
        >
          <span class="ret-tool-icon" aria-hidden="true">◎</span>
          <span class="ret-tool-on">買い目の馬だけ</span>
          <span class="ret-tool-off">全頭に戻す</span>
        </button>
      )}

      <span class="ret-tool-note" data-tools-note hidden></span>
    </div>
  )}

  <table class="ret-table">
    <thead>
      <tr>
        <th class="c-waku"><span class="sr">枠</span></th>
        <th class="c-num">馬番</th>
        <th class="c-name">馬名 ／ AI短評</th>
        {showMarkColumn && <th class="c-mark">印</th>}
        {showScoreColumn && <th class="c-pt">AI指数</th>}
        {hasBaseIndex && <th class="c-base">基礎指数</th>}
        {hasAge && <th class="c-age">性齢</th>}
        {hasWeight && <th class="c-weight">斤量</th>}
        {hasJockey && <th class="c-jockey">騎手</th>}
        {hasTrainer && <th class="c-trainer">厩舎</th>}
        <th class="c-more"><span class="sr">詳細</span></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => {
        const rowId = `${raceKey}-h${r.number ?? i}`;
        return (
          <>
            <tr
              class={`ret-row ${r.frameClass}`}
              data-row={rowId}
              data-order={i}
              data-pt={showRanked && r.pt != null ? r.pt : ''}
              data-bet={r.inBet ? '1' : ''}
              tabindex="0"
              role="button"
              aria-expanded="false"
              aria-controls={`detail-${rowId}`}
            >
              <td class="c-waku"><span class="waku-chip">{r.frame ?? ''}</span></td>
              <td class="c-num"><span class="uma-badge">{r.number ?? ''}</span></td>
              <td class="c-name">
                <span class="horse-name">{r.name}</span>
                {r.excerpt && <span class="horse-excerpt">{r.excerpt}</span>}
              </td>
              {showMarkColumn && (
                <td class="c-mark">
                  {r.freeMark
                    ? <span class="mark mk-free">{[...r.freeMark].map((c: string) => (
                        <i class={`mk mk-${MARK_CLASS[c] || 'x'}`}>{c}</i>
                      ))}</span>
                    : ''}
                </td>
              )}
              {showScoreColumn && (
                <td class="c-pt">
                  {maskScore
                    ? <span class="num-pill num-masked" title="AI指数は有料プランで公開しています" aria-label="有料プランで公開">•••</span>
                    : (r.pt != null ? <span class="num-pill num-pt">{r.pt}</span> : '')}
                </td>
              )}
              {hasBaseIndex && (
                <td class="c-base">{r.baseIndex != null ? <span class="num-pill num-base">{r.baseIndex}</span> : ''}</td>
              )}
              {hasAge && <td class="c-age">{r.age ?? ''}</td>}
              {hasWeight && <td class="c-weight">{r.weight ?? ''}</td>}
              {hasJockey && <td class="c-jockey">{r.jockey ?? ''}</td>}
              {hasTrainer && <td class="c-trainer">{r.trainer ?? ''}</td>}
              <td class="c-more">
                <span class="more-btn">
                  <span class="more-label">詳細</span>
                  <span class="more-caret" aria-hidden="true">▾</span>
                </span>
              </td>
            </tr>
            <tr class="ret-detail" id={`detail-${rowId}`} data-detail={rowId} hidden>
              <td colspan={colCount}>
                <HorseDetailPanel
                  horse={r.horse}
                  view={view}
                  narrative={r.narrative}
                  features={featuresOf ? featuresOf(r.horse) : null}
                  pastRaces={pastRacesOf ? pastRacesOf(r.horse) : []}
                  stats={statsOf ? statsOf(r.horse) : null}
                />
              </td>
            </tr>
          </>
        );
      })}
    </tbody>
  </table>
</div>

<script>
  // 行クリックで直下の詳細を開閉する（表示のみ。認可には一切関与しない）
  function toggleRow(row: HTMLElement) {
    const key = row.getAttribute('data-row');
    if (!key) return;
    const detail = document.querySelector(`tr[data-detail="${key}"]`) as HTMLElement | null;
    if (!detail) return;
    const open = !detail.hasAttribute('hidden');
    if (open) {
      detail.setAttribute('hidden', '');
      row.setAttribute('aria-expanded', 'false');
      row.classList.remove('is-open');
    } else {
      detail.removeAttribute('hidden');
      row.setAttribute('aria-expanded', 'true');
      row.classList.add('is-open');
    }
  }

  document.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement)?.closest?.('.ret-row') as HTMLElement | null;
    if (!row) return;
    toggleRow(row);
  });

  /* ==========================================================
     並べ替え・抽出（🔴 有料 tier のときだけ DOM に存在する）

     - ボタンは `.ret-tools` の中にあり、`.ret-row` の外なので
       行クリックの開閉ハンドラとは衝突しない。
     - 認可には一切関与しない。無料会員の HTML にはこのボタンも
       `data-pt` / `data-bet` も **存在しない**（サーバー側で描画しない）。
     ========================================================== */

  /** 本体行と、その直下の詳細行を 1 組として扱う。 */
  function pairsOf(table: HTMLElement) {
    const body = table.querySelector('tbody');
    if (!body) return [];
    return Array.from(body.querySelectorAll('tr.ret-row')).map((row) => ({
      row: row as HTMLElement,
      detail: body.querySelector(`tr[data-detail="${row.getAttribute('data-row')}"]`) as HTMLElement | null,
      order: Number((row as HTMLElement).dataset.order || 0),
      pt: (row as HTMLElement).dataset.pt ? Number((row as HTMLElement).dataset.pt) : null,
      inBet: (row as HTMLElement).dataset.bet === '1',
    }));
  }

  function applyTools(ret: HTMLElement) {
    const body = ret.querySelector('tbody');
    if (!body) return;

    const sortOn = ret.dataset.sort === 'pt';
    const betOn = ret.dataset.filter === 'bet';
    const pairs = pairsOf(ret);

    // 並べ替え。AI指数が無い馬は末尾へ（馬番順の相対位置は保つ）
    const ordered = [...pairs].sort((a, b) => {
      if (sortOn) {
        if (a.pt == null && b.pt != null) return 1;
        if (a.pt != null && b.pt == null) return -1;
        if (a.pt != null && b.pt != null && a.pt !== b.pt) return b.pt - a.pt;
      }
      return a.order - b.order;
    });

    for (const p of ordered) {
      body.appendChild(p.row);
      if (p.detail) body.appendChild(p.detail);
    }

    // 抽出。買い目に居ない馬は本体行ごと隠し、開いていた詳細も閉じる
    let shown = 0;
    for (const p of pairs) {
      const hide = betOn && !p.inBet;
      p.row.classList.toggle('is-filtered', hide);
      if (hide) {
        p.row.setAttribute('hidden', '');
        if (p.detail) p.detail.setAttribute('hidden', '');
        p.row.setAttribute('aria-expanded', 'false');
        p.row.classList.remove('is-open');
      } else {
        p.row.removeAttribute('hidden');
        shown += 1;
      }
    }

    const note = ret.querySelector('[data-tools-note]') as HTMLElement | null;
    if (note) {
      const parts: string[] = [];
      if (sortOn) parts.push('AI指数の高い順');
      if (betOn) parts.push(`買い目の${shown}頭のみ`);
      if (parts.length) {
        note.textContent = parts.join(' ／ ');
        note.hidden = false;
      } else {
        note.hidden = true;
      }
    }

    for (const btn of Array.from(ret.querySelectorAll('.ret-tool'))) {
      const b = btn as HTMLElement;
      const on = b.dataset.tool === 'sort' ? sortOn : betOn;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('is-on', on);
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('.ret-tool') as HTMLElement | null;
    if (!btn) return;
    const ret = btn.closest('.ret') as HTMLElement | null;
    if (!ret) return;

    if (btn.dataset.tool === 'sort') {
      ret.dataset.sort = ret.dataset.sort === 'pt' ? 'num' : 'pt';
    } else if (btn.dataset.tool === 'bet') {
      ret.dataset.filter = ret.dataset.filter === 'bet' ? 'all' : 'bet';
    }
    applyTools(ret);
  });

  document.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key !== 'Enter' && ke.key !== ' ') return;
    const row = (ke.target as HTMLElement)?.closest?.('.ret-row') as HTMLElement | null;
    if (!row) return;
    ke.preventDefault();
    toggleRow(row);
  });
</script>

<style>
  .sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /*
   * 🔴 `overflow: hidden` を使わない。
   *    祖先に overflow があると `position: sticky` の基準が変わり、
   *    列見出しが固定されずスクロールで完全に消える
   *    （2026-08-29 に実測。見出しが画面外へ出て列名が読めなくなっていた）。
   *    角丸はセル側で作る。
   */
  .ret {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .ret-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  /* ── ヘッダー: 紙の茶色をやめ、静かなラベル行にする ── */
  .ret-table thead th {
    /* サイトヘッダーの真下に固定する（重なると列名が読めない） */
    position: sticky;
    top: var(--nav-height, 84px);
    z-index: 5;
    background: var(--bg-secondary);
    color: var(--text-tertiary);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: none;
    padding: 10px 8px 8px;
    white-space: nowrap;
    border-bottom: 1px solid var(--border-color);
  }

  /* ── 行 ── */
  .ret-row {
    cursor: pointer;
    transition: background-color 120ms ease, box-shadow 120ms ease;
  }

  .ret-row > td {
    padding: 12px 8px;
    font-size: 0.86rem;
    color: var(--text-primary);
    vertical-align: middle;
    text-align: center;
    white-space: nowrap;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }

  .ret-row:hover > td { background: #f7faff; }
  .ret-row:focus-visible { outline: 2px solid var(--primary-start); outline-offset: -2px; }

  .ret-row.is-open > td {
    background: #eff5ff;
    border-bottom-color: transparent;
  }

  /* ── 枠色チップ ── */
  .c-waku { width: 30px; padding-left: 10px !important; padding-right: 0 !important; }

  .waku-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 0.78rem;
    border: 1px solid transparent;
  }

  .waku-1 .waku-chip { background: var(--waku-1-bg); color: var(--waku-1-fg); border-color: #d5dbe3; }
  .waku-2 .waku-chip { background: var(--waku-2-bg); color: var(--waku-2-fg); }
  .waku-3 .waku-chip { background: var(--waku-3-bg); color: var(--waku-3-fg); }
  .waku-4 .waku-chip { background: var(--waku-4-bg); color: var(--waku-4-fg); }
  .waku-5 .waku-chip { background: var(--waku-5-bg); color: var(--waku-5-fg); }
  .waku-6 .waku-chip { background: var(--waku-6-bg); color: var(--waku-6-fg); }
  .waku-7 .waku-chip { background: var(--waku-7-bg); color: var(--waku-7-fg); }
  .waku-8 .waku-chip { background: var(--waku-8-bg); color: var(--waku-8-fg); }
  .waku-none .waku-chip { background: var(--bg-muted); color: var(--text-tertiary); }

  .c-num { width: 40px; }

  .uma-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 5px;
    border-radius: 50%;
    background: var(--bg-muted);
    color: var(--text-primary);
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 0.88rem;
  }

  /* ── 馬名 ＋ 短評 ── */
  .c-name {
    text-align: left !important;
    white-space: normal !important;
    min-width: 11em;
    line-height: 1.35;
  }

  .horse-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--text-primary);
    letter-spacing: 0.01em;
  }

  /* 🔴 閉じた状態でも短評を見せる（文章は本改修の中心） */
  .horse-excerpt {
    display: block;
    margin-top: 3px;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--text-secondary);
