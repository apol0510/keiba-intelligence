---
// KI 馬単 F3 買い目の「方向別2行」表示（南関/JRA・Premium/Light 共通・単一源）。
//
// 表示（DOM）のみを担う。F3 のグループ分割ロジックは変更しない:
//   - bidi = 双方向 = KI評価上位 bidiCount(=3) 頭
//   - fwd  = 一方向 = 残りの相手（メインレースは forwardAll のため全頭が fwd）
// bidi/fwd の内容・順序・件数は importResults 側の判定と同一（表示専用の再分割）。
//
// レイアウト:
//   - 1行目: 軸 ⇔ 相手（双方向・bidi があるときのみ）
//   - 2行目: 軸 → 相手（一方向・fwd があるときのみ）
//   メインレースは fwd のみ = 一方向1行だけ（空行は出さない）。
//   方向は矢印（⇔ / →）で判別する（種別バッジは表示しない）。
const { axis } = Astro.props;

function f3Groups(axisObj) {
  if (!axisObj) return { bidi: [], fwd: [] };
  const opp = Array.isArray(axisObj.opponents) ? axisObj.opponents : [];
  if (axisObj.forwardAll) return { bidi: [], fwd: opp };
  const k = axisObj.bidiCount ?? 3;
  return { bidi: opp.slice(0, k), fwd: opp.slice(k) };
}

const g = f3Groups(axis);
const axisNum = axis?.axis;
---

{g.bidi.length > 0 && (
  <div class="bet-direction-row bidirectional">
    <span class="axis-number">{axisNum}</span>
    <span class="formula-arrow bidi-arrow">⇔</span>
    <span class="opponents-list">
      {g.bidi.map((num, idx) => (
        <>
          <span class="opponent-number">{num}</span>
          {idx < g.bidi.length - 1 && <span class="opponent-separator">・</span>}
        </>
      ))}
    </span>
  </div>
)}

{g.fwd.length > 0 && (
  <div class="bet-direction-row one-directional">
    <span class="axis-number">{axisNum}</span>
    <span class="formula-arrow oneway-arrow">→</span>
    <span class="opponents-list">
      {g.fwd.map((num, idx) => (
        <>
          <span class="opponent-number">{num}</span>
          {idx < g.fwd.length - 1 && <span class="opponent-separator">・</span>}
        </>
      ))}
    </span>
  </div>
)}

<style>
  /* 軸/矢印は同一行に固定し、相手番号だけ折り返す。方向は矢印で判別（バッジなし）。 */
  .bet-direction-row {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    align-items: start;
    gap: 4px 8px;
    padding: 4px 0;
  }

  /* 軸・矢印を相手番号1行目の高さに合わせる（相手が折り返しても先頭行と揃う） */
  .axis-number,
  .formula-arrow {
    align-self: start;
  }

  /* 軸番号は相手番号との視覚差を縮めるため従来(2rem)より小さめに */
  .axis-number {
    font-size: 1.4rem;
    font-weight: 900;
    color: #60a5fa;
    font-family: 'Courier New', monospace;
    padding: 4px 10px;
    background: rgba(96, 165, 250, 0.15);
    border: 2px solid rgba(96, 165, 250, 0.4);
    border-radius: var(--radius-sm, 8px);
    min-width: 44px;
    text-align: center;
  }

  .formula-arrow {
    font-size: 1.3rem;
    font-weight: 900;
    justify-self: center;
  }

  /* 双方向=黄色系アクセント / 一方向=中間色（矢印の色でも方向を補助） */
  .bidi-arrow {
    color: #fbbf24;
  }

  .oneway-arrow {
    color: var(--text-secondary, #cbd5e1);
  }

  /* 相手番号のみ必要に応じて折り返す（横スクロールなし） */
  .opponents-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px;
    min-width: 0;
  }

  .opponent-number {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary, #f8fafc);
    font-family: 'Courier New', monospace;
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm, 8px);
    min-width: 30px;
    text-align: center;
  }

  .opponent-separator {
    font-size: 0.9rem;
    color: var(--text-tertiary, #94a3b8);
  }

  /* スマートフォン: さらに詰めて1行に収まりやすくする */
  @media (max-width: 480px) {
    .bet-direction-row {
      gap: 3px 6px;
    }
    .axis-number {
      font-size: 1.15rem;
      padding: 3px 7px;
      min-width: 36px;
    }
    .formula-arrow {
      font-size: 1.1rem;
    }
    .opponents-list {
      gap: 2px;
    }
    .opponent-number {
      font-size: 0.95rem;
      padding: 2px 6px;
      min-width: 26px;
    }
  }
</style>
