---
/**
 * NankanHorseStatsPanel.astro (keiba-intelligence)
 *
 * horse.horseStatsNankan（uma_info 元表統計）を「近走詳細データ」として表示（表示専用）。
 * KI 方針: 分析メモ寄り（紫〜青）。重要ブロックをグループ化したカード状に整理。
 * recentRacesDetailed は表示しない（既存「直近走」欄と重複・統計/条件適性に寄せる）。
 *
 * 厳守: featureScores / AI指数 / 印 / 買い目 / EV 非接続。空/null/全0ブロックは非表示。
 * 表示名「近走詳細データ」固定（過去走データ/最大5走/5走は使わない）。
 */
const { horse } = Astro.props;
const s = horse?.horseStatsNankan || null;

const ne = (v) => v !== null && v !== undefined && String(v).trim() !== '';
const arr = (x) => Array.isArray(x) && x.length > 0;
const chaku = (r) => `${r?.first ?? 0}-${r?.second ?? 0}-${r?.third ?? 0}-${r?.out ?? 0}`;
const starts = (r) => (Number(r?.first) || 0) + (Number(r?.second) || 0) + (Number(r?.third) || 0) + (Number(r?.out) || 0);
const pctStr = (raw, val) => (ne(raw) ? raw : (val != null ? `${val}%` : ''));
// 勝率/連対率行: 値がある側だけ表示（空の「連」「勝」を出さない）
const fmtPctRow = (r) => {
  const w = pctStr(r.winRateRaw, r.winRate);
  const q = pctStr(r.quinellaRateRaw, r.quinellaRate);
  return [(ne(r.label) ? r.label : ''), (ne(w) ? `勝${w}` : ''), (ne(q) ? `連${q}` : '')].filter(ne).join(' ');
};
const hasPct = (r) => ne(pctStr(r.winRateRaw, r.winRate)) || ne(pctStr(r.quinellaRateRaw, r.quinellaRate));

// ---- 基本情報 ----
const p = (s && s.profile) || {};
const sexAge = `${ne(p.sex) ? p.sex : ''}${p.age != null ? p.age : ''}`;
const profileItems = [
  ne(sexAge) && { k: '性齢', v: sexAge },
  ne(p.sire) && { k: '父', v: p.sire },
  ne(p.dam) && { k: '母', v: p.dam },
  ne(p.damsire) && { k: '母父', v: p.damsire },
  ne(p.color) && { k: '毛色', v: p.color },
  ne(p.jockey) && { k: '騎手', v: p.jockey + (ne(p.jockeyAffiliation) ? `(${p.jockeyAffiliation})` : '') },
  ne(p.carriedWeight) && { k: '斤量', v: String(p.carriedWeight) },
  ne(p.trainer) && { k: '調教師', v: p.trainer + (ne(p.trainerAffiliation) ? `(${p.trainerAffiliation})` : '') },
  ne(p.owner) && { k: '馬主', v: p.owner },
  ne(p.breeder) && { k: '生産', v: p.breeder },
].filter(Boolean);

const chakuRows = (rows) => (arr(rows) ? rows.filter((r) => starts(r) > 0) : []);
const chakuChips = (rows) => chakuRows(rows).map((x) => `${ne(x.label) ? x.label + ' ' : ''}${chaku(x)}`);
const pctChips = (rows) => (arr(rows) ? rows.filter(hasPct).map(fmtPctRow) : []);

// 騎手別
let jkChips = [];
if (s && s.jockeyStats) {
  const jkLabel = { current: '今回騎手', previous: '前回騎手', all: '全成績' };
  jkChips = ['current', 'previous', 'all'].map((k) => {
    const j = s.jockeyStats[k];
    if (!j || (starts(j) === 0 && j.winRate == null)) return '';
    const rate = [(ne(j.winRateRaw) ? `勝${j.winRateRaw}` : ''), (ne(j.quinellaRateRaw) ? `連${j.quinellaRateRaw}` : '')].filter(ne).join(' ');
    return `${jkLabel[k]} ${chaku(j)}${rate ? ' ' + rate : ''}`;
  }).filter(ne);
}
// 回収率
const rr = s && s.returnRates;
const rrChips = [];
if (rr && rr.horse && rr.horse.win) rrChips.push(`競走馬 単${rr.horse.win.raw} 複${rr.horse.place ? rr.horse.place.raw : ''}`);
if (rr && rr.jockey && rr.jockey.win) rrChips.push(`騎手 単${rr.jockey.win.raw} 複${rr.jockey.place ? rr.jockey.place.raw : ''}`);

// ---- グループ（分析メモ）----
const sub = (title, chips) => { const c = (chips || []).filter(ne); return c.length ? { title, chips: c } : null; };
const groups = [
  { name: '条件別サマリー', subs: [sub('距離別', chakuChips(s && s.finishStatsByDistance)), sub('場別', chakuChips(s && s.finishStatsByVenue)), sub('馬場状態別', chakuChips(s && s.trackConditionStats))].filter(Boolean) },
  { name: 'ローテ／季節', subs: [sub('出走間隔別', chakuChips(s && s.intervalStats)), sub('季節別', chakuChips(s && s.seasonStats))].filter(Boolean) },
  { name: '血統／騎手', subs: [sub('種牡馬分析', pctChips(s && s.sireStats)), sub('騎手コース別', pctChips(s && s.jockeyCourseStats)), sub('騎手別', jkChips)].filter(Boolean) },
  { name: '回収率', subs: [sub('回収率', rrChips)].filter(Boolean), accent: true },
  { name: '持時計', subs: [sub('持時計', arr(s && s.bestTimes) ? s.bestTimes.map((b) => [b.venue, (ne(b.time) ? b.time : b.raw), b.trackCondition, b.surface, (b.finish != null ? `${b.finish}着` : '')].filter(ne).join(' ')) : [])].filter(Boolean) },
].filter((g) => g.subs.length > 0);

const show = !!s && (profileItems.length > 0 || groups.length > 0);
---
{show && (
  <details class="kinhs">
    <summary class="kinhs-sum"><span class="kinhs-title">近走詳細データ</span><span class="kinhs-sub">条件適性メモ</span></summary>
    <div class="kinhs-body">
      {profileItems.length > 0 && (
        <div class="kinhs-grp">
          <div class="kinhs-gh">基本情報</div>
          <div class="kinhs-kvwrap">
            {profileItems.map((it) => (<span class="kinhs-kv"><span class="kinhs-k">{it.k}</span>{it.v}</span>))}
          </div>
        </div>
      )}
      {groups.map((g) => (
        <div class={g.accent ? 'kinhs-grp kinhs-grp-accent' : 'kinhs-grp'}>
          <div class="kinhs-gh">{g.name}</div>
          {g.subs.map((sb) => (
            <div class="kinhs-subrow">
              <span class="kinhs-sublabel">{sb.title}</span>
              <span class="kinhs-chips">{sb.chips.map((c) => (<span class="kinhs-chip">{c}</span>))}</span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </details>
)}

<style>
  .kinhs { margin-top: 10px; border: 1px solid rgba(168,139,250,0.32); border-radius: 10px; background: rgba(23,18,43,0.6); overflow: hidden; }
  .kinhs-sum { cursor: pointer; padding: 9px 12px; list-style: none; display: flex; align-items: baseline; gap: 8px; }
  .kinhs-sum::-webkit-details-marker { display: none; }
  .kinhs-sum::before { content: '▸'; color: #a78bfa; font-size: 0.7rem; }
  .kinhs[open] .kinhs-sum::before { content: '▾'; }
  .kinhs-title { font-weight: 700; color: #ede9fe; font-size: 0.84rem; }
  .kinhs-sub { color: #c4b5fd; font-size: 0.72rem; }
  .kinhs-body { padding: 4px 12px 14px; display: flex; flex-direction: column; gap: 10px; }
  .kinhs-grp { border: 1px solid rgba(148,163,184,0.18); border-radius: 8px; background: rgba(30,27,55,0.55); padding: 0.6rem 0.7rem; }
  .kinhs-gh { color: #a78bfa; font-weight: 700; font-size: 0.74rem; border-left: 3px solid #a78bfa; padding-left: 0.45rem; margin-bottom: 0.5rem; letter-spacing: 0.02em; }
  .kinhs-kvwrap { display: flex; flex-wrap: wrap; gap: 6px 14px; line-height: 1.75; }
  .kinhs-kv { font-size: 0.8rem; color: #e9e6f5; }
  .kinhs-k { color: #a5a0c0; margin-right: 4px; }
  .kinhs-subrow { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; margin-bottom: 0.4rem; line-height: 1.7; }
  .kinhs-subrow:last-child { margin-bottom: 0; }
  .kinhs-sublabel { color: #c4b5fd; font-size: 0.72rem; min-width: 4.5em; }
  .kinhs-chips { display: flex; flex-wrap: wrap; gap: 5px 7px; }
  .kinhs-chip { font-size: 0.76rem; color: #e9e6f5; background: rgba(49,46,77,0.7); border: 1px solid rgba(168,139,250,0.22); border-radius: 999px; padding: 0.22rem 0.55rem; }
  .kinhs-grp-accent { border-color: rgba(251,191,36,0.4); }
  .kinhs-grp-accent .kinhs-gh { color: #fbbf24; border-left-color: #fbbf24; }
  .kinhs-grp-accent .kinhs-chip { color: #fde68a; border-color: rgba(251,191,36,0.45); background: rgba(120,53,15,0.35); }
</style>
