---
/**
 * /pricing — 料金プラン
 *
 * 正本: docs/RENEWAL_2026_08.md §6
 *
 * 🔴 2026-08-30 改定（仕様所有者の指示）:
 *   - 月額は **プレミアム 1 本のみ**。ライトは保留（導線を出さない）。
 *     「ライト＝南関のみ」という **会場で分ける概念は廃止**。有料なら南関＋中央。
 *   - 正規 ¥5,000 の取り消し線 ＋ 割引 ¥3,980 を出す。
 *     **請求額の正本は Stripe の Price**。取得できたら表示金額を上書きする。
 *   - 銀行振込は **年払い ¥39,800 のみ**（買い切り・月払いは出さない）。控えめな導線のまま。
 *   - プレミアム限定コンテンツ（詳細レポート・穴馬・優先配信）の訴求は **廃止**。
 *
 * 🔴 2026-09-01 追加（docs/MEMBERSHIP_REWARDS.md §4）:
 *   本ページは **二本柱**である。
 *     柱1: 予想サービスの価値（マトリクス ＋ 月額プラン）
 *     柱2: **続けるほど会員価値が積み上がる**（KI 会員クラブ）
 *   🔴 柱2 に出してよい数値は **docs/MEMBERSHIP_REWARDS.md §7.1 の確定値だけ**
 *      （100 pt/月・0/3/12/24 か月・600/1,200 pt・記念品 12/24 か月・解約後 90 日）。
 *      **景品の品目は未確定**なので書かない（カタログはデータ駆動）。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { publicPlans, BANK_YEARLY_PRICE_YEN } from '../lib/billing/plans.js';
import { entitlementFromAstro, viewFlags } from '../lib/auth/entitlement.js';
import { PRICING_BENEFITS, RANK_LADDER } from '../lib/membership/membershipView.js';

export const prerender = false;

const entitlement = entitlementFromAstro(Astro);
const view = viewFlags(entitlement);

// 🔴 サーバー側では Price ID の有無だけを見る（金額は取得しない＝ページを速く返す）
const plans = publicPlans({
  ...(typeof process !== 'undefined' && process.env ? process.env : {}),
  ...(import.meta.env || {}),
});

const TIER_MATRIX = [
  { label: '全頭の馬柱・過去走', guest: true, free: true, paid: true },
  { label: 'AI短評（1頭ごとの文章）', guest: true, free: true, paid: true },
  { label: 'AIレース展望・展開予想', guest: true, free: true, paid: true },
  { label: '特徴量6指標', guest: true, free: true, paid: true },
  { label: '的中実績・回収率', guest: true, free: true, paid: true },
  { label: '印（◎○▲△・複数付与）', guest: false, free: true, paid: true },
  { label: 'AI指数の数値（無料はモザイク）', guest: false, free: false, paid: true },
  { label: 'AI結論（推奨理由の解説）', guest: false, free: false, paid: true },
  { label: '南関東4場の馬単買い目', guest: false, free: false, paid: true },
  { label: '中央競馬（JRA）の馬単買い目', guest: false, free: false, paid: true },
];

const yen = (n) => new Intl.NumberFormat('ja-JP').format(n);
---

<BaseLayout
  title="料金プラン"
  description="KEIBA Intelligence の料金プラン。馬柱・過去走・AI短評・展開予想は登録不要で無料公開。印は無料会員、馬単買い目は月額プランで提供します。"
>
  <div class="container pricing">
    <!-- ヒーロー -->
    <header class="pr-hero">
      <h1>まず無料で、中身を確かめてください</h1>
      <p class="pr-hero-lead">
        全レースの馬柱・過去走・<b>AI短評</b>・展開予想は<b>登録なしで全部</b>ご覧いただけます。<br>
        印は無料会員登録で、AI指数の数値・AI結論・馬単の買い目は月額プレミアムで公開します。<br>
        <b>続けていただくほど、会員としての価値も積み上がります。</b>
      </p>
      <div class="pr-hero-actions">
        <a class="pr-btn pr-btn-ghost" href="/prediction/nankan">今日の予想を見る（無料）</a>
        {!view.authenticated && <a class="pr-btn pr-btn-primary" href="/register">無料会員に登録</a>}
      </div>
    </header>

    <!-- 何がどこまで見えるか -->
    <section class="pr-matrix-wrap">
      <h2 class="pr-h2">どこまで見えるか</h2>
      <div class="pr-matrix-scroll">
        <table class="pr-matrix">
          <thead>
            <tr>
              <th class="pr-m-label">できること</th>
              <th>未登録<br><small>¥0</small></th>
              <th>無料会員<br><small>¥0</small></th>
              <th class="pr-m-paid">プレミアム<br><small>月額</small></th>
            </tr>
          </thead>
          <tbody>
            {TIER_MATRIX.map((row) => (
              <tr>
                <td class="pr-m-label">{row.label}</td>
                <td class={row.guest ? 'ok' : 'no'}>{row.guest ? '○' : '—'}</td>
                <td class={row.free ? 'ok' : 'no'}>{row.free ? '○' : '—'}</td>
                <td class={`pr-m-paid ${row.paid ? 'ok' : 'no'}`}>{row.paid ? '○' : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 月額プラン -->
    <section class="pr-plans">
      <h2 class="pr-h2">月額プラン</h2>
      <p class="pr-plans-note">いつでも解約できます。解約後も無料会員として印までご覧いただけます。</p>

      <div class="pr-plan-grid pr-plan-single">
        {plans.map((plan) => (
          <article class="pr-plan is-recommended" data-plan={plan.id}>
            <span class="pr-plan-ribbon">いまだけ割引</span>
            <h3 class="pr-plan-name">{plan.name}</h3>
            <p class="pr-plan-tagline">{plan.tagline}</p>

            {/*
              🔴 金額は **確定した仕様**なので常に出す（Price ID の有無で消さない）。
                 買えるかどうかは CTA 側で止める（Price ID 未設定なら「準備中」ボタン）。
                 Stripe から取得できたら金額はクライアント側で上書きする（請求額が正本）。
            */}
            <p class="pr-plan-price" data-price-for={plan.id}>
              {plan.listPriceYen && (
                <span class="pr-price-list">¥{yen(plan.listPriceYen)}</span>
              )}
              <span class="pr-price-amount">¥{yen(plan.priceYen)}</span>
              <span class="pr-price-unit">/月</span>
            </p>

            <ul class="pr-plan-features">
              {plan.features.map((f) => <li>{f}</li>)}
            </ul>

            {plan.purchasable ? (
              <button class="pr-btn pr-btn-action pr-plan-cta" type="button" data-checkout={plan.id}
                      aria-controls="pr-purchase-auth" aria-expanded="false">
                <span class="pr-cta-label">このプランを申し込む</span>
              </button>
              <p class="pr-plan-steps">
                <span>①&nbsp;メール確認</span><span class="pr-step-sep">→</span>
                <span>②&nbsp;お支払い</span><span class="pr-step-sep">→</span>
                <span>③&nbsp;すぐに利用開始</span>
              </p>
            ) : (
              <>
                <button class="pr-btn pr-btn-disabled" type="button" disabled>まもなく受付開始</button>
                <p class="pr-plan-soon">お申し込みの受付を準備しています。</p>
              </>
            )}
          </article>
        ))}
      </div>

      {/*
        🔴 未ログインで申し込んだときの「購入手続きの入口」。
           ここは **無料会員登録の導線ではない**（購入の続きとして見せる）。
           送信後は登録・ログインのどちらでも、認証を終えると購入へ戻る。
      */}
      <div class="pr-purchase-auth" id="pr-purchase-auth" hidden>
        <p class="pr-purchase-step" aria-hidden="true">
          <span class="pr-purchase-step-now">STEP 1 / 3</span>
          <span class="pr-purchase-step-of">メールアドレスの確認</span>
        </p>
        <h3>お申し込みを続けます</h3>
        <p class="pr-purchase-lead">
          ご本人確認のため、確認メールをお送りします。<br />
          メール内のリンクを開くと、<b>このままお支払い画面へ進みます</b>。
        </p>
        <form id="pr-purchase-form" novalidate>
          <label class="pr-purchase-label" for="pr-purchase-email">メールアドレス</label>
          <input class="pr-purchase-input" id="pr-purchase-email" type="email" name="email"
                 autocomplete="email" inputmode="email" placeholder="your@email.com" required />
          <button class="pr-btn pr-btn-action pr-purchase-submit" type="submit">確認メールを送る</button>
        </form>
        <p class="pr-purchase-msg" id="pr-purchase-msg" hidden></p>
        <p class="pr-purchase-note">
          お支払いはこのあとの画面で行います。確認メールだけでは課金されません。
        </p>
      </div>

      <p class="pr-plan-msg" id="pr-plan-msg" hidden></p>

      {view.showBetting && (
        <p class="pr-manage">
          <button class="pr-link-btn" type="button" id="pr-portal">お支払い方法の変更・解約はこちら</button>
        </p>
      )}
    </section>


    <!-- 柱2: 続けるほど会員価値が積み上がる（KI 会員クラブ） -->
    <section class="pr-club">
      <h2 class="pr-h2">続けるほど、会員価値が積み上がる</h2>
      <p class="pr-club-lead">
        KEIBA Intelligence は、予想を出すだけのサービスではありません。<br>
        プレミアムを続けていただくあいだ、<b>KIリワード</b>が自動で積み上がり、
        会員ランクが上がり、プレゼントをお選びいただけるようになります。
      </p>

      <!-- 会員ランク（昇格月数は確定値・§7.1） -->
      <div class="pr-rank-ladder" aria-label="会員ランク">
        {RANK_LADDER.map((r, i) => (
          <>
            {i > 0 && <span class="pr-rank-arrow" aria-hidden="true">→</span>}
            <span class={`pr-rank-step is-${r.rank}`}>
              {r.label}
              <small>{r.months === 0 ? 'ご登録から' : `${r.months}か月`}</small>
            </span>
          </>
        ))}
      </div>
      <p class="pr-rank-note">
        ランクで変わるのは<b>リワードとプレゼントの待遇</b>だけです。
        予想の精度・買い目の内容・有料情報の質にランクによる差はありません。
      </p>

      <!-- 訴求 -->
      <ul class="pr-club-grid">
        {PRICING_BENEFITS.map((b) => (
          <li class="pr-club-card" data-benefit={b.id}>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))}
      </ul>

      <p class="pr-club-pending">
        <b>準備中</b>：プレゼントの品目は選定中です。決まりしだい、このページとマイページでご案内します。
      </p>
      <p class="pr-club-legal">
        KIリワードは会員特典のポイントです。現金・預金ではなく、換金・払い戻し・第三者への譲渡はできません。
      </p>
    </section>

    <!-- 銀行振込（控えめ） -->
    <section class="pr-bank">
      <details>
        <summary>年払い（銀行振込）をご希望の方</summary>
        <div class="pr-bank-body">
          <p>
            クレジットカードをお使いにならない場合は、銀行振込の年払いもご用意しています。
            お申し込み後、振込先をメールでご案内します。
          </p>
          <ul>
            <li><b>年払い ¥{yen(BANK_YEARLY_PRICE_YEN)}</b> — 内容は月額プレミアムと同じ（南関東＋中央、全レースの馬単買い目）</li>
          </ul>
          <a class="pr-btn pr-btn-ghost" href="/apply">銀行振込で申し込む</a>
        </div>
      </details>
    </section>

    <!-- FAQ -->
    <section class="pr-faq">
      <h2 class="pr-h2">よくあるご質問</h2>
      <details><summary>無料でどこまで見られますか？</summary>
        <p>登録なしで、全レースの馬柱・過去走・AI短評・レース展望・展開予想・特徴量をご覧いただけます。無料会員登録をすると、これに印（◎○▲△）が加わります。1頭に複数の印が付き、該当しない馬は空欄です。AI指数の数値・AI結論・買い目は月額プレミアムです。</p>
      </details>
      <details><summary>買い目は何点ですか？</summary>
        <p>馬単で、1レースあたりの投資は5点固定です。点数を後から増やしたり、高配当だけを選んで実績に載せたりはしていません。</p>
      </details>
      <details><summary>解約はできますか？</summary>
        <p>いつでも解約できます。解約手続きはマイページから行えます。解約後も無料会員として印までご覧いただけます。</p>
      </details>
      <details><summary>KIリワードとは何ですか？</summary>
        <p>プレミアムを続けていただくと毎月100ptずつ自動で積み上がる、会員特典のポイントです。ログインや操作は必要ありません。600ptと1,200ptの2段階でプレゼントとお引き換えいただけます。抽選はありません。現金・預金ではなく、換金・払い戻し・第三者への譲渡はできません。プレゼントの品目は準備中です。</p>
      </details>
      <details><summary>ポイントの有効期限はありますか？</summary>
        <p>ご契約が続いている間は失効しません。解約された場合は90日以内に再開されるとポイントが戻ります。それを過ぎると失効します。</p>
      </details>
      <details><summary>あとから値上げされませんか？</summary>
        <p>ご契約中は、加入されたときの価格のまま続けていただけます（継続価格ロック）。新規のお申し込み価格を変更する場合でも、契約中の会員さまの金額は上がりません。解約後90日以内に再開された場合は以前の価格が戻り、それを過ぎた場合はその時点の価格になります。</p>
      </details>
      <details><summary>回収率はどう計算していますか？</summary>
        <p>払戻 ÷ 投資 × 100 の実測値です。公開している的中はすべて算入しています。</p>
      </details>
    </section>
  </div>
</BaseLayout>

<script>
  import { storeIntent } from '../lib/billing/purchaseIntent.js';

  // 価格は Stripe から取得する（金額をコードに持たない）
  async function loadPrices() {
    const msg = document.getElementById('pr-plan-msg');
    // 購入導線が出ていない（Price ID 未設定）なら Stripe に問い合わせない。
    // CTA が「まもなく受付開始」と出ているので、価格取得の失敗を重ねて出さない。
    if (!document.querySelector('[data-checkout]')) return;
    try {
      const res = await fetch('/.netlify/functions/stripe-prices');
      if (!res.ok) throw new Error('unavailable');
      const data = await res.json();

      // 🔴 請求額の正本は Stripe。取得できたら表示金額を上書きする
      for (const p of (data.plans || [])) {
        const el = document.querySelector(`[data-price-for="${p.id}"]`);
        if (!el) continue;
        // 取得できないときはコード側の表示金額を残す（消さない）
        if (!p.available || typeof p.amount !== 'number') continue;
        const amount = el.querySelector('.pr-price-amount');
        if (!amount) continue;
        const yen = new Intl.NumberFormat('ja-JP').format(Math.round(p.amount));
        amount.textContent = `¥${yen}`;
        const unit = el.querySelector('.pr-price-unit');
        if (unit && p.interval) unit.textContent = `/${p.interval === 'month' ? '月' : p.interval}`;
      }
    } catch {
      // 取得できなくても、コード側で描画済みの金額はそのまま残す
      // （Price ID 未設定のプランは購入ボタン自体が出ていない）
      if (msg) {
        msg.hidden = false;
        msg.textContent = '価格の確認ができませんでした。お申し込み画面で最終金額をご確認ください。';
      }
    }
  }

  async function startCheckout(planId, button) {
    const msg = document.getElementById('pr-plan-msg');
    const original = button.textContent;
    button.disabled = true;
    button.textContent = '手続きへ移動中…';
    if (msg) msg.hidden = true;

    try {
      const res = await fetch('/.netlify/functions/stripe-create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ plan: planId }),
      });

      if (res.status === 401) {
        // 🔴 「まず無料会員登録を」ではなく、購入手続きの続きとして扱う
        openPurchaseAuth(planId);
        button.disabled = false;
        button.textContent = original;
        return;
      }

      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      throw new Error(data.error || 'unavailable');
    } catch {
      if (msg) {
        msg.hidden = false;
        msg.textContent = '現在お申し込みを受け付けられません。しばらくしてからお試しください。';
      }
      button.disabled = false;
      button.textContent = original;
    }
  }

  async function openPortal(button) {
    const msg = document.getElementById('pr-plan-msg');
    button.disabled = true;
    try {
      const res = await fetch('/.netlify/functions/stripe-portal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      throw new Error('unavailable');
    } catch {
      if (msg) {
        msg.hidden = false;
        msg.textContent = 'お手続きページを開けませんでした。お問い合わせください。';
      }
      button.disabled = false;
    }
  }

  /* ------------------------------------------------------------------
     購入導線（未ログインで申し込んだとき）

     🔴 これらは **startCheckout と同じスコープ**に置くこと。
        DOMContentLoaded の内側へ入れると startCheckout から参照できず、
        クリック時に ReferenceError になって
        「現在お申し込みを受け付けられません」だけが出る（2026-09-02 に発生）。
     ------------------------------------------------------------------ */
  /** 購入意図を保持したままメール確認へ切り替える。 */
  let pendingPlan = null;
  function openPurchaseAuth(planId) {
    pendingPlan = planId;
    const box = document.getElementById('pr-purchase-auth');
    if (!box) return;
    box.hidden = false;
    // 押した CTA 自身にも「下へ続く」ことを出す（何が起きたか分かるように）
    document.querySelectorAll('[data-checkout]').forEach((b) => {
      const mine = b.getAttribute('data-checkout') === planId;
      b.classList.toggle('is-open', mine);
      b.setAttribute('aria-expanded', mine ? 'true' : 'false');
    });
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const input = document.getElementById('pr-purchase-email');
    if (input) input.focus();
  }

  async function submitPurchaseAuth(e) {
    e.preventDefault();
    const input = document.getElementById('pr-purchase-email');
    const msg = document.getElementById('pr-purchase-msg');
    const btn = document.querySelector('.pr-purchase-submit');
    const email = (input && input.value || '').trim();
    if (msg) msg.hidden = true;
    if (!email) { if (input) input.focus(); return; }

    if (btn) { btn.disabled = true; btn.textContent = '送信中…'; }
    try {
      const res = await fetch('/.netlify/functions/start-purchase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ email, plan: pendingPlan }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.sent) {
        // 🔴 メールのリンクから intent が落ちても購入へ戻れるように控えを残す。
        //    保存するのはプラン id だけ。認可には使わない。
        try { storeIntent(window.localStorage, pendingPlan); } catch { /* 使えなくても続行 */ }
        if (msg) {
          msg.hidden = false;
          msg.className = 'pr-purchase-msg is-ok';
          msg.textContent = '確認メールをお送りしました。メール内のリンクを開くと、お申し込みに戻ります。';
        }
        const form = document.getElementById('pr-purchase-form');
        if (form) form.hidden = true;
        return;
      }
      throw new Error(data.error || 'failed');
    } catch {
      if (msg) {
        msg.hidden = false;
        msg.className = 'pr-purchase-msg is-error';
        msg.textContent = '確認メールを送れませんでした。メールアドレスをご確認のうえ、もう一度お試しください。';
      }
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '確認メールを送る'; }
    }
  }

  /**
   * 認証から戻ってきたら、そのまま Checkout を開く。
   * 🔴 `resume` はサーバーが固定パスで付けたプラン id。
   *    ここでも実在するボタンとの一致だけを見て、値を URL として使わない。
   */
  function resumeCheckout() {
    const plan = new URLSearchParams(window.location.search).get('resume');
    if (!plan) return;
    const btn = document.querySelector(`[data-checkout="${CSS.escape(plan)}"]`);
    // ボタンが無い＝未ログイン（Price 未設定 or 認証されていない）なら何もしない
    if (!btn) return;
    startCheckout(plan, btn);
  }


  document.addEventListener('DOMContentLoaded', () => {
    if (document.querySelector('[data-price-for]')) loadPrices();

    const purchaseForm = document.getElementById('pr-purchase-form');
    if (purchaseForm) purchaseForm.addEventListener('submit', submitPurchaseAuth);

    // 認証から戻ってきたら、そのまま Checkout を開く
    resumeCheckout();

    document.querySelectorAll('[data-checkout]').forEach((btn) => {
      btn.addEventListener('click', () => startCheckout(btn.getAttribute('data-checkout'), btn));
    });

    const portal = document.getElementById('pr-portal');
    if (portal) portal.addEventListener('click', () => openPortal(portal));
  });
</script>

