---
/**
 * /pricing — 料金プラン
 *
 * 正本: docs/RENEWAL_2026_08.md §6
 *
 * 🔴 2026-08-28 全面改修:
 *   - 主導線を **Stripe の月額サブスク**にした（低価格帯・5,000円以下）。
 *   - **価格をコードに書かない**。金額の正本は Stripe の Price であり、
 *     `/.netlify/functions/stripe-prices` から取得して表示する。
 *     取得できないプランは「準備中」と出す（推測価格・仮の金額を出さない）。
 *   - 既存の買い切り・年払い（銀行振込）は削除せず、ページ下部の控えめな導線へ移した。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { publicPlans } from '../lib/billing/plans.js';
import { entitlementFromAstro, viewFlags } from '../lib/auth/entitlement.js';

export const prerender = false;

const entitlement = entitlementFromAstro(Astro);
const view = viewFlags(entitlement);

// 🔴 サーバー側では Price ID の有無だけを見る（金額は取得しない＝ページを速く返す）
const plans = publicPlans({
  ...(typeof process !== 'undefined' && process.env ? process.env : {}),
  ...(import.meta.env || {}),
});

const TIER_MATRIX = [
  { label: '全頭の馬柱・過去走', guest: true, free: true, paid: true },
  { label: 'AI短評（1頭ごとの文章）', guest: true, free: true, paid: true },
  { label: 'AIレース展望・展開予想', guest: true, free: true, paid: true },
  { label: '特徴量6指標', guest: true, free: true, paid: true },
  { label: '的中実績・回収率', guest: true, free: true, paid: true },
  { label: '注目馬の印（2〜5頭）', guest: false, free: true, paid: true },
  { label: '◎○▲△の印・AI指数', guest: false, free: false, paid: true },
  { label: 'AI結論（本命の推奨理由）', guest: false, free: false, paid: true },
  { label: '馬単の買い目', guest: false, free: false, paid: true },
  { label: '開催日の注目馬・穴馬メール', guest: false, free: false, paid: true },
];
---

<BaseLayout
  title="料金プラン"
  description="KEIBA Intelligence の料金プラン。馬柱・過去走・AI短評・展開予想は登録不要で無料公開。印は無料会員、馬単買い目は月額プランで提供します。"
>
  <div class="container pricing">
    <!-- ヒーロー -->
    <header class="pr-hero">
      <h1>まず無料で、中身を確かめてください</h1>
      <p class="pr-hero-lead">
        全レースの馬柱・過去走・<b>AI短評</b>・展開予想は<b>登録なしで全部</b>ご覧いただけます。<br>
        注目馬の印は無料会員登録で、◎○▲△の印・AI指数・馬単の買い目は月額プランで公開します。
      </p>
      <div class="pr-hero-actions">
        <a class="pr-btn pr-btn-ghost" href="/prediction/nankan">今日の予想を見る（無料）</a>
        {!view.authenticated && <a class="pr-btn pr-btn-primary" href="/register">無料会員に登録</a>}
      </div>
    </header>

    <!-- 何がどこまで見えるか -->
    <section class="pr-matrix-wrap">
      <h2 class="pr-h2">どこまで見えるか</h2>
      <div class="pr-matrix-scroll">
        <table class="pr-matrix">
          <thead>
            <tr>
              <th class="pr-m-label">できること</th>
              <th>未登録<br><small>¥0</small></th>
              <th>無料会員<br><small>¥0</small></th>
              <th class="pr-m-paid">有料プラン<br><small>月額</small></th>
            </tr>
          </thead>
          <tbody>
            {TIER_MATRIX.map((row) => (
              <tr>
                <td class="pr-m-label">{row.label}</td>
                <td class={row.guest ? 'ok' : 'no'}>{row.guest ? '○' : '—'}</td>
                <td class={row.free ? 'ok' : 'no'}>{row.free ? '○' : '—'}</td>
                <td class={`pr-m-paid ${row.paid ? 'ok' : 'no'}`}>{row.paid ? '○' : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 月額プラン -->
    <section class="pr-plans">
      <h2 class="pr-h2">月額プラン</h2>
      <p class="pr-plans-note">いつでも解約できます。解約後も無料会員として注目馬の印までご覧いただけます。</p>

      <div class="pr-plan-grid">
        {plans.map((plan) => (
          <article class={`pr-plan ${plan.recommended ? 'is-recommended' : ''}`} data-plan={plan.id}>
            {plan.recommended && <span class="pr-plan-ribbon">おすすめ</span>}
            <h3 class="pr-plan-name">{plan.name}</h3>
            <p class="pr-plan-tagline">{plan.tagline}</p>

            <p class="pr-plan-price" data-price-for={plan.id}>
              {plan.purchasable
                ? <span class="pr-price-loading">価格を取得中…</span>
                : <span class="pr-price-pending">準備中</span>}
            </p>

            <ul class="pr-plan-features">
              {plan.features.map((f) => <li>{f}</li>)}
            </ul>

            {plan.purchasable ? (
              <button class="pr-btn pr-btn-primary pr-plan-cta" type="button" data-checkout={plan.id}>
                このプランを申し込む
              </button>
            ) : (
              <button class="pr-btn pr-btn-disabled" type="button" disabled>準備中</button>
            )}
          </article>
        ))}
      </div>

      <p class="pr-plan-msg" id="pr-plan-msg" hidden></p>

      {view.showBetting && (
        <p class="pr-manage">
          <button class="pr-link-btn" type="button" id="pr-portal">お支払い方法の変更・解約はこちら</button>
        </p>
      )}
    </section>

    <!-- 銀行振込（控えめ） -->
    <section class="pr-bank">
      <details>
        <summary>年払い・買い切りをご希望の方（銀行振込）</summary>
        <div class="pr-bank-body">
          <p>
            月額ではなく、まとめてお支払いいただくプランもご用意しています。
            お申し込み後、振込先をメールでご案内します。
          </p>
          <ul>
            <li><b>年払い</b> — 南関東＋中央、全レースの馬単買い目</li>
            <li><b>買い切り</b> — 同内容を永久にご利用いただけます</li>
          </ul>
          <a class="pr-btn pr-btn-ghost" href="/apply">銀行振込で申し込む</a>
        </div>
      </details>
    </section>

    <!-- FAQ -->
    <section class="pr-faq">
      <h2 class="pr-h2">よくあるご質問</h2>
      <details><summary>無料でどこまで見られますか？</summary>
        <p>登録なしで、全レースの馬柱・過去走・AI短評・レース展望・展開予想・特徴量をご覧いただけます。無料会員登録をすると、これに注目馬の印（2〜5頭）が加わります。◎○▲△の印・AI指数・買い目は有料プランです。</p>
      </details>
      <details><summary>買い目は何点ですか？</summary>
        <p>馬単で、1レースあたりの投資は5点固定です。点数を後から増やしたり、高配当だけを選んで実績に載せたりはしていません。</p>
      </details>
      <details><summary>解約はできますか？</summary>
        <p>いつでも解約できます。解約手続きはマイページから行えます。解約後も無料会員として注目馬の印までご覧いただけます。</p>
      </details>
      <details><summary>回収率はどう計算していますか？</summary>
        <p>払戻 ÷ 投資 × 100 の実測値です。公開している的中はすべて算入しています。</p>
      </details>
    </section>
  </div>
</BaseLayout>

<script>
  // 価格は Stripe から取得する（金額をコードに持たない）
  async function loadPrices() {
    const msg = document.getElementById('pr-plan-msg');
    try {
      const res = await fetch('/.netlify/functions/stripe-prices');
      if (!res.ok) throw new Error('unavailable');
      const data = await res.json();

      for (const p of (data.plans || [])) {
        const el = document.querySelector(`[data-price-for="${p.id}"]`);
        if (!el) continue;
        if (!p.available || typeof p.amount !== 'number') {
          el.innerHTML = '<span class="pr-price-pending">準備中</span>';
          continue;
        }
        const yen = new Intl.NumberFormat('ja-JP').format(Math.round(p.amount));
        const unit = p.interval ? `/${p.interval}` : '';
        el.innerHTML = `<span class="pr-price-amount">¥${yen}</span><span class="pr-price-unit">${unit}</span>`;
      }
    } catch {
      document.querySelectorAll('[data-price-for]').forEach((el) => {
        el.innerHTML = '<span class="pr-price-pending">準備中</span>';
      });
      if (msg) {
        msg.hidden = false;
        msg.textContent = '現在お申し込みを受け付けられません。しばらくしてからお試しください。';
      }
    }
  }

  async function startCheckout(planId, button) {
    const msg = document.getElementById('pr-plan-msg');
    const original = button.textContent;
    button.disabled = true;
    button.textContent = '手続きへ移動中…';
    if (msg) msg.hidden = true;

    try {
      const res = await fetch('/.netlify/functions/stripe-create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ plan: planId }),
      });

      if (res.status === 401) {
        window.location.href = '/login?redirect=/pricing';
        return;
      }

      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      throw new Error(data.error || 'unavailable');
    } catch {
      if (msg) {
        msg.hidden = false;
        msg.textContent = '現在お申し込みを受け付けられません。しばらくしてからお試しください。';
      }
      button.disabled = false;
      button.textContent = original;
    }
  }

  async function openPortal(button) {
    const msg = document.getElementById('pr-plan-msg');
    button.disabled = true;
    try {
      const res = await fetch('/.netlify/functions/stripe-portal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      throw new Error('unavailable');
    } catch {
      if (msg) {
        msg.hidden = false;
        msg.textContent = 'お手続きページを開けませんでした。お問い合わせください。';
      }
      button.disabled = false;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (document.querySelector('[data-price-for]')) loadPrices();

    document.querySelectorAll('[data-checkout]').forEach((btn) => {
      btn.addEventListener('click', () => startCheckout(btn.getAttribute('data-checkout'), btn));
    });

    const portal = document.getElementById('pr-portal');
    if (portal) portal.addEventListener('click', () => openPortal(portal));
  });
</script>

<style>
  .pricing { padding-bottom: 48px; }

  /* ヒーロー */
  .pr-hero {
    text-align: center;
    padding: 32px 16px 28px;
    background: linear-gradient(180deg, #f0f7ff 0%, #fff8f0 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    margin-bottom: 32px;
  }

  .pr-hero h1 {
    font-size: 2rem;
    margin-bottom: 12px;
  }

  .pr-hero-lead {
    font-size: 0.98rem;
    line-height: 1.85;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .pr-hero-lead b { color: var(--secondary-start); }

  .pr-hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .pr-btn {
    display: inline-block;
    padding: 12px 26px;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 0.95rem;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pr-btn-primary {
    background: var(--primary-gradient);
    color: var(--text-inverse);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
  }

  .pr-btn-primary:hover { transform: translateY(-1px); color: var(--text-inverse); }

  .pr-btn-ghost {
    background: var(--bg-secondary);
    border-color: var(--primary-start);
    color: var(--primary-start);
  }

  .pr-btn-ghost:hover { background: var(--bg-muted); color: var(--primary-start); }

  .pr-btn-disabled {
    background: var(--bg-muted);
    color: var(--text-tertiary);
    cursor: not-allowed;
  }

  .pr-h2 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    margin-bottom: 14px;
    text-align: center;
  }

  /* 比較表 */
  .pr-matrix-wrap { margin-bottom: 40px; }

  .pr-matrix-scroll { overflow-x: auto; }

  .pr-matrix {
    width: 100%;
    min-width: 520px;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .pr-matrix th,
  .pr-matrix td {
    padding: 10px 12px;
    text-align: center;
    font-size: 0.86rem;
    border-bottom: 1px solid var(--border-color);
  }

  .pr-matrix thead th {
    background: var(--bg-muted);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .pr-matrix thead th small {
    font-weight: 600;
    color: var(--text-tertiary);
    font-size: 0.72rem;
  }

  .pr-m-label { text-align: left !important; font-weight: 600; }

  .pr-matrix .ok { color: var(--success); font-weight: 800; }
  .pr-matrix .no { color: var(--text-tertiary); }

  .pr-matrix .pr-m-paid { background: rgba(249, 115, 22, 0.06); }
  .pr-matrix thead .pr-m-paid { background: rgba(249, 115, 22, 0.14); }

  .pr-matrix tbody tr:last-child td { border-bottom: none; }

  /* プラン */
  .pr-plans { margin-bottom: 40px; }

  .pr-plans-note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .pr-plan-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    max-width: 760px;
    margin: 0 auto;
  }

  .pr-plan {
    position: relative;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 24px 20px;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .pr-plan.is-recommended {
    border-color: var(--secondary-start);
    box-shadow: var(--shadow-lg);
  }

  .pr-plan-ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 16px;
    border-radius: var(--radius-pill);
    background: var(--secondary-gradient);
    color: var(--text-inverse);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .pr-plan-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 4px;
  }

  .pr-plan-tagline {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }

  .pr-plan-price {
    min-height: 48px;
    margin-bottom: 16px;
  }

  .pr-price-amount {
    font-family: var(--font-num);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .pr-price-unit {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-weight: 700;
  }

  .pr-price-loading,
  .pr-price-pending {
    font-size: 1rem;
    color: var(--text-tertiary);
    font-weight: 700;
  }

  .pr-plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    text-align: left;
  }

  .pr-plan-features li {
    font-size: 0.86rem;
    color: var(--text-secondary);
    padding: 6px 0 6px 22px;
    position: relative;
    line-height: 1.5;
  }

  .pr-plan-features li::before {
    content: '✓';
    position: absolute;
    left: 2px;
    color: var(--success);
    font-weight: 800;
  }

  .pr-plan-cta { width: 100%; }

  .pr-plan-msg {
    max-width: 760px;
    margin: 16px auto 0;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    background: rgba(220, 38, 38, 0.08);
    color: #991b1b;
    font-size: 0.86rem;
    text-align: center;
  }

  .pr-manage { text-align: center; margin-top: 18px; }

  .pr-link-btn {
    background: none;
    border: none;
    color: var(--primary-start);
    font-weight: 700;
    font-size: 0.86rem;
    cursor: pointer;
    text-decoration: underline;
  }

  /* 銀行振込（控えめ） */
  .pr-bank {
    max-width: 760px;
    margin: 0 auto 40px;
  }

  .pr-bank details {
    background: var(--bg-muted);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
  }

  .pr-bank summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .pr-bank-body {
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .pr-bank-body ul { margin: 10px 0 14px 18px; }

  /* FAQ */
  .pr-faq { max-width: 760px; margin: 0 auto; }

  .pr-faq details {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    margin-bottom: 8px;
  }

  .pr-faq summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .pr-faq p {
    margin: 10px 0 0;
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .pr-hero h1 { font-size: 1.5rem; }
    .pr-hero-lead { font-size: 0.88rem; }
  }
</style>
