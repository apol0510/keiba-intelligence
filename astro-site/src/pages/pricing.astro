---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const recommendedPlans = [
  {
    id: 'lifetime',
    name: '買い切りプラン',
    price: 88000,
    period: '',
    description: '南関4場＋中央競馬（JRA全10場）永久アクセス',
    features: [
      { text: '南関4場全レース予想', included: true },
      { text: 'JRA全10場全レース予想', included: true },
      { text: '馬単買い目提供', included: true },
      { text: '的中実績閲覧', included: true },
      { text: 'データ可視化', included: true },
      { text: 'Feature Importance Analysis', included: true },
      { text: '永久アクセス権', included: true, highlight: true },
    ],
    cta: '銀行振込で申し込む',
    ctaLink: '/apply',
    highlighted: true,
    badge: '一番お得',
    lifetimeNote: '永久アクセス（追加料金なし）',
  },
  {
    id: 'yearly',
    name: '年払いプラン',
    price: 66000,
    originalPrice: 144000, // 月払い12,000円×12ヶ月
    period: '/年',
    description: '南関4場＋中央競馬（JRA全10場）',
    features: [
      { text: '南関4場全レース予想', included: true },
      { text: 'JRA全10場全レース予想', included: true },
      { text: '馬単買い目提供', included: true },
      { text: '的中実績閲覧', included: true },
      { text: 'データ可視化', included: true },
      { text: 'Feature Importance Analysis', included: true },
    ],
    cta: '銀行振込で申し込む',
    ctaLink: '/apply',
    highlighted: true,
    badge: 'おすすめ',
    monthlyEquivalent: 5500,
    dailyPrice: 181,
    savings: 78000, // 144,000 - 66,000
  },
];

const lightPlan = {
  id: 'light',
  name: 'ライトプラン',
  price: 6600,
  period: '/月',
  description: 'まずはお試しで始めたい方に',
  features: [
    { text: '南関4場＋JRA全10場 全レース予想', included: true },
    { text: 'メインレース馬単買い目', included: true, highlight: true },
    { text: '的中実績閲覧', included: true },
    { text: 'データ可視化', included: true },
    { text: '全レース馬単買い目', included: false },
  ],
  cta: '銀行振込で申し込む',
  ctaLink: '/apply',
  highlighted: false,
  badge: 'お試し',
  dailyPrice: 220,
};

const monthlyPlans = [
  {
    id: 'monthly-nankan',
    name: '南関のみ（月払い）',
    price: 12000,
    period: '/月',
    description: '南関4場のみ',
    features: [
      { text: '南関4場全レース予想', included: true },
      { text: '馬単買い目提供', included: true },
      { text: '的中実績閲覧', included: true },
      { text: 'データ可視化', included: true },
      { text: 'JRA予想', included: false },
    ],
    cta: '銀行振込で申し込む',
    ctaLink: '/apply',
    highlighted: false,
    warning: '年払いより2.2倍割高',
    dailyPrice: 400,
  },
  {
    id: 'monthly-jra',
    name: '中央のみ（月払い）',
    price: 12000,
    period: '/月',
    description: 'JRA全10場のみ',
    features: [
      { text: 'JRA全10場全レース予想', included: true },
      { text: '馬単買い目提供', included: true },
      { text: '的中実績閲覧', included: true },
      { text: 'データ可視化', included: true },
      { text: '南関予想', included: false },
    ],
    cta: '銀行振込で申し込む',
    ctaLink: '/apply',
    highlighted: false,
    warning: '年払いより2.2倍割高',
    dailyPrice: 400,
  },
];
---

<BaseLayout
  title="料金プラン"
  description="KEIBA Intelligenceの料金プラン。買い切り¥88,000（永久アクセス、3年利用で月額換算¥2,444）または年払い¥66,000。南関4場＋中央競馬（JRA全10場）全レース対応。"
>
  <!-- ヘッダーセクション -->
  <section class="pricing-header gradient-bg">
    <div class="container text-center">
      <h1 class="fade-in">料金プラン</h1>
      <p class="section-subtitle slide-in">
        買い切り¥88,000（永久アクセス）または年払い¥66,000。<br>
        南関4場＋中央競馬（JRA全10場）全レース対応。
      </p>
    </div>
  </section>

  <!-- 365日競馬バナー -->
  <section class="daily-racing-banner">
    <div class="container">
      <div class="banner-card">
        <div class="banner-icon">🏇</div>
        <h2 class="banner-title">365日、毎日競馬ができる</h2>
        <p class="banner-subtitle">平日も週末も、年中無休で競馬予想を提供</p>

        <div class="racing-schedule">
          <div class="schedule-item">
            <div class="schedule-days">月〜金</div>
            <div class="schedule-icon">🌙</div>
            <div class="schedule-venue">南関競馬</div>
            <div class="schedule-desc">大井・川崎・船橋・浦和</div>
          </div>
          <div class="schedule-divider">+</div>
          <div class="schedule-item">
            <div class="schedule-days">土・日</div>
            <div class="schedule-icon">☀️</div>
            <div class="schedule-venue">中央競馬</div>
            <div class="schedule-desc">JRA全10場</div>
          </div>
        </div>

        <div class="banner-highlight">
          <div class="lifetime-access-huge">永久アクセス</div>
          <div class="banner-highlight-text">
            買い切りプラン <span class="highlight-price">¥88,000</span> なら、<br>
            この環境が永久に手に入る
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- おすすめプラン（年払い・買い切り） -->
  <section class="pricing-plans">
    <div class="container">
      <h2 class="section-title text-center">おすすめプラン</h2>
      <p class="text-center mb-3" style="color: var(--text-secondary);">
        南関4場＋中央競馬（JRA全10場）セット
      </p>

      <div class="grid grid-2" style="max-width: 900px; margin: 0 auto;">
        {recommendedPlans.map((plan) => (
          <div class={`pricing-card card ${plan.highlighted ? 'featured' : ''} ${plan.id === 'lifetime' ? 'lifetime-special' : ''}`}>
            {plan.badge && (
              <div class={`badge ${plan.id === 'lifetime' ? 'badge-lifetime' : 'badge-success'}`}>{plan.badge}</div>
            )}

            <div class="plan-header">
              <div class="plan-name">{plan.name}</div>
              <div class="plan-price">
                <span class="price">¥{plan.price.toLocaleString()}</span>
                <span class="period">{plan.period}</span>
              </div>
              {plan.monthlyEquivalent && (
                <div class="monthly-equivalent">
                  月額換算 ¥{plan.monthlyEquivalent.toLocaleString()}/月
                </div>
              )}
              {plan.dailyPrice && (
                <div class="daily-price">1日あたり¥{plan.dailyPrice}</div>
              )}
              {plan.savings && (
                <div class="savings-badge">
                  年間¥{plan.savings.toLocaleString()}お得
                </div>
              )}
              {plan.lifetimeNote && (
                <div class="lifetime-note-big">{plan.lifetimeNote}</div>
              )}
              <div class="plan-description">{plan.description}</div>
            </div>

            <ul class="plan-features">
              {plan.features.map((feature) => (
                <li class={`${feature.included ? 'included' : 'excluded'} ${feature.highlight ? 'highlight' : ''}`}>
                  {feature.included ? '✅' : '❌'} {feature.text}
                </li>
              ))}
            </ul>

            {plan.id === 'lifetime' && (
              <>
                <div class="lifetime-future">
                  <div class="future-title">🚀 50年後も、追加料金なし</div>

                  <ul class="future-features">
                    <li>✅ AIは自動で動き続ける（2076年も使える）</li>
                    <li>✅ 毎日進化し、精度が上がる</li>
                    <li>✅ ¥88,000以外、一生払わない</li>
                  </ul>

                  <div class="future-comparison">
                    <div class="comparison-label">毎月課金型なら50年で</div>
                    <div class="comparison-monthly">720万円</div>
                    <div class="comparison-arrow">↓</div>
                    <div class="comparison-label">買い切りなら</div>
                    <div class="comparison-lifetime">8万8千円のみ</div>
                  </div>

                  <div class="future-tagline">
                    未来を買うなら今
                  </div>
                </div>
              </>
            )}

            <button
              class={`btn ${plan.id === 'lifetime' ? 'btn-lifetime' : 'btn-primary'} w-full open-apply-modal`}
              data-plan={plan.id}
              data-price={plan.price}
              data-name={plan.name}
            >
              {plan.cta}
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ライトプラン（お試し） -->
  <section class="light-plan-section">
    <div class="container">
      <h2 class="section-title text-center">まずはお試し</h2>
      <p class="text-center mb-3" style="color: var(--text-secondary);">
        全レース予想を閲覧可能。メインレースの買い目付き。
      </p>

      <div style="max-width: 450px; margin: 0 auto;">
        <div class="pricing-card card light-card">
          <div class="badge badge-light">{lightPlan.badge}</div>

          <div class="plan-header">
            <div class="plan-name">{lightPlan.name}</div>
            <div class="plan-price">
              <span class="price">¥{lightPlan.price.toLocaleString()}</span>
              <span class="period">{lightPlan.period}</span>
            </div>
            {lightPlan.dailyPrice && (
              <div class="daily-price">1日あたり¥{lightPlan.dailyPrice}</div>
            )}
            <div class="plan-description">{lightPlan.description}</div>
          </div>

          <ul class="plan-features">
            {lightPlan.features.map((feature) => (
              <li class={`${feature.included ? 'included' : 'excluded'} ${feature.highlight ? 'highlight' : ''}`}>
                {feature.included ? '✅' : '❌'} {feature.text}
              </li>
            ))}
          </ul>

          <div class="light-upgrade-hint">
            <p>気に入ったらプロプランへアップグレード可能</p>
          </div>

          <button
            class="btn btn-light w-full open-apply-modal"
            data-plan={lightPlan.id}
            data-price={lightPlan.price}
            data-name={lightPlan.name}
          >
            {lightPlan.cta}
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* 月払いプラン（割高・非推奨）は非表示（2026-06-15） */}
  {/*
  <section class="monthly-plans">
    <div class="container">
      <h2 class="section-title text-center">月払いプラン（割高・非推奨）</h2>
      <p class="text-center mb-3" style="color: #ef4444; font-weight: 700;">
        ⚠️ 年払いより2.2倍割高です。年払いプランを強くおすすめします。
      </p>

      <div class="grid grid-2" style="max-width: 900px; margin: 0 auto;">
        {monthlyPlans.map((plan) => (
          <div class="pricing-card card monthly-warning">
            {plan.warning && (
              <div class="badge badge-warning">{plan.warning}</div>
            )}

            <div class="plan-header">
              <div class="plan-name">{plan.name}</div>
              <div class="plan-price">
                <span class="price">¥{plan.price.toLocaleString()}</span>
                <span class="period">{plan.period}</span>
              </div>
              {plan.dailyPrice && (
                <div class="daily-price warning-text">1日あたり¥{plan.dailyPrice}</div>
              )}
              <div class="plan-description">{plan.description}</div>
            </div>

            <ul class="plan-features">
              {plan.features.map((feature) => (
                <li class={feature.included ? 'included' : 'excluded'}>
                  {feature.included ? '✅' : '❌'} {feature.text}
                </li>
              ))}
            </ul>

            <button
              class="btn btn-secondary w-full open-apply-modal"
              data-plan={plan.id}
              data-price={plan.price}
              data-name={plan.name}
            >
              {plan.cta}
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>
  */}

  <!-- 価格比較表 -->
  <section class="price-comparison">
    <div class="container">
      <h2 class="section-title text-center">価格比較</h2>

      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>プラン</th>
              <th>価格</th>
              <th>月額換算</th>
              <th>1日あたり</th>
              <th>お得度</th>
            </tr>
          </thead>
          <tbody>
            <tr class="highlight-row">
              <td><strong>買い切り（南関＋中央）</strong></td>
              <td><strong>¥88,000（永久）</strong></td>
              <td><strong>¥2,444/月</strong><br><small>（3年利用時）</small></td>
              <td><strong>¥81/日</strong><br><small>（3年利用時）</small></td>
              <td><span class="badge badge-success">3年で¥256,000お得</span></td>
            </tr>
            <tr class="highlight-row">
              <td><strong>年払い（南関＋中央）</strong></td>
              <td><strong>¥66,000/年</strong></td>
              <td><strong>¥5,500/月</strong></td>
              <td><strong>¥181/日</strong></td>
              <td><span class="badge badge-success">年間¥78,000お得</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="comparison-note">
        <p>💎 <strong>買い切りプランなら：</strong></p>
        <ul>
          <li>3年利用で月額換算¥2,444（年払いの半額以下）</li>
          <li>5年利用なら月額換算¥1,467（さらにお得）</li>
          <li>永久アクセス権で将来の値上げリスクなし</li>
          <li>長期利用すればするほどお得</li>
        </ul>
        <p>💡 <strong>年払いプランなら：</strong></p>
        <ul>
          <li>月額換算¥5,500で南関＋中央の両方が利用可能</li>
          <li>1日あたりわずか¥181（缶コーヒー1本分以下）</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- プラン機能比較表 -->
  <section class="plan-comparison">
    <div class="container">
      <h2 class="section-title text-center">プラン機能比較表</h2>

      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>機能</th>
              <th class="highlighted">買い切り</th>
              <th class="highlighted">年払い</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>南関4場全レース予想</td>
              <td>✅</td>
              <td>✅</td>
            </tr>
            <tr>
              <td>JRA全10場全レース予想</td>
              <td>✅</td>
              <td>✅</td>
            </tr>
            <tr>
              <td>馬単買い目提供</td>
              <td>✅</td>
              <td>✅</td>
            </tr>
            <tr>
              <td>的中実績閲覧</td>
              <td>✅</td>
              <td>✅</td>
            </tr>
            <tr>
              <td>データ可視化</td>
              <td>✅</td>
              <td>✅</td>
            </tr>
            <tr>
              <td>Feature Importance Analysis</td>
              <td>✅</td>
              <td>✅</td>
            </tr>
            <tr>
              <td>永久アクセス</td>
              <td>✅</td>
              <td>❌</td>
            </tr>
            <tr class="highlight-row">
              <td><strong>月額換算</strong></td>
              <td><strong>¥2,444</strong><br><small>(3年利用時)</small></td>
              <td><strong>¥5,500</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <h2 class="section-title text-center">よくある質問</h2>

      <div class="faq-grid">
        <div class="faq-item card">
          <h3>Q. おすすめのプランはどれですか？</h3>
          <p>
            <strong>買い切りプラン（¥88,000）</strong>を最もおすすめします。3年利用で月額換算¥2,444（年払いの半額以下）、5年なら¥1,467と、長期利用で圧倒的にお得になります。
          </p>
          <p>
            1年程度の利用を予定されている方は<strong>年払いプラン（¥66,000）</strong>もおすすめです。月額換算¥5,500（1日¥181）でお得にご利用いただけます。
          </p>
        </div>

        <div class="faq-item card">
          <h3>Q. 買い切りプランの「永久アクセス」とは？</h3>
          <p>
            買い切りプラン（¥88,000）は<strong>一度の購入で永久に利用可能</strong>です。追加料金は一切発生しません。
            3年利用で月額換算¥2,444、5年なら¥1,467と、利用期間が長いほどお得になります。
          </p>
        </div>

        <div class="faq-item card highlight-faq">
          <h3>Q. 50年後も本当に使えるの？AIは進化する？</h3>
          <p>
            <strong>はい、50年後も追加料金なしで使えます。</strong>
            AIシステムは自動で動き続け、毎日進化を重ねます。2076年のAIがどれだけ進化しているか、誰にもわかりません。
          </p>
          <p>
            でも、ひとつ確実なこと。<strong>あなたが支払うのは2026年の¥88,000だけ</strong>です。
            毎月課金型のサービスなら50年で720万円。買い切りなら8万8千円のみ。それが買い切りの力です。
          </p>
        </div>

        <div class="faq-item card">
          <h3>Q. 南関のみ・中央のみのプランはありますか？</h3>
          <p>
            現在は<strong>南関＋中央セット</strong>の買い切りプラン・年払いプランのみのご提供です。
            年払い（¥66,000）なら1日あたり¥181で南関4場＋中央（JRA全10場）の両方をご利用いただけます。
          </p>
        </div>

        <div class="faq-item card">
          <h3>Q. 支払い方法は？</h3>
          <p>
            現在、<strong>銀行振り込みのみ</strong>対応しています。お申し込み後、振込先情報をメールでお送りします。
            入金確認後、即座にアクセス権を付与いたします。
          </p>
        </div>

        <div class="faq-item card">
          <h3>Q. 途中解約・返金はできますか？</h3>
          <p>
            年払いプラン・買い切りプランともに、<strong>購入後の返金は原則として承っておりません</strong>。
            無料予想ページで予想の精度を事前にご確認の上、お申し込みください。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta gradient-bg">
    <div class="container text-center">
      <h2>今すぐ始めて、勝ち馬を見つけよう</h2>
      <p class="mb-3">買い切り¥88,000（永久アクセス）または年払い¥66,000</p>
      <div class="cta-buttons">
        <button id="open-apply-modal-cta" class="btn btn-primary btn-lg">銀行振込で申し込む</button>
        <a href="/register" class="btn btn-secondary btn-lg">まずは無料会員登録</a>
      </div>
    </div>
  </section>

  <!-- 申し込みモーダル -->
  <div id="apply-modal" class="modal hidden">
    <div class="modal-overlay" id="modal-overlay"></div>
    <div class="modal-content">
      <button class="modal-close" id="modal-close">&times;</button>

      <h2 class="modal-title">銀行振込で申し込む</h2>

      <!-- Step 1: プラン選択 -->
      <div id="step-plan-selection" class="modal-step">
        <h3>プランを選択してください</h3>
        <div class="plan-selection-grid">
          <div class="plan-select-card" data-plan="lifetime" data-price="88000">
            <div class="plan-badge">一番お得</div>
            <h4>買い切りプラン</h4>
            <div class="plan-price">¥88,000</div>
            <p>永久アクセス（追加料金なし）</p>
            <button class="btn btn-primary btn-sm select-plan-btn">このプランを選ぶ</button>
          </div>

          <div class="plan-select-card" data-plan="yearly" data-price="66000">
            <div class="plan-badge">おすすめ</div>
            <h4>年払いプラン</h4>
            <div class="plan-price">¥66,000<span class="plan-period">/年</span></div>
            <p>月額換算¥5,500</p>
            <button class="btn btn-primary btn-sm select-plan-btn">このプランを選ぶ</button>
          </div>

          {/* 月払いプランは非表示（2026-06-15） */}
          {/*
          <div class="plan-select-card" data-plan="monthly-nankan" data-price="12000">
            <h4>南関のみ（月払い）</h4>
            <div class="plan-price">¥12,000<span class="plan-period">/月</span></div>
            <p class="plan-warning">年払いより2.2倍割高</p>
            <button class="btn btn-secondary btn-sm select-plan-btn">このプランを選ぶ</button>
          </div>

