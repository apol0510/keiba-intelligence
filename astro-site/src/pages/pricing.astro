      .pricing-card.lifetime-special {
        transform: scale(1);
      }

      .pricing-card.lifetime-special:hover {
        transform: scale(1.02);
      }

      .cta-buttons {
        flex-direction: column;
      }

      .comparison-table {
        font-size: 0.875rem;
      }

      .comparison-table th,
      .comparison-table td {
        padding: var(--spacing-sm);
      }
    }

    /* モーダル */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal.hidden {
      display: none;
    }

    .modal-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(5px);
    }

    .modal-content {
      position: relative;
      background: var(--card-bg);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-lg);
      max-width: 900px;
      max-height: 90vh;
      overflow-y: auto;
      padding: var(--spacing-2xl);
      margin: var(--spacing-lg);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    }

    .modal-close {
      position: absolute;
      top: var(--spacing-lg);
      right: var(--spacing-lg);
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 2rem;
      cursor: pointer;
      transition: color 0.3s;
      line-height: 1;
    }

    .modal-close:hover {
      color: var(--color-accent);
    }

    .modal-title {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: var(--spacing-xl);
      background: linear-gradient(135deg, #e0f2fe 0%, #60a5fa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .modal-step {
      animation: fadeIn 0.3s;
    }

    .modal-step.hidden {
      display: none;
    }

    /* プラン選択グリッド */
    .plan-selection-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-xl);
    }

    .plan-select-card {
      background: rgba(30, 41, 59, 0.8);
      border: 2px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-md);
      padding: var(--spacing-lg);
      text-align: center;
      transition: all 0.3s;
      cursor: pointer;
      position: relative;
    }

    .plan-select-card:hover {
      border-color: var(--color-accent);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
    }

    .plan-select-card .plan-badge {
      position: absolute;
      top: -10px;
      right: -10px;
      background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-alt) 100%);
      color: white;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .plan-select-card h4 {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }

    .plan-select-card .plan-price {
      font-size: 1.75rem;
      font-weight: 900;
      color: var(--color-accent);
      margin-bottom: var(--spacing-sm);
    }

    .plan-select-card .plan-period {
      font-size: 1rem;
      font-weight: 400;
    }

    .plan-select-card p {
      font-size: 0.875rem;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-md);
    }

    .plan-select-card .plan-warning {
      color: #ef4444;
      font-weight: 600;
    }

    .select-plan-btn {
      width: 100%;
      margin-top: var(--spacing-sm);
    }

    /* 選択プラン情報 */
    .selected-plan-info {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-md);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
      text-align: center;
    }

    .selected-plan-info h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--spacing-sm);
      color: var(--text-primary);
    }

    .selected-plan-price {
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--color-accent);
    }

    /* 銀行情報 */
    .bank-info-section {
      margin-bottom: var(--spacing-xl);
    }

    .bank-info-section h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }

    .bank-info-card {
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-md);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-md);
    }

    .bank-detail {
      display: flex;
      justify-content: space-between;
      padding: var(--spacing-sm) 0;
      border-bottom: 1px solid rgba(100, 116, 139, 0.2);
    }

    .bank-detail:last-child {
      border-bottom: none;
    }

    .bank-label {
      color: var(--text-secondary);
      font-weight: 600;
    }

    .bank-value {
      color: var(--text-primary);
      font-weight: 700;
      font-family: 'Courier New', monospace;
    }

    .bank-notice {
      background: rgba(251, 191, 36, 0.1);
      border: 1px solid rgba(251, 191, 36, 0.3);
      border-radius: var(--radius-sm);
      padding: var(--spacing-md);
    }

    .bank-notice p {
      margin: var(--spacing-xs) 0;
      font-size: 0.875rem;
    }

    /* フォーム */
    .application-form {
      margin-top: var(--spacing-xl);
    }

    .form-group {
      margin-bottom: var(--spacing-lg);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-md);
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: var(--spacing-sm);
      color: var(--text-primary);
    }

    .required {
      color: #ef4444;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: var(--spacing-md);
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid rgba(100, 116, 139, 0.3);
      border-radius: var(--radius-sm);
      color: var(--text-primary);
      font-size: 1rem;
      transition: border-color 0.3s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-accent);
    }

    .form-group small {
      display: block;
      margin-top: var(--spacing-xs);
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .form-notice {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: var(--radius-sm);
      padding: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
    }

    .form-notice p {
      margin: var(--spacing-xs) 0;
      font-size: 0.875rem;
    }

    /* 成功メッセージ */
    .success-message {
      text-align: center;
      padding: var(--spacing-2xl);
    }

    .success-message.hidden {
      display: none;
    }

    .success-icon {
      font-size: 4rem;
      margin-bottom: var(--spacing-lg);
    }

    .success-message h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }

    .success-message p {
      margin-bottom: var(--spacing-sm);
      color: var(--text-secondary);
    }

    /* 戻るボタン */
    .back-btn {
      background: transparent;
      border: none;
      color: var(--color-accent);
      font-weight: 600;
      cursor: pointer;
      margin-bottom: var(--spacing-lg);
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      transition: opacity 0.3s;
    }

    .back-btn:hover {
      opacity: 0.8;
    }

    /* レスポンシブ */
    @media (max-width: 768px) {
      .modal-content {
        padding: var(--spacing-lg);
        margin: var(--spacing-md);
      }

      .plan-selection-grid {
        grid-template-columns: 1fr;
      }

      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // モーダル要素取得
    const modal = document.getElementById('apply-modal');
    const modalOverlay = document.getElementById('modal-overlay');
    const modalClose = document.getElementById('modal-close');
    const stepPlanSelection = document.getElementById('step-plan-selection');
    const stepApplicationForm = document.getElementById('step-application-form');
    const applicationForm = document.getElementById('application-form');
    const successMessage = document.getElementById('success-message');
    const backBtn = document.getElementById('back-to-plan-selection');

    // 選択プラン情報
    let selectedPlan = {
      type: '',
      name: '',
      price: 0
    };

    // モーダルを開く（プラン選択から）
    document.querySelectorAll('.open-apply-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const planType = btn.dataset.plan;
        const planPrice = parseInt(btn.dataset.price);
        const planName = btn.dataset.name;

        // プランが指定されている場合は直接フォームへ
        if (planType && planPrice && planName) {
          selectedPlan = { type: planType, name: planName, price: planPrice };
          showApplicationForm();
        } else {
          // プラン選択画面を表示
          showPlanSelection();
        }
        modal.classList.remove('hidden');
      });
    });

    // モーダルを開く（CTAボタンから）
    document.getElementById('open-apply-modal-cta')?.addEventListener('click', () => {
      showPlanSelection();
      modal.classList.remove('hidden');
    });

    // モーダルを閉じる
    const closeModal = () => {
      modal.classList.add('hidden');
      resetModal();
    };

    modalOverlay.addEventListener('click', closeModal);
    modalClose.addEventListener('click', closeModal);
    document.getElementById('close-modal-success')?.addEventListener('click', closeModal);

    // プラン選択画面を表示
    const showPlanSelection = () => {
      stepPlanSelection.classList.remove('hidden');
      stepApplicationForm.classList.add('hidden');
    };

    // 申し込みフォーム画面を表示
    const showApplicationForm = () => {
      stepPlanSelection.classList.add('hidden');
      stepApplicationForm.classList.remove('hidden');

      // 選択プラン情報を表示
      document.getElementById('selected-plan-name').textContent = selectedPlan.name;
      document.getElementById('selected-plan-price').textContent = `¥${selectedPlan.price.toLocaleString()}`;

      // 振込金額フィールドに自動入力
      document.getElementById('transferAmount').value = selectedPlan.price;

      // フォーム・成功メッセージをリセット
      applicationForm.classList.remove('hidden');
      successMessage.classList.add('hidden');
    };

    // プラン選択ボタンのイベント
    document.querySelectorAll('.select-plan-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.plan-select-card');
        selectedPlan = {
          type: card.dataset.plan,
          name: card.querySelector('h4').textContent,
          price: parseInt(card.dataset.price)
        };
        showApplicationForm();
      });
    });

    // 戻るボタン
    backBtn.addEventListener('click', showPlanSelection);

    // モーダルリセット
    const resetModal = () => {
      applicationForm.reset();
      applicationForm.classList.remove('hidden');
      successMessage.classList.add('hidden');
      showPlanSelection();
    };

    // フォーム送信
    applicationForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById('submit-btn');
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中...';

      try {
        const formData = {
          fullName: document.getElementById('fullName').value,
          email: document.getElementById('email').value,
          transferDate: document.getElementById('transferDate').value,
          transferTime: '',  // 不要（空文字列）
          transferAmount: selectedPlan.price,
          transferName: '',  // 不要（空文字列）
          remarks: document.getElementById('remarks').value,
          productName: selectedPlan.name,
          planType: selectedPlan.type,
          timestamp: new Date().toISOString()
        };

        console.log('📤 送信データ:', formData);

        const response = await fetch('/.netlify/functions/bank-transfer-application', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });

        if (!response.ok) {
          const errorText = await response.text();
          throw new Error(`送信エラー: ${response.status} - ${errorText}`);
        }

        const result = await response.json();
        console.log('✅ 送信成功:', result);

        // 成功メッセージを表示
        applicationForm.classList.add('hidden');
        successMessage.classList.remove('hidden');
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });

      } catch (error) {
        console.error('❌ 送信エラー:', error);
        alert('送信に失敗しました。もう一度お試しください。\n\nエラー: ' + error.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  </script>
</BaseLayout>
