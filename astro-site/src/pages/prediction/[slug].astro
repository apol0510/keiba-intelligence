---
/**
 * /prediction/[slug] — 南関の特定開催（slug = YYYY-MM-DD-{venue}）
 *
 * 正本: docs/RENEWAL_2026_08.md
 *
 * 🔴 2026-08-28 全面改修。旧実装には次の 2 つの問題があった:
 *   1. **認可が一切無く**、`race.bettingLines.umatan` を誰にでもそのまま描画していた
 *      （2026-08-17 監査 A-1 と同種の露出。index ページだけを直しても塞がらない）。
 *   2. 期待値 `ev` を `Math.random()` で生成して「+X%」と表示していた。
 *      **実データではない数値を成績のように見せていた**ため削除した
 *      （未検証の数値を出さない方針。docs/progress.md の JRA 期待値の件と同じ理由）。
 *
 *   現在は index ページと同じ `RaceDayBoard` を使い、tier に応じてサーバー側で出し分ける。
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import RaceDayBoard from '../../components/newspaper/RaceDayBoard.astro';
import TierRibbon from '../../components/newspaper/TierRibbon.astro';
import { loadNankanRaceDayBySlug } from '../../lib/prediction/loadRaceDay.js';
import { entitlementFromAstro, viewFlags, paidPageRedirect } from '../../lib/auth/entitlement.js';

export const prerender = false;

const { slug } = Astro.params;

const entitlement = entitlementFromAstro(Astro);
const view = viewFlags(entitlement);

// 🔴 有料ページは買い目を出せない tier を入れない（fail-closed）。
//    同じ開催の無料ページ（`/free-prediction/nankan/[slug]`）へ送る。
const denied = paidPageRedirect(view, `/free-prediction/nankan/${slug}`);
if (denied) return Astro.redirect(denied, 302);
const day = loadNankanRaceDayBySlug(slug, process.cwd());

const venueNames = day.venues.map((v) => v.venueName).join('・');
const title = day.date
  ? `${venueNames} ${day.date} の予想 - KEIBA Intelligence`
  : '予想データ - KEIBA Intelligence';
const description = `${venueNames || '南関東'}${day.date || ''}の全レース馬柱・過去走・AI短評・展開予想。`;
---

<BaseLayout title={title} description={description}>
  <div class="container prediction-page">
    <TierRibbon view={view} />
    <RaceDayBoard day={day} view={view} category="nankan" />
    <p class="pp-back"><a href="/prediction/nankan">← 最新の南関予想へ</a></p>
  </div>
</BaseLayout>

<style>
  .prediction-page { padding-top: 8px; padding-bottom: 40px; }
  .pp-back { margin-top: 24px; font-weight: 700; }
</style>
