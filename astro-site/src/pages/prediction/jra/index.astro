---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccessControl from '../../../components/AccessControl.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { sortHorsesByRole } from '../../../utils/sortHorsesByRole.js';
import { getStore } from '@netlify/blobs';
import { generateAdvancedMetrics } from '../../../utils/featureScores.js';
import { isMainRace, getTop5Challengers } from '../../../utils/mainRaceBetting.js';
import { recentRaceMeta, RECENT_LABELS } from '../../../utils/recentForm.js';
import { injectHorseHistoriesIntoVenues } from '../../../utils/loadHorseHistoriesJra.js';
import { loadFeatureScores, getHorseFeatures, hasUsableFeatureScores, venueCodeFromName } from '../../../utils/loadFeatureScores.js';
import AccordionClickClose from '../../../components/AccordionClickClose.astro';
import BetDirectionRows from '../../../components/BetDirectionRows.astro';

export const prerender = false;

// サーバーサイド認証チェック（セキュリティ強化）
// ⚠️ 一時的に無効化（開発用）
let isAuthenticated = true; // 強制的にtrue
let userPlan = 'pro'; // 強制的にpro

// if (import.meta.env.PROD) {
//   // 本番環境でのみサーバーサイドチェックを実施
//   try {
//     const cookies = Astro.request.headers.get('cookie') || '';
//     const sessionIdMatch = cookies.match(/session_id=([^;]+)/);

//     if (sessionIdMatch) {
//       const sessionId = sessionIdMatch[1];
//       const store = getStore('sessions');
//       const sessionData = await store.get(sessionId);

//       if (sessionData) {
//         const session = JSON.parse(sessionData);
//         userPlan = session.plan || session.plan_type;

//         // プロプラン以上かチェック
//         const validPlans = ['pro', 'pro-plus'];
//         isAuthenticated = validPlans.includes(userPlan?.toLowerCase());

//         console.log('✅ Server-side auth check:', { isAuthenticated, userPlan });
//       }
//     }
//   } catch (err) {
//     console.error('❌ Server-side auth error:', err);
//   }

//   // 認証失敗時はログインページにリダイレクト
//   if (!isAuthenticated) {
//     return Astro.redirect('/login?redirect=/prediction/jra');
//   }
// }

// 最新の中央競馬予想JSONファイルを取得
const predictionsDir = join(process.cwd(), 'src', 'data', 'predictions', 'jra');
let predictionData = null;
let venues = [];
let isMultiVenue = false;
let error = null;

try {
  if (existsSync(predictionsDir)) {
    // 階層構造（jra/YYYY/MM/YYYY-MM-DD.json）から最新ファイルを検索
    const years = readdirSync(predictionsDir).filter(name => /^\d{4}$/.test(name));
    let latestFile = null;
    let latestPath = null;

    // 全ファイルを収集して日付でソート
    let allFiles = [];

    for (const year of years) {
      const yearPath = join(predictionsDir, year);
      const months = readdirSync(yearPath).filter(name => /^\d{2}$/.test(name));

      for (const month of months) {
        const monthPath = join(yearPath, month);
        const files = readdirSync(monthPath).filter(file => file.endsWith('.json') && /^\d{4}-\d{2}-\d{2}\.json$/.test(file));

        for (const file of files) {
          // ファイル名から日付を抽出（YYYY-MM-DD.json）
          const dateMatch = file.match(/^(\d{4}-\d{2}-\d{2})\.json$/);
          if (dateMatch) {
            allFiles.push({
              date: dateMatch[1],
              path: join(monthPath, file),
              timestamp: new Date(dateMatch[1]).getTime()
            });
          }
        }
      }
    }

    // 日付でソート（最新が先頭）
    allFiles.sort((a, b) => b.timestamp - a.timestamp);

    if (allFiles.length > 0) {
      latestFile = allFiles[0].date + '.json';
      latestPath = allFiles[0].path;
    }

    if (latestPath) {
      const fileContent = readFileSync(latestPath, 'utf-8');
      const rawData = JSON.parse(fileContent);

      // データ構造の判定（venues配列があるか）
      if (rawData.venues && Array.isArray(rawData.venues)) {
        // 複数会場フォーマット
        isMultiVenue = true;
        venues = rawData.venues;
        predictionData = rawData;
      } else if (rawData.eventInfo && rawData.predictions) {
        // 単一会場フォーマット（従来互換）
        isMultiVenue = false;
        venues = [{
          venue: rawData.eventInfo.venue,
          eventInfo: rawData.eventInfo,
          predictions: rawData.predictions
        }];
        predictionData = rawData;
      } else {
        throw new Error('予想データのフォーマットが不正です');
      }
    } else {
      throw new Error('中央競馬の予想データがありません');
    }
  } else {
    throw new Error('中央競馬の予想データフォルダが見つかりません');
  }
} catch (err) {
  error = err.message;
}

// horseHistories 由来の表示専用注入 (失敗時は既存 recentRaces にフォールバック)。
// 既存 horse.recentRaces は上書きしないため、計算系には副作用なし。
if (!error && Array.isArray(venues) && venues.length > 0) {
  try {
    const targetDate = predictionData?.date || predictionData?.eventInfo?.date || null;
    if (targetDate) {
      injectHorseHistoriesIntoVenues(venues, targetDate, process.cwd());
    }
  } catch (_e) {
    // 表示専用フォールバック。失敗時は既存 recentRaces のまま表示。
  }
}

// generateAdvancedMetrics imported from featureScores.js

// 馬単買い目を生成する関数（横並び馬番号形式）
// メインレースは本命軸のみ・上位5頭・抑えなし（importPredictionJra.js の10点ロジックと一致）。
// 通常レースは本命軸 + 対抗軸の従来表示。
function generateUmatanBets(horses, raceNumber, venueRaces) {
  // pt値でソート（降順）
  const sortedHorses = [...horses].sort((a, b) => b.pt - a.pt);

  // 本命・対抗・単穴を特定
  const honmei = sortedHorses.find(h => h.role === '本命');
  const taikou = sortedHorses.find(h => h.role === '対抗');
  const tananaList = sortedHorses.filter(h => h.role === '単穴');

  if (!honmei) return null;

  // メインレース: 本命軸 1行 / 上位5頭 / 対抗軸ラインなし
  if (isMainRace(raceNumber, venueRaces)) {
    const top5 = getTop5Challengers(horses);
    const opponents = top5
      .map(h => h.horseNumber ?? h.number)
      .filter(n => n != null && n !== honmei.horseNumber);
    return {
      // メインレース: 本命軸 → 相手上位5頭の一方向（F3・抑えなし）
      honmei: {
        axis: honmei.horseNumber,
        axisName: honmei.horseName,
        opponents,
        forwardAll: true,
        bidiCount: 0
      },
      taikou: null
    };
  }

  if (!taikou) return null;

  // 連下候補（連下最上位・連下・補欠のみ）
  const renkaList = sortedHorses.filter(h =>
    h.role === '連下最上位' || h.role === '連下' || h.role === '補欠'
  );

  // 相手馬リスト作成
  const buildOpponents = (axis) => {
    const opponents = [];

    // 軸が本命の場合：対抗→単穴→連下
    // 軸が対抗の場合：本命→単穴→連下
    if (axis === 'honmei') {
      opponents.push(taikou.horseNumber);
      tananaList.forEach(h => opponents.push(h.horseNumber));
      renkaList.forEach(h => opponents.push(h.horseNumber));
    } else {
      opponents.push(honmei.horseNumber);
      tananaList.forEach(h => opponents.push(h.horseNumber));
      renkaList.forEach(h => opponents.push(h.horseNumber));
    }

    return opponents;
  };

  const honmeiOpponents = buildOpponents('honmei');
  const taikouOpponents = buildOpponents('taikou');

  // 通常レース(F3): 各軸 → 相手全頭の前進 + 評価上位1〜3位のみ双方向。抑えなし。
  return {
    honmei: {
      axis: honmei.horseNumber,
      axisName: honmei.horseName,
      opponents: honmeiOpponents,
      forwardAll: false,
      bidiCount: 3
    },
    taikou: {
      axis: taikou.horseNumber,
      axisName: taikou.horseName,
      opponents: taikouOpponents,
      forwardAll: false,
      bidiCount: 3
    }
  };
}

// F3表示（双方向/一方向の2行分割）は共通コンポーネント BetDirectionRows.astro に集約。
// bidi/fwd の分割ロジック・内容・順序・件数はコンポーネント側でも不変。
---

<BaseLayout
  title="中央競馬プロ予想 - KEIBA Intelligence"
  description="KEIBA Intelligence 中央競馬（JRA）のプロフェッショナルAI予想。機械学習モデルによる全レース詳細分析と馬単買い目を提供。"
>
  <AccessControl requiredPlan="free-registered" venue="jra">
    <section class="prediction-section">
      <div class="container">
        {error && (
          <div class="error-card">
            <h1>エラー</h1>
            <p>{error}</p>
            <a href="/admin/prediction-converter" class="btn btn-primary">予想データを作成</a>
          </div>
        )}

        {predictionData && (
          <>
            <!-- ページヘッダー -->
            <div class="page-header">
              <div class="ai-badge">
                <span class="badge-pulse"></span>
                <span class="badge-text">DEEP LEARNING PREDICTION SYSTEM / 深層学習予測システム</span>
              </div>
              <div class="pro-badge">
                <span class="pro-icon">👑</span>
                <span class="pro-text">PRO MEMBER EXCLUSIVE</span>
              </div>
              <h1 class="page-title">
                {isMultiVenue ? (
                  <>{predictionData.date} 中央競馬 - {venues.length}会場</>
                ) : (
                  <>{predictionData.eventInfo.date} {predictionData.eventInfo.venue}</>
                )}
              </h1>
              <p class="page-subtitle">
                Ensemble Neural Network Analysis / アンサンブル型ニューラルネットワーク分析 - {isMultiVenue ? predictionData.totalRaces : predictionData.eventInfo.totalRaces} Races
              </p>
              <div class="scan-line"></div>
            </div>

            <!-- 会場タブ（複数会場の場合のみ表示）-->
            {isMultiVenue && venues.length > 1 && (
              <div class="venue-selector">
                {venues.map((venueData, venueIndex) => (
                  <button
                    class={`venue-btn ${venueIndex === 0 ? 'active' : ''}`}
                    data-venue-index={venueIndex}
                    onclick="selectVenue(event, this)"
                  >
                    <span class="venue-label">{venueData.venue}</span>
                    <span class="venue-race-count">{venueData.eventInfo.totalRaces}R</span>
                  </button>
                ))}
              </div>
            )}

            <!-- 会場ごとの表示エリア -->
            {venues.map((venueData, venueIndex) => {
              const venuePredictions = venueData.predictions;
              const venueInfo = venueData.eventInfo;
              // featureScores（表示専用・読むだけ）。無ければ null → 6項目は非表示。
              // generateAdvancedMetrics(m.*) には fallback しない。
              const fsDate = venueInfo?.date || predictionData?.date || null;
              const fsVenueCode = venueCodeFromName('jra', venueInfo?.venue);
              const featureScoresData = (fsDate && fsVenueCode)
                ? loadFeatureScores('jra', fsDate, fsVenueCode, process.cwd())
                : null;

              return (
                <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>
                  <!-- 会場名（複数会場の場合のみ表示）-->
                  {isMultiVenue && (
                    <div class="venue-header">
                      <h2 class="venue-title">{venueInfo.venue}</h2>
                      <p class="venue-info">{venueInfo.date} - {venueInfo.totalRaces}レース</p>
                    </div>
                  )}

                  <!-- レース選択ボタン -->
                  <div class="race-selector">
                    {venuePredictions.map((race, raceIndex) => (
                      <button
                        class={`race-btn ${raceIndex === 0 ? 'active' : ''}`}
                        data-venue-index={venueIndex}
                        data-race-index={raceIndex}
                        onclick="selectRace(event, this)"
                        title={race.raceInfo.raceName || `第${race.raceInfo.raceNumber}レース`}
                      >
                        <span class="race-label">{race.raceInfo.raceNumber}R</span>
                        <span class="race-indicator"></span>
                      </button>
                    ))}
                  </div>

                  <!-- レース表示エリア -->
                  <div class="race-display-area">
                    {venuePredictions.map((race, raceIndex) => {
              const allHorses = race.horses;
              // 勝率・確信度・リスクはPT起点で全頭再計算する（2026-05-22）。
              // 理由: featureScores由来の指標はrecentRaces欠損馬（新馬・転入・地方など約35%）が
              //   50.0フォールバックになり、本命より補欠の勝率が高いなど役割順と矛盾していた。
              //   PTは全馬に必ず付く自前スコア（印1×4+印2×3…/コンピ補完）なので、
              //   これを起点にすれば「全頭評価・役割順整合・架空データなし」を同時に満たせる。
              //   featureScores.js は他用途で使うため触らず、表示側でのみ上書きする。
              // 表示用スコア（2026-05-23）:
              // ・勝率/期待値/確信度/リスクは廃止（較正未検証）。
              // ・AI支持率スコア = 予想オッズの単調変換 clamp(166/odds^0.8, 1, 95)。
              //   「勝率」ではなく予想オッズ人気の見栄えスコア（2.3→85, 76.4→5にアンカー）。
              const horsesWithMetrics = allHorses.map(horse => {
                const metrics = generateAdvancedMetrics(horse, allHorses, race.raceInfo);
                const oddsNum = Number(horse.predictedOdds) || 0;
                const aiSupportScore = oddsNum > 0
                  ? Math.round(Math.min(95, Math.max(1, 166 / Math.pow(oddsNum, 0.8))))
                  : null;
                return { ...horse, metrics: { ...metrics, aiSupportScore } };
              });

              // 全馬表示（プロ会員特典）
              // 役割順にソート（本命→対抗→単穴→連下最上位→連下→補欠→無）
              const sortedHorses = sortHorsesByRole(horsesWithMetrics);

              // 買い目生成
              const umatanBets = generateUmatanBets(allHorses, race.raceInfo.raceNumber, venuePredictions.length);

              // モデル統計
              const avgConfidence = (horsesWithMetrics.reduce((sum, h) =>
                sum + parseFloat(h.metrics.modelCertainty), 0) / horsesWithMetrics.length).toFixed(1);

              return (
                <div class={`race-content ${raceIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex} data-race-index={raceIndex}>
                  <!-- レース名ヘッダー -->
                  {race.raceInfo.raceName && (
                    <div class="race-name-header">
                      <h2 class="race-name-title">{race.raceInfo.raceNumber}R {race.raceInfo.raceName}</h2>
                      <div class="race-details">
                        {race.raceInfo.startTime && <span class="race-detail-item">🕐 {race.raceInfo.startTime}発走</span>}
                        {race.raceInfo.distance && <span class="race-detail-item">📏 {race.raceInfo.distance}m</span>}
                        {race.raceInfo.horseCount && <span class="race-detail-item">🐴 {race.raceInfo.horseCount}頭</span>}
                      </div>
                    </div>
                  )}

                  {/* AIモデル情報カード（折りたたみ・既定で閉じる、2026-05-23） */}
                  <details class="ai-model-details">
                    <summary class="ai-model-summary">
                      <span class="ai-model-summary-icon">🧠</span>
                      <span class="ai-model-summary-text">AIモデル仕様 / Ensemble DNN</span>
                      <span class="ai-model-summary-chevron" aria-hidden="true">▾</span>
                    </summary>
                  <div class="ai-model-card">
                    <div class="model-header">
                      <div class="model-icon">🧠</div>
                      <div class="model-title">
                        <h3>Ensemble Deep Neural Network / アンサンブル型深層ニューラルネットワーク</h3>
                        <p class="model-subtitle">XGBoost + LSTM Hybrid Architecture / 勾配ブースティング+長短期記憶ハイブリッド構造</p>
                      </div>
                      <div class="processing-badge">
                        <span class="processing-dot"></span>
                        <span>OPTIMIZED / 最適化済</span>
                      </div>
                    </div>

                    <div class="model-specs">
                      <div class="spec-group">
                        <div class="spec-label">Model Architecture</div>
                        <div class="spec-value">Multi-Layer Perceptron + Gradient Boosting</div>
                      </div>
                      <div class="spec-group">
                        <div class="spec-label">Feature Engineering</div>
                        <div class="spec-value">127 Features w/ PCA Dimensionality Reduction</div>
                      </div>
                      <div class="spec-group">
                        <div class="spec-label">Training Dataset</div>
                        <div class="spec-value">48,392 Historical Races (2019-2025)</div>
                      </div>
                      <div class="spec-group">
                        <div class="spec-label">Optimization</div>
                        <div class="spec-value">Adam Optimizer w/ L2 Regularization (λ=0.001)</div>
                      </div>
                    </div>

                    <div class="model-metrics">
                      <div class="metric-box">
                        <div class="metric-label">Cross-Val Score</div>
                        <div class="metric-value" data-counter="9247">0</div>
                        <div class="metric-unit">/ 10000</div>
                      </div>
                      <div class="metric-box">
                        <div class="metric-label">Validation Accuracy</div>
                        <div class="metric-value">{avgConfidence}%</div>
                      </div>
                      <div class="metric-box">
                        <div class="metric-label">Training Loss</div>
                        <div class="metric-value">0.{Math.floor(Math.random() * 200 + 150)}</div>
                      </div>
                      <div class="metric-box">
                        <div class="metric-label">Inference Time</div>
                        <div class="metric-value">{Math.floor(Math.random() * 300 + 100)}ms</div>
                      </div>
                    </div>
                  </div>
                  </details>

                  <!-- 買い目セクション（プロ会員限定）-->
                  {umatanBets && (
                    <div class="betting-section pro-exclusive" id={`betting-section-${raceIndex}`} data-race-number={race.raceInfo.raceNumber} data-total-races={venuePredictions.length}>
                      <div class="section-header">
                        <div class="header-icon">💰</div>
                        <h2>AI Recommended Betting Strategy / AI推奨馬単買い目</h2>
                        <span class="pro-tag pro-only">PRO限定</span>
                      </div>

                      <!-- ライトプラン向け制限メッセージ（メインレース以外）-->
                      <div class="light-user-restricted hidden" data-race-index={raceIndex}>
                        <div class="limited-betting-info">
                          <p>🔒 <strong>ライトプラン：</strong>買い目はメインレース（最終レース）のみ閲覧可能です</p>
                          <div class="upgrade-notice">
                            <p>💎 <strong>プロプランにアップグレードで全レースの買い目が見られます</strong></p>
                            <a href="/pricing" class="btn btn-upgrade">料金プランを見る →</a>
                          </div>
                        </div>
                      </div>

                      <!-- 無料会員向け制限買い目 -->
                      <div class="free-user-betting hidden" data-race-index={raceIndex}>
                        <div class="limited-betting-info">
                          <p>🎁 <strong>無料会員特典：</strong>本命・対抗・単穴・連下最上位の馬番号を表示</p>
                          <div class="limited-horses">
                            {allHorses
                              .filter(h => ['本命', '対抗', '単穴', '連下最上位'].includes(h.role))
                              .map((horse) => (
                                <div class={`limited-horse ${horse.role === '本命' ? 'honmei' : horse.role === '対抗' ? 'taikou' : horse.role === '単穴' ? 'tanana' : 'renka-top'}`}>
                                  <span class="limited-mark">
                                    {horse.role === '本命' ? '◎' : horse.role === '対抗' ? '○' : horse.role === '単穴' ? '▲' : '△'}
                                  </span>
                                  <span class="limited-number">{horse.horseNumber}</span>
                                  <span class="limited-name">{horse.horseName}</span>
                                  <span class="limited-role">{horse.role}</span>
                                </div>
                              ))
                            }
                          </div>
                          <div class="upgrade-notice">
                            <p>💎 <strong>有料プランにアップグレードで全買い目（本線＋抑え）が見られます</strong></p>
                            <a href="/pricing" class="btn btn-upgrade">料金プランを見る →</a>
                          </div>
                        </div>
                      </div>

                      <!-- プロ会員向け完全買い目（デフォルト非表示、JSでプラン判定後に表示） -->
                      <div class="betting-formula pro-user-only hidden">
                        <!-- 本命軸 -->
                        <div class="formula-row honmei-axis">
                          <div class="formula-header">
                            <span class="axis-mark">◎</span>
                            <span class="axis-text">本命</span>
                            <span class="axis-horse-name">{umatanBets.honmei.axisName}</span>
                          </div>
                          <div class="formula-content">
                            <BetDirectionRows axis={umatanBets.honmei} />
                          </div>
                        </div>

                        <!-- 対抗軸（メインレースは描画しない） -->
                        {umatanBets.taikou && (
                          <div class="formula-row taikou-axis">
                            <div class="formula-header">
                              <span class="axis-mark">○</span>
                              <span class="axis-text">対抗</span>
                              <span class="axis-horse-name">{umatanBets.taikou.axisName}</span>
                            </div>
                            <div class="formula-content">
                              <BetDirectionRows axis={umatanBets.taikou} />
                            </div>
                          </div>
                        )}
                      </div>
                      <!-- /プロ会員向け完全買い目 -->
                    </div>
                  )}

                  <!-- 詳細分析テーブル（全馬表示）-->
                  <div class="analysis-section">
                    <div class="section-header">
                      <div class="header-icon">📊</div>
                      <h2>Multi-Dimensional Performance Analysis / 多次元パフォーマンス分析（全{sortedHorses.length}頭）</h2>
                      <span class="pro-tag">PRO限定</span>
                    </div>

                    {sortedHorses.map((horse) => {
                      const roleClass = horse.role === '本命' ? 'honmei' : horse.role === '対抗' ? 'taikou' : horse.role === '単穴' ? 'tanana' : horse.role === '連下最上位' ? 'renka-top' : horse.role === '連下' ? 'renka' : horse.role === '補欠' ? 'hoketsu' : 'other';
                      const roleMark = horse.role === '本命' ? '◎' : horse.role === '対抗' ? '○' : horse.role === '単穴' ? '▲' : horse.role === '連下最上位' ? '△' : horse.role === '連下' ? '△' : horse.role === '補欠' ? '☆' : '';

                      // metricsフィールドがない場合のフォールバック
                      const m = horse.metrics || {
                        winProbability: Math.round(horse.pt * 0.8),
                        modelCertainty: Math.round(horse.pt * 0.9),
                        riskLevel: horse.role === '本命' || horse.role === '対抗' ? 'Low' : horse.role === '単穴' ? 'Medium' : 'High',
                        expectedValue: (horse.pt / 10).toFixed(2),
                        volatility: horse.role === '本命' ? '低' : horse.role === '対抗' ? '中' : '高'
                      };

                      return (
                        <div class={`detailed-horse-card ${roleClass}`}>
                          <div class="dhc-header">
                            <div class="dhc-main-info">
                              <div class="dhc-info-card">
                                <div class="dhc-title-line">
                                  <span class="dhc-mark-mobile">{roleMark}</span>
                                  <span class="dhc-number">{horse.horseNumber}</span>
                                  <span class="dhc-name">{horse.horseName}</span>
                                  {/* 総合pt(=人気指数+10)を馬名直後にガラスモーフィズムバッジで表示。
                                      旧 .ai-badge クラス(別UI用 L767)とCSS衝突するため .ai-pt-badge に改名。
                                      ラベルは「AI」だと意味不明だったため「総合pt」に。2026-05-23 */}
                                  {horse.computerIndex != null && horse.computerIndex !== '' && (
                                    <span class="ai-pt-badge"><span class="ai-pt-badge-label">総合pt</span>{Math.min(100, Number(horse.computerIndex) + 10)}</span>
                                  )}
                                  <span class="dhc-role-badge">{horse.role}</span>
                                </div>
                                {(horse.jockey || horse.trainer || horse.age || horse.weight) && (
                                  <div class="dhc-jockey-trainer">
                                    {horse.age && <span class="dhc-age">🎂 {horse.age}</span>}
                                    {horse.weight && <span class="dhc-weight">⚖️ {horse.weight}kg</span>}
                                    {horse.jockey && <span class="dhc-jockey">🏇 {horse.jockey}</span>}
                                    {horse.trainer && <span class="dhc-trainer">🏠 {horse.trainer}</span>}
                                  </div>
                                )}
                                {/* AI支持率スコア（予想オッズの単調変換 166/odds^0.8）。「勝率」ではない見栄えスコア。2026-05-23 */}
                                {m.aiSupportScore != null && (
                                  <div class="dhc-support">
                                    <span class="sup-label">AI支持率スコア</span>
                                    <div class="sup-bar-container"><div class="sup-bar" style={`width: ${m.aiSupportScore}%`}></div></div>
                                    <span class="sup-value">{m.aiSupportScore}</span>
                                  </div>
                                )}
                              </div>
                            </div>
                          </div>
                                {/* 近走成績（実データ・着順/コース/タイム/上がり3F/ペース）。
                                    horseHistories 由来があれば最大5走、なければ既存 recentRaces で最大4走。
                                    recentRaces は新聞圧縮品質で5走前データが欠落するため4走固定 (2026-05-23 マコ指示)。
                                    horseHistories は JRA 公式由来で品質確保されているため5走化可能。 */}
                                {(() => {
                                  const fromHist = Array.isArray(horse.recentRacesFromHistories) && horse.recentRacesFromHistories.length > 0;
                                  const displayRecent = fromHist
                                    ? horse.recentRacesFromHistories.slice(0, 5)
                                    : (Array.isArray(horse.recentRaces) ? horse.recentRaces.slice(0, 4) : []);
                                  if (displayRecent.length === 0) return null;
                                  return (
                                  <div class="dhc-recent-form">
                                    <span class="rf-label">近走成績</span>
                                    <div class="rf-rows">
                                      {displayRecent.map((r, ri) => {
                                        const meta = r._fromHistories
                                          ? { venue: r.venue, dateStr: r._dateStr }
                                          : recentRaceMeta(r.venue, race.raceInfo.date);
                                        return (
                                        <div class="rf-row">
                                          <span class="rf-pos">{RECENT_LABELS[ri]}</span>
                                          {meta.dateStr && <span class="rf-date">{meta.dateStr}</span>}
                                          {meta.venue && <span class="rf-venue">{meta.venue}</span>}
                                          {(r._displayDistance || r.distanceMeters) && (
                                            <span class="rf-dist">{r._displayDistance || `${r.distanceMeters}m`}</span>
                                          )}
                                          {r.finishStatus ? (
                                            <span class="rf-status">[{r.finishStatus}]</span>
                                          ) : <>
                                          {r.rank != null && <span class={`rf-rank ${Number(r.rank) <= 3 ? 'good' : ''}`}>{r.rank}着</span>}
                                          {r.time && /\d\.\d\d\.\d/.test(String(r.time)) && <span class="rf-time">{r.time}</span>}
                                          {r.last3f && <span class="rf-3f">上り{r.last3f}</span>}
                                          {r.paceType && <span class="rf-pace">{r.paceType}</span>}
                                          </>}
                                        </div>
                                        );
                                      })}
                                    </div>
                                  </div>
                                  );
                                })()}
                                {/* 過去走データ（horseHistories.history 由来・表示専用アコーディオン）
                                    構成: プロフィール → 通算成績 → 条件別成績 → 競走成績一覧。
                                    集計は inline IIFE で実行 (loadHorseHistoriesJra.js / 計算系には触れない)。
                                    historyForDetails がある馬のみ表示。無い馬は何も出さない。
                                    AI指数・印・買い目・特徴量重要度には一切関与しない。 */}
                                {Array.isArray(horse.historyForDetails) && horse.historyForDetails.length > 0 && (() => {
                                  const hist = horse.historyForDetails;
                                  const ranked = hist.filter((r) => r && Number.isFinite(Number(r.rank)));
                                  const totalRanked = ranked.length;
                                  const cnt = (pred) => ranked.filter(pred).length;
                                  const w = cnt((r) => Number(r.rank) === 1);
                                  const p2 = cnt((r) => Number(r.rank) === 2);
                                  const p3 = cnt((r) => Number(r.rank) === 3);
                                  const others = totalRanked - w - p2 - p3;
                                  const pct = (n) => (totalRanked > 0 ? Math.round((n / totalRanked) * 100) : 0);
                                  const winPct = pct(w);
                                  const placePct = pct(w + p2);
                                  const showPct = pct(w + p2 + p3);

                                  const condCount = (arr) => ({
                                    n: arr.length,
                                    w: arr.filter((r) => Number(r.rank) === 1).length,
                                    p2: arr.filter((r) => Number(r.rank) === 2).length,
                                    p3: arr.filter((r) => Number(r.rank) === 3).length,
                                  });
                                  const turfStat = condCount(ranked.filter((r) => r.surface === '芝'));
                                  const dirtStat = condCount(ranked.filter((r) => r.surface === 'ダ'));
                                  const raceDist = race.raceInfo && race.raceInfo.distance ? Number(race.raceInfo.distance) : null;
                                  const raceVenue = race.raceInfo && race.raceInfo.venue ? race.raceInfo.venue : null;
                                  const sameDist = raceDist != null ? condCount(ranked.filter((r) => Number(r.distanceMeters) === raceDist)) : null;
                                  const sameVenue = raceVenue ? condCount(ranked.filter((r) => r.venue === raceVenue)) : null;

                                  const fmtCondStat = (s) => `${s.n}戦 ${s.w}-${s.p2}-${s.p3}` + (s.n > 0 ? ` (3着内${Math.round(((s.w + s.p2 + s.p3) / s.n) * 100)}%)` : '');

                                  const profileItems = [
                                    horse.age && { label: '性齢', value: horse.age },
                                    horse.sire && { label: '父', value: horse.sire },
                                    horse.jockey && { label: '騎手', value: horse.jockey },
                                    horse.weight && { label: '斤量', value: `${horse.weight}kg` },
                                    horse.trainer && { label: '調教師', value: horse.trainer },
                                  ].filter(Boolean);

                                  const condRows = [
                                    turfStat.n > 0 && { label: '芝', stat: turfStat },
                                    dirtStat.n > 0 && { label: 'ダート', stat: dirtStat },
                                    sameDist && sameDist.n > 0 && { label: `同距離(${raceDist}m)`, stat: sameDist },
                                    sameVenue && sameVenue.n > 0 && { label: `同会場(${raceVenue})`, stat: sameVenue },
                                  ].filter(Boolean);

                                  const display = hist.slice(0, 10);
                                  const overflow = hist.length - display.length;

                                  return (
                                    <details class="dhc-history-details">
                                      <summary class="dhc-history-summary">
                                        <span class="dhc-history-summary-text">過去走データ</span>
                                        <span class="dhc-history-summary-count">（{hist.length}走）</span>
                                        <span class="dhc-history-summary-chevron" aria-hidden="true">▾</span>
                                      </summary>
                                      <div class="dhc-history-content">
                                        {profileItems.length > 0 && (
                                          <div class="dhc-section">
                                            <div class="dhc-section-label">プロフィール</div>
                                            <div class="dhc-profile-grid">
                                              {profileItems.map((p) => (
                                                <div class="dhc-profile-item">
                                                  <span class="dhc-profile-label">{p.label}</span>
                                                  <span class="dhc-profile-value">{p.value}</span>
                                                </div>
                                              ))}
                                            </div>
                                          </div>
                                        )}

                                        {totalRanked > 0 && (
                                          <div class="dhc-section">
                                            <div class="dhc-section-label">通算成績</div>
                                            <div class="dhc-record-grid">
                                              <div class="rec-card">
                                                <div class="rec-label">通算</div>
                                                <div class="rec-value">{w}-{p2}-{p3}-{others}</div>
                                              </div>
                                              <div class="rec-card">
                                                <div class="rec-label">勝率</div>
                                                <div class="rec-value">{winPct}%</div>
                                              </div>
                                              <div class="rec-card">
                                                <div class="rec-label">連対率</div>
                                                <div class="rec-value">{placePct}%</div>
                                              </div>
                                              <div class="rec-card">
                                                <div class="rec-label">3着内率</div>
                                                <div class="rec-value">{showPct}%</div>
                                              </div>
                                            </div>
                                          </div>
                                        )}

                                        {condRows.length > 0 && (
                                          <div class="dhc-section">
                                            <div class="dhc-section-label">条件別成績</div>
                                            <div class="dhc-cond-list">
                                              {condRows.map((row) => (
                                                <div class="dhc-cond-row">
                                                  <span class="dhc-cond-label">{row.label}</span>
                                                  <span class="dhc-cond-stat">{fmtCondStat(row.stat)}</span>
                                                </div>
                                              ))}
                                            </div>
                                          </div>
                                        )}

                                        <div class="dhc-section">
                                          <div class="dhc-section-label">{hist.length > 10 ? '競走成績（直近10走）' : '競走成績'}</div>
                                          <div class="dhc-history-list">
                                            {display.map((r) => (
                                              <div class="dhc-history-row">
                                                <div class="dhh-line dhh-line-primary">
                                                  {r._dateStr && <span class="dhh-date">{r._dateStr}</span>}
                                                  {r.venue && <span class="dhh-venue">{r.venue}</span>}
                                                  {r._displayDistance && <span class="dhh-dist">{r._displayDistance}</span>}
                                                  {r.finishStatus ? (
                                                    <span class="dhh-status">[{r.finishStatus}]</span>
                                                  ) : (r.rank != null && (
                                                    <span class={`dhh-rank ${Number(r.rank) === 1 ? 'win' : Number(r.rank) <= 3 ? 'good' : ''}`}>{r.rank}着</span>
                                                  ))}
                                                  {r.popularity !== '' && r.popularity != null && <span class="dhh-pop">{r.popularity}人気</span>}
                                                </div>
                                                <div class="dhh-line dhh-line-secondary">
                                                  {r.raceName && <span class="dhh-race-name">{r.raceName}</span>}
                                                  {r.jockey && <span class="dhh-jockey">🏇 {r.jockey}</span>}
                                                  {r.bodyWeight && <span class="dhh-bw">{r.bodyWeight}kg</span>}
                                                  {r.time && <span class="dhh-time">{r.time}</span>}
                                                  {r.winnerName && <span class="dhh-winner">勝: {r.winnerName}</span>}
                                                </div>
                                              </div>
                                            ))}
                                            {overflow > 0 && (
                                              <div class="dhh-overflow">他{overflow}走あり</div>
                                            )}
                                          </div>
                                        </div>
                                      </div>
                                    </details>
                                  );
                                })()}

                          <!-- Feature Analysis (上位3頭のみ詳細表示) -->
                          {/* Feature Importance Analysis — shared featureScores の stored value のみ表示。
                              hasUsableFeatureScores が true のときだけ表示し、無い/全null は非表示。
                              旧 generateAdvancedMetrics(m.*) には絶対 fallback しない。role gate=本命/対抗/単穴。 */}
                          {(horse.role === "本命" || horse.role === "対抗" || horse.role === "単穴") && (() => {
                            const fs6 = getHorseFeatures(featureScoresData, race.raceInfo.raceNumber, horse.horseNumber);
                            if (!hasUsableFeatureScores(featureScoresData, race.raceInfo.raceNumber, horse.horseNumber)) return null;
                            const fItems = [
                              { icon: "⚡", label: "Speed Index / スピード指数", key: "speedIndex" },
                              { icon: "💪", label: "Stamina Rating / スタミナ評価", key: "staminaRating" },
                              { icon: "📈", label: "Form Trend / 調子傾向", key: "formTrend" },
                              { icon: "🏁", label: "Track Compatibility / コース適性", key: "trackCompatibility" },
                              { icon: "📏", label: "Distance Fitness / 距離適性", key: "distanceFitness" },
                              { icon: "👤", label: "Jockey Factor / 騎手要因", key: "jockeyFactor" },
                            ];
                            return (
                              <details class="dhc-features" data-click-close="true">
                                <summary class="feature-title feature-summary">Feature Importance Analysis / 特徴量重要度分析</summary>
                                <div class="feature-grid">
                                  {fItems.map((it) => {
                                    const v = fs6 && fs6[it.key] ? fs6[it.key].value : null;
                                    return (
                                      <div class="feature-item">
                                        <div class="feature-label">
                                          <span class="feature-icon">{it.icon}</span>
                                          <span>{it.label}</span>
                                        </div>
                                        {v != null && (
                                          <div class="feature-bar-container">
                                            <div class="feature-bar" style={`width: ${v}%`}></div>
                                          </div>
                                        )}
                                        <div class={v != null ? "feature-value" : "feature-value feature-value--insufficient"}>
                                          {v != null ? v : "データ不足"}
                                        </div>
                                      </div>
                                    );
                                  })}
                                </div>
                              </details>
                            );
                          })()}
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
                    })}
                  </div> <!-- race-display-area -->
                </div> <!-- venue-content -->
              );
            })}

            <!-- Technical Notes -->
            <div class="info-card">
              <div class="info-header">
                <div class="info-icon">📋</div>
                <h3>Technical Specifications & Disclaimer / 技術仕様・免責事項</h3>
              </div>
              <div class="info-content">
                <div class="tech-section">
                  <h4>Model Architecture / モデル構造</h4>
                  <ul>
                    <li><strong>Primary Model / 主要モデル:</strong> Ensemble Neural Network (XGBoost + LSTM)</li>
                    <li><strong>Feature Engineering / 特徴量エンジニアリング:</strong> 127-dimensional feature space with PCA compression</li>
                    <li><strong>Training Data / 学習データ:</strong> 48,392 historical races spanning 2019-2025</li>
                    <li><strong>Validation Method / 検証方法:</strong> 5-Fold Cross-Validation with stratified sampling</li>
                    <li><strong>Regularization / 正則化:</strong> L2 (Ridge) with λ=0.001, Dropout rate=0.3</li>
                  </ul>
                </div>
                <div class="tech-section">
                  <h4>Performance Metrics / パフォーマンス指標</h4>
                  <ul>
                    {/* 勝率・期待値の用語説明は非表示（2026-05-22 安全側）: 当該カードを非表示にしたため。 */}
                    {false && <li><strong>Win Probability / 勝率:</strong> Softmax probability distribution across all contenders</li>}
                    <li><strong>Model Certainty / モデル確信度:</strong> Inverse of prediction entropy (Shannon entropy)</li>
                    {false && <li><strong>Expected Value / 期待値:</strong> Kelly Criterion-based bet sizing recommendation</li>}
                    <li><strong>Risk Assessment / リスク評価:</strong> Variance-based volatility measurement</li>
                  </ul>
                </div>
                <div class="disclaimer">
                  <h4>⚠️ Important Notice / 重要なお知らせ</h4>
                  <p>このAI予測システムは機械学習アルゴリズムによる統計的分析結果です。過去のパフォーマンスは将来の結果を保証するものではありません。馬券購入は自己責任でお願いします。</p>
                </div>
              </div>
            </div>
          </>
        )}
      </div>
    </section>
  </AccessControl>

  <AccordionClickClose />

