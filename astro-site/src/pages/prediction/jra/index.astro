---
/**
 * /prediction/jra — 中央競馬の予想（全 tier 共通の紙面）
 *
 * 正本: docs/RENEWAL_2026_08.md
 *
 * 🔴 2026-08-28 全面改修。南関側と同じ `RaceDayBoard` を共有する
 *    （片肺修正による退行の防止。docs/ui-cross-plan-regression-policy.md）。
 *    旧実装の監査事項 A-1 / A-5（買い目のサーバー描画・認証ハードコード）を是正済み。
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceDayBoard from '../../../components/newspaper/RaceDayBoard.astro';
import TierRibbon from '../../../components/newspaper/TierRibbon.astro';
import { loadJraRaceDay } from '../../../lib/prediction/loadRaceDay.js';
import { entitlementFromAstro, viewFlags } from '../../../lib/auth/entitlement.js';

export const prerender = false;

const entitlement = entitlementFromAstro(Astro, { venue: 'jra' });
const view = viewFlags(entitlement);

const day = loadJraRaceDay(process.cwd());

const venueNames = day.venues.map((v) => v.venueName).join('・');
const title = day.date
  ? `${venueNames || '中央競馬'}の予想（${day.date}） - KEIBA Intelligence`
  : '中央競馬 AI予想 - KEIBA Intelligence';
const description = '中央競馬（JRA）全10場の全レース馬柱・過去走・AI短評・展開予想を無料公開。印（◎○▲△）は無料会員、AI指数の数値と馬単買い目は有料プランで提供しています。';
---

<BaseLayout title={title} description={description}>
  <div class="container prediction-page">
    <TierRibbon view={view} />
    <RaceDayBoard day={day} view={view} category="jra" />

    <section class="pp-foot">
      <h2 class="pp-foot-title">KEIBA Intelligence の予想の見方</h2>
      <div class="pp-foot-grid">
        <div class="pp-foot-card">
          <h3>馬柱を、文章で読めます</h3>
          <p>
            全頭に <b>AI短評</b>を付けています。前走の内容・コース実績・距離適性・
            上がりの脚・馬体重の増減・休養明けなど、<b>過去走から取れた材料</b>を
            1 行にまとめています。材料が足りない馬には「データ不足」と表示します。
          </p>
        </div>
        <div class="pp-foot-card">
          <h3>隊列とペースが、先に見えます</h3>
          <p>
            各馬の過去走から脚質（逃げ・先行・差し・追込）を判定し、
            今回の<b>隊列とペース</b>を出します。逃げ・先行が何頭いるかが
            一目で分かります。材料が無い馬は「判定不能」に置きます。
          </p>
        </div>
        <div class="pp-foot-card">
          <h3>全レースの結果を残しています</h3>
          <p>
            公開したレースの結果を日付ごとに残しています。回収率は
            <code>払戻 ÷ 投資 × 100</code> で算出し、公開したレースは
            すべて集計に入れています。
          </p>
          <a class="pp-foot-link" href="/archive/jra">中央競馬の的中実績を見る →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .prediction-page {
    padding-top: 8px;
    padding-bottom: 40px;
  }

  .pp-foot {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .pp-foot-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .pp-foot-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .pp-foot-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: var(--shadow-sm);
  }

  .pp-foot-card h3 {
    font-size: 0.98rem;
    font-family: var(--font-serif);
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .pp-foot-card p {
    font-size: 0.84rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
  }

  .pp-foot-card code {
    font-family: var(--font-num);
    background: var(--bg-muted);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .pp-foot-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--primary-start);
  }
</style>
