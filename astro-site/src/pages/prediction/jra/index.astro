      box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
    }

    .pro-tag {
      padding: 4px 12px;
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      border-radius: 12px;
      font-size: 0.7rem;
      font-weight: 800;
      color: #1f2937;
      letter-spacing: 1px;
    }

    .betting-formula {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
    }

    .formula-row {
      background: var(--bg-tertiary);
      padding: var(--spacing-lg);
      border-radius: var(--radius-md);
      border: 2px solid var(--border-color);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .formula-row.honmei-axis {
      border-color: #3b82f6;
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
    }

    .formula-row.taikou-axis {
      border-color: #8b5cf6;
      box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
    }

    .formula-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .axis-mark {
      font-size: 1.5rem;
      font-weight: 900;
    }

    .honmei-axis .axis-mark {
      color: #3b82f6;
    }

    .taikou-axis .axis-mark {
      color: #8b5cf6;
    }

    .axis-text {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .axis-horse-name {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-left: var(--spacing-xs);
    }

    .formula-content {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
    }

    /* スマートフォン: カード内の左右余白を少し縮める（横スクロール防止） */
    @media (max-width: 480px) {
      .formula-row {
        padding: var(--spacing-md);
      }
    }

    .axis-number {
      font-size: 2rem;
      font-weight: 900;
      color: #60a5fa;
      font-family: 'Courier New', monospace;
