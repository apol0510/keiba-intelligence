---
/**
 * /prediction/nankan — 南関東の予想（全 tier 共通の紙面）
 *
 * 正本: docs/RENEWAL_2026_08.md
 *
 * 🔴 2026-08-28 全面改修:
 *   - 旧実装は pro 向け買い目を**サーバーで描画して CSS で隠す**だけで、未認証の
 *     レスポンスに買い目が含まれていた（2026-08-17 監査 A-1／本番で再現確認済み）。
 *     加えて `isAuthenticated = true` / `userPlan = 'pro'` がハードコードされていた（A-5）。
 *   - 本実装は **サーバー側 entitlement（署名付き Cookie）** で tier を決め、
 *     権限が無いものは **HTML に出さない**。
 *
 *   tier ごとの表示:
 *     guest   … 馬柱・過去走・特徴量・AI短評・レース展望・展開予想（馬番順）
 *     free    … ＋ 印（役割マーク・PT・PT 順の並び）・AI結論
 *     light+  … ＋ 馬単買い目
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceDayBoard from '../../../components/newspaper/RaceDayBoard.astro';
import TierRibbon from '../../../components/newspaper/TierRibbon.astro';
import { loadNankanRaceDay } from '../../../lib/prediction/loadRaceDay.js';
import { entitlementFromAstro, viewFlags } from '../../../lib/auth/entitlement.js';

export const prerender = false;

const entitlement = entitlementFromAstro(Astro, { venue: 'nankan' });
const view = viewFlags(entitlement);

const day = loadNankanRaceDay(process.cwd());

const venueNames = day.venues.map((v) => v.venueName).join('・');
const title = day.date
  ? `${venueNames || '南関東'}の予想（${day.date}） - KEIBA Intelligence`
  : '南関東競馬 AI予想 - KEIBA Intelligence';
const description = '南関東4競馬場（大井・川崎・船橋・浦和）の全レース馬柱・過去走・AI短評・展開予想を無料公開。印（◎○▲△）は無料会員、AI指数の数値と馬単買い目は有料プランで提供しています。';
---

<BaseLayout title={title} description={description}>
  <div class="container prediction-page">
    <TierRibbon view={view} />
    <RaceDayBoard day={day} view={view} category="nankan" />

    <section class="pp-foot">
      <h2 class="pp-foot-title">KEIBA Intelligence の予想の見方</h2>
      <div class="pp-foot-grid">
        <div class="pp-foot-card">
          <h3>馬柱を、文章で読めます</h3>
          <p>
            全頭に <b>AI短評</b>を付けています。前走の内容・コース実績・距離適性・
            上がりの脚・馬体重の増減・休養明けなど、<b>過去走から分かること</b>を
            そのまま書きます。手がかりが足りない馬には「データ不足」と表示し、
            決めつけはしません。
          </p>
        </div>
        <div class="pp-foot-card">
          <h3>隊列とペースが、先に見えます</h3>
          <p>
            各馬の過去走から脚質（逃げ・先行・差し・追込）を判定し、
            今回の<b>隊列と流れ</b>を予想します。展開が読めると狙う馬が変わります。
            手がかりが無い馬は「判定不能」に置き、推測では並べません。
          </p>
        </div>
        <div class="pp-foot-card">
          <h3>実績は、良い日も悪い日もそのまま</h3>
          <p>
            回収率は <code>払戻 ÷ 投資 × 100</code> の実測値です。
            当たった日だけを選んで載せたり、あとから点数を変えたりはしません。
            公開しているレースはすべて算入しています。
          </p>
          <a class="pp-foot-link" href="/archive/nankan">南関東の的中実績を見る →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .prediction-page {
    padding-top: 8px;
    padding-bottom: 40px;
  }

  .pp-foot {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .pp-foot-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .pp-foot-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .pp-foot-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: var(--shadow-sm);
  }

  .pp-foot-card h3 {
    font-size: 0.98rem;
    font-family: var(--font-serif);
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .pp-foot-card p {
    font-size: 0.84rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
  }

  .pp-foot-card code {
    font-family: var(--font-num);
    background: var(--bg-muted);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .pp-foot-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--primary-start);
  }
</style>
