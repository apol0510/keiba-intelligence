---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="認証中... | KEIBA Intelligence"
  description="ログイン処理中"
>
  <section class="verify-section">
    <div class="container">
      <div class="verify-card">
        <div class="verify-content">
          <div class="spinner"></div>
          <h1 id="status">認証中...</h1>
          <p id="message">トークンを確認しています。しばらくお待ちください。</p>
          <div class="verify-actions" id="verifyActions" hidden>
            <a href="/login" class="btn-primary" id="reloginLink">新しいログインリンクを受け取る</a>
            <p class="verify-hint" id="verifyHint" hidden></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .verify-section {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    padding: 80px 0;
    background: linear-gradient(135deg, #f5f7fb 0%, #eef2f8 100%);
  }

  .verify-card {
    max-width: 600px;
    margin: 0 auto;
    background: var(--bg-muted);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 16px;
    padding: 64px 48px;
    backdrop-filter: blur(10px);
  }

  .verify-content {
    text-align: center;

    .spinner {
      width: 60px;
      height: 60px;
      margin: 0 auto 32px;
      border: 4px solid rgba(59, 130, 246, 0.2);
      border-top: 4px solid #3b82f6;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    h1 {
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 16px;
    }

    p {
      color: var(--text-tertiary);
      font-size: 16px;
      line-height: 1.6;
    }

    &.success h1 {
      background: linear-gradient(135deg, #059669 0%, #10b981 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    &.error {
      .spinner {
        display: none;
      }

      h1 {
        background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
    }
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .btn-primary {
    display: inline-block;
    margin-top: 24px;
    padding: 14px 28px;
    /* 主要 CTA: 青 → 紫（旧 #1e40af→#3b82f6 は同系色の濃淡） */
    background: var(--grad-nav-btn);
    border: none;
    border-radius: 8px;
    color: var(--btn-ink); /* 8.84 / 6.96 */
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4);
    }
  }

  .verify-actions {
    margin-top: 8px;

    &[hidden] { display: none; }

    .verify-hint {
      margin-top: 20px;
      font-size: 14px;
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .verify-card {
      padding: 48px 24px;
    }

    .verify-content h1 {
      font-size: 24px;
    }
  }
</style>

<script>
  import { readStoredIntent, clearStoredIntent, resumePathFor } from '../../lib/billing/purchaseIntent.js';
  // GA4 計測（PII なし。token・email は送らない。docs/measurements/FUNNEL_2026_10.md）
  import { trackFunnel, FUNNEL_EVENTS, verifyResultOf } from '../../lib/analytics/funnelEvents.js';
  import { verifyFailureCopy, isSignedInSession } from '../../lib/auth/verifyRecovery.js';
  // ログイン前に見ていたページ（許可リストのパスだけ。LOGIN_RETURN_TO_2026_10.md）
  import { normalizeReturnTo, returnToKind, loginHrefFor, paidEquivalentPath, RETURN_PARAM } from '../../lib/auth/returnTo.js';
  import { canSeeBetting } from '../../lib/auth/tiers.js';
  import { verifySourceOf, SIGNUP_SOURCE_PARAM } from '../../lib/auth/signupGuidance.js';

  const statusEl = document.getElementById('status') as HTMLHeadingElement;
  const messageEl = document.getElementById('message') as HTMLParagraphElement;
  const contentEl = document.querySelector('.verify-content') as HTMLDivElement;

  async function verifyToken() {
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');

    if (!token) {
      showError('リンクを確認できませんでした', 'URL が途中で切れている可能性があります。新しいログインリンクを受け取ってください。');
      return;
    }

    try {
      // 🔴 購入導線から来た場合は intent（プラン id）をそのまま渡す。
      //    戻り先はサーバーが固定パスで決めるので、ここでは値を解釈しない。
      // 🔴 URL の intent が最優先。落ちていたら購入導線が残した控えを使う
      //    （メールクライアントがクエリを削ることがある）。
      //    どちらも値はサーバー側で `plans.js` と照合され、戻り先は固定パス。
      const intent = urlParams.get('intent') || readStoredIntent(window.localStorage);
      // 🔴 戻り先も許可リストで検査してから渡す（サーバーでも同じ検査をする）。購入意図が優先。
      const next = normalizeReturnTo(urlParams.get(RETURN_PARAM));
      const q = `token=${encodeURIComponent(token)}` + (intent ? `&intent=${encodeURIComponent(intent)}` : '')
        + (next ? `&${RETURN_PARAM}=${encodeURIComponent(next)}` : '');
      const response = await fetch(`/.netlify/functions/verify-magic-link?${q}`);
      const data = await response.json();
      trackFunnel(FUNNEL_EVENTS.LOGIN_VERIFY_RESULT, {
        result: verifyResultOf(response.status, response.ok && data.success, data.error),
        intent: intent ? 'purchase' : 'none',
        return_to: returnToKind(next),
        // 登録の確認リンク（&src=signup）から来たか。固定の列挙値だけ（SIGNUP_COMPLETION_2026_10.md）
        source: verifySourceOf(urlParams.get(SIGNUP_SOURCE_PARAM)),
      });

      if (response.ok && data.success) {
        // セッション情報をsessionStorageに保存
        sessionStorage.setItem('keiba_session', JSON.stringify(data.session));

        // プラン別フラグを保存
        const plan = data.session.plan?.toLowerCase();
        sessionStorage.setItem('isFreeUser', plan === 'free-registered' ? 'true' : 'false');
        sessionStorage.setItem('isLightUser', plan === 'light' ? 'true' : 'false');

        // 一度使った控えは残さない
        clearStoredIntent(window.localStorage);

        console.log('✅ 認証成功 - プラン:', data.session.plan);

        /*
         * 🔴 購入導線では「何が確認できたか」と「次に何が起きるか」を両方出す。
         *    「確認できました」だけだと、何を確認したのか分からない。
         */
        if (intent) {
          showSuccess('メールアドレスを確認しました', 'このままお支払い画面へ進みます…');
        } else {
          /*
           * 🔴 遷移先は tier で変わる（有料 → /mypage、無料 → /free-prediction）。
           *    文言を「マイページへ」に固定すると、無料会員には
           *    実際の遷移先と食い違う案内になる。行き先から選ぶ。
           */
          const to = data.redirectTo || '/mypage';
          // 戻り先があれば元のページ（有料会員は対応する有料ページ）へ戻る
          const where = next && to.indexOf('/mypage') !== 0 && to.indexOf('/pricing') !== 0
            ? '元のページへ戻ります…'
            : to.indexOf('/mypage') === 0
            ? 'マイページへ移動します…'
            : (to.indexOf('/free-prediction') === 0 ? '今日の予想へ移動します…' : 'ページへ移動します…');
          showSuccess('ログインしました', where);
        }
        setTimeout(() => {
          window.location.href = data.redirectTo || '/mypage';
        }, 500);
      } else {
        await handleFailure(verifyResultOf(response.status, false, data.error), intent, next);
      }
    } catch (error) {
      console.error('Verify error:', error);
      showError('通信エラー', 'サーバーとの通信に失敗しました。もう一度お試しください。');
    }
  }

  /*
   * 🔴 リンクが使えなかったときに「もう一度ログイン」で終わらせない（docs/measurements/LOGIN_RECOVERY_2026_10.md）。
   *    1. この端末ですでにログインしているなら（同じリンクを 2 回開いた・戻るで再表示した等）、そのまま進める。
   *       判定は get-session（署名付き Cookie をサーバーが検証）だけ。sessionStorage は見ない。
   *    2. ログインしていなければ、何が起きたか（使用済み・期限切れ）と、新しいリンクの受け取り方を出す。
   */
  async function handleFailure(result: string, intent: string | null, next: string | null) {
    let signedIn = false;
    let paid = false;
    try {
      const res = await fetch('/.netlify/functions/get-session', { credentials: 'include' });
      const body = res.ok ? await res.json() : null;
      signedIn = isSignedInSession(res.status, body);
      // 行き先を選ぶためだけに使う（有料ページ自身が Cookie で判定する）
      paid = signedIn && canSeeBetting(body?.tier);
    } catch { /* 判定できなければログインしていない扱い */ }
    trackFunnel(FUNNEL_EVENTS.VERIFY_FALLBACK, { result: signedIn ? 'signed_in' : 'relogin' });

    if (signedIn) {
      const back = next ? ((paid && paidEquivalentPath(next)) || next) : null;
      const to = resumePathFor(intent, back || '/mypage');
      if (intent) clearStoredIntent(window.localStorage);
      showSuccess('ログイン済みです', intent ? 'お申し込みの続きへ移動します…'
        : (next && next.indexOf('/mypage') !== 0 ? '元のページへ戻ります…' : 'マイページへ移動します…'));
      setTimeout(() => { window.location.href = to; }, 500);
      return;
    }
    const copy = verifyFailureCopy(result);
    // 新しいリンクを受け取った後も元のページへ戻れるように、/login へ戻り先を引き継ぐ
    const relogin = document.getElementById('reloginLink') as HTMLAnchorElement | null;
    if (relogin && next) relogin.href = loginHrefFor(next);
    showError(copy.title, copy.message, copy.hint);
  }

  function showSuccess(title: string, message: string) {
    contentEl.classList.add('success');
    statusEl.textContent = title;
    messageEl.textContent = message;
  }

  function showError(title: string, message: string, hint?: string) {
    contentEl.classList.add('error');
    statusEl.textContent = title;
    // 🔴 文言は固定文字列（verifyRecovery.js）。URL の値は表示に使わない
    messageEl.textContent = message;
    const actions = document.getElementById('verifyActions');
    const hintEl = document.getElementById('verifyHint');
    if (hintEl && hint) { hintEl.textContent = hint; hintEl.hidden = false; }
    if (actions) actions.hidden = false;
  }

  // ページ読み込み時に自動実行
  verifyToken();
</script>
