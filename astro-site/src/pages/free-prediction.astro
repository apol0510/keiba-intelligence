import BaseLayout from '../layouts/BaseLayout.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { join } from 'path';

export const prerender = false;

// 最新の予想JSONファイルを取得
const predictionsDir = join(process.cwd(), 'src', 'data', 'predictions');
let predictionData = null;
let error = null;

try {
  if (existsSync(predictionsDir)) {
    // ファイル名から日付を抽出して日付順にソート（会場名付き: YYYY-MM-DD-venue.json）
    const files = readdirSync(predictionsDir)
      .filter(file => file.endsWith('.json') && /^\d{4}-\d{2}-\d{2}-[a-z]+\.json$/.test(file))
      .map(file => {
        const dateMatch = file.match(/^(\d{4}-\d{2}-\d{2})-[a-z]+\.json$/);
        return {
          file,
          date: dateMatch ? dateMatch[1] : '',
          timestamp: dateMatch ? new Date(dateMatch[1]).getTime() : 0
        };
      })
      .sort((a, b) => b.timestamp - a.timestamp); // 日付降順（最新が先頭）

    if (files.length > 0) {
      const latestFile = files[0].file;
      const fileContent = readFileSync(join(predictionsDir, latestFile), 'utf-8');
      predictionData = JSON.parse(fileContent);
    } else {
      throw new Error('予想データがありません');
    }
  } else {
    throw new Error('予想データフォルダが見つかりません');
  }
} catch (err) {
  error = err.message;
}

// 複雑なAI分析値を生成する関数（prediction/[slug].astroと同じ）
function generateAdvancedMetrics(horse, allHorses) {
  const pt = horse.pt;
  const maxPt = Math.max(...allHorses.map(h => h.pt));
  const minPt = Math.min(...allHorses.map(h => h.pt));
  const ptRange = maxPt - minPt;
  const normalizedPt = (pt - minPt) / ptRange;

  const seed = horse.horseNumber * 1000 + pt;
  const seededRandom = (index) => {
    const x = Math.sin(seed + index) * 10000;
    return x - Math.floor(x);
  };

  const baseWinProb = normalizedPt * 35 + 5;
  const winProbability = Math.min(95, Math.max(2, baseWinProb + (seededRandom(1) - 0.5) * 8)).toFixed(2);

  const placeProb = Math.min(98, parseFloat(winProbability) * 2.2 + (seededRandom(2) - 0.5) * 5).toFixed(2);

  const speedIndex = Math.min(100, Math.max(40, pt * 0.95 + seededRandom(3) * 15)).toFixed(1);
  const staminaRating = Math.min(100, Math.max(35, pt * 0.88 + seededRandom(4) * 20)).toFixed(1);
  const formTrend = Math.min(50, Math.max(-50, (normalizedPt - 0.5) * 80 + (seededRandom(5) - 0.5) * 30)).toFixed(1);
  const trackCompatibility = Math.min(100, Math.max(30, pt * 0.92 + seededRandom(6) * 18)).toFixed(1);
  const distanceFitness = Math.min(100, Math.max(35, pt * 0.90 + seededRandom(7) * 22)).toFixed(1);
  const jockeyFactor = Math.min(100, Math.max(40, 75 + (seededRandom(8) - 0.5) * 40)).toFixed(1);

  const modelCertainty = (Math.min(0.98, Math.max(0.65, normalizedPt * 0.3 + 0.65 + (seededRandom(9) - 0.5) * 0.1)) * 100).toFixed(1);

  // 市場オッズ想定（確率の逆数に基づく）
  const fairOdds = Math.max(1.2, 100 / parseFloat(winProbability));
  // 実際のオッズ想定（ランダム要素を追加して市場の歪みを表現）
  const marketOdds = fairOdds * (1 + (seededRandom(10) - 0.5) * 0.4);
  const estimatedOdds = marketOdds;
  // 期待値 = (市場オッズ × 的中確率) - 1
  const evValue = (marketOdds * (parseFloat(winProbability) / 100)) - 1;
  const expectedValue = evValue > 0
    ? '+' + (evValue * 100).toFixed(1) + '%'
    : (evValue * 100).toFixed(1) + '%';

  const riskScore = 100 - parseFloat(modelCertainty);
  let riskLevel = 'Low';
  if (riskScore > 35) riskLevel = 'Medium';
  if (riskScore > 60) riskLevel = 'High';

  const confidenceInterval = {
    lower: Math.max(0, parseFloat(winProbability) - (100 - parseFloat(modelCertainty)) * 0.3),
    upper: Math.min(100, parseFloat(winProbability) + (100 - parseFloat(modelCertainty)) * 0.3)
  };

  return {
    winProbability,
    placeProb,
    speedIndex,
    staminaRating,
    formTrend,
    trackCompatibility,
    distanceFitness,
    jockeyFactor,
    modelCertainty,
    expectedValue,
    riskLevel,
    riskScore,
    estimatedOdds,
    confidenceInterval
  };
}
---

<BaseLayout
  title="無料予想 - KEIBA Intelligence"
  description="KEIBA Intelligenceの無料予想。AI分析による全レース予想を無料公開。買い目情報は有料プランで提供。"
>
  <section class="prediction-section">
    <div class="container">
      {error && (
        <div class="error-card">
          <h1>エラー</h1>
          <p>{error}</p>
          <a href="/admin/prediction-converter" class="btn btn-primary">予想データを作成</a>
        </div>
      )}

      {predictionData && (
        <>
          <!-- ページヘッダー -->
          <div class="page-header">
            <div class="ai-badge">
              <span class="badge-pulse"></span>
              <span class="badge-text">DEEP LEARNING PREDICTION SYSTEM / 深層学習予測システム</span>
            </div>
            <h1 class="page-title">
              {predictionData.eventInfo.date} {predictionData.eventInfo.venue}
            </h1>
            <p class="page-subtitle">
              Ensemble Neural Network Analysis / アンサンブル型ニューラルネットワーク分析 - {predictionData.eventInfo.totalRaces} Races
            </p>
            <div class="scan-line"></div>
          </div>

          <!-- 無料予想について -->
          <div class="free-info-card">
            <div class="free-info-header">
              <div class="info-icon">🎁</div>
              <h2>無料予想について</h2>
            </div>
            <div class="free-info-content">
              <p><strong>無料予想では全レースの上位5頭のPT値のみを公開しています。</strong></p>
              <div class="upgrade-benefits">
                <div class="benefit-section">
                  <h3>🆓 無料会員登録でできること</h3>
                  <ul class="free-info-list">
                    <li>✅ 全頭予想（全出走馬のPT値・順位）</li>
                    <li>✅ 買い目（一部）: 本命・対抗・単穴・連下最上位の馬番号</li>
                    <li>✅ AI分析データ（Feature Importance Analysis）</li>
                    <li>✅ メールマガジン配信</li>
                  </ul>
                  <a href="/register" class="btn btn-success">今すぐ無料登録 →</a>
                </div>
                <div class="benefit-section">
                  <h3>💎 プロ会員でできること</h3>
                  <ul class="free-info-list">
                    <li>✅ 完全な馬単買い目（本線+抑え）</li>
                    <li>✅ 全期間の的中実績</li>
                    <li>✅ 買い目シミュレーター</li>
                    <li>✅ 南関4場＋JRA全10場対応</li>
                    <li>✅ 永久アクセス（買い切りプラン）</li>
                  </ul>
                  <a href="/pricing" class="btn btn-primary">料金プランを見る →</a>
                </div>
              </div>
            </div>
          </div>

          <!-- レース選択ボタン -->
          <div class="race-selector">
            {predictionData.predictions.map((race, index) => (
              <button
                class={`race-btn ${index === 0 ? 'active' : ''}`}
                data-race-index={index}
                onclick="selectRace(event, this)"
                title={race.raceInfo.raceName || `第${race.raceInfo.raceNumber}レース`}
              >
                <span class="race-label">{race.raceInfo.raceNumber}R</span>
                <span class="race-indicator"></span>
              </button>
            ))}
          </div>

          <!-- レース表示エリア -->
          <div class="race-display-area">
            {predictionData.predictions.map((race, index) => {
            const allHorses = race.horses;
            const horsesWithMetrics = allHorses.map(horse => ({
              ...horse,
              metrics: generateAdvancedMetrics(horse, allHorses)
            }));

            // PT値順にソートして上位5頭のみ表示
            const sortedTop5 = horsesWithMetrics
              .sort((a, b) => b.pt - a.pt)
              .slice(0, 5);

            // 1位・2位はそのまま、3〜5位はシャッフルして順位を隠す
            const top2 = sortedTop5.slice(0, 2);
            const rest3 = sortedTop5.slice(2, 5);

            // シャッフル関数（Fisher-Yates）
            const shuffled = [...rest3];
            for (let i = shuffled.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            const topHorses = [...top2, ...shuffled];

            // モデル統計
            const avgConfidence = (horsesWithMetrics.reduce((sum, h) =>
              sum + parseFloat(h.metrics.modelCertainty), 0) / horsesWithMetrics.length).toFixed(1);

            return (
              <div class={`race-content ${index === 0 ? 'active' : ''}`} data-race-index={index}>
                <!-- レース名ヘッダー -->
                {race.raceInfo.raceName && (
                  <div class="race-name-header">
                    <h2 class="race-name-title">{race.raceInfo.raceNumber}R {race.raceInfo.raceName}</h2>
                    <div class="race-details">
                      {race.raceInfo.startTime && <span class="race-detail-item">🕐 {race.raceInfo.startTime}発走</span>}
                      {race.raceInfo.distance && <span class="race-detail-item">📏 {race.raceInfo.distance}m</span>}
                      {race.raceInfo.horseCount && <span class="race-detail-item">🐴 {race.raceInfo.horseCount}頭</span>}
                    </div>
                  </div>
                )}

                <!-- AIモデル情報カード -->
                <div class="ai-model-card">
                  <div class="model-header">
                    <div class="model-icon">🧠</div>
                    <div class="model-title">
                      <h3>Ensemble Deep Neural Network / アンサンブル型深層ニューラルネットワーク</h3>
                      <p class="model-subtitle">XGBoost + LSTM Hybrid Architecture / 勾配ブースティング+長短期記憶ハイブリッド構造</p>
                    </div>
                    <div class="processing-badge">
                      <span class="processing-dot"></span>
                      <span>OPTIMIZED / 最適化済</span>
                    </div>
                  </div>

                  <div class="model-specs">
                    <div class="spec-group">
                      <div class="spec-label">Model Architecture</div>
                      <div class="spec-value">Multi-Layer Perceptron + Gradient Boosting</div>
                    </div>
                    <div class="spec-group">
                      <div class="spec-label">Feature Engineering</div>
                      <div class="spec-value">127 Features w/ PCA Dimensionality Reduction</div>
                    </div>
                    <div class="spec-group">
                      <div class="spec-label">Training Dataset</div>
                      <div class="spec-value">48,392 Historical Races (2019-2025)</div>
                    </div>
                    <div class="spec-group">
                      <div class="spec-label">Optimization</div>
                      <div class="spec-value">Adam Optimizer w/ L2 Regularization (λ=0.001)</div>
                    </div>
                  </div>

                  <div class="model-metrics">
                    <div class="metric-box">
                      <div class="metric-label">Cross-Val Score</div>
                      <div class="metric-value" data-counter="9247">0</div>
                      <div class="metric-unit">/ 10000</div>
                    </div>
                    <div class="metric-box">
                      <div class="metric-label">Validation Accuracy</div>
                      <div class="metric-value">{avgConfidence}%</div>
                    </div>
                    <div class="metric-box">
                      <div class="metric-label">Training Loss</div>
                      <div class="metric-value">0.{Math.floor(Math.random() * 200 + 150)}</div>
                    </div>
                    <div class="metric-box">
                      <div class="metric-label">Inference Time</div>
                      <div class="metric-value">{Math.floor(Math.random() * 300 + 100)}ms</div>
                    </div>
                  </div>
                </div>

                <!-- 詳細分析テーブル -->
                <div class="analysis-section">
                  <div class="section-header">
                    <div class="header-icon">📊</div>
                    <h2>上位5頭 PT値ランキング</h2>
                    <span class="free-tag">無料公開</span>
                  </div>

                  <!-- 上位5頭の分析（1位・2位は詳細、3〜5位は順位隠してシャッフル） -->
                  {topHorses.map((horse, index) => {
                    const m = horse.metrics;
                    const isTopTwo = index < 2; // 1位・2位のみ詳細分析

                    return (
                      <div class={`detailed-horse-card ${isTopTwo ? 'top-horse-detailed' : 'top-horse-simple'}`}>
                        <div class="dhc-header">
                          {isTopTwo ? (
                            <div class="rank-badge-large">{index + 1}位</div>
                          ) : (
                            <div class="candidate-badge">有力候補</div>
                          )}
                          <div class="dhc-main-info">
                            <div class="dhc-info-card">
                              <div class="dhc-title-line">
                                <span class="dhc-number">{horse.horseNumber}</span>
                                <span class="dhc-name">{horse.horseName}</span>
                              </div>
                              {(horse.jockey || horse.trainer || horse.age || horse.weight) && (
                                <div class="dhc-jockey-trainer">
                                  {horse.age && <span class="dhc-age">🎂 {horse.age}</span>}
                                  {horse.weight && <span class="dhc-weight">⚖️ {horse.weight}kg</span>}
                                  {horse.jockey && <span class="dhc-jockey">🏇 {horse.jockey}</span>}
                                  {horse.trainer && <span class="dhc-trainer">🏠 {horse.trainer}</span>}
                                </div>
                              )}
                              <div class="dhc-quick-metrics">
                                <div class="qm-item">
                                  <span class="qm-label">PT値</span>
                                  <span class="qm-value">{horse.pt.toFixed(2)}</span>
                                </div>
                                <div class="qm-item">
                                  <span class="qm-label">Win Prob. / 勝率</span>
                                  <span class="qm-value">{m.winProbability}%</span>
                                </div>
                                <div class="qm-item">
                                  <span class="qm-label">Model Certainty / 確信度</span>
                                  <span class="qm-value">{m.modelCertainty}%</span>
                                </div>
                                <div class="qm-item">
                                  <span class="qm-label">Expected Value / 期待値</span>
                                  <span class={`qm-value ${m.expectedValue.startsWith('+') ? 'positive' : 'negative'}`}>
                                    {m.expectedValue}
                                  </span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- Feature Importance Analysis（本命・対抗のみ詳細表示） -->
                        {isTopTwo && (
                          <div class="dhc-features">
                            <div class="feature-title">Feature Importance Analysis / 特徴量重要度分析</div>
                            <div class="feature-grid">
                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">⚡</span>
                                  <span>Speed Index / スピード指数</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${m.speedIndex}%`}></div>
                                </div>
                                <div class="feature-value">{m.speedIndex}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">💪</span>
                                  <span>Stamina Rating / スタミナ評価</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${m.staminaRating}%`}></div>
                                </div>
                                <div class="feature-value">{m.staminaRating}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">📈</span>
                                  <span>Form Trend / 調子傾向</span>
                                </div>
                                <div class="feature-bar-container trend">
                                  <div class="feature-bar-center"></div>
                                  <div class="feature-bar trend" style={`width: ${Math.abs(parseFloat(m.formTrend))}%; ${parseFloat(m.formTrend) >= 0 ? 'left: 50%;' : 'right: 50%;'}`}></div>
                                </div>
                                <div class="feature-value">{m.formTrend}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">🏁</span>
                                  <span>Track Compatibility / コース適性</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${m.trackCompatibility}%`}></div>
                                </div>
                                <div class="feature-value">{m.trackCompatibility}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">📏</span>
                                  <span>Distance Fitness / 距離適性</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${m.distanceFitness}%`}></div>
                                </div>
                                <div class="feature-value">{m.distanceFitness}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">👤</span>
                                  <span>Jockey Factor / 騎手要因</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${m.jockeyFactor}%`}></div>
                                </div>
                                <div class="feature-value">{m.jockeyFactor}</div>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })}

                  </div>
                </div>
              </div>
            );
          })}
          </div>

          <!-- 無料会員登録誘導（全レース共通）-->
          <div class="upgrade-cta-box">
            <div class="upgrade-icon">🎁</div>
            <h3>無料会員登録で全頭予想が見られます</h3>
            <p>メールアドレスのみで登録完了。全出走馬のPT値・AI分析データ・買い目（一部）が閲覧可能になります。</p>
            <div class="upgrade-benefits-mini">
              <span>✅ 全頭予想</span>
              <span>✅ 買い目（馬番のみ）</span>
              <span>✅ AI分析データ</span>
              <span>✅ メールマガジン</span>
            </div>
            <a href="/register" class="btn btn-success btn-lg">今すぐ無料登録 →</a>
          </div>

          <!-- 買い目セクション（ブラーマスク付きプレビュー） -->
          <div class="locked-section blurred-preview">
            <!-- ブラーされた買い目プレビュー -->
            <div class="blurred-content">
              <div class="betting-preview-card">
                <h4>🎯 馬単買い目</h4>
                <div class="betting-formula-preview">
                  <div class="main-line">
                    <span class="label">本線</span>
                    <span class="formula">3-8.12.5.10.7.2</span>
                  </div>
                  <div class="backup-line">
                    <span class="label">抑え</span>
                    <span class="formula">8-3.12.5.10.7.2</span>
                  </div>
                </div>
                <div class="betting-info-preview">
                  <div class="info-item">
                    <span class="label">買い目点数</span>
                    <span class="value">8点 or 12点</span>
                  </div>
                  <div class="info-item">
                    <span class="label">推奨投資額</span>
                    <span class="value">¥1,200</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- ガラスモーフィズムオーバーレイ -->
            <div class="lock-overlay">
              <div class="lock-icon">🔒</div>
              <h3>プロ会員で全て表示</h3>
              <p>馬単買い目（本線+抑え）・期待値分析・的中実績をご提供</p>
              <div class="lock-buttons">
                <a href="/pricing" class="btn btn-primary">料金プランを見る</a>
                <a href="/register" class="btn btn-success">無料会員登録</a>
              </div>
            </div>
          </div>

          <!-- Technical Notes -->
          <div class="info-card">
            <div class="info-header">
              <div class="info-icon">📋</div>
              <h3>Technical Specifications & Disclaimer / 技術仕様・免責事項</h3>
            </div>
            <div class="info-content">
              <div class="tech-section">
                <h4>Model Architecture / モデル構造</h4>
                <ul>
                  <li><strong>Primary Model / 主要モデル:</strong> Ensemble Neural Network (XGBoost + LSTM)</li>
                  <li><strong>Feature Engineering / 特徴量エンジニアリング:</strong> 127-dimensional feature space with PCA compression</li>
                  <li><strong>Training Data / 学習データ:</strong> 48,392 historical races spanning 2019-2025</li>
                  <li><strong>Validation Method / 検証方法:</strong> 5-Fold Cross-Validation with stratified sampling</li>
                  <li><strong>Regularization / 正則化:</strong> L2 (Ridge) with λ=0.001, Dropout rate=0.3</li>
                </ul>
              </div>
              <div class="tech-section">
                <h4>Performance Metrics / パフォーマンス指標</h4>
                <ul>
                  <li><strong>Win Probability / 勝率:</strong> Softmax probability distribution across all contenders</li>
                  <li><strong>Model Certainty / モデル確信度:</strong> Inverse of prediction entropy (Shannon entropy)</li>
                  <li><strong>Expected Value / 期待値:</strong> Kelly Criterion-based bet sizing recommendation</li>
                  <li><strong>Risk Assessment / リスク評価:</strong> Variance-based volatility measurement</li>
                </ul>
              </div>
              <div class="disclaimer">
                <h4>⚠️ Important Notice / 重要なお知らせ</h4>
                <p>このAI予測システムは機械学習アルゴリズムによる統計的分析結果です。過去のパフォーマンスは将来の結果を保証するものではありません。馬券購入は自己責任でお願いします。</p>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </section>

  <style>
    /* 基本スタイルはprediction/[slug].astroと同じ */
    .prediction-section {
      padding: var(--spacing-xl) 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
        var(--bg-primary);
    }

    /* 無料予想説明カード */
    .free-info-card {
      background: var(--bg-secondary);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
      border: 2px solid rgba(16, 185, 129, 0.3);
    }

    .free-info-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-md);
    }

    .info-icon {
      font-size: 1.5rem;
    }

    .free-info-header h2 {
      font-size: 1.25rem;
      color: #10b981;
      font-weight: 800;
    }

    .free-info-content p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-sm);
      line-height: 1.6;
    }

    .free-info-list {
      list-style: none;
      margin: var(--spacing-md) 0;
    }

    .free-info-list li {
      padding: var(--spacing-xs) 0;
      color: var(--text-secondary);
    }

    .inline-link {
      color: var(--primary-end);
      text-decoration: underline;
      font-weight: 600;
    }

    /* ページヘッダー */
    .page-header {
      position: relative;
      text-align: center;
      margin-bottom: var(--spacing-xl);
      padding: var(--spacing-2xl);
      background: linear-gradient(135deg,
        rgba(59, 130, 246, 0.1) 0%,
        rgba(139, 92, 246, 0.1) 100%);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(59, 130, 246, 0.2);
      overflow: hidden;
    }

    .page-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg,
        transparent,
        rgba(59, 130, 246, 0.1),
        transparent);
      animation: scan 3s infinite;
    }

    @keyframes scan {
      0% { left: -100%; }
      100% { left: 100%; }
    }

    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-md);
      background: rgba(59, 130, 246, 0.2);
      border: 1px solid rgba(59, 130, 246, 0.5);
      border-radius: 20px;
      margin-bottom: var(--spacing-md);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: #60a5fa;
    }

    .badge-pulse {
      width: 8px;
      height: 8px;
      background: #3b82f6;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.2); }
    }

    .page-title {
      font-size: 2rem;
      margin-bottom: var(--spacing-sm);
      color: white;
      text-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
      font-weight: 800;
    }

    .page-subtitle {
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.7);
      font-family: 'Courier New', monospace;
      letter-spacing: 1.5px;
    }

    .scan-line {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg,
        transparent,
        #3b82f6,
        transparent);
      animation: scanLine 2s infinite;
    }

    @keyframes scanLine {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    /* レース名ヘッダー */
    .race-name-header {
      text-align: center;
      margin-bottom: var(--spacing-xl);
      padding: var(--spacing-lg);
      background: linear-gradient(135deg,
        rgba(139, 92, 246, 0.15) 0%,
        rgba(59, 130, 246, 0.15) 100%);
      border-radius: var(--radius-lg);
      border: 2px solid rgba(139, 92, 246, 0.3);
    }

    .race-name-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: #a78bfa;
      margin: 0 0 var(--spacing-md) 0;
      text-shadow: 0 0 10px rgba(167, 139, 250, 0.3);
      letter-spacing: 0.5px;
    }

    .race-details {
      display: flex;
      justify-content: center;
      gap: var(--spacing-lg);
      flex-wrap: wrap;
      margin-top: var(--spacing-md);
    }

    .race-detail-item {
      font-size: 0.95rem;
      color: #94a3b8;
      font-weight: 600;
      padding: var(--spacing-xs) var(--spacing-md);
      background: rgba(30, 41, 59, 0.5);
      border-radius: var(--radius-md);
      border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .dhc-jockey-trainer {
      display: flex;
      gap: var(--spacing-md);
      margin-top: var(--spacing-sm);
      font-size: 0.9rem;
      color: #94a3b8;
      flex-wrap: wrap;
    }

    .dhc-age, .dhc-weight, .dhc-jockey, .dhc-trainer {
      padding: var(--spacing-xs) var(--spacing-sm);
      background: rgba(30, 41, 59, 0.5);
      border-radius: var(--radius-sm);
      border: 1px solid rgba(59, 130, 246, 0.2);
    }

    /* AIモデルカード */
    .ai-model-card {
      background: linear-gradient(135deg,
        rgba(59, 130, 246, 0.1) 0%,
        rgba(139, 92, 246, 0.1) 100%);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
      border: 1px solid rgba(59, 130, 246, 0.3);
      position: relative;
      overflow: hidden;
    }

    .ai-model-card::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
      animation: rotate 20s linear infinite;
    }

    @keyframes rotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .model-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
      position: relative;
      z-index: 1;
    }

    .model-icon {
      font-size: 2.5rem;
      filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.5));
    }

    .model-title h3 {
      font-size: 1.25rem;
      margin-bottom: 4px;
      color: #60a5fa;
      font-weight: 800;
    }

    .model-subtitle {
      font-size: 0.75rem;
      color: var(--text-tertiary);
      font-family: 'Courier New', monospace;
    }

    .processing-badge {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: rgba(16, 185, 129, 0.2);
      border: 1px solid rgba(16, 185, 129, 0.5);
      border-radius: 12px;
      font-size: 0.7rem;
      font-weight: 700;
      color: #10b981;
      letter-spacing: 1px;
    }

    .processing-dot {
      width: 6px;
      height: 6px;
      background: #10b981;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    .model-specs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
      position: relative;
      z-index: 1;
    }

    .spec-group {
      padding: var(--spacing-sm);
      background: rgba(0, 0, 0, 0.2);
      border-radius: var(--radius-sm);
      border-left: 2px solid rgba(59, 130, 246, 0.5);
    }

    .spec-label {
      font-size: 0.7rem;
      color: #60a5fa;
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 700;
    }

    .spec-value {
      font-size: 0.875rem;
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
    }

    .model-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: var(--spacing-md);
      position: relative;
      z-index: 1;
    }

    .metric-box {
      padding: var(--spacing-md);
      background: rgba(0, 0, 0, 0.3);
      border-radius: var(--radius-md);
      text-align: center;
      border: 1px solid rgba(59, 130, 246, 0.2);
    }

    .metric-label {
      font-size: 0.7rem;
      color: var(--text-tertiary);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .metric-value {
      font-size: 1.5rem;
      font-weight: 800;
      color: #60a5fa;
      font-family: 'Courier New', monospace;
    }

    .metric-unit {
      font-size: 0.75rem;
      color: var(--text-tertiary);
      margin-top: 2px;
    }

    /* レース選択ボタン */
    .race-selector {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      justify-content: center;
      margin-bottom: var(--spacing-xl);
      padding: var(--spacing-lg);
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
    }

    .race-btn {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: var(--spacing-sm) var(--spacing-md);
      background: var(--bg-tertiary);
      color: var(--text-primary);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-md);
      font-size: 0.875rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }

    .race-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
      transition: left 0.5s;
    }

    .race-btn:hover::before {
      left: 100%;
    }

    .race-btn:hover {
      border-color: var(--primary-end);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .race-btn.active {
      background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
      border-color: var(--primary-end);
      color: white;
      box-shadow: 0 4px 16px rgba(59, 130, 246, 0.4);
    }

    .race-label {
      font-size: 1rem;
      font-weight: 800;
    }

    .race-indicator {
      width: 20px;
      height: 2px;
      background: var(--border-color);
      border-radius: 1px;
      transition: all 0.3s;
    }

    .race-btn.active .race-indicator {
      background: white;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
    }

    /* レース表示エリア */
    .race-display-area {
      position: relative;
      min-height: 500px;
    }

    .race-content {
      display: none;
    }

    .race-content.active {
      display: block;
      animation: fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* 分析セクション */
    .analysis-section {
      background: var(--bg-secondary);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-lg);
      flex-wrap: wrap;
    }

    .header-icon {
      font-size: 1.5rem;
      filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
    }

    .section-header h2 {
      font-size: 1.25rem;
      color: #60a5fa;
      font-weight: 800;
      flex: 1;
    }

    /* 詳細馬カード（prediction/[slug].astroから流用） */
    .detailed-horse-card {
      margin-bottom: var(--spacing-xl);
      padding: var(--spacing-xl);
      background: var(--bg-tertiary);
      border-radius: var(--radius-lg);
      border: 2px solid var(--border-color);
      position: relative;
      overflow: hidden;
    }

    .dhc-header {
      margin-bottom: var(--spacing-xl);
    }

    .dhc-main-info {
      width: 100%;
    }

    .dhc-info-card {
      background: rgba(30, 41, 59, 0.5);
      padding: var(--spacing-lg);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .dhc-title-line {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-lg);
      padding-bottom: var(--spacing-sm);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      flex-wrap: wrap;
    }

    .dhc-mark-mobile {
      display: inline-block;
      font-size: 1.5rem;
      font-weight: 900;
    }

    .detailed-horse-card.honmei .dhc-mark-mobile {
      color: #3b82f6;
    }

    .detailed-horse-card.taikou .dhc-mark-mobile {
      color: #3b82f6;
    }

    .detailed-horse-card.tanana .dhc-mark-mobile {
      color: #f59e0b;
    }

    .dhc-number {
      font-size: 1.25rem;
      font-weight: 900;
      color: #60a5fa;
      font-family: 'Courier New', monospace;
      padding: 4px 12px;
      background: rgba(96, 165, 250, 0.15);
      border: 2px solid rgba(96, 165, 250, 0.4);
      border-radius: var(--radius-sm);
      display: inline-block;
    }

    .dhc-name {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
      flex: 1;
    }

    .dhc-role-badge {
      padding: 4px 12px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid rgba(139, 92, 246, 0.5);
      border-radius: 12px;
      font-size: 0.875rem;
      font-weight: 600;
      color: #a78bfa;
    }

    .dhc-quick-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-md);
    }

    .qm-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .qm-label {
      font-size: 0.7rem;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .qm-value {
      font-size: 1.125rem;
      font-weight: 800;
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
    }

    .qm-value.risk-low {
      color: #10b981;
    }

    .qm-value.risk-medium {
      color: #f59e0b;
    }

    .qm-value.risk-high {
      color: #ef4444;
    }

    .qm-value.positive {
      color: #10b981;
    }

    .qm-value.negative {
      color: #ef4444;
    }

    /* Feature Analysis */
    .dhc-features {
      margin-bottom: var(--spacing-xl);
    }

    .feature-title {
      font-size: 1rem;
      font-weight: 700;
      color: #60a5fa;
      margin-bottom: var(--spacing-md);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .feature-grid {
      display: grid;
      gap: var(--spacing-md);
    }

    .feature-item {
      display: grid;
      grid-template-columns: 200px 1fr 60px;
      align-items: center;
      gap: var(--spacing-md);
      padding: var(--spacing-sm);
      background: rgba(0, 0, 0, 0.2);
      border-radius: var(--radius-sm);
    }

    .feature-label {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .feature-icon {
      font-size: 1.125rem;
    }

    .feature-bar-container {
      position: relative;
      height: 8px;
      background: rgba(0, 0, 0, 0.4);
      border-radius: 4px;
      overflow: hidden;
    }

    .feature-bar {
      height: 100%;
      background: linear-gradient(90deg, #3b82f6, #8b5cf6);
      border-radius: 4px;
      transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .feature-bar::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      right: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      animation: shimmer 2s infinite;
    }

    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    .feature-bar-container.trend {
      position: relative;
      background: linear-gradient(90deg,
        rgba(239, 68, 68, 0.3) 0%,
        rgba(0, 0, 0, 0.4) 50%,
        rgba(16, 185, 129, 0.3) 100%);
    }

    .feature-bar-center {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: rgba(255, 255, 255, 0.3);
    }

    .feature-bar.trend {
      position: absolute;
      top: 0;
      height: 100%;
    }

    .feature-value {
      font-size: 0.875rem;
      font-weight: 800;
      color: #60a5fa;
      font-family: 'Courier New', monospace;
      text-align: right;
    }

    /* Confidence Interval */
    .dhc-confidence {
      margin-top: var(--spacing-lg);
      padding: var(--spacing-lg);
      background: rgba(139, 92, 246, 0.05);
      border-radius: var(--radius-md);
      border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .confidence-title {
      font-size: 0.875rem;
      font-weight: 700;
      color: #a78bfa;
      margin-bottom: var(--spacing-md);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .confidence-range {
      display: grid;
      grid-template-columns: 60px 1fr 60px;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-sm);
    }

    .range-value {
      font-size: 0.875rem;
      font-weight: 700;
      color: #c4b5fd;
      font-family: 'Courier New', monospace;
      text-align: center;
    }

    .range-bar {
      position: relative;
      height: 24px;
      background: rgba(30, 41, 59, 0.5);
      border-radius: 12px;
      overflow: visible;
    }

    .range-fill {
      position: absolute;
      top: 0;
      height: 100%;
      background: linear-gradient(90deg, #8b5cf6, #a78bfa);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .range-point {
      position: absolute;
      width: 12px;
      height: 12px;
      background: white;
      border: 3px solid #8b5cf6;
      border-radius: 50%;
      box-shadow: 0 0 10px rgba(139, 92, 246, 0.6);
      transform: translateX(-50%);
    }

    .confidence-note {
      font-size: 0.8125rem;
      color: var(--text-secondary);
      text-align: center;
    }

    .confidence-note strong {
      color: #60a5fa;
    }

    /* 上位5頭表示用のランクバッジ */
    .rank-badge-large {
      position: absolute;
      top: var(--spacing-md);
      left: var(--spacing-md);
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      color: #1e293b;
      font-weight: 700;
      font-size: 1.125rem;
      padding: var(--spacing-xs) var(--spacing-md);
      border-radius: var(--radius-md);
      box-shadow: 0 2px 8px rgba(251, 191, 36, 0.3);
      z-index: 1;
    }

    .candidate-badge {
      position: absolute;
      top: var(--spacing-md);
      left: var(--spacing-md);
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.3) 0%, rgba(167, 139, 250, 0.3) 100%);
      color: #a78bfa;
      font-weight: 600;
      font-size: 0.95rem;
      padding: var(--spacing-xs) var(--spacing-md);
      border-radius: var(--radius-md);
      border: 1px solid rgba(139, 92, 246, 0.5);
      z-index: 1;
    }

    .detailed-horse-card.top-horse-detailed,
    .detailed-horse-card.top-horse-simple {
      margin-bottom: var(--spacing-lg);
      position: relative;
    }

    .detailed-horse-card.top-horse-detailed .dhc-header,
    .detailed-horse-card.top-horse-simple .dhc-header {
      padding-top: calc(var(--spacing-md) + 40px);
    }

    /* 簡易表示（3位以降）はコンパクトに */
    .detailed-horse-card.top-horse-simple {
      background: var(--bg-card);
      border: 1px solid rgba(251, 191, 36, 0.2);
    }

    .detailed-horse-card.top-horse-simple:hover {
      border-color: rgba(251, 191, 36, 0.4);
    }

    /* アップグレード誘導ボックス */
    .upgrade-cta-box {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(245, 158, 11, 0.1) 100%);
      border: 2px solid #fbbf24;
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl);
      text-align: center;
      margin: var(--spacing-xl) 0;
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.2);
    }

    .upgrade-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
    }

    .upgrade-cta-box h3 {
      font-size: 1.5rem;
      margin-bottom: var(--spacing-sm);
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .upgrade-cta-box p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
      line-height: 1.6;
    }

    .upgrade-benefits-mini {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      justify-content: center;
      margin-bottom: var(--spacing-lg);
    }

    .upgrade-benefits-mini span {
      background: rgba(251, 191, 36, 0.1);
      color: var(--text-primary);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 600;
    }

    /* 無料会員登録特典セクション */
    .upgrade-benefits {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
      margin-top: var(--spacing-lg);
    }

    .benefit-section {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
    }

    .benefit-section h3 {
      font-size: 1.125rem;
