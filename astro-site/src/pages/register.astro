---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '無料会員登録 - KEIBA Intelligence';
const description = '無料会員登録で印（◎○▲△）が見られます。全頭の馬柱・過去走・AI短評は登録なしで公開中。メールアドレスのみで簡単登録。';
---

<BaseLayout title={title} description={description}>
  {/*
    🔴 ログイン中にこの画面を開いたときの案内。
       静的ページなので Cookie は読めない。`BaseLayout` の `syncAuthNav` が
       読み込み後に `[data-auth-in]` を出す（表示だけ。認可には関係しない）。
  */}
  <div class="already-signed-in" data-auth-in hidden>
    <p>すでにログインしています。</p>
    <a href="/mypage">マイページへ</a>
  </div>

  <main class="container">
    <div class="register-page">
      <div class="register-header">
        <h1>🎁 無料会員登録</h1>
        <p class="subtitle">全12レースの全頭予想が見られる！</p>
      </div>

      <!-- 無料会員の特典 -->
      <section class="benefits">
        <h2>無料会員の特典</h2>
        <div class="benefit-grid">
          <div class="benefit-card">
            <div class="benefit-icon">🏇</div>
            <h3>全頭の馬柱</h3>
            <p>全レースの馬柱・過去走・AI短評（登録なしでも公開）</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">🎯</div>
            <h3>印（◎○▲△）</h3>
            <p>1頭に複数の印。該当しない馬は空欄</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">📊</div>
            <h3>AI分析</h3>
            <p>Feature Importance分析データ</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">📧</div>
            <h3>メルマガ配信</h3>
            <p>週次レポート・限定オファー</p>
          </div>
        </div>
      </section>

      <!-- 登録フォーム -->
      <section class="register-form-section">
        <div class="form-container">
          <h2>メールアドレスで登録</h2>
          <p class="form-description">登録完了メールのリンクをクリックして認証してください</p>

          <!--
            🔴 結果メッセージはフォームの**上**に置く。
               以前はフォームの下（ログインリンクの下）にあり、
               ボタンを押した位置から遠く、画面下に埋もれて気づけなかった。
          -->
          <div id="message" class="message" role="status" aria-live="polite" tabindex="-1"></div>

          <form id="registerForm" class="register-form">
            <div class="form-group">
              <label for="email">メールアドレス</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="your-email@example.com"
                required
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="emailConfirm">メールアドレス（確認）</label>
              <input
                type="email"
                id="emailConfirm"
                name="emailConfirm"
                placeholder="もう一度入力してください"
                required
                autocomplete="off"
              />
              <div id="emailMatchError" class="error-message hidden">
                ⚠️ メールアドレスが一致しません
              </div>
            </div>

            <div class="terms-notice">
              <p>
                登録することで、
                <a href="/terms" target="_blank">利用規約</a>および
                <a href="/privacy" target="_blank">プライバシーポリシー</a>に同意し、
                メールマガジンの配信を承諾したものとみなします。
              </p>
            </div>

            <button type="submit" class="btn-register" id="submitBtn">
              無料で登録する
            </button>

            <div class="login-link">
              <p>すでに登録済みの方は <a href="/login">ログイン</a></p>
            </div>
          </form>
        </div>
      </section>

      <!-- 有料プランへの誘導 -->
      <section class="upgrade-section">
        <h2>🚀 有料会員になると...</h2>
        <div class="upgrade-grid">
          <div class="upgrade-item">
            <span class="upgrade-icon">✅</span>
            <span>全買い目（本線+抑え）が見られる</span>
          </div>
          <div class="upgrade-item">
            <span class="upgrade-icon">✅</span>
            <span>全期間の的中実績が見られる</span>
          </div>
          <div class="upgrade-item">
            <span class="upgrade-icon">✅</span>
            <span>南関東＋中央競馬の馬単買い目</span>
          </div>
        </div>
        <a href="/pricing" class="btn-upgrade">料金プランを見る →</a>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('registerForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const messageDiv = document.getElementById('message') as HTMLDivElement;

  /**
   * 結果メッセージを**確実に見える位置**へ運ぶ。
   * 🔴 出しただけでは、スクロール位置によっては画面外のままになる。
   *    スクリーンリーダーへは role="status" が読み上げる。
   */
  function revealMessage() {
    try {
      messageDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      messageDiv.focus({ preventScroll: true });
    } catch {
      messageDiv.scrollIntoView();
    }
  }
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const emailConfirmInput = document.getElementById('emailConfirm') as HTMLInputElement;
  const emailMatchError = document.getElementById('emailMatchError') as HTMLDivElement;

  // リアルタイム検証（確認用メールアドレス入力時）
  emailConfirmInput?.addEventListener('input', () => {
    const email = emailInput.value;
    const emailConfirm = emailConfirmInput.value;

    if (emailConfirm && email !== emailConfirm) {
      emailMatchError?.classList.remove('hidden');
      emailConfirmInput.style.borderColor = '#ef4444';
    } else {
      emailMatchError?.classList.add('hidden');
      emailConfirmInput.style.borderColor = '';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = emailInput.value;
    const emailConfirm = emailConfirmInput.value;

    // メールアドレス一致チェック
    if (email !== emailConfirm) {
      emailMatchError?.classList.remove('hidden');
      emailConfirmInput.style.borderColor = '#ef4444';
      emailConfirmInput.focus();
      return;
    }

    emailMatchError?.classList.add('hidden');
    emailConfirmInput.style.borderColor = '';

    // ボタン無効化
    submitBtn.disabled = true;
    submitBtn.textContent = '送信中...';
    messageDiv.textContent = '';
    messageDiv.className = 'message';

    try {
      const response = await fetch('/.netlify/functions/register-free', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email }),
      });

      const data = await response.json();

      if (response.ok && data.alreadyRegistered) {
        // 🔴 認証済みの会員。メールは送っていないので「送信しました」と言わない
        messageDiv.innerHTML =
          'ℹ️ このメールアドレスは既に登録済みです。<a href="/login">ログイン</a>してください。';
        messageDiv.className = 'message notice';
      } else if (response.ok) {
        messageDiv.textContent = data.resent
          ? '✅ 確認メールを再送しました。メールをご確認ください。'
          : '✅ 登録完了メールを送信しました。メールをご確認ください。';
        messageDiv.className = 'message success';
        form.reset();
      } else {
        messageDiv.textContent = `❌ ${data.error || '登録に失敗しました'}`;
        messageDiv.className = 'message error';
      }
      revealMessage();
    } catch (error) {
      messageDiv.textContent = '❌ ネットワークエラーが発生しました';
      messageDiv.className = 'message error';
      revealMessage();
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '無料で登録する';
    }
  });
</script>

<style>
.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.register-page {
  display: flex;
  flex-direction: column;
  gap: 3rem;
}

/* ヘッダー */
.register-header {
  text-align: center;
  padding: 2rem 0;
}

.register-header h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  font-size: 1.2rem;
  color: var(--text-primary);
  font-weight: 600;
}

/* 特典セクション */
.benefits {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  border: 1px solid var(--border-color);
}

.benefits h2 {
  text-align: center;
  margin-bottom: 2rem;
  background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}

.benefit-card {
  text-align: center;
  padding: 1.5rem;
  background: var(--background);
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.benefit-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.benefit-card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
}

.benefit-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* 登録フォーム */
.register-form-section {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  border: 1px solid var(--border-color);
}

.form-container {
  max-width: 500px;
  margin: 0 auto;
}

.form-container h2 {
  text-align: center;
  margin-bottom: 0.5rem;
  background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.form-description {
  text-align: center;
  margin-bottom: 2rem;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.register-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-weight: 600;
  color: var(--heading-color);
}

.form-group input {
  padding: 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  font-size: 1rem;
  background: var(--background);
  color: var(--text-color);
}

.form-group input:focus {
  outline: none;
  border-color: var(--primary-blue);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.terms-notice {
  padding: 1rem;
  background: var(--background);
  border-radius: 6px;
  border: 1px solid var(--border-color);
}

.terms-notice p {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.terms-notice a {
  color: var(--primary-blue);
  text-decoration: none;
}

.terms-notice a:hover {
  text-decoration: underline;
}

/* 登録 / 強い行動: 桃 → 橙（旧 #fbbf24→#f59e0b は同系色の濃淡） */
.btn-register {
  padding: 1rem 2rem;
  background: var(--grad-action-btn);
  color: var(--btn-ink); /* 7.15 / 11.34 */
  border: none;
  border-radius: 8px;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 0 0 2px rgba(219, 39, 119, 0.3), 0 4px 12px rgba(194, 65, 12, 0.4);
}

.btn-register:hover:not(:disabled) {
  background: linear-gradient(135deg, #fcd34d 0%, #fbbf24 100%);
  transform: translateY(-2px);
  box-shadow: 0 0 0 2px rgba(251, 191, 36, 0.5), 0 6px 16px rgba(251, 191, 36, 0.6);
  color: #0f172a;
}

.btn-register:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.login-link {
  text-align: center;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
}

.login-link a {
  color: var(--primary-blue);
  text-decoration: none;
  font-weight: 600;
}

.login-link a:hover {
  text-decoration: underline;
}

/* エラーメッセージ */
.error-message {
  margin-top: 0.5rem;
  padding: 0.75rem;
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border: 1px solid #ef4444;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.error-message.hidden {
  display: none;
}

/* メッセージ */
/* 🔴 空のときは余白を作らない（フォームが下へずれない） */
.message {
  display: none;
}

.message.success,
.message.error,
.message.notice {
  display: block;
  margin-bottom: 1.25rem;
  padding: 1rem 1.25rem;
  border-radius: 8px;
  text-align: center;
  font-weight: 700;
  font-size: 1.05rem;
  line-height: 1.6;
  scroll-margin-top: 1rem;
}

/* キーボード操作でフォーカスを当てたときに枠を二重に出さない */
.message:focus {
  outline: none;
}

.message.success {
  background: rgba(34, 197, 94, 0.12);
  color: #16a34a;
  border: 2px solid #22c55e;
}

.message.error {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
  border: 2px solid #ef4444;
}

/* 登録済みの案内（エラーではないので赤くしない） */
.message.notice {
  background: rgba(59, 130, 246, 0.12);
  color: #1d4ed8;
  border: 2px solid #3b82f6;
}

.message.notice a {
  color: inherit;
  font-weight: 800;
  text-decoration: underline;
}

/* アップグレードセクション */
.upgrade-section {
  background: linear-gradient(135deg, var(--card-bg) 0%, rgba(59, 130, 246, 0.05) 100%);
  padding: 2rem;
  border-radius: 12px;
  border: 2px solid var(--primary-blue);
  text-align: center;
}

.upgrade-section h2 {
  margin-bottom: 1.5rem;
  background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.upgrade-grid {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2rem;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

.upgrade-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: var(--background);
  border-radius: 6px;
  text-align: left;
}

.upgrade-icon {
  font-size: 1.5rem;
}

/* 主要 CTA: 青 → 紫（白文字が AA を満たす濃いストップへ） */
.btn-upgrade {
  display: inline-block;
  padding: 1rem 2rem;
  background: var(--grad-nav-btn);
  color: var(--btn-ink); /* 8.84 / 6.96 */
  text-decoration: none;
  border-radius: 8px;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.btn-upgrade:hover {
  background: var(--grad-nav-btn);
  filter: brightness(1.08);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(59, 130, 246, 0.4);
}

/* レスポンシブ */
@media (max-width: 768px) {
  .register-header h1 {
    font-size: 2rem;
  }

  .benefit-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .register-form-section,
  .benefits,
  .upgrade-section {
    padding: 1.5rem;
  }
}

@media (max-width: 480px) {
  .benefit-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<style>
  .already-signed-in {
    max-width: 520px;
    margin: 24px auto 0;
    padding: 14px 18px;
    border-radius: var(--radius-md);
    background: var(--outlook-bg);
    border: 1px solid var(--outlook-border);
    text-align: center;
    font-size: 0.9rem;
  }

  .already-signed-in p { margin: 0 0 8px; color: var(--text-secondary); }

  .already-signed-in a { font-weight: 700; color: var(--primary-start); }

  .already-signed-in[hidden] { display: none !important; }
</style>
