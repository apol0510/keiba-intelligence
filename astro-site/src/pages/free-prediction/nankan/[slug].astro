---
/**
 * /free-prediction/nankan/[slug] — 南関の特定開催（`/prediction/[slug]` と同一内容）
 *
 * 正本: docs/RENEWAL_2026_08.md
 *
 * 🔴 2026-08-28 全面改修:
 *   旧実装は `prerender = true` の静的ページで、**閲覧者によらず同じ HTML** を返していた。
 *   tier で印を出し分けるにはリクエスト単位の判定が必要なため SSR へ切り替えた
 *   （印は無料会員以上。U-1）。
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceDayBoard from '../../../components/newspaper/RaceDayBoard.astro';
import TierRibbon from '../../../components/newspaper/TierRibbon.astro';
import { loadNankanRaceDayBySlug } from '../../../lib/prediction/loadRaceDay.js';
import { entitlementFromAstro, freePageViewFlags } from '../../../lib/auth/entitlement.js';

export const prerender = false;

const { slug } = Astro.params;

const entitlement = entitlementFromAstro(Astro);
// 🔴 無料ページは tier を問わず買い目を出さない（有料会員でも「無料の見え方」）
const view = freePageViewFlags(entitlement);
const day = loadNankanRaceDayBySlug(slug, process.cwd());

const venueNames = day.venues.map((v) => v.venueName).join('・');
const title = day.date
  ? `${venueNames} ${day.date} の無料予想 - KEIBA Intelligence`
  : '無料予想 - KEIBA Intelligence';
const description = `${venueNames || '南関東'}${day.date || ''}の全レース馬柱・過去走・AI短評・展開予想を無料公開。`;
---

<BaseLayout title={title} description={description} canonicalPath={slug ? `/prediction/${slug}` : '/prediction/nankan'}>
  <div class="container prediction-page">
    <TierRibbon view={view} />
    <RaceDayBoard day={day} view={view} category="nankan" />
    <p class="pp-back"><a href="/free-prediction/nankan">← 最新の南関予想へ</a></p>
  </div>
</BaseLayout>

<style>
  .prediction-page { padding-top: 8px; padding-bottom: 40px; }
  .pp-back { margin-top: 24px; font-weight: 700; }
</style>
