  <script is:inline>
    // 会場切り替え関数
    function selectVenue(event, button) {
      event.preventDefault();

      const venueName = button.getAttribute('data-venue-name');
      console.log('🏇 会場切り替え:', venueName);

      // すべての会場ボタンからactiveを削除
      document.querySelectorAll('.venue-btn').forEach(btn => {
        btn.classList.remove('active');
      });

      // クリックされたボタンをアクティブに
      button.classList.add('active');

      // 会場データをリロード（ページ全体をリロードせず、JavaScriptで切り替え）
      // 今のところシンプルに、URLパラメータで切り替える方法を使用
      const url = new URL(window.location.href);
      url.searchParams.set('venue', venueName);
      window.location.href = url.toString();
    }

    function selectRace(event, button) {
      event.preventDefault();

      const raceIndex = button.getAttribute('data-race-index');

      // すべてのボタンからactiveを削除
      document.querySelectorAll('.race-btn').forEach(btn => {
        btn.classList.remove('active');
      });

      // クリックされたボタンをアクティブに
      button.classList.add('active');

      // すべてのレースコンテンツを非表示
      document.querySelectorAll('.race-content').forEach(content => {
        content.classList.remove('active');
      });

      // 選択されたレースを表示
      const selectedRace = document.querySelector(`.race-content[data-race-index="${raceIndex}"]`);
      if (selectedRace) {
        selectedRace.classList.add('active');

        // カウンターアニメーション再実行
        selectedRace.querySelectorAll('[data-counter]').forEach(el => {
          const target = parseInt(el.getAttribute('data-counter'));
          animateCounter(el, target);
        });
      }
    }

    // カウンターアニメーション
    function animateCounter(element, target) {
      const duration = 1500;
      const start = 0;
      const startTime = Date.now();

      function update() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        const easeProgress = 1 - Math.pow(1 - progress, 3); // easeOut
        const current = Math.floor(easeProgress * target);
        element.textContent = current.toLocaleString();

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      update();
    }

    // ページ読み込み時にカウンターアニメーション実行
    document.addEventListener('DOMContentLoaded', () => {
      const activeRace = document.querySelector('.race-content.active');
      if (activeRace) {
        activeRace.querySelectorAll('[data-counter]').forEach(el => {
          const target = parseInt(el.getAttribute('data-counter'));
          animateCounter(el, target);
        });
      }
    });
  </script>
