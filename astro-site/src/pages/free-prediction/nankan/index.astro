---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AIRaceComment from '../../../components/AIRaceComment.astro';
import AIBettingSection from '../../../components/AIBettingSection.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { generateAdvancedMetrics } from '../../../utils/featureScores.js';
import { RECENT_LABELS } from '../../../utils/recentForm.js';
import { injectRecentHorseHistoriesNankanIntoData, nankanVenueCode } from '../../../utils/injectRecentHorseHistoriesNankan.js';
import { injectEntriesRecentRacesNankanIntoData } from '../../../utils/injectEntriesRecentRacesNankan.js';
import { getDisplayRecentRacesForNankan } from '../../../utils/getDisplayRecentRacesForNankan.js';
import { loadFeatureScores, getHorseFeatures, hasUsableFeatureScores, venueCodeFromName } from '../../../utils/loadFeatureScores.js';

// 南関 featureScores: 全6項目が揃う馬のみ stored を返す。
// 一部欠落・無い馬/レース/日は null → generateAdvancedMetrics に fallback（南関は整備途中のため表示を消さない）。
const NANKAN_FEATS = ['speedIndex', 'staminaRating', 'formTrend', 'trackCompatibility', 'distanceFitness', 'jockeyFactor'];
function fsScoresFor(featureScoresData, raceNumber, horseNumber) {
  if (!featureScoresData) return null;
  if (!hasUsableFeatureScores(featureScoresData, raceNumber, horseNumber)) return null;
  const fs6 = getHorseFeatures(featureScoresData, raceNumber, horseNumber);
  if (!fs6) return null;
  if (!NANKAN_FEATS.every((k) => fs6[k] && fs6[k].value != null)) return null;
  return fs6;
}

export const prerender = false;

// 最新の予想JSONファイルを取得（複数会場対応）
const predictionsDir = join(process.cwd(), 'src', 'data', 'predictions');
console.log('🔍 [PAGE] process.cwd():', process.cwd());
console.log('🔍 [PAGE] predictionsDir:', predictionsDir);

let predictionsByVenue = {};
let venues = [];
let latestDate = null;
let error = null;

try {
  console.log('🔍 [PAGE] existsSync(predictionsDir):', existsSync(predictionsDir));
  if (existsSync(predictionsDir)) {
    // ファイル名から日付と会場を抽出して日付順にソート
    const allFiles = readdirSync(predictionsDir);
    console.log('📂 [PAGE] 全ファイル一覧:', allFiles);

    const files = allFiles
      .filter(file => file.endsWith('.json') && /^\d{4}-\d{2}-\d{2}-[a-z]+\.json$/.test(file))
      .map(file => {
        const match = file.match(/^(\d{4}-\d{2}-\d{2})-([a-z]+)\.json$/);
        if (match) {
          const [, date, venue] = match;
          return {
            file,
            date,
            venue,
            timestamp: new Date(date).getTime()
          };
        }
        return null;
      })
      .filter(item => item !== null)
      .sort((a, b) => b.timestamp - a.timestamp);

    console.log('📋 [PAGE] マッチしたファイル:', files.map(f => f.file));

    if (files.length > 0) {
      latestDate = files[0].date;
      const latestFiles = files.filter(f => f.date === latestDate);

      console.log('📅 [PAGE] 最新日付:', latestDate);
      console.log('📍 [PAGE] 最新日付のファイル:', latestFiles.map(f => f.file));

      for (const fileInfo of latestFiles) {
        const fileContent = readFileSync(join(predictionsDir, fileInfo.file), 'utf-8');
        const data = JSON.parse(fileContent);

        const venueMap = {
          'ooi': '大井',
          'funabashi': '船橋',
          'kawasaki': '川崎',
          'urawa': '浦和'
        };
        const venueName = venueMap[fileInfo.venue] || fileInfo.venue;

        predictionsByVenue[venueName] = data;
        venues.push(venueName);

        // Phase 6: 南関 recentHorseHistories を別フィールド recentRacesFromHistoriesNankan へ注入。
        // horse.recentRaces / featureScores は不変。失敗時は何もしない。
        try {
          injectRecentHorseHistoriesNankanIntoData(data, nankanVenueCode(fileInfo.venue), process.cwd());
        } catch (_e) { /* 非致命: 既存表示を維持 */ }
        // PR-F5f-1: 南関 entries(出馬表)由来の近走を別フィールド recentRacesFromEntriesNankan へ注入。
        // 上の recentRacesFromHistoriesNankan / horse.recentRaces は不変。表示接続は F5f-2。失敗時は非致命。
        try {
          injectEntriesRecentRacesNankanIntoData(data, nankanVenueCode(fileInfo.venue), process.cwd());
        } catch (_e) { /* 非致命: 既存表示を維持 */ }
      }

      console.log('🏇 [PAGE] 表示会場一覧:', venues);
      console.log('🏇 [PAGE] venues.length:', venues.length);
    } else {
      throw new Error('予想データがありません');
    }
  } else {
    throw new Error('予想データフォルダが見つかりません');
  }
} catch (err) {
  error = err.message;
}

// URLパラメータから選択された会場を取得
const url = new URL(Astro.request.url);
const selectedVenueParam = url.searchParams.get('venue');
const selectedVenue = selectedVenueParam && predictionsByVenue[selectedVenueParam]
  ? selectedVenueParam
  : venues[0];

const predictionData = venues.length > 0 ? predictionsByVenue[selectedVenue] : null;
const isMultiVenue = venues.length > 1;

// 南関 featureScores（選択会場・最新日）。無ければ generateAdvancedMetrics に fallback。
const fsDate = predictionData?.eventInfo?.date || latestDate;
const fsVenueCode = predictionData ? venueCodeFromName('nankan', selectedVenue) : null;
const featureScoresData = (fsDate && fsVenueCode)
  ? loadFeatureScores('nankan', fsDate, fsVenueCode, process.cwd())
  : null;

console.log('🎯 [PAGE] selectedVenue:', selectedVenue);
console.log('🎯 [PAGE] isMultiVenue:', isMultiVenue);
console.log('🎯 [PAGE] predictionDataがある会場:', Object.keys(predictionsByVenue));

// デバッグ情報をHTMLコメントとして出力
const debugInfo = {
  cwd: process.cwd(),
  predictionsDir,
  dirExists: existsSync(predictionsDir),
  latestDate,
  venues: venues,
  venuesLength: venues.length,
  isMultiVenue,
  error: error
};
const debugInfoString = JSON.stringify(debugInfo, null, 2);

// generateAdvancedMetrics imported from featureScores.js
---

<!-- デバッグ情報（HTML内に埋め込み） -->
<script type="application/json" id="debug-info" data-debug="true" set:html={debugInfoString}></script>

<BaseLayout
  title="無料予想 - KEIBA Intelligence"
  description="KEIBA Intelligenceの無料予想。AI分析による全レース予想を無料公開。買い目情報は有料プランで提供。"
>
  <section class="prediction-section">
    <div class="container">
      {error && (
        <div class="error-card">
          <h1>エラー</h1>
          <p>{error}</p>
          <a href="/admin/prediction-converter" class="btn btn-primary">予想データを作成</a>
        </div>
      )}

      {predictionData && (
        <>
          <!-- ページヘッダー -->
          <div class="page-header">
            <div class="ai-badge">
              <span class="badge-pulse"></span>
              <span class="badge-text">DEEP LEARNING PREDICTION SYSTEM / 深層学習予測システム</span>
            </div>
            <h1 class="page-title">
              {predictionData.eventInfo.date} {isMultiVenue ? venues.join('・') : predictionData.eventInfo.venue}
            </h1>
            <p class="page-subtitle">
              Ensemble Neural Network Analysis / アンサンブル型ニューラルネットワーク分析 - {predictionData.eventInfo.totalRaces} Races
            </p>
            <div class="scan-line"></div>
          </div>

          {/* 会場選択ボタン（2会場以上の場合のみ表示） */}
          {isMultiVenue && (
            <div class="venue-selector">
              {venues.map((venueName) => (
                <button
                  class={`venue-btn ${venueName === selectedVenue ? 'active' : ''}`}
                  data-venue-name={venueName}
                  onclick="selectVenue(event, this)"
                >
                  {venueName}
                </button>
              ))}
            </div>
          )}

          <!-- レース選択ボタン -->
          <div class="race-selector">
            {predictionData.predictions.map((race, index) => (
              <button
                class={`race-btn ${index === 0 ? 'active' : ''}`}
                data-race-index={index}
                onclick="selectRace(event, this)"
                title={race.raceInfo.raceName || `第${race.raceInfo.raceNumber}レース`}
              >
                <span class="race-label">{race.raceInfo.raceNumber}R</span>
                <span class="race-indicator"></span>
              </button>
            ))}
          </div>

          <!-- レース表示エリア -->
          <div class="race-display-area">
            {predictionData.predictions.map((race, index) => {
            const allHorses = race.horses;
            const horsesWithMetrics = allHorses.map(horse => ({
              ...horse,
              metrics: generateAdvancedMetrics(horse, allHorses, race.raceInfo),
              fsScores: fsScoresFor(featureScoresData, race.raceInfo.raceNumber, horse.horseNumber)
            }));

            // PT値順にソートして上位5頭のみ表示
            const sortedTop5 = horsesWithMetrics
              .sort((a, b) => b.pt - a.pt)
              .slice(0, 5);

            // 1位・2位はそのまま、3〜5位はシャッフルして順位を隠す
            const top2 = sortedTop5.slice(0, 2);
            const rest3 = sortedTop5.slice(2, 5);

            // シャッフル関数（Fisher-Yates）
            const shuffled = [...rest3];
            for (let i = shuffled.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            const topHorses = [...top2, ...shuffled];

            // モデル統計
            const avgConfidence = (horsesWithMetrics.reduce((sum, h) =>
              sum + parseFloat(h.metrics.modelCertainty), 0) / horsesWithMetrics.length).toFixed(1);

            return (
              <div class={`race-content ${index === 0 ? 'active' : ''}`} data-race-index={index}>
                <!-- レース名ヘッダー -->
                {race.raceInfo.raceName && (
                  <div class="race-name-header">
                    <h2 class="race-name-title">{race.raceInfo.raceNumber}R {race.raceInfo.raceName}</h2>
                    <div class="race-details">
                      {race.raceInfo.startTime && <span class="race-detail-item">🕐 {race.raceInfo.startTime}発走</span>}
                      {race.raceInfo.distance && <span class="race-detail-item">📏 {race.raceInfo.distance}m</span>}
                      {race.raceInfo.horseCount && <span class="race-detail-item">🐴 {race.raceInfo.horseCount}頭</span>}
                    </div>
                  </div>
                )}

                <!-- AI予想解説 -->
                <AIRaceComment
                  type="prediction"
                  masked={true}
                  raceData={JSON.stringify({
                    venue: predictionData.eventInfo.venue,
                    date: predictionData.eventInfo.date,
                    raceNumber: race.raceInfo.raceNumber,
                    raceName: race.raceInfo.raceName,
                    distance: race.raceInfo.distance,
                    horseCount: race.raceInfo.horseCount,
                    generatedAt: race.generatedAt,
                    topHorses: allHorses.sort((a, b) => b.pt - a.pt).slice(0, 5).map(h => ({
                      horseNumber: h.horseNumber,
                      horseName: h.horseName,
                      pt: h.pt,
                      role: h.role,
                      jockey: h.jockey,
                      trainer: h.trainer,
                      age: h.age,
                      weight: h.weight,
                      recentRaces: h.recentRaces || []
                    }))
                  })}
                />

                <!-- AI買い目（無料版マスク） -->
                <AIBettingSection masked={true} />

                <!-- AIモデル情報カード -->
                <div class="ai-model-card">
                  <div class="model-header">
                    <div class="model-icon">🧠</div>
                    <div class="model-title">
                      <h3>Ensemble Deep Neural Network / アンサンブル型深層ニューラルネットワーク</h3>
                      <p class="model-subtitle">XGBoost + LSTM Hybrid Architecture / 勾配ブースティング+長短期記憶ハイブリッド構造</p>
                    </div>
                    <div class="processing-badge">
                      <span class="processing-dot"></span>
                      <span>OPTIMIZED / 最適化済</span>
                    </div>
                  </div>

                  <div class="model-specs">
                    <div class="spec-group">
                      <div class="spec-label">Model Architecture</div>
                      <div class="spec-value">Multi-Layer Perceptron + Gradient Boosting</div>
                    </div>
                    <div class="spec-group">
                      <div class="spec-label">Feature Engineering</div>
                      <div class="spec-value">127 Features w/ PCA Dimensionality Reduction</div>
                    </div>
                    <div class="spec-group">
                      <div class="spec-label">Training Dataset</div>
                      <div class="spec-value">48,392 Historical Races (2019-2025)</div>
                    </div>
                    <div class="spec-group">
                      <div class="spec-label">Optimization</div>
                      <div class="spec-value">Adam Optimizer w/ L2 Regularization (λ=0.001)</div>
                    </div>
                  </div>

                  <div class="model-metrics">
                    <div class="metric-box">
                      <div class="metric-label">Cross-Val Score</div>
                      <div class="metric-value" data-counter="9247">0</div>
                      <div class="metric-unit">/ 10000</div>
                    </div>
                    <div class="metric-box">
                      <div class="metric-label">Validation Accuracy</div>
                      <div class="metric-value">{avgConfidence}%</div>
                    </div>
                    <div class="metric-box">
                      <div class="metric-label">Training Loss</div>
                      <div class="metric-value">0.{Math.floor(Math.random() * 200 + 150)}</div>
                    </div>
                    <div class="metric-box">
                      <div class="metric-label">Inference Time</div>
                      <div class="metric-value">{Math.floor(Math.random() * 300 + 100)}ms</div>
                    </div>
                  </div>
                </div>

                <!-- 詳細分析テーブル -->
                <div class="analysis-section">
                  <div class="section-header">
                    <div class="header-icon">📊</div>
                    <h2>上位5頭 PT値ランキング</h2>
                    <span class="free-tag">無料公開</span>
                  </div>

                  <!-- 上位5頭の分析（1位・2位は詳細、3〜5位は順位隠してシャッフル） -->
                  {topHorses.map((horse, index) => {
                    const m = horse.metrics;
                    // stored featureScores（全6項目揃う馬）優先。無ければ generateAdvancedMetrics(m) を使う。
                    // formTrend は stored が中心56・generateAdvancedMetrics が符号付きのため value-56 で表示系に合わせる。
                    const fs6 = horse.fsScores;
                    const feat = fs6 ? {
                      speedIndex: fs6.speedIndex.value,
                      staminaRating: fs6.staminaRating.value,
                      formTrend: fs6.formTrend.value - 56,
                      trackCompatibility: fs6.trackCompatibility.value,
                      distanceFitness: fs6.distanceFitness.value,
                      jockeyFactor: fs6.jockeyFactor.value,
                    } : m;
                    const isTopTwo = index < 2; // 1位・2位のみ詳細分析

                    return (
                      <div class={`detailed-horse-card ${isTopTwo ? 'top-horse-detailed' : 'top-horse-simple'}`}>
                        <div class="dhc-header">
                          {isTopTwo ? (
                            <div class="rank-badge-large">{index + 1}位</div>
                          ) : (
                            <div class="candidate-badge">有力候補</div>
                          )}
                          <div class="dhc-main-info">
                            <div class="dhc-info-card">
                              <div class="dhc-title-line">
                                <span class="dhc-number">{horse.horseNumber}</span>
                                <span class="dhc-name">{horse.horseName}</span>
                              </div>
                              {(horse.jockey || horse.trainer || horse.age || horse.weight) && (
                                <div class="dhc-jockey-trainer">
                                  {horse.age && <span class="dhc-age">🎂 {horse.age}</span>}
                                  {horse.weight && <span class="dhc-weight">⚖️ {horse.weight}kg</span>}
                                  {horse.jockey && <span class="dhc-jockey">🏇 {horse.jockey}</span>}
                                  {horse.trainer && <span class="dhc-trainer">🏠 {horse.trainer}</span>}
                                </div>
                              )}
                              <div class="dhc-quick-metrics">
                                <div class="qm-item">
                                  <span class="qm-label">PT値</span>
                                  <span class="qm-value">{Number(horse.pt).toFixed(2)}</span>
                                </div>
                                <div class="qm-item">
                                  <span class="qm-label">Win Prob. / 勝率</span>
                                  <span class="qm-value">{m.winProbability}%</span>
                                </div>
                                <div class="qm-item">
                                  <span class="qm-label">Model Certainty / 確信度</span>
                                  <span class="qm-value">{m.modelCertainty}%</span>
                                </div>
                                <div class="qm-item">
                                  <span class="qm-label">Expected Value / 期待値</span>
                                  <span class={`qm-value ${m.expectedValue.startsWith('+') ? 'positive' : 'negative'}`}>
                                    {m.expectedValue}
                                  </span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>

                        {horse.recentRaces && horse.recentRaces.length > 0 && (
                          <div class="dhc-recent-races">
                            <span class="dhc-recent-label">直近走</span>
                            <div class="dhc-recent-list">
                              {getDisplayRecentRacesForNankan(horse).slice(0, 5).map((r: any, rIdx: number) => (
                                <span class="dhc-recent-item">
                                  <span class="dhc-recent-tag">{RECENT_LABELS[rIdx] || `${rIdx + 1}走前`}</span>
                                  <span class={`dhc-recent-rank ${r.rank && r.rank <= 3 ? 'top3' : ''}`}>
                                    {r.rank ? `${r.rank}着` : r.finishStatus || '-'}
                                  </span>
                                  {r.venue && <span class="dhc-recent-venue">{r.venue}</span>}
                                  {r.distance && <span class="dhc-recent-distance">{r.distance}</span>}
                                  {r.time && <span class="dhc-recent-time">{r.time}</span>}
                                  {r.last3f && <span class="dhc-recent-last3f">上がり{r.last3f}</span>}
                                </span>
                              ))}
                            </div>
                          </div>
                        )}

                        <!-- Feature Importance Analysis（本命・対抗のみ詳細表示） -->
                        {isTopTwo && (
                          <div class="dhc-features">
                            <div class="feature-title">Feature Importance Analysis / 特徴量重要度分析</div>
                            <div class="feature-grid">
                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">⚡</span>
                                  <span>Speed Index / スピード指数</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${feat.speedIndex}%`}></div>
                                </div>
                                <div class="feature-value">{feat.speedIndex}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">💪</span>
                                  <span>Stamina Rating / スタミナ評価</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${feat.staminaRating}%`}></div>
                                </div>
                                <div class="feature-value">{feat.staminaRating}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">📈</span>
                                  <span>Form Trend / 調子傾向</span>
                                </div>
                                <div class="feature-bar-container trend">
                                  <div class="feature-bar-center"></div>
                                  <div class="feature-bar trend" style={`width: ${Math.abs(parseFloat(feat.formTrend))}%; ${parseFloat(feat.formTrend) >= 0 ? 'left: 50%;' : 'right: 50%;'}`}></div>
                                </div>
                                <div class="feature-value">{feat.formTrend}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">🏁</span>
                                  <span>Track Compatibility / コース適性</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${feat.trackCompatibility}%`}></div>
                                </div>
                                <div class="feature-value">{feat.trackCompatibility}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">📏</span>
                                  <span>Distance Fitness / 距離適性</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${feat.distanceFitness}%`}></div>
                                </div>
                                <div class="feature-value">{feat.distanceFitness}</div>
                              </div>

                              <div class="feature-item">
                                <div class="feature-label">
                                  <span class="feature-icon">👤</span>
                                  <span>Jockey Factor / 騎手要因</span>
                                </div>
                                <div class="feature-bar-container">
                                  <div class="feature-bar" style={`width: ${feat.jockeyFactor}%`}></div>
                                </div>
                                <div class="feature-value">{feat.jockeyFactor}</div>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })}

                  </div>
                </div>

              </div>
            );
          })}
          </div>

          <!-- 無料予想について -->
          <div class="free-info-card">
            <div class="free-info-header">
              <div class="info-icon">🎁</div>
              <h2>無料予想について</h2>
            </div>
            <div class="free-info-content">
              <p><strong>無料予想では全レースの上位5頭のPT値のみを公開しています。</strong></p>
              <div class="upgrade-benefits">
                <div class="benefit-section">
                  <h3>🆓 無料会員登録でできること</h3>
                  <ul class="free-info-list">
                    <li>✅ 全頭予想（全出走馬のPT値・順位）</li>
                    <li>✅ 買い目（一部）: 本命・対抗・単穴・連下最上位の馬番号</li>
                    <li>✅ AI分析データ（Feature Importance Analysis）</li>
                    <li>✅ メールマガジン配信</li>
                  </ul>
                  <a href="/register" class="btn btn-success">今すぐ無料登録 →</a>
                </div>
                <div class="benefit-section">
                  <h3>💎 プロ会員でできること</h3>
                  <ul class="free-info-list">
                    <li>✅ 完全な馬単買い目（本線+抑え）</li>
                    <li>✅ 全期間の的中実績</li>
                    <li>✅ 買い目シミュレーター</li>
                    <li>✅ 南関4場＋JRA全10場対応</li>
                    <li>✅ 永久アクセス（買い切りプラン）</li>
                  </ul>
                  <a href="/pricing" class="btn btn-primary">料金プランを見る →</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Technical Notes -->
          <div class="info-card">
            <div class="info-header">
              <div class="info-icon">📋</div>
              <h3>Technical Specifications & Disclaimer / 技術仕様・免責事項</h3>
            </div>
            <div class="info-content">
              <div class="tech-section">
