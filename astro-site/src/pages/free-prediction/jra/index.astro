---
/**
 * /free-prediction/jra — 中央競馬の予想（`/prediction/jra` と同一内容）
 *
 * 正本: docs/RENEWAL_2026_08.md
 * 🔴 2026-08-28 全面改修。理由と方針は free-prediction/nankan/index.astro と同じ。
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceDayBoard from '../../../components/newspaper/RaceDayBoard.astro';
import TierRibbon from '../../../components/newspaper/TierRibbon.astro';
import { loadJraRaceDay } from '../../../lib/prediction/loadRaceDay.js';
import { entitlementFromAstro, viewFlags } from '../../../lib/auth/entitlement.js';

export const prerender = false;

const entitlement = entitlementFromAstro(Astro, { venue: 'jra' });
const view = viewFlags(entitlement);
const day = loadJraRaceDay(process.cwd());

const venueNames = day.venues.map((v) => v.venueName).join('・');
const title = day.date
  ? `${venueNames || '中央競馬'}の無料予想（${day.date}） - KEIBA Intelligence`
  : '中央競馬 無料予想 - KEIBA Intelligence';
const description = '中央競馬（JRA）の全レース馬柱・過去走・AI短評・展開予想を登録不要で公開。注目馬の印は無料会員、◎○▲△の印と馬単買い目は有料プランです。';
---

<BaseLayout title={title} description={description} canonicalPath="/prediction/jra">
  <div class="container prediction-page">
    <TierRibbon view={view} />
    <RaceDayBoard day={day} view={view} category="jra" />
  </div>
</BaseLayout>

<style>
  .prediction-page { padding-top: 8px; padding-bottom: 40px; }
</style>
