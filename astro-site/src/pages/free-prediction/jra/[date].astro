---
/**
 * /free-prediction/jra/[date] — JRA の特定開催日（YYYY-MM-DD）
 *
 * 正本: docs/RENEWAL_2026_08.md
 * 🔴 2026-08-28 全面改修。理由と方針は free-prediction/nankan/[slug].astro と同じ。
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RaceDayBoard from '../../../components/newspaper/RaceDayBoard.astro';
import TierRibbon from '../../../components/newspaper/TierRibbon.astro';
import { loadJraRaceDayByDate } from '../../../lib/prediction/loadRaceDay.js';
import { entitlementFromAstro, viewFlags } from '../../../lib/auth/entitlement.js';

export const prerender = false;

const { date } = Astro.params;

const entitlement = entitlementFromAstro(Astro, { venue: 'jra' });
const view = viewFlags(entitlement);
const day = loadJraRaceDayByDate(date, process.cwd());

const venueNames = day.venues.map((v) => v.venueName).join('・');
const title = day.date
  ? `${venueNames} ${day.date} の中央競馬予想 - KEIBA Intelligence`
  : '中央競馬予想 - KEIBA Intelligence';
const description = `${venueNames || '中央競馬'}${day.date || ''}の全レース馬柱・過去走・AI短評・展開予想を無料公開。`;
---

<BaseLayout title={title} description={description}>
  <div class="container prediction-page">
    <TierRibbon view={view} />
    <RaceDayBoard day={day} view={view} category="jra" />
    <p class="pp-back"><a href="/free-prediction/jra">← 最新の中央予想へ</a></p>
  </div>
</BaseLayout>

<style>
  .prediction-page { padding-top: 8px; padding-bottom: 40px; }
  .pp-back { margin-top: 24px; font-weight: 700; }
</style>
