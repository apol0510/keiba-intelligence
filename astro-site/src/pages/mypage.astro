---
/**
 * /mypage — マイページ（プラン確認・お支払い管理・ログアウト）
 *
 * 正本: docs/RENEWAL_2026_08.md §3 / §6
 *
 * 🔴 2026-08-28 全面改修:
 *   旧実装は `prerender = true` の静的ページで、`sessionStorage` の自己申告値から
 *   プランを表示していた（2026-08-17 監査 A-3 と同じ判定源）。
 *   本実装は **サーバー側 entitlement**（署名付き Cookie）で tier を決めて描画する。
 *   未ログインはサーバーで判定して案内を出す（クライアント JS に依存しない）。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { entitlementFromAstro } from '../lib/auth/entitlement.js';
import { TIER, tierAtLeast } from '../lib/auth/tiers.js';
import { buildMembershipView, MEMBERSHIP_COPY } from '../lib/membership/membershipView.js';
import { LOCK_STATUS } from '../lib/membership/priceLock.js';
import { resolveMembershipStore, STORE_RESULT } from '../lib/membership/store.js';
import { MONTHLY_LIST_PRICE_YEN } from '../lib/billing/plans.js';
import rewardCatalogSource from '../data/membership/rewardCatalog.json';

export const prerender = false;

const ent = entitlementFromAstro(Astro);

const isPaid = tierAtLeast(ent.tier, TIER.LIGHT);

/* ------------------------------------------------------------------
   会員クラブ（KI Membership / KIリワード）
   正本: docs/MEMBERSHIP_REWARDS.md §5

   制度の確定値は docs/MEMBERSHIP_REWARDS.md §7.1
   （100 pt/月・0/3/12/24 か月・600/1,200 pt・記念品 12/24 か月・解約後 90 日で失効）。

   🔴 ただし **会員ごとのデータ**（継続月数・残高・契約価格）は保存先がまだ無い
      （docs/MEMBERSHIP_DATA_MIGRATION.md）。読めない項目は「準備中」と表示する。
      **仮の数字（0 pt / Bronze / ¥3,980）を推測で当てはめない。**
   ------------------------------------------------------------------ */
const runtimeEnv = {
  ...(typeof process !== 'undefined' && process.env ? process.env : {}),
  ...(import.meta.env || {}),
};

// 🔴 フラグ未設定なら disabled（本番の現状）。列が無いまま有効化しても
//    アダプタが schema_missing を検出して書きに行かない。
const membershipStore = resolveMembershipStore({ env: runtimeEnv });
let membershipProfile = null;
let membershipLedger = null;

if (membershipStore.enabled && ent.authenticated && ent.email) {
  const [p, l] = await Promise.all([
    membershipStore.readProfile(ent.email),
    membershipStore.readLedger(ent.email),
  ]);
  if (p.status !== STORE_RESULT.UNAVAILABLE) membershipProfile = p.profile;
  if (l.status !== STORE_RESULT.UNAVAILABLE) membershipLedger = l.entries;
}

const club = buildMembershipView({
  entitlement: ent,
  profile: membershipProfile,
  ledger: membershipLedger,
  config: runtimeEnv,
  catalogSource: rewardCatalogSource,
  currentListPriceYen: MONTHLY_LIST_PRICE_YEN,
});

const PENDING = MEMBERSHIP_COPY.pending;
const yen = (n) => new Intl.NumberFormat('ja-JP').format(n);
const pt = (n) => `${new Intl.NumberFormat('ja-JP').format(n)} pt`;

/** 会員クラブの行。値が確定していないものは必ず「準備中」を出す。 */
const CLUB_ROWS = [
  {
    label: MEMBERSHIP_COPY.contractPriceLabel,
    value: club.priceLock.status === LOCK_STATUS.LOCKED
      ? `¥${yen(club.priceLock.contractPriceYen)} / 月`
      : PENDING,
  },
  {
    label: MEMBERSHIP_COPY.priceLockLabel,
    value: club.priceLock.status === LOCK_STATUS.LOCKED
      ? '適用中（ご契約中は加入時の価格を維持）'
      : (club.priceLock.status === LOCK_STATUS.NOT_APPLICABLE ? '—' : PENDING),
  },
  {
    label: MEMBERSHIP_COPY.rankLabel,
    value: club.rank.status === 'ready' ? club.rank.label : PENDING,
  },
  {
    label: MEMBERSHIP_COPY.monthsLabel,
    value: club.months.status === 'ready' ? `${club.months.value} か月` : PENDING,
  },
  {
    label: MEMBERSHIP_COPY.balanceLabel,
    value: club.rewards.status === 'ready' ? pt(club.rewards.balancePoints) : PENDING,
  },
  {
    label: MEMBERSHIP_COPY.monthLabel,
    value: club.rewards.status === 'ready' ? pt(club.rewards.monthAccrualPoints) : PENDING,
  },
];

/**
 * 解約後の猶予中だけ出す注意書き。
 * 🔴 契約中は出さない（契約中は失効しないため、不要な不安を与えない）。
 */
const graceNotice = club.rewards.status === 'ready' && club.rewards.pointsStatus === 'grace'
  ? `解約手続き済みです。あと${club.rewards.daysLeft}日以内に再開されると、ポイントと以前の価格が戻ります。`
  : null;

/** 次ランクまで / 次のプレゼントまでの進捗。確定していなければ出さない。 */
const rankProgress = club.rank.status === 'ready' && club.rank.nextRank
  ? { label: `次のランク（${club.rank.nextLabel}）まで`, note: `あと ${club.rank.monthsToNext} か月`, ratio: club.rank.progressRatio }
  : null;

const giftProgress = club.gifts.status === 'ready' && club.gifts.next
  ? { label: `${MEMBERSHIP_COPY.nextGiftLabel}（${club.gifts.next.item.name}）`, note: `あと ${pt(club.gifts.next.remainingPoints)}`, ratio: club.gifts.next.progressRatio }
  : null;

/** 現在の tier で開いている機能。閉じているものは次の一歩を添える。 */
const FEATURES = [
  { label: '全頭の馬柱・過去走', open: true },
  { label: 'AI短評・レース展望・展開予想', open: true },
  { label: '的中実績・回収率', open: true },
  { label: '印（◎○▲△・複数付与）', open: ent.showMarks },
  { label: 'AI指数の数値（無料はモザイク）', open: ent.showBetting },
  { label: 'AI結論（推奨理由の解説）', open: ent.showBetting },
  { label: '馬単の買い目', open: ent.showBetting },
  // 🔴 「穴馬レポート・優先メルマガ」は docs/RENEWAL_2026_08.md §6.1 で
  //    「実装が無いものを訴求しない」として廃止済み。復活させない。
];

// 🔴 2026-08-30: 会場で分ける概念を廃止。有料は常に南関東＋中央
const venueLabel = '南関東＋中央競馬';

const expiresLabel = ent.expiresAtMs
  ? new Date(ent.expiresAtMs).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<BaseLayout title="マイページ" description="KEIBA Intelligence マイページ。プラン確認・お支払い管理。">
  <section class="mypage">
    <div class="container">
      {!ent.authenticated ? (
        <div class="mp-guest">
          <div class="mp-guest-icon">🔒</div>
          <h1>ログインが必要です</h1>
          <p>マイページを表示するにはログインしてください。<br>予想ページは登録なしでもご覧いただけます。</p>
          <div class="mp-guest-actions">
            <a class="mp-btn mp-btn-primary" href="/login">ログイン</a>
            <a class="mp-btn mp-btn-ghost" href="/register">無料会員に登録</a>
          </div>
          <p class="mp-guest-sub"><a href="/prediction/nankan">今日の予想を見る（無料）→</a></p>
        </div>
      ) : (
        <div class="mp-content">
          <header class="mp-head">
            <h1>マイページ</h1>
            <p class="mp-email">{ent.email}</p>
          </header>

          <!-- プラン -->
          <div class={`mp-status ${isPaid ? 'is-paid' : ''}`}>
            <div class="mp-status-top">
              <div>
                <p class="mp-status-label">現在のプラン</p>
                <p class="mp-status-plan">{ent.tierLabel}</p>
              </div>
              <span class={`mp-badge tier-${ent.tier}`}>{ent.tierLabel}</span>
            </div>
            <ul class="mp-status-meta">
              <li>閲覧範囲: <b>{venueLabel}</b></li>
              {expiresLabel && <li>ログインの有効期限: <b>{expiresLabel}</b></li>}
            </ul>
          </div>

          <!-- 会員クラブ（KIリワード / ランク / 継続価格ロック） -->
          <section class="mp-block">
            <h2 class="mp-h2">{MEMBERSHIP_COPY.clubName}</h2>
            <div class="mp-club">
              <ul class="mp-club-rows">
                {CLUB_ROWS.map((row) => (
                  <li class={row.value === PENDING ? 'is-pending' : ''}>
                    <span class="mp-club-k">{row.label}</span>
                    <span class="mp-club-v">{row.value}</span>
                  </li>
                ))}
              </ul>

              {graceNotice && <p class="mp-club-grace">{graceNotice}</p>}

              <div class="mp-club-progress">
                {rankProgress ? (
                  <div class="mp-prog">
                    <p class="mp-prog-head"><span>{rankProgress.label}</span><b>{rankProgress.note}</b></p>
                    <div class="mp-prog-bar"><span style={`width:${Math.round(rankProgress.ratio * 100)}%`}></span></div>
                  </div>
                ) : (
                  <p class="mp-club-note"><b>次のランクまでの進捗</b>：{PENDING}</p>
                )}

                {giftProgress ? (
                  <div class="mp-prog">
                    <p class="mp-prog-head"><span>{giftProgress.label}</span><b>{giftProgress.note}</b></p>
                    <div class="mp-prog-bar"><span style={`width:${Math.round(giftProgress.ratio * 100)}%`}></span></div>
                  </div>
                ) : (
                  <p class="mp-club-note"><b>{MEMBERSHIP_COPY.nextGiftLabel}の進捗</b>：{PENDING}</p>
                )}
              </div>

              <div class="mp-club-sub">
                <h3>交換できるプレゼント</h3>
                {club.gifts.blockedByMilestone ? (
                  <p class="mp-club-note">
                    今月は<b>継続記念品</b>をお贈りする月です。通常のポイント交換は翌月から再開します。
                  </p>
                ) : club.gifts.status === 'ready' && club.gifts.available.length ? (
                  <ul class="mp-gift-list">
                    {club.gifts.available.map((item) => (
                      <li><span class="mp-gift-name">{item.name}</span><span class="mp-gift-cost">{pt(item.costPoints)}</span></li>
                    ))}
                  </ul>
                ) : (
                  <p class="mp-club-note">{PENDING}（プレゼントの品目が決まりしだいご案内します）</p>
                )}
              </div>

              <div class="mp-club-sub">
                <h3>{MEMBERSHIP_COPY.historyLabel}</h3>
                {/*
                  🔴 pending（台帳が読めない / 付与設定が未確定）と
                     ready かつ 0 件（本当に受け取っていない）を **同じ文言にしない**。
                     読めていないのに「まだありません」と言い切ると、
                     受け取り済みの特典を無いことにして伝えるおそれがある。
                */}
                {club.history.status !== 'ready' ? (
                  <p class="mp-club-note">{PENDING}</p>
                ) : club.history.items.length ? (
                  <ul class="mp-gift-list">
                    {club.history.items.map((h) => (
                      <li>
                        <span class="mp-gift-name">{h.ref}</span>
                        <span class="mp-gift-cost">{new Date(h.occurredAtMs).toLocaleDateString('ja-JP')}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="mp-club-note">まだ受け取られた特典はありません。</p>
                )}
              </div>

              <p class="mp-club-legal">
                KIリワードは会員特典のポイントです。毎月100ptが加算され、600pt・1,200ptでお引き換えいただけます。
                ご契約中は失効しません（解約後は90日以内の再開でポイントが戻ります）。
                現金・預金ではなく、換金・払い戻し・第三者への譲渡はできません。
              </p>
            </div>
          </section>

          <!-- 予想ページ -->
          <section class="mp-block">
            <h2 class="mp-h2">予想ページ</h2>
            <div class="mp-links">
              <a class="mp-link" href="/prediction/nankan">
                <span class="mp-link-title">南関東</span>
                <span class="mp-link-sub">大井・川崎・船橋・浦和</span>
              </a>
              <a class="mp-link" href="/prediction/jra">
                <span class="mp-link-title">中央競馬</span>
                <span class="mp-link-sub">JRA 全10場</span>
              </a>
            </div>
          </section>

          <!-- 利用可能な機能 -->
          <section class="mp-block">
            <h2 class="mp-h2">利用できる機能</h2>
            <ul class="mp-features">
              {FEATURES.map((f) => (
                <li class={f.open ? 'is-open' : 'is-locked'}>
                  <span class="mp-f-icon">{f.open ? '✓' : '🔒'}</span>{f.label}
                </li>
              ))}
            </ul>
          </section>

          <!-- お支払い -->
          <section class="mp-block">
            <h2 class="mp-h2">お支払い</h2>
            {isPaid ? (
              <div class="mp-billing">
                <p>お支払い方法の変更・プラン変更・解約は、お支払い管理ページから行えます。</p>
                <button class="mp-btn mp-btn-ghost" type="button" id="mp-portal">お支払い管理ページを開く</button>
                <p class="mp-billing-msg" id="mp-portal-msg" hidden></p>
              </div>
            ) : (
              <div class="mp-billing">
                <p>買い目をご覧いただくには有料プランへのお申し込みが必要です。</p>
                <a class="mp-btn mp-btn-primary" href="/pricing">プランを見る</a>
              </div>
            )}
          </section>

          <div class="mp-logout">
            <form method="POST" action="/.netlify/functions/logout">
              <button class="mp-btn mp-btn-quiet" type="submit">ログアウト</button>
            </form>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mp-portal');
    if (!btn) return;
    const msg = document.getElementById('mp-portal-msg');

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      if (msg) msg.hidden = true;
      try {
        const res = await fetch('/.netlify/functions/stripe-portal', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.url) {
          window.location.href = data.url;
          return;
        }
        throw new Error('unavailable');
      } catch {
        if (msg) {
          msg.hidden = false;
          msg.textContent = 'お支払い管理ページを開けませんでした。銀行振込でお申し込みの場合はこちらからは操作できません。お問い合わせください。';
        }
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .mypage { padding: 24px 0 56px; }

  /* 未ログイン */
  .mp-guest {
    max-width: 520px;
    margin: 40px auto;
    text-align: center;
    padding: 40px 24px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .mp-guest-icon { font-size: 48px; margin-bottom: 12px; }

  .mp-guest h1 { font-size: 1.5rem; margin-bottom: 10px; }

  .mp-guest p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.8; }

  .mp-guest-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 20px 0 12px;
  }

  .mp-guest-sub a { font-size: 0.85rem; font-weight: 700; }

  /* 本体 */
  .mp-content { max-width: 760px; margin: 0 auto; }

  .mp-head { text-align: center; margin-bottom: 24px; }

  .mp-head h1 { font-size: 1.8rem; margin-bottom: 4px; }

  .mp-email {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-family: var(--font-num);
  }

  .mp-status {
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .mp-status.is-paid { border-color: var(--secondary-start); }

  .mp-status-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .mp-status-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-weight: 700;
    margin: 0;
  }

  .mp-status-plan {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 2px 0 0;
    color: var(--text-primary);
  }

  .mp-badge {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    color: var(--text-inverse);
    background: var(--text-tertiary);
    white-space: nowrap;
  }

  .mp-badge.tier-free { background: var(--success); }
  .mp-badge.tier-light { background: var(--primary-gradient); }
  .mp-badge.tier-premium { background: var(--secondary-gradient); }

  .mp-status-meta {
    list-style: none;
    margin: 14px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .mp-status-meta li {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .mp-block { margin-bottom: 26px; }

  .mp-h2 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin-bottom: 12px;
    padding-left: 10px;
    border-left: 4px solid var(--primary-start);
  }

  .mp-links {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .mp-link {
    display: block;
    padding: 16px 18px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .mp-link:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

  .mp-link-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .mp-link-sub {
    display: block;
    font-size: 0.76rem;
    color: var(--text-tertiary);
    margin-top: 2px;
  }

  .mp-features {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .mp-features li {
    padding: 11px 16px;
    font-size: 0.88rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .mp-features li:last-child { border-bottom: none; }
  .mp-features li.is-locked { color: var(--text-tertiary); background: var(--bg-muted); }
  .mp-f-icon { margin-right: 8px; }
  .mp-features li.is-open .mp-f-icon { color: var(--success); font-weight: 800; }

  /* 会員クラブ */
  .mp-club {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 6px 16px 16px;
  }

  .mp-club-rows { list-style: none; margin: 0; padding: 0; }

  .mp-club-rows li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .mp-club-k { font-size: 0.82rem; color: var(--text-secondary); }

  .mp-club-v {
    font-family: var(--font-num);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    text-align: right;
  }

  .mp-club-rows li.is-pending .mp-club-v {
    font-family: inherit;
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }

  .mp-club-progress { padding: 14px 0 4px; display: grid; gap: 12px; }

  .mp-prog-head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0 0 6px;
  }

  .mp-prog-head b { font-family: var(--font-num); color: var(--text-primary); }

  .mp-prog-bar {
    height: 8px;
    background: var(--bg-muted);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .mp-prog-bar span {
    display: block;
    height: 100%;
    background: var(--secondary-gradient, var(--primary-gradient));
  }

  .mp-club-sub { padding-top: 14px; border-top: 1px solid var(--border-color); margin-top: 10px; }

  .mp-club-sub h3 {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 8px;
  }

  .mp-club-note { font-size: 0.8rem; color: var(--text-tertiary); margin: 0; line-height: 1.7; }

  .mp-club-grace {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    background: var(--bg-muted);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .mp-gift-list { list-style: none; margin: 0; padding: 0; }

  .mp-gift-list li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
    font-size: 0.84rem;
    border-bottom: 1px dashed var(--border-color);
