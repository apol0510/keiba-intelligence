<script>
  /*
    交換申込の送信。
    🔴 冪等キーはフォーム 1 回につき 1 つ作る。二重クリック・再送で
       同じ札が送られ、サーバー側が 2 回目を「already」として何も書かない。
    🔴 Email・ポイント数・資格は送らない（サーバーがセッションと台帳から決める）。
  */
  const form = document.getElementById('mp-redeem-form');
  if (form) {
    const msg = document.getElementById('mp-redeem-msg');
    let requestId = null;

    const newRequestId = () => {
      const bytes = new Uint8Array(16);
      crypto.getRandomValues(bytes);
      return 'r-' + Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    };

    const ERROR_TEXT = {
      login_required: 'ログインが切れています。再度ログインしてください。',
      invalid_address: '受取人氏名・郵便番号・住所をご確認ください。',
      insufficient_points: 'ポイントが足りません。',
      unknown_item: 'その景品は現在お選びいただけません。',
      milestone_month_blocks_exchange: '今月は継続記念品をお贈りする月のため、通常の交換は翌月から再開します。',
      milestone_already_claimed: 'その節目の記念品はお申し込み済みです。',
      milestone_not_reached: 'その記念品はまだ対象期間に達していません。',
      points_expired: 'ポイントの有効期限が過ぎています。',
      catalog_not_published: '準備中です。',
      redemption_not_ready: '準備中です。しばらくしてからお試しください。',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true;
      if (!requestId) requestId = newRequestId();

      const data = new FormData(form);
      try {
        const res = await fetch('/.netlify/functions/redeem-reward', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            itemId: data.get('itemId'),
            requestId,
            shipping: {
              recipientName: data.get('recipientName'),
              postalCode: data.get('postalCode'),
              address: data.get('address'),
            },
          }),
        });
        const body = await res.json().catch(() => ({}));
        msg.hidden = false;
        if (res.ok) {
          msg.textContent = body.status === 'already'
            ? 'このお申し込みは受付済みです。'
            : 'お申し込みを受け付けました。発送までお待ちください。';
          // 受付できたので、この札は使い切り。次の申込は新しい札にする。
          requestId = null;
        } else {
          msg.textContent = ERROR_TEXT[body.error] || 'お申し込みできませんでした。';
          btn.disabled = false;
        }
      } catch {
        msg.hidden = false;
        msg.textContent = '通信に失敗しました。時間をおいてお試しください。';
        btn.disabled = false;
      }
    });
  }
</script>
</BaseLayout>

<script>
  /**
   * 決済から戻ってきたら、いまの権限で Cookie を出し直す。
   *
   * 🔴 tier は署名済み Cookie に焼き付いているので、決済しても
   *    再ログインするまで無料会員のままになる（2026-09-02 の不具合）。
   * 🔴 webhook の反映には数秒かかることがあるので、少しだけ待って様子を見る。
   *    ここでの表示は補助で、認可はサーバー側の entitlement が決める。
   */
  async function syncAfterCheckout() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('checkout') !== 'success') return;

    const notice = document.getElementById('mp-syncing');
    if (notice) notice.hidden = false;

    for (let i = 0; i < 6; i += 1) {
      try {
        const res = await fetch('/.netlify/functions/refresh-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.changed) {
          // 反映済み。?checkout を落として読み込み直す（同じ処理を繰り返さない）
          window.location.replace(window.location.pathname);
          return;
        }
      } catch {
        /* 通信できなくても待って再試行する */
      }
      await new Promise((r) => setTimeout(r, 2000));
    }

    if (notice) {
      notice.textContent = 'お支払いの反映に少し時間がかかっています。'
        + 'このページを再読み込みするか、しばらくしてからご確認ください。';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    syncAfterCheckout();

    // 決済後にページを離れてしまった場合の手動更新
    const refresh = document.getElementById('mp-refresh');
    if (refresh) {
      refresh.addEventListener('click', async () => {
        const notice = document.getElementById('mp-syncing');
        refresh.disabled = true;
        if (notice) {
          notice.hidden = false;
          notice.textContent = 'お支払いを確認しています…';
        }
        try {
          const res = await fetch('/.netlify/functions/refresh-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.changed) {
            window.location.replace(window.location.pathname);
            return;
          }
          if (notice) {
            notice.textContent = 'お支払いの記録がまだ確認できませんでした。'
              + '決済直後の場合は少し待ってからもう一度お試しください。';
          }
        } catch {
          if (notice) notice.textContent = '確認できませんでした。しばらくしてからお試しください。';
        }
        refresh.disabled = false;
      });
    }

    const btn = document.getElementById('mp-portal');
    if (!btn) return;
    const msg = document.getElementById('mp-portal-msg');

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      if (msg) msg.hidden = true;
      try {
        const res = await fetch('/.netlify/functions/stripe-portal', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.url) {
          window.location.href = data.url;
          return;
        }
        throw new Error('unavailable');
      } catch {
        if (msg) {
          msg.hidden = false;
          msg.textContent = 'お支払い管理ページを開けませんでした。銀行振込でお申し込みの場合はこちらからは操作できません。お問い合わせください。';
        }
        btn.disabled = false;
      }
    });
  });
</script>

