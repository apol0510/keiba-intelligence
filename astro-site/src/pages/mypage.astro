---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="マイページ - KEIBA Intelligence"
  description="KEIBA Intelligence マイページ。プラン確認・アカウント管理。"
>
  <section class="mypage-section">
    <div class="container">
      <div id="mypage-content" style="display: none;">

        <!-- ヘッダー -->
        <div class="mypage-header">
          <div class="header-icon" id="header-icon">🏇</div>
          <h1>マイページ</h1>
          <p class="header-email" id="user-email">-</p>
        </div>

        <!-- プランステータスカード -->
        <div class="status-card" id="status-card">
          <div class="status-top">
            <div>
              <div class="status-label">現在のプラン</div>
              <div class="status-plan" id="user-plan-display">-</div>
            </div>
            <div class="plan-badge-lg" id="plan-badge-lg">-</div>
          </div>
          <div class="status-details" id="status-details">
            <!-- JSで動的に表示 -->
          </div>
        </div>

        <!-- 予想ページカード -->
        <div class="section-block" id="quick-links" style="display: none;">
          <h2 class="section-title">予想ページ</h2>
          <div class="prediction-cards" id="quick-links-content"></div>
        </div>

        <!-- 利用可能な機能 -->
        <div class="section-block" id="plan-detail">
          <h2 class="section-title">利用可能な機能</h2>
          <div class="features-grid" id="features-grid"></div>
        </div>

        <!-- アップグレード -->
        <div class="section-block" id="upgrade-cta" style="display: none;">
          <h2 class="section-title">プランアップグレード</h2>
          <div id="upgrade-content"></div>
        </div>

        <!-- ログアウト -->
        <div class="logout-block">
          <button class="btn-logout" id="logout-btn">ログアウト</button>
        </div>
      </div>

      <!-- 未ログイン時 -->
      <div class="not-logged-card" id="not-logged-in" style="display: none;">
        <div class="not-logged-icon">🔒</div>
        <h1>ログインが必要です</h1>
        <p>マイページを表示するにはログインしてください。</p>
        <div class="not-logged-actions">
          <a href="/login" class="btn-action primary">ログイン</a>
          <a href="/register" class="btn-action secondary">無料会員登録</a>
        </div>
      </div>

      <!-- ローディング -->
      <div class="mypage-loading" id="mypage-loading">
        <div class="spinner"></div>
        <p>読み込み中...</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mypage-section {
    padding: 60px 0 80px;
    min-height: calc(100vh - 200px);
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ===== ヘッダー ===== */
  .mypage-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .header-icon {
    font-size: 48px;
    margin-bottom: 12px;
  }

  .mypage-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .header-email {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* ===== ステータスカード（glassmorphism） ===== */
  .status-card {
    background: linear-gradient(135deg, rgba(147, 197, 253, 0.18) 0%, rgba(196, 181, 253, 0.14) 100%);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    padding: 28px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .status-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
  }

  .status-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .status-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .status-plan {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .plan-badge-lg {
    padding: 6px 16px;
    border-radius: 24px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .plan-badge-lg.free-registered {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
  }
  .plan-badge-lg.light {
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: white;
  }
  .plan-badge-lg.pro {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #1e293b;
  }
  .plan-badge-lg.pro-plus {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
  }

  .status-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .detail-item {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 14px 16px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .detail-item .detail-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }

  .detail-item .detail-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* ===== セクション（glassmorphism カード化・入れ子コンテナ） ===== */
  .section-block {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    padding: 24px;
    margin-bottom: 20px;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 0 24px rgba(0, 0, 0, 0.12);
  }

  .section-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    letter-spacing: 0.03em;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title::before {
    content: '';
    width: 4px;
    height: 18px;
    background: linear-gradient(180deg, #60a5fa, #c4b5fd);
    border-radius: 2px;
    box-shadow: 0 0 8px rgba(96, 165, 250, 0.6);
  }

  /* ===== 予想ページカード ===== */
  .prediction-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .pred-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .pred-card::after {
    content: '→';
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.4);
    transition: all 0.3s;
  }

  .pred-card:hover::after {
    right: 16px;
    color: rgba(255, 255, 255, 0.8);
  }

  .pred-card {
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  .pred-card.nankan {
    background: linear-gradient(135deg, rgba(110, 231, 183, 0.45) 0%, rgba(167, 243, 208, 0.30) 100%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow:
      0 10px 30px rgba(16, 185, 129, 0.25),
      0 2px 6px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.05);
  }
  .pred-card.nankan:hover {
    background: linear-gradient(135deg, rgba(110, 231, 183, 0.6) 0%, rgba(167, 243, 208, 0.42) 100%);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-4px);
    box-shadow:
      0 18px 42px rgba(16, 185, 129, 0.4),
      0 4px 10px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .pred-card.jra {
    background: linear-gradient(135deg, rgba(147, 197, 253, 0.45) 0%, rgba(196, 181, 253, 0.30) 100%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow:
      0 10px 30px rgba(59, 130, 246, 0.25),
      0 2px 6px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.05);
  }
  .pred-card.jra:hover {
    background: linear-gradient(135deg, rgba(147, 197, 253, 0.6) 0%, rgba(196, 181, 253, 0.42) 100%);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-4px);
    box-shadow:
      0 18px 42px rgba(59, 130, 246, 0.4),
      0 4px 10px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .pred-card-icon {
    font-size: 2rem;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .pred-card.nankan .pred-card-icon {
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
  }
  .pred-card.jra .pred-card-icon {
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
  }

  .pred-card-body {
    flex: 1;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    padding: 12px 16px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10);
  }

  .pred-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .pred-card-sub {
    font-size: 0.82rem;
    color: rgba(241, 245, 249, 0.92);
  }

  .pred-card-desc {
    font-size: 0.78rem;
    color: rgba(241, 245, 249, 0.78);
    margin-top: 4px;
  }

  /* ===== 機能グリッド ===== */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(135deg, rgba(167, 243, 208, 0.32) 0%, rgba(255, 255, 255, 0.14) 100%);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 14px;
    font-size: 0.9rem;
    color: #f1f5f9;
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    box-shadow:
      0 6px 18px rgba(16, 185, 129, 0.18),
      0 2px 4px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-item:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.55);
    box-shadow:
      0 12px 28px rgba(16, 185, 129, 0.32),
      0 4px 8px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .feature-item .feature-check {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #6ee7b7, #34d399);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: #064e3b;
    font-size: 0.85rem;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(52, 211, 153, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .feature-item .feature-text {
    flex: 1;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    padding: 8px 12px;
    color: #ffffff;
    font-weight: 600;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  /* ===== アップグレード ===== */
  .upgrade-card {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.08) 0%, rgba(245, 158, 11, 0.04) 100%);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 12px;
  }

  .upgrade-card h3 {
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .upgrade-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }

  .upgrade-card .price {
    font-size: 1.4rem;
    font-weight: 900;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .btn-upgrade {
    display: inline-block;
    margin-top: 14px;
    padding: 10px 28px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.3s;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #1e293b;
  }

  .btn-upgrade:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(251, 191, 36, 0.3);
  }

  /* ===== ログアウト ===== */
  .logout-block {
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .btn-logout {
    width: 100%;
    padding: 14px;
    background: transparent;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    color: rgba(239, 68, 68, 0.7);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-logout:hover {
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.5);
    color: #ef4444;
  }

  /* ===== 未ログイン ===== */
  .not-logged-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 60px 32px;
    text-align: center;
  }

  .not-logged-icon {
    font-size: 56px;
    margin-bottom: 16px;
  }

  .not-logged-card h1 {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .not-logged-card p {
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .not-logged-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .btn-action {
    padding: 12px 32px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s;
  }

  .btn-action.primary {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
  }
  .btn-action.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
  }

  .btn-action.secondary {
    background: transparent;
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: #3b82f6;
  }
  .btn-action.secondary:hover {
    background: rgba(59, 130, 246, 0.08);
  }

  /* ===== ローディング ===== */
  .mypage-loading {
    text-align: center;
    padding: 80px 0;
    color: var(--text-secondary);
  }

  .spinner {
    width: 40px;
    height: 40px;
    margin: 0 auto 16px;
    border: 3px solid rgba(59, 130, 246, 0.2);
    border-top: 3px solid #3b82f6;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 640px) {
    .status-details {
      grid-template-columns: 1fr;
    }

    .prediction-cards {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .not-logged-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const loading = document.getElementById('mypage-loading');
    const content = document.getElementById('mypage-content');
    const notLoggedIn = document.getElementById('not-logged-in');

    // セッション確認
    const sessionAuth = sessionStorage.getItem('keiba_session');
    if (!sessionAuth) {
      loading.style.display = 'none';
      notLoggedIn.style.display = 'block';
      return;
    }

    let session;
    try {
      session = JSON.parse(sessionAuth);
      if (!session.user || (session.expiresAt && new Date() > new Date(session.expiresAt))) {
        sessionStorage.removeItem('keiba_session');
        loading.style.display = 'none';
        notLoggedIn.style.display = 'block';
        return;
      }
    } catch {
      loading.style.display = 'none';
      notLoggedIn.style.display = 'block';
      return;
    }

    // ログイン済み表示
    const plan = (session.plan || 'free-registered').toLowerCase();
    const email = session.user.email || '-';
    const venueAccess = session.venueAccess || 'all';
    const planExpiresAt = session.planExpiresAt || null;

    document.getElementById('user-email').textContent = email;

    // プラン設定
    const planConfig = {
      'free-registered': { label: '無料会員', badge: 'free-registered', icon: '🆓', features: ['全レース予想閲覧', '上位馬の馬番号', 'AI分析データ', 'メールマガジン'] },
      'light': { label: 'ライトプラン', badge: 'light', icon: '⚡', features: ['全レース予想閲覧', 'メインレースの馬単買い目', '的中実績閲覧', 'データ可視化'] },
      'pro': { label: 'プロプラン', badge: 'pro', icon: '👑', features: ['全レース予想閲覧', '全レースの馬単買い目', '的中実績閲覧', 'データ可視化', 'Feature Importance'] },
      'pro-plus': { label: 'プロプラスプラン', badge: 'pro-plus', icon: '💎', features: ['プロプランの全機能', '優先サポート'] },
    };

    const cfg = planConfig[plan] || planConfig['free-registered'];

    // ヘッダーアイコン
    document.getElementById('header-icon').textContent = cfg.icon;

    // ステータスカード
    document.getElementById('user-plan-display').textContent = cfg.label;
    const badgeLg = document.getElementById('plan-badge-lg');
    badgeLg.textContent = cfg.label;
    badgeLg.className = `plan-badge-lg ${cfg.badge}`;

    // ステータス詳細
    const statusDetails = document.getElementById('status-details');
    const details = [];

    if (plan !== 'free-registered') {
      const venueLabels = {
        'all': '南関4場 + JRA全10場',
        'nankan': '南関4場',
        'jra': 'JRA全10場'
      };
      details.push({ label: 'アクセス対象', value: venueLabels[venueAccess] || venueLabels['all'] });

      if (planExpiresAt) {
        if (planExpiresAt === '2099-12-31') {
          details.push({ label: '有効期限', value: '永久アクセス' });
        } else {
          const d = new Date(planExpiresAt);
          details.push({ label: '有効期限', value: `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}` });
        }
      }
    }

    details.push({ label: 'メールアドレス', value: email });
    details.push({ label: 'ステータス', value: 'アクティブ' });

    statusDetails.innerHTML = details.map(d => `
      <div class="detail-item">
        <div class="detail-label">${d.label}</div>
        <div class="detail-value">${d.value}</div>
      </div>
    `).join('');

    // 予想ページカード
    const quickLinks = document.getElementById('quick-links');
    const quickLinksContent = document.getElementById('quick-links-content');
    const links = [];

    if (plan === 'free-registered') {
      links.push({ href: '/free-prediction/jra', cls: 'jra', icon: '🐎', title: '中央予想（無料）', sub: 'JRA全10場', desc: '中央競馬AI分析（高配当狙い）' });
      links.push({ href: '/free-prediction', cls: 'nankan', icon: '🏇', title: '南関予想（無料）', sub: '大井・川崎・船橋・浦和', desc: '地方競馬AI分析（安定型）' });
    } else if (venueAccess === 'nankan') {
      links.push({ href: '/prediction/nankan', cls: 'nankan', icon: '🏇', title: '南関予想', sub: '大井・川崎・船橋・浦和', desc: '地方競馬AI分析（安定型）' });
    } else if (venueAccess === 'jra') {
      links.push({ href: '/prediction/jra', cls: 'jra', icon: '🐎', title: '中央予想', sub: 'JRA全10場', desc: '中央競馬AI分析（高配当狙い）' });
    } else {
      links.push({ href: '/prediction/jra', cls: 'jra', icon: '🐎', title: '中央予想', sub: 'JRA全10場', desc: '中央競馬AI分析（高配当狙い）' });
      links.push({ href: '/prediction/nankan', cls: 'nankan', icon: '🏇', title: '南関予想', sub: '大井・川崎・船橋・浦和', desc: '地方競馬AI分析（安定型）' });
    }

    quickLinksContent.innerHTML = links.map(l => `
      <a href="${l.href}" class="pred-card ${l.cls}">
        <div class="pred-card-icon">${l.icon}</div>
        <div class="pred-card-body">
          <div class="pred-card-title">${l.title}</div>
          <div class="pred-card-sub">${l.sub}</div>
          ${l.desc ? `<div class="pred-card-desc">${l.desc}</div>` : ''}
        </div>
      </a>
    `).join('');
    quickLinks.style.display = 'block';

    // 利用可能な機能
    const featuresGrid = document.getElementById('features-grid');
    featuresGrid.innerHTML = cfg.features.map(f => `
      <div class="feature-item">
        <span class="feature-check">✓</span>
        <span class="feature-text">${f}</span>
      </div>
    `).join('');

    // アップグレードCTA
    const upgradeCta = document.getElementById('upgrade-cta');
    const upgradeContent = document.getElementById('upgrade-content');

    if (plan === 'free-registered') {
      upgradeCta.style.display = 'block';
      upgradeContent.innerHTML = `
        <div class="upgrade-card">
          <h3>ライトプラン</h3>
          <p>メインレースの馬単買い目が見られます</p>
          <div><span class="price">¥6,600</span><span style="color:var(--text-secondary)">/月</span></div>
          <a href="/pricing" class="btn-upgrade">詳細を見る</a>
        </div>
        <div class="upgrade-card">
          <h3>プロプラン（買い切り）</h3>
          <p>全レースの馬単買い目＋永久アクセス</p>
          <div><span class="price">¥88,000</span></div>
          <a href="/pricing" class="btn-upgrade">詳細を見る</a>
        </div>
      `;
    } else if (plan === 'light') {
      upgradeCta.style.display = 'block';
      upgradeContent.innerHTML = `
        <div class="upgrade-card">
          <h3>プロプランにアップグレード</h3>
          <p>全レースの馬単買い目が見られるようになります</p>
          <div><span class="price">¥88,000</span><span style="color:var(--text-secondary)">（買い切り・永久アクセス）</span></div>
          <a href="/pricing" class="btn-upgrade">詳細を見る</a>
        </div>
      `;
    }

    // ログアウト
    document.getElementById('logout-btn').addEventListener('click', () => {
      sessionStorage.removeItem('keiba_session');
      sessionStorage.removeItem('isFreeUser');
      sessionStorage.removeItem('isLightUser');
      window.location.href = '/';
    });

    // 表示切り替え
    loading.style.display = 'none';
    content.style.display = 'block';
  });
</script>
