---
/**
 * / — トップページ
 *
 * 正本: docs/RENEWAL_2026_08.md §1
 *
 * 🔴 2026-08-28 改修:
 *   - 訴求を「無料でどこまで見えるか」に変えた（改修の最重要目的）。
 *   - 的中率・回収率は **archive の実測値をビルド時に集計**して表示する。
 *     旧実装の「的中率71%・回収率186%・会員数1,000+」は出典が確認できない固定値だったため撤去した。
 *   - 価格をトップに書かない（金額の正本は Stripe。docs/RENEWAL_2026_08.md §6.1）。
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import archiveNankan from '../data/archiveResults.json';
import archiveJra from '../data/archiveResultsJra.json';
import { combinedTotals, formatPercent, formatCount } from '../lib/stats/archiveTotals.js';

export const prerender = true;

// ⚠️ archive の蓄積に依存する時点値。恒久的な保証値ではない。
const totals = combinedTotals(archiveNankan, archiveJra);
---

<BaseLayout
  title="ホーム"
  description="南関東4場と中央競馬（JRA全10場）の全レース馬柱・過去走・AI短評・展開予想を登録不要で無料公開。印は無料会員、馬単の買い目は月額プランで提供します。"
>
  <!-- ヒーローキービジュアル（ヒーローセクションの上） -->
  <section class="hero-keyvisual">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/KI_hero_Mobile.png">
      <img
        src="/images/KI_hero_PC.png"
        alt="KEIBA INTELLIGENCE - 中央競馬を、AIとデータで深く読む。オッズ・AI評価・騎手・馬データを一目で可視化"
        class="hero-keyvisual-img"
        width="1536"
        height="1024"
        fetchpriority="high"
      >
    </picture>
  </section>

  <!-- ヒーローセクション -->
  <!-- 🔴 gradient-bg-animated は付けない。global の同名クラスと specificity が並び、
       読み込み順で青→橙のアニメーション背景に上書きされていた（2026-09-04） -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title fade-in">
          全レースの馬柱と短評を、<br>
          まず無料で。
        </h1>
        <p class="hero-subtitle slide-in">
          南関東4場と中央競馬（JRA全10場）。出走全頭の過去走・AI短評・展開予想を<b>登録なし</b>で公開しています。
        </p>
        <div class="hero-cta">
          <a href="/prediction/nankan" class="btn btn-red btn-lg">南関の予想を見る</a>
          <a href="/prediction/jra" class="btn btn-green btn-lg">中央の予想を見る</a>
          <a href="/register" class="btn btn-gold btn-lg">無料会員に登録</a>
        </div>

        <!-- 統計カード（公開アーカイブの実測集計。加工なし） -->
        <div class="stats-grid">
          <div class="stat-card card">
            <div class="stat-icon">💰</div>
            <div class="stat-value">{formatPercent(totals.all.returnRate)}</div>
            <div class="stat-label">回収率（通算）</div>
          </div>
          <div class="stat-card card">
            <div class="stat-icon">🎯</div>
            <div class="stat-value">{formatPercent(totals.all.hitRate)}</div>
            <div class="stat-label">的中率（通算）</div>
          </div>
          <div class="stat-card card">
            <div class="stat-icon">📊</div>
            <div class="stat-value">{formatCount(totals.all.races)}</div>
            <div class="stat-label">公開レース数</div>
          </div>
          <div class="stat-card card">
            <div class="stat-icon">🗓️</div>
            <div class="stat-value">{formatCount(totals.all.days)}</div>
            <div class="stat-label">公開開催日数</div>
          </div>
        </div>
        <p class="stats-note">
          公開しているアーカイブ全件から算出した実測値です（払戻÷投資×100）。高配当を除外していません。
          <a href="/archive">内訳を見る →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 特徴セクション -->
  <section class="features">
    <div class="container">
      <h2 class="section-title text-center">KEIBA Intelligenceの特徴</h2>

      <div class="grid grid-3">
        <div class="feature-card card">
          <div class="feature-icon">🤖</div>
          <h3>AI予想システム</h3>
          <p>
            最新の機械学習モデルを活用した高精度予想。過去データから学習したAIが最適な買い目を提案します。
          </p>
        </div>

        <div class="feature-card card">
          <div class="feature-icon">📰</div>
          <h3>無料で全頭ぶんの紙面</h3>
          <p>
            登録なしで、出走全頭の馬柱・過去走・AI短評・展開予想をご覧いただけます。
            印は無料会員登録で、AI指数の数値と馬単の買い目は月額プランで公開します。
          </p>
        </div>

        <div class="feature-card card">
          <div class="feature-icon">📈</div>
          <h3>データ可視化</h3>
          <p>
            的中率・回収率をグラフで可視化。直感的なダッシュボードで予想の精度を一目で確認できます。
          </p>
        </div>

        <div class="feature-card card">
          <div class="feature-icon">🏇</div>
          <h3>南関・中央対応</h3>
          <p>
            南関4場（大井・川崎・船橋・浦和）と中央競馬（JRA全10場）に完全対応。地方・中央の特性を熟知したAIが予想を提供。
          </p>
        </div>

        <div class="feature-card card">
          <div class="feature-icon">📱</div>
          <h3>スマホ対応</h3>
          <p>
            レスポンシブデザインでスマホでも快適に利用可能。外出先でも予想をチェックできます。
          </p>
        </div>

        <div class="feature-card card">
          <div class="feature-icon">🔒</div>
          <h3>安心のセキュリティ</h3>
          <p>
            マジックリンク認証で安全にログイン。個人情報は厳重に管理され、安心してご利用いただけます。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 無料登録ビジュアル（対応競馬場セクションの上） -->
  <section class="register-visual">
    <a href="/free-prediction" class="register-visual-link" aria-label="無料予想を見る">
      <picture>
        <source media="(max-width: 768px)" srcset="/images/KI_register_Mobile.png">
        <img
          src="/images/KI_register_PC.png"
          alt="無料予想で、まず体験。全頭予想とAI分析を今すぐチェック。クレジットカード不要・1分で登録"
          class="register-visual-img"
          width="1536"
          height="1024"
          loading="lazy"
        >
      </picture>
    </a>
  </section>

  <!-- 対応競馬場セクション -->
  <section class="venues">
    <div class="container">
      <h2 class="section-title text-center">対応競馬場</h2>
      <p class="section-subtitle text-center">
        南関東・中央競馬の両方に対応。全レースAI予想を提供
      </p>

      <div class="grid grid-2" style="max-width: 900px; margin: 0 auto;">
        <!-- 南関競馬 -->
        <div class="venue-card card">
          <div class="venue-header">
            <div class="venue-icon">🏇</div>
            <h3 class="venue-title">南関競馬</h3>
            <div class="venue-badge badge-primary">運用中</div>
          </div>
          <p class="venue-description">
            大井・川崎・船橋・浦和の南関東4競馬場に完全対応。地方競馬の特性を熟知したAIが毎日予想を提供します。
          </p>
          <ul class="venue-tracks">
            <li>🏟️ 大井競馬場（東京）</li>
            <li>🏟️ 川崎競馬場（神奈川）</li>
            <li>🏟️ 船橋競馬場（千葉）</li>
            <li>🏟️ 浦和競馬場（埼玉）</li>
          </ul>
          <div class="venue-cta">
            <a href="/prediction/nankan" class="btn btn-primary w-full">南関の予想を見る（無料）</a>
            <a href="/archive/nankan" class="btn btn-secondary w-full">南関の的中実績</a>
          </div>
        </div>

        <!-- 中央競馬（JRA）-->
        <div class="venue-card card featured">
          <div class="venue-header">
            <div class="venue-icon">🏆</div>
            <h3 class="venue-title">中央競馬（JRA）</h3>
            <div class="venue-badge badge-success">NEW!</div>
          </div>
          <p class="venue-description">
            東京・中山・京都・阪神など全国10場のJRA競馬場に対応。G1レースから一般レースまで、全レースAI予想を提供します。
          </p>
          <ul class="venue-tracks">
            <li>🏟️ 東京・中山（関東）</li>
            <li>🏟️ 京都・阪神（関西）</li>
            <li>🏟️ 中京・小倉・新潟・福島・札幌・函館</li>
          </ul>
          <div class="venue-cta">
            <a href="/prediction/jra" class="btn btn-primary w-full">中央の予想を見る（無料）</a>
            <a href="/archive/jra" class="btn btn-secondary w-full">中央の的中実績</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 料金プラン（金額はここに書かない。正本は Stripe / /pricing） -->
  <section class="pricing">
    <div class="container">
      <h2 class="section-title text-center">どこまで無料で、どこから有料か</h2>
      <p class="section-subtitle text-center">
        馬柱も文章も無料で全部。閉じているのは「印」と「買い目」だけです。
      </p>

      <div class="tier-cards">
        <div class="tier-card card">
          <div class="tier-name">未登録</div>
          <div class="tier-cost">¥0</div>
          <ul class="tier-list">
            <li>✅ 出走全頭の馬柱・過去走</li>
            <li>✅ AI短評（1頭ごとの文章）</li>
            <li>✅ AIレース展望・展開予想</li>
            <li>✅ 特徴量6指標</li>
            <li>✅ 的中実績・回収率</li>
          </ul>
          <a href="/prediction/nankan" class="btn btn-secondary w-full">そのまま見る</a>
        </div>

        <div class="tier-card card">
          <div class="tier-name">無料会員</div>
          <div class="tier-cost">¥0<span class="tier-cost-sub">（登録のみ）</span></div>
          <ul class="tier-list">
            <li>✅ 未登録でできること全部</li>
            <li>✅ 印（◎○▲△・1頭に複数付与）</li>
            <li>✅ AI結論（推奨理由の解説）</li>
          </ul>
          <a href="/register" class="btn btn-primary w-full">無料で登録する</a>
        </div>

        <div class="tier-card card featured">
          <div class="badge badge-warning">買い目つき</div>
          <div class="tier-name">有料プラン</div>
          <div class="tier-cost">月額</div>
          <ul class="tier-list">
            <li>✅ 無料会員でできること全部</li>
            <li>✅ AI指数の数値（無料はモザイク）</li>
            <li>✅ 全レースの馬単買い目</li>
            <li>✅ 開催日の注目馬・穴馬メール</li>
            <li>✅ メインレースの詳細レポート</li>
          </ul>
          <a href="/pricing" class="btn btn-primary w-full">プランと料金を見る</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ヒーローキービジュアル */
    .hero-keyvisual {
      width: 100%;
      background: #0a0e1a;
      line-height: 0;
      /* main の上パディング(--spacing-2xl)を相殺し、ヘッダー直下に詰める */
      margin-top: calc(-1 * var(--spacing-2xl));
    }

    .hero-keyvisual-img {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 auto;
    }

    /* 無料登録ビジュアル */
    .register-visual {
      width: 100%;
      background: #0a0e1a;
      line-height: 0;
    }

    .register-visual-link {
      display: block;
      cursor: pointer;
      transition: opacity var(--transition-base);
    }

    .register-visual-link:hover {
      opacity: 0.92;
    }

    .register-visual-img {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 auto;
    }

    /* ヒーローセクション */
    .hero {
      padding: var(--spacing-2xl) 0;
      min-height: 600px;
      display: flex;
      align-items: center;
      /* 🔴 グレーにしない。かつて背景画像の上に敷いていた暗いオーバーレイの残骸で
         「中間グレーの帯」になっていた（2026-09-04 報告）。画像はこの上の
         .hero-keyvisual に分離済み。
         フッターのロゴ（#60a5fa→#a78bfa）と同じ 青→藤 の系統を、ごく淡くして敷く。
         🔴 このブロックは plain CSS。スラッシュ2つはコメントにならず、
            直後の宣言までまとめて無効化される
            （2026-09-04 に実際に background が消え、下の
             gradient-bg-animated が透けて青→橙になっていた）。
            コメントはスラッシュ＋アスタリスクの形だけを使うこと。 */
      background: linear-gradient(180deg, #e0f2fe 0%, #f5f3ff 55%, #ffffff 100%);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      animation: none;
    }

    .hero-content {
      text-align: center;
    }

    .hero-title {
      font-size: 3rem;
      margin-bottom: var(--spacing-lg);
      font-weight: 800;
      /* 🔴 #e0f2fe→#60a5fa は暗い背景用で、明るい背景では 1.0〜2.2:1 しか出ない。
         フッターのロゴと同じ 青→藤 の系統で、淡い背景でも読める濃さにする
         （6.11:1 / 6.48:1）。 */
      background: linear-gradient(135deg, #1d4ed8 0%, #6d28d9 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.5rem;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-xl);
    }

    .hero-cta {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      margin-bottom: var(--spacing-2xl);
    }

    .btn-lg {
      padding: var(--spacing-md) var(--spacing-xl);
      font-size: 1.125rem;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-lg);
      margin-top: var(--spacing-2xl);
    }

    .stat-card {
      text-align: center;
    }

    .stat-icon {
      font-size: 2.5rem;
      margin-bottom: var(--spacing-sm);
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      background: var(--primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    /* 特徴セクション */
    .features {
      padding: var(--spacing-2xl) 0;
    }

    .section-title {
      font-size: 2.5rem;
      margin-bottom: var(--spacing-lg);
    }

    .section-subtitle {
      font-size: 1.125rem;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-2xl);
    }

    .feature-card {
      text-align: center;
    }

    .feature-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
    }

    .feature-card h3 {
      margin-bottom: var(--spacing-sm);
    }

    .feature-card p {
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    /* 料金プラン */
    .pricing {
      padding: var(--spacing-2xl) 0;
      background: var(--bg-secondary);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-xl);
      max-width: 900px;
      margin: 0 auto var(--spacing-xl);
    }

    .pricing-card {
      text-align: center;
      position: relative;
    }

    .pricing-card.featured {
      border: 2px solid #fbbf24;
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
    }

    .pricing-card .badge {
      position: absolute;
      top: var(--spacing-md);
      right: var(--spacing-md);
    }

    .plan-name {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
    }

    .plan-price {
      margin-bottom: var(--spacing-md);
    }

    .price {
      font-size: 2.5rem;
      font-weight: 700;
      background: var(--primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .period {
      font-size: 1.125rem;
      color: var(--text-secondary);
    }

    .plan-description {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-md);
      font-size: 0.9rem;
    }

    .lifetime-badge {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      padding: var(--spacing-sm) var(--spacing-md);
      border-radius: var(--radius-md);
      margin-bottom: var(--spacing-lg);
      display: inline-flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .lifetime-text {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
    }

    .lifetime-note {
      font-size: 0.75rem;
      color: #1e293b;
      opacity: 0.8;
    }

    .monthly-equivalent {
      background: rgba(59, 130, 246, 0.1);
      color: var(--primary-end);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: var(--spacing-lg);
      display: inline-block;
    }

    .plan-features {
      list-style: none;
      text-align: left;
      margin-bottom: var(--spacing-lg);
    }

    .plan-features li {
      padding: var(--spacing-sm) 0;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .w-full {
      width: 100%;
    }

    @media (max-width: 768px) {
      .pricing-grid {
        grid-template-columns: 1fr;
      }
    }

    /* 対応競馬場セクション */
    .venues {
      padding: var(--spacing-2xl) 0;
    }

    .venue-card {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .venue-card.featured {
      border: 2px solid #fbbf24;
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
    }

    .venue-header {
      text-align: center;
      margin-bottom: var(--spacing-md);
      position: relative;
    }

    .venue-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-sm);
    }

    .venue-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: var(--spacing-sm);
    }

    .venue-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .venue-description {
      color: var(--text-secondary);
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: var(--spacing-lg);
    }

    .venue-tracks {
      list-style: none;
      margin-bottom: var(--spacing-lg);
      flex: 1;
    }

    .venue-tracks li {
      padding: var(--spacing-xs) 0;
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    .venue-cta {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      margin-top: auto;
    }

    /* レスポンシブ */
    @media (max-width: 1024px) {
      .hero-title {
        font-size: 2.5rem;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      /* 🔴 ここに暗いオーバーレイの上書きが残っており、モバイルだけグレーの帯に
         なっていた（2026-09-04 報告）。背景は上の .hero の指定に任せる。 */

      .hero-title {
        font-size: 2rem;
      }

      .hero-subtitle {
        font-size: 1.125rem;
      }

      .hero-cta {
        flex-direction: column;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
    /* ── 2026-08-28 追加: tier 比較カード / 実測値の注記 ── */
    .stats-note {
      margin-top: 12px;
      font-size: 0.78rem;
      color: var(--text-secondary);
      text-align: center;
      line-height: 1.7;
    }

    .tier-cards {
      display: grid;
