---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '銀行振込申し込み - KEIBA Intelligence';
const description = 'KEIBA Intelligence プロプラン（買い切り・年払い・月払い）の銀行振込申し込みフォーム';
---

<BaseLayout title={title} description={description}>
  <section class="apply-section">
    <div class="container">
      <!-- ページヘッダー -->
      <div class="page-header">
        <h1>💳 銀行振込申し込み</h1>
        <p class="subtitle">KEIBA Intelligence プロプラン - 銀行振込でのお支払い</p>
      </div>

      <!-- プラン選択カード -->
      <div class="plan-selector-section">
        <h2>プランを選択</h2>
        <div class="plan-grid">
          <!-- 買い切りプラン -->
          <div class="plan-card recommended" data-plan="lifetime" data-price="88000">
            <div class="badge badge-warning">一番お得</div>
            <div class="plan-name">買い切りプラン</div>
            <div class="plan-price">
              <span class="price">¥88,000</span>
            </div>
            <div class="lifetime-badge">
              <span class="lifetime-text">永久アクセス</span>
              <span class="lifetime-note">追加料金なし</span>
            </div>
            <ul class="plan-features">
              <li>✅ 南関4場＋JRA全10場 全レース予想</li>
              <li>✅ 馬単買い目（本線+抑え）</li>
              <li>✅ 全期間の的中実績</li>
              <li>✅ 永久アクセス（一度の支払いのみ）</li>
            </ul>
            <button class="btn btn-select" onclick="selectPlan('買い切りプラン', 88000, 'lifetime')">このプランを選択</button>
          </div>

          <!-- 年払いプラン -->
          <div class="plan-card" data-plan="yearly" data-price="66000">
            <div class="badge badge-success">おすすめ</div>
            <div class="plan-name">年払いプラン</div>
            <div class="plan-price">
              <span class="price">¥66,000</span>
              <span class="period">/年</span>
            </div>
            <div class="monthly-equivalent">月額換算 ¥5,500</div>
            <ul class="plan-features">
              <li>✅ 南関4場＋JRA全10場 全レース予想</li>
              <li>✅ 馬単買い目（本線+抑え）</li>
              <li>✅ 全期間の的中実績</li>
              <li>✅ 1年間アクセス（自動更新なし）</li>
            </ul>
            <button class="btn btn-select" onclick="selectPlan('年払いプラン', 66000, 'yearly')">このプランを選択</button>
          </div>

          <!-- 月払い南関プラン -->
          <div class="plan-card" data-plan="monthly-nankan" data-price="12000">
            <div class="plan-name">月払い南関プラン</div>
            <div class="plan-price">
              <span class="price">¥12,000</span>
              <span class="period">/月</span>
            </div>
            <ul class="plan-features">
              <li>✅ 南関4場のみ全レース予想</li>
              <li>✅ 馬単買い目（本線+抑え）</li>
              <li>✅ 全期間の的中実績</li>
              <li>⚠️ 年払いより割高（月額2.2倍）</li>
            </ul>
            <button class="btn btn-select" onclick="selectPlan('月払い南関プラン', 12000, 'monthly-nankan')">このプランを選択</button>
          </div>

          <!-- 月払い中央プラン -->
          <div class="plan-card" data-plan="monthly-jra" data-price="12000">
            <div class="plan-name">月払い中央プラン</div>
            <div class="plan-price">
              <span class="price">¥12,000</span>
              <span class="period">/月</span>
            </div>
            <ul class="plan-features">
              <li>✅ JRA全10場のみ全レース予想</li>
              <li>✅ 馬単買い目（本線+抑え）</li>
              <li>✅ 全期間の的中実績</li>
              <li>⚠️ 年払いより割高（月額2.2倍）</li>
            </ul>
            <button class="btn btn-select" onclick="selectPlan('月払い中央プラン', 12000, 'monthly-jra')">このプランを選択</button>
          </div>
        </div>
      </div>

      <!-- 振込先情報（プラン選択後に表示） -->
      <div id="bank-info-section" class="bank-info-section hidden">
        <h2>振込先情報</h2>
        <div class="bank-info-card">
          <div class="bank-detail">
            <span class="bank-label">金融機関</span>
            <span class="bank-value">三井住友銀行</span>
          </div>
          <div class="bank-detail">
            <span class="bank-label">支店名</span>
            <span class="bank-value">洲本支店（支店番号：411）</span>
          </div>
          <div class="bank-detail">
            <span class="bank-label">口座種別</span>
            <span class="bank-value">普通</span>
          </div>
          <div class="bank-detail">
            <span class="bank-label">口座番号</span>
            <span class="bank-value">5361435</span>
          </div>
          <div class="bank-detail">
            <span class="bank-label">口座名義</span>
            <span class="bank-value">フタバ アサイトシヒロ</span>
          </div>
          <div class="bank-detail selected-amount">
            <span class="bank-label">振込金額</span>
            <span class="bank-value" id="selected-amount">-</span>
          </div>
        </div>
        <div class="bank-note">
          <p><strong>⚠️ 重要：</strong>振込手数料はお客様負担となります。</p>
          <p>振込完了後、下記フォームにご入力ください。入金確認後、アカウントを有効化いたします。</p>
        </div>
      </div>

      <!-- 申し込みフォーム（プラン選択後に表示） -->
      <div id="application-form-section" class="application-form-section hidden">
        <h2>申し込み情報入力</h2>
        <form id="applicationForm" class="application-form">
          <input type="hidden" id="productName" name="productName">
          <input type="hidden" id="transferAmount" name="transferAmount">

          <div class="form-group">
            <label for="fullName">お名前（フルネーム）<span class="required">*</span></label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              placeholder="山田 太郎"
              required
            />
          </div>

          <div class="form-group">
            <label for="email">メールアドレス<span class="required">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="your-email@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="transferDate">振込日<span class="required">*</span></label>
            <input
              type="date"
              id="transferDate"
              name="transferDate"
              required
            />
          </div>

          <div class="form-group">
            <label for="remarks">備考・連絡事項</label>
            <textarea
              id="remarks"
              name="remarks"
              rows="4"
              placeholder="その他、ご質問やご要望があればご記入ください"
            ></textarea>
          </div>

          <div class="terms-section">
            <label class="checkbox-label">
              <input type="checkbox" id="agreeTerms" required>
              <span><a href="/terms" target="_blank">利用規約</a>および<a href="/privacy" target="_blank">プライバシーポリシー</a>に同意する</span>
            </label>
          </div>

          <button type="submit" class="btn btn-submit" id="submitBtn">
            申し込みを送信
          </button>

          <div id="message" class="message"></div>
        </form>
      </div>
    </div>
  </section>

  <style>
    .apply-section {
      padding: var(--spacing-2xl) 0;
      min-height: 100vh;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 var(--spacing-md);
    }

    .page-header {
      text-align: center;
      margin-bottom: var(--spacing-2xl);
    }

    .page-header h1 {
      font-size: 2.5rem;
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: var(--spacing-md);
    }

    .subtitle {
      font-size: 1.1rem;
      color: var(--text-secondary);
    }

    /* プラン選択 */
    .plan-selector-section {
      margin-bottom: var(--spacing-2xl);
    }

    .plan-selector-section h2 {
      font-size: 1.5rem;
      margin-bottom: var(--spacing-lg);
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .plan-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }

    .plan-card {
      position: relative;
      background: var(--bg-secondary);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl);
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .plan-card.recommended {
      border-color: #fbbf24;
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
    }

    .plan-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .plan-card.selected {
      border-color: #10b981;
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
    }

    .badge {
      position: absolute;
      top: -12px;
      right: var(--spacing-lg);
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .badge-warning {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      color: #1e293b;
    }

    .badge-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
    }

    .plan-name {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }

    .plan-price {
      margin-bottom: var(--spacing-md);
    }

    .price {
      font-size: 2.5rem;
      font-weight: 900;
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .period {
      font-size: 1rem;
      color: var(--text-secondary);
    }

    .lifetime-badge {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      padding: var(--spacing-sm);
      border-radius: var(--radius-md);
      margin-bottom: var(--spacing-md);
      text-align: center;
    }

    .lifetime-text {
      display: block;
      font-size: 1.1rem;
      font-weight: 800;
      color: #1e293b;
    }

    .lifetime-note {
      display: block;
      font-size: 0.85rem;
      color: #1e293b;
      opacity: 0.8;
    }

    .monthly-equivalent {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-md);
    }

    .plan-features {
      list-style: none;
      margin: var(--spacing-lg) 0;
    }

    .plan-features li {
      padding: var(--spacing-xs) 0;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .btn-select {
      width: 100%;
      padding: var(--spacing-md);
      font-weight: 700;
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-select:hover {
      background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
      transform: translateY(-2px);
    }

    /* 銀行情報 */
    .bank-info-section,
    .application-form-section {
      margin-bottom: var(--spacing-2xl);
    }

    .bank-info-section h2,
    .application-form-section h2 {
      font-size: 1.5rem;
      margin-bottom: var(--spacing-lg);
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .bank-info-card {
      background: var(--bg-secondary);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      border: 2px solid var(--border-color);
      margin-bottom: var(--spacing-lg);
    }

    .bank-detail {
      display: flex;
      justify-content: space-between;
      padding: var(--spacing-md) 0;
      border-bottom: 1px solid var(--border-color);
    }

    .bank-detail:last-child {
      border-bottom: none;
    }

    .bank-detail.selected-amount {
      background: rgba(251, 191, 36, 0.1);
      padding: var(--spacing-md);
      border-radius: var(--radius-md);
      margin-top: var(--spacing-md);
    }

    .bank-label {
      font-weight: 600;
      color: var(--text-secondary);
    }

    .bank-value {
      font-weight: 700;
      color: var(--text-primary);
    }

    .selected-amount .bank-value {
      font-size: 1.5rem;
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .bank-note {
      background: rgba(251, 191, 36, 0.1);
      border: 2px solid #fbbf24;
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
    }

    .bank-note p {
      margin: var(--spacing-sm) 0;
      color: var(--text-secondary);
    }

    /* フォーム */
    .application-form {
      background: var(--bg-secondary);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      border: 2px solid var(--border-color);
    }

    .form-group {
      margin-bottom: var(--spacing-lg);
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }

    .form-group label {
      display: block;
      margin-bottom: var(--spacing-sm);
      font-weight: 600;
      color: var(--text-primary);
    }

    .required {
      color: #ef4444;
      margin-left: 4px;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: var(--spacing-md);
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      color: var(--text-primary);
      font-size: 1rem;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-help {
      margin-top: var(--spacing-xs);
      font-size: 0.85rem;
      color: var(--text-tertiary);
    }

    .terms-section {
      margin: var(--spacing-xl) 0;
      padding: var(--spacing-lg);
      background: rgba(59, 130, 246, 0.1);
      border-radius: var(--radius-md);
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      cursor: pointer;
    }

    .checkbox-label input[type="checkbox"] {
      width: auto;
      cursor: pointer;
    }

    .checkbox-label a {
      color: #3b82f6;
      text-decoration: underline;
    }

    .btn-submit {
      width: 100%;
      padding: var(--spacing-lg);
      font-size: 1.1rem;
      font-weight: 700;
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      color: #1e293b;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-submit:hover:not(:disabled) {
      background: linear-gradient(135deg, #fcd34d 0%, #fbbf24 100%);
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(251, 191, 36, 0.4);
    }

    .btn-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .message {
      margin-top: var(--spacing-lg);
      padding: var(--spacing-lg);
      border-radius: var(--radius-md);
      text-align: center;
      font-weight: 600;
    }

    .message.success {
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
      border: 2px solid #10b981;
    }

    .message.error {
      background: rgba(239, 68, 68, 0.1);
      color: #ef4444;
      border: 2px solid #ef4444;
    }

    .hidden {
      display: none;
    }

    /* レスポンシブ */
    @media (max-width: 768px) {
      .plan-grid {
        grid-template-columns: 1fr;
      }

      .form-row {
        grid-template-columns: 1fr;
      }

      .page-header h1 {
        font-size: 2rem;
      }

      .price {
        font-size: 2rem;
      }
    }
  </style>

  <script is:inline>
    let selectedPlanName = '';
    let selectedPlanPrice = 0;
    let selectedPlanType = '';

    function selectPlan(planName, price, planType) {
      selectedPlanName = planName;
      selectedPlanPrice = price;
      selectedPlanType = planType;

      // プランカードの選択状態を更新
      document.querySelectorAll('.plan-card').forEach(card => {
        card.classList.remove('selected');
      });
      document.querySelector(`[data-plan="${planType}"]`).classList.add('selected');

      // 銀行情報セクションを表示
      document.getElementById('bank-info-section').classList.remove('hidden');
      document.getElementById('application-form-section').classList.remove('hidden');

      // 振込金額を表示
      document.getElementById('selected-amount').textContent = `¥${price.toLocaleString()}`;

      // フォームに値をセット
      document.getElementById('productName').value = planName;
      document.getElementById('transferAmount').value = price;

      // スクロール
      document.getElementById('bank-info-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // フォーム送信
    document.getElementById('applicationForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById('submitBtn');
      const messageDiv = document.getElementById('message');

      // ボタン無効化
      submitBtn.disabled = true;
      submitBtn.textContent = '送信中...';
      messageDiv.textContent = '';
      messageDiv.className = 'message';

      // フォームデータ収集
      const formData = {
        fullName: document.getElementById('fullName').value,
        email: document.getElementById('email').value,
        transferDate: document.getElementById('transferDate').value,
        transferTime: '',  // 不要（空文字列）
        transferAmount: selectedPlanPrice,
        transferName: '',  // 不要（空文字列）
        remarks: document.getElementById('remarks').value,
        productName: selectedPlanName,
        planType: selectedPlanType,
        timestamp: new Date().toISOString()
      };

      try {
        const response = await fetch('/.netlify/functions/bank-transfer-application', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData),
        });

        const data = await response.json();

        if (response.ok) {
          messageDiv.textContent = '✅ 申し込みを受け付けました。確認メールをお送りしましたのでご確認ください。入金確認後、アカウントを有効化いたします。';
          messageDiv.className = 'message success';
          document.getElementById('applicationForm').reset();

          // 選択状態をリセット
          document.querySelectorAll('.plan-card').forEach(card => {
            card.classList.remove('selected');
          });
          document.getElementById('bank-info-section').classList.add('hidden');
          document.getElementById('application-form-section').classList.add('hidden');
        } else {
          messageDiv.textContent = `❌ ${data.error || '申し込みに失敗しました'}`;
          messageDiv.className = 'message error';
        }
      } catch (error) {
        console.error('Error:', error);
        messageDiv.textContent = '❌ ネットワークエラーが発生しました';
        messageDiv.className = 'message error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '申し込みを送信';
      }
    });

    // グローバルにエクスポート
    window.selectPlan = selectPlan;
  </script>
</BaseLayout>
