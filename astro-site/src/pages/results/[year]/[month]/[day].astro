---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AIRaceComment from '../../../../components/AIRaceComment.astro';
import archiveResults from '../../../../data/archiveResults.json';
import archiveResultsJra from '../../../../data/archiveResultsJra.json';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = true;

export async function getStaticPaths() {
  const paths = [];

  // 南関競馬の日別ページ
  archiveResults.forEach((entry) => {
    const [year, month, day] = entry.date.split('-');
    paths.push({
      params: { year, month, day },
      props: { entry, type: 'nankan' }
    });
  });

  // 中央競馬の日別ページ
  archiveResultsJra.forEach((entry) => {
    const [year, month, day] = entry.date.split('-');
    paths.push({
      params: { year, month, day },
      props: { entry, type: 'jra' }
    });
  });

  return paths;
}

const { entry, type } = Astro.props;
const { year, month, day } = Astro.params;

// 予想データから役割情報（本命・対抗等）を取得
const venueToFile: Record<string, string> = { '大井': 'ooi', '川崎': 'kawasaki', '船橋': 'funabashi', '浦和': 'urawa' };
const predictionRoles: Record<string, Array<{horseNumber: number, horseName: string, role: string}>> = {};

try {
  const dateStr = entry.date;
  if (type === 'jra') {
    const jraPath = path.join(process.cwd(), 'src/data/predictions/jra', year, month, `${dateStr}.json`);
    if (fs.existsSync(jraPath)) {
      const jraData = JSON.parse(fs.readFileSync(jraPath, 'utf-8'));
      for (const v of jraData.venues || []) {
        for (const pred of v.predictions || []) {
          const rNum = pred.raceInfo?.raceNumber;
          const vName = v.venue || pred.raceInfo?.venue;
          if (rNum) {
            const key = `${vName}-${rNum}`;
            predictionRoles[key] = (pred.horses || [])
              .filter((h: any) => h.role && h.role !== '無')
              .slice(0, 5)
              .map((h: any) => ({ horseNumber: h.horseNumber, horseName: h.horseName, role: h.role }));
          }
        }
      }
    }
  } else {
    const venues = (entry.venues || [entry.venue]).flatMap((v: string) => v.split('・'));
    for (const venue of venues) {
      const fileKey = venueToFile[venue];
      if (!fileKey) continue;
      const predPath = path.join(process.cwd(), 'src/data/predictions', `${dateStr}-${fileKey}.json`);
      if (!fs.existsSync(predPath)) continue;
      const predData = JSON.parse(fs.readFileSync(predPath, 'utf-8'));
      for (const pred of predData.predictions || []) {
        const rNum = pred.raceInfo?.raceNumber;
        if (rNum) {
          const key = `${venue}-${rNum}`;
          predictionRoles[key] = (pred.horses || [])
            .filter((h: any) => h.role && h.role !== '無')
            .slice(0, 5)
            .map((h: any) => ({ horseNumber: h.horseNumber, horseName: h.horseName, role: h.role }));
        }
      }
    }
  }
} catch (e) {
  // 予想データがない場合は空のままで問題ない
}

const title = `${entry.date} ${type === 'jra' ? '中央競馬' : '南関競馬'} 的中実績 - KEIBA Intelligence`;
const description = `${entry.date}の${type === 'jra' ? '中央競馬' : '南関競馬'}予想の的中実績。的中率${entry.hitRate}%、回収率${entry.returnRate}%、${entry.hitRaces}/${entry.totalRaces}レース的中。AI競馬予想の詳細な結果を公開。`;

// 会場別の住所マッピング
const venueAddresses = {
  "大井": "東京都品川区勝島2丁目1-2",
  "川崎": "神奈川県川崎市川崎区富士見2丁目1-6",
  "船橋": "千葉県船橋市若松1丁目2-1",
  "浦和": "埼玉県さいたま市南区別所4丁目1-1",
  "東京": "東京都府中市日吉町1-1",
  "京都": "京都府京都市伏見区葭島渡場島町32",
  "阪神": "兵庫県宝塚市駒の町1-1",
  "中山": "千葉県船橋市古作1丁目1-1",
  "小倉": "福岡県北九州市小倉南区北方4丁目5-1",
  "新潟": "新潟県新潟市北区笹山3490",
  "中京": "愛知県豊明市間米町敷田1225",
  "福島": "福島県福島市松浪町9-23",
  "札幌": "北海道札幌市中央区北16条西16丁目",
  "函館": "北海道函館市駒場町12-2"
};

// 会場から住所を取得（複数会場の場合は最初の会場）
const primaryVenue = entry.venue.split('・')[0];
const venueAddress = venueAddresses[primaryVenue] || "日本";

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `${entry.date} ${type === 'jra' ? '中央競馬' : '南関競馬'} 的中実績`,
  "description": description,
  "startDate": `${entry.date}T10:00:00+09:00`,
  "endDate": `${entry.date}T20:30:00+09:00`,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": entry.venue,
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "JP",
      "addressRegion": venueAddress
    }
  },
  "image": [
    "https://keiba-intelligence.netlify.app/og-image.png"
  ],
  "organizer": {
    "@type": "Organization",
    "name": "KEIBA Intelligence",
    "url": "https://keiba-intelligence.netlify.app"
  },
  "performer": {
    "@type": "SportsTeam",
    "name": `${entry.totalRaces}レース出走馬`
  },
  "offers": {
    "@type": "Offer",
    "url": `https://keiba-intelligence.netlify.app/results/${year}/${month}/${day}`,
    "price": "0",
    "priceCurrency": "JPY",
    "availability": "https://schema.org/InStock",
    "validFrom": entry.date
  },
  "sport": "競馬"
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="container">
    <div class="page-header">
      <h1>🎯 {entry.date} 的中実績</h1>
      <p class="subtitle">{type === 'jra' ? '中央競馬' : '南関競馬'} - {entry.venue}</p>
    </div>

    <!-- パンくずリスト -->
    <nav class="breadcrumb">
      <a href="/">ホーム</a>
      <span>›</span>
      <a href={type === 'jra' ? '/archive/jra' : '/archive'}>的中実績</a>
      <span>›</span>
      <a href={`/results/${year}/${month}`}>{year}年{month}月</a>
      <span>›</span>
      <span>{day}日</span>
    </nav>

    <!-- 統計サマリー -->
    <section class="stats-summary">
      <div class="stat-card">
        <div class="stat-label">的中率</div>
        <div class="stat-value">{entry.hitRate}%</div>
        <div class="stat-detail">{entry.hitRaces}/{entry.totalRaces}レース</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">回収率</div>
        <div class="stat-value">{entry.returnRate}%</div>
        <div class="stat-detail">{entry.betPointsPerRace}点/R</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">投資額</div>
        <div class="stat-value">¥{(entry.betAmount || 0).toLocaleString()}</div>
        <div class="stat-detail">{entry.totalRaces}レース</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">払戻額</div>
        <div class="stat-value">¥{(entry.totalPayout || 0).toLocaleString()}</div>
        <div class="stat-detail">+¥{((entry.totalPayout || 0) - (entry.betAmount || 0)).toLocaleString()}</div>
      </div>
    </section>

    <!-- レース別結果 -->
    <section class="races-section">
      <h2>📋 全{entry.totalRaces}レース結果</h2>

      {(entry.raceResults || entry.races || []).map((race) => (
        <div class={`race-card ${race.honmeiHit || race.isHit ? 'hit' : 'miss'}`}>
          <div class="race-header">
            <div class="race-info">
              <span class="race-number">{race.raceNumber}R</span>
              <span class="race-name">{race.raceName}</span>
              {race.venue && <span class="race-venue">{race.venue}</span>}
            </div>
            <div class={`race-result-badge ${race.honmeiHit || race.isHit ? 'hit' : 'miss'}`}>
              {(race.honmeiHit || race.isHit) ? '✅ 的中' : '❌ 外れ'}
            </div>
          </div>

          <div class="race-content">
            <!-- 結果 -->
            <div class="result-box">
              <h4>レース結果</h4>
              <div class="result-line">
                <span class="position">1着</span>
                <span class="horse">{race.winner || race.result?.first?.number}番{race.result?.first?.name ? ` ${race.result.first.name}` : ''}</span>
              </div>
              <div class="result-line">
                <span class="position">2着</span>
                <span class="horse">{race.second || race.result?.second?.number}番{race.result?.second?.name ? ` ${race.result.second.name}` : ''}</span>
              </div>
              <div class="result-line">
                <span class="position">3着</span>
                <span class="horse">{race.third || race.result?.third?.number}番{race.result?.third?.name ? ` ${race.result.third.name}` : ''}</span>
              </div>
              <div class="hit-summary">
                {race.honmeiHit && <span class="hit-badge">本命的中</span>}
                {race.umatanHit && <span class="hit-badge">馬単的中</span>}
                {race.sanrenpukuHit && <span class="hit-badge">3連複的中</span>}
              </div>
            </div>

            {/* 予想サマリー（買い目は非表示） */}
            <div class="prediction-summary-box">
              <h4>AI予想サマリー</h4>
              {(race.payouts?.umatan?.[0]?.combination || race.umatan?.combination) && (
                <div class="summary-item">
                  <span class="summary-label">馬単</span>
                  <span class={`summary-value ${(race.isHit || race.honmeiHit) ? 'hit' : ''}`}>{race.payouts?.umatan?.[0]?.combination || race.umatan?.combination}</span>
                </div>
              )}
              <div class="summary-item">
                <span class="summary-label">判定</span>
                <span class={`summary-value ${(race.isHit || race.honmeiHit) ? 'hit' : 'miss'}`}>
                  {(race.isHit || race.honmeiHit) ? '的中' : '不的中'}
                </span>
              </div>
              {(race.isHit || race.honmeiHit) && (race.umatan?.payout || race.payouts?.umatan?.[0]?.payout) && (
                <div class="summary-item">
                  <span class="summary-label">払い戻し</span>
                  <span class="summary-value hit">¥{(race.umatan?.payout || race.payouts?.umatan?.[0]?.payout || 0).toLocaleString()}</span>
                </div>
              )}
            </div>

          </div>

          {/* AI振り返り */}
          <AIRaceComment
            type="result"
            masked={true}
            raceData={JSON.stringify({
              venue: race.venue || entry.venue,
              date: entry.date,
              raceNumber: race.raceNumber,
              raceName: race.raceName,
              isHit: race.isHit || race.honmeiHit || false,
              result: race.result || {
                first: { number: race.winner || '?', name: '' },
                second: { number: race.second || '?', name: '' },
                third: { number: race.third || '?', name: '' }
              },
              umatanCombination: race.umatan?.combination || race.payouts?.umatan?.[0]?.combination || '',
              payout: race.umatan?.payout || race.payouts?.umatan?.[0]?.payout || 0,
              roles: predictionRoles[`${race.venue || entry.venue}-${race.raceNumber}`] || []
            })}
          />
        </div>
      ))}
    </section>

    <!-- 関連リンク -->
    <section class="related-links">
      <h3>関連ページ</h3>
      <div class="link-grid">
        <a href={`/results/${year}/${month}`} class="link-card">
          📅 {year}年{month}月の実績一覧
        </a>
        <a href={type === 'jra' ? '/archive/jra' : '/archive'} class="link-card">
          📊 全期間の実績
        </a>
        <a href={type === 'jra' ? '/prediction/jra' : '/prediction/nankan'} class="link-card">
          🔮 最新予想を見る
        </a>
      </div>
    </section>

    <!-- 注意事項 -->
    <section class="results-notice">
      <p>※ 掲載されている的中率・収支データは、AIモデルが算出した買い目パターンに基づく理論値です。実際の収支はお客様の購入点数・金額配分により異なります。</p>
      <p>※ 本サービスで提示する買い目は複数パターンの候補を含むため、表示点数と集計上の基準点数が異なる場合があります。</p>
      <p>※ 過去の実績は将来の結果を保証するものではありません。馬券購入は自己責任でお願いいたします。</p>
    </section>
  </main>
</BaseLayout>

<style>
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.page-header {
  text-align: center;
  margin-bottom: 2rem;
}

.page-header h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  color: var(--primary-blue);
}

.subtitle {
  font-size: 1.1rem;
  color: var(--text-muted);
}

/* パンくずリスト */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  padding: 1rem;
  background: var(--card-bg);
  border-radius: 8px;
  font-size: 0.9rem;
}

.breadcrumb a {
  color: var(--primary-blue);
  text-decoration: none;
}

.breadcrumb a:hover {
  text-decoration: underline;
}

.breadcrumb span:not(:has(a)) {
  color: var(--text-muted);
}

/* 統計サマリー */
.stats-summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.stat-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
}

.stat-label {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
}

.stat-value {
  font-size: 2rem;
  font-weight: bold;
  color: var(--primary-blue);
  margin-bottom: 0.25rem;
}

.stat-detail {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* レース別結果 */
.races-section h2 {
  margin-bottom: 1.5rem;
  color: var(--heading-color);
}

.race-card {
  background: var(--card-bg);
  border: 2px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.race-card.hit {
  border-color: #22c55e;
  background: linear-gradient(135deg, var(--card-bg) 0%, rgba(34, 197, 94, 0.05) 100%);
}

.race-card.miss {
  border-color: var(--border-color);
}

.race-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-color);
}

.race-info {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.race-number {
  background: var(--primary-blue);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 6px;
  font-weight: bold;
}

.race-name {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--heading-color);
}

.race-venue {
  background: var(--background);
  padding: 0.25rem 0.75rem;
  border-radius: 6px;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.race-result-badge {
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-weight: bold;
  font-size: 0.9rem;
}

.race-result-badge.hit {
  background: #22c55e;
  color: white;
}

.race-result-badge.miss {
  background: #6b7280;
  color: white;
}

.race-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.result-box, .betting-box {
  background: var(--background);
  padding: 1rem;
  border-radius: 8px;
}

.result-box h4, .betting-box h4 {
  margin-bottom: 1rem;
  color: var(--heading-color);
  font-size: 0.95rem;
}

.result-line {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
  padding: 0.5rem;
  background: var(--card-bg);
  border-radius: 6px;
}

.position {
  font-weight: bold;
  color: var(--primary-blue);
  min-width: 40px;
}

.horse {
  color: var(--text-color);
}

.umatan-payout {
  margin-top: 1rem;
  padding: 0.75rem;
  background: var(--card-bg);
  border-radius: 6px;
  text-align: center;
  font-size: 0.95rem;
}

.umatan-payout strong {
  color: var(--primary-blue);
  font-size: 1.1rem;
}

.betting-line {
  padding: 0.75rem;
  background: var(--card-bg);
  border-radius: 6px;
  margin-bottom: 0.5rem;
  font-family: monospace;
  font-size: 0.9rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.betting-line.hit-line {
  background: rgba(34, 197, 94, 0.1);
  border: 2px solid #22c55e;
}

.hit-badge {
  background: #22c55e;
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.8rem;
  font-family: sans-serif;
}

.betting-points {
  margin-top: 0.75rem;
  font-size: 0.85rem;
  color: var(--text-muted);
  text-align: right;
}

/* 予想サマリー */
.prediction-summary-box {
  background: var(--background);
  padding: 1rem;
  border-radius: 8px;
}

.prediction-summary-box h4 {
  margin-bottom: 0.75rem;
  color: var(--heading-color);
  font-size: 0.95rem;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border-color);
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-label {
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.summary-value {
  font-weight: 700;
  font-size: 0.95rem;
}

.summary-value.hit {
  color: #22c55e;
}

.summary-value.miss {
  color: #ef4444;
}

/* 関連リンク */
.related-links {
  margin-top: 3rem;
  padding: 2rem;
  background: var(--card-bg);
  border-radius: 12px;
}

.related-links h3 {
  margin-bottom: 1rem;
  color: var(--heading-color);
}

.link-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.link-card {
  padding: 1rem;
  background: var(--background);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-color);
  transition: all 0.3s ease;
  text-align: center;
}

.link-card:hover {
  background: var(--primary-blue);
  color: white;
  border-color: var(--primary-blue);
  transform: translateY(-2px);
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .race-content {
    grid-template-columns: 1fr;
  }

  .stats-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .race-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .link-grid {
    grid-template-columns: 1fr;
  }
}

.results-notice {
  margin-top: 2rem;
  padding: 1rem 1.25rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.results-notice p {
  font-size: 0.75rem;
  color: rgba(148, 163, 184, 0.6);
  line-height: 1.7;
  margin: 0;
}
</style>
