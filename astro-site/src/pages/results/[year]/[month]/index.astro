---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import archiveResults from '../../../../data/archiveResults.json';
import archiveResultsJra from '../../../../data/archiveResultsJra.json';

export const prerender = true;

export async function getStaticPaths() {
  const paths = new Map();

  // 南関競馬の月別集計
  archiveResults.forEach((entry) => {
    const [year, month] = entry.date.split('-');
    const key = `${year}-${month}`;

    if (!paths.has(key)) {
      paths.set(key, {
        params: { year, month },
        props: { nankan: [], jra: [] }
      });
    }

    paths.get(key).props.nankan.push(entry);
  });

  // 中央競馬の月別集計
  archiveResultsJra.forEach((entry) => {
    const [year, month] = entry.date.split('-');
    const key = `${year}-${month}`;

    if (!paths.has(key)) {
      paths.set(key, {
        params: { year, month },
        props: { nankan: [], jra: [] }
      });
    }

    paths.get(key).props.jra.push(entry);
  });

  return Array.from(paths.values());
}

const { nankan, jra } = Astro.props;
const { year, month } = Astro.params;

// 月別統計計算
function calculateMonthlyStats(entries) {
  if (entries.length === 0) return null;

  const totalRaces = entries.reduce((sum, e) => sum + e.totalRaces, 0);
  const hitRaces = entries.reduce((sum, e) => sum + e.hitRaces, 0);
  const betAmount = entries.reduce((sum, e) => sum + e.betAmount, 0);
  const totalPayout = entries.reduce((sum, e) => sum + e.totalPayout, 0);

  return {
    days: entries.length,
    totalRaces,
    hitRaces,
    hitRate: Math.round((hitRaces / totalRaces) * 100),
    betAmount,
    totalPayout,
    returnRate: Math.round((totalPayout / betAmount) * 100 * 10) / 10,
    profit: totalPayout - betAmount
  };
}

const nankanStats = calculateMonthlyStats(nankan);
const jraStats = calculateMonthlyStats(jra);

// 月別統計の合算
const hasData = nankanStats || jraStats;
const combinedStats = hasData ? {
  days: (nankanStats?.days || 0) + (jraStats?.days || 0),
  totalRaces: (nankanStats?.totalRaces || 0) + (jraStats?.totalRaces || 0),
  hitRaces: (nankanStats?.hitRaces || 0) + (jraStats?.hitRaces || 0),
  betAmount: (nankanStats?.betAmount || 0) + (jraStats?.betAmount || 0),
  totalPayout: (nankanStats?.totalPayout || 0) + (jraStats?.totalPayout || 0),
} : null;

if (combinedStats) {
  combinedStats.hitRate = Math.round((combinedStats.hitRaces / combinedStats.totalRaces) * 100);
  combinedStats.returnRate = Math.round((combinedStats.totalPayout / combinedStats.betAmount) * 100 * 10) / 10;
  combinedStats.profit = combinedStats.totalPayout - combinedStats.betAmount;
}

const monthName = new Date(year, parseInt(month) - 1).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long' });
const title = `${monthName} 的中実績 - KEIBA Intelligence`;
const description = `${monthName}の競馬予想的中実績。${combinedStats ? `的中率${combinedStats.hitRate}%、回収率${combinedStats.returnRate}%、${combinedStats.days}日間で${combinedStats.hitRaces}/${combinedStats.totalRaces}レース的中。` : ''}AI競馬予想の詳細な結果を公開。`;
---

<BaseLayout title={title} description={description}>
  <main class="container">
    <div class="page-header">
      <h1>📊 {monthName} 的中実績</h1>
      <p class="subtitle">南関競馬 + 中央競馬 月間統計</p>
    </div>

    <!-- パンくずリスト -->
    <nav class="breadcrumb">
      <a href="/">ホーム</a>
      <span>›</span>
      <a href="/archive">的中実績</a>
      <span>›</span>
      <span>{year}年{month}月</span>
    </nav>

    {combinedStats && (
      <>
        <!-- 月間統計サマリー -->
        <section class="monthly-summary">
          <h2>🎯 月間統計</h2>
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">開催日数</div>
              <div class="stat-value">{combinedStats.days}日</div>
              <div class="stat-detail">
                {nankanStats && `南関${nankanStats.days}日`}
                {nankanStats && jraStats && ' + '}
                {jraStats && `中央${jraStats.days}日`}
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-label">的中率</div>
              <div class="stat-value">{combinedStats.hitRate}%</div>
              <div class="stat-detail">{combinedStats.hitRaces}/{combinedStats.totalRaces}R</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">回収率</div>
              <div class="stat-value">{combinedStats.returnRate}%</div>
              <div class="stat-detail">
                {combinedStats.profit >= 0 ? '+' : ''}¥{combinedStats.profit.toLocaleString()}
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-label">投資額</div>
              <div class="stat-value">¥{combinedStats.betAmount.toLocaleString()}</div>
              <div class="stat-detail">払戻 ¥{combinedStats.totalPayout.toLocaleString()}</div>
            </div>
          </div>
        </section>

        <!-- 南関競馬・中央競馬別統計 -->
        <section class="type-stats">
          <h2>📈 開催別統計</h2>
          <div class="type-grid">
            {nankanStats && (
              <div class="type-card nankan">
                <h3>🏇 南関競馬</h3>
                <div class="type-stats-row">
                  <div class="type-stat">
                    <span class="label">開催日数</span>
                    <span class="value">{nankanStats.days}日</span>
                  </div>
                  <div class="type-stat">
                    <span class="label">的中率</span>
                    <span class="value">{nankanStats.hitRate}%</span>
                  </div>
                  <div class="type-stat">
                    <span class="label">回収率</span>
                    <span class="value">{nankanStats.returnRate}%</span>
                  </div>
                  <div class="type-stat">
                    <span class="label">的中</span>
                    <span class="value">{nankanStats.hitRaces}/{nankanStats.totalRaces}R</span>
                  </div>
                </div>
              </div>
            )}
            {jraStats && (
              <div class="type-card jra">
                <h3>🏆 中央競馬</h3>
                <div class="type-stats-row">
                  <div class="type-stat">
                    <span class="label">開催日数</span>
                    <span class="value">{jraStats.days}日</span>
                  </div>
                  <div class="type-stat">
                    <span class="label">的中率</span>
                    <span class="value">{jraStats.hitRate}%</span>
                  </div>
                  <div class="type-stat">
                    <span class="label">回収率</span>
                    <span class="value">{jraStats.returnRate}%</span>
                  </div>
                  <div class="type-stat">
                    <span class="label">的中</span>
                    <span class="value">{jraStats.hitRaces}/{jraStats.totalRaces}R</span>
                  </div>
                </div>
              </div>
            )}
          </div>
        </section>
      </>
    )}

    <!-- 日別実績リスト -->
    <section class="daily-results">
      <h2>📅 日別実績</h2>

      {nankan.length > 0 && (
        <div class="results-group">
          <h3>南関競馬</h3>
          <div class="results-list">
            {nankan.map((entry) => (
              <a href={`/results/${year}/${month}/${entry.date.split('-')[2]}`} class="result-item">
                <div class="result-date">{entry.date}</div>
                <div class="result-venue">{entry.venue}</div>
                <div class="result-stats">
                  <span class="hit-rate">{entry.hitRate}%</span>
                  <span class="return-rate">{entry.returnRate}%</span>
                  <span class="races">{entry.hitRaces}/{entry.totalRaces}R</span>
                </div>
                <div class="result-payout">
                  ¥{entry.totalPayout.toLocaleString()}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {jra.length > 0 && (
        <div class="results-group">
          <h3>中央競馬</h3>
          <div class="results-list">
            {jra.map((entry) => (
              <a href={`/results/${year}/${month}/${entry.date.split('-')[2]}`} class="result-item">
                <div class="result-date">{entry.date}</div>
                <div class="result-venue">{entry.venue}</div>
                <div class="result-stats">
                  <span class="hit-rate">{entry.hitRate}%</span>
                  <span class="return-rate">{entry.returnRate}%</span>
                  <span class="races">{entry.hitRaces}/{entry.totalRaces}R</span>
                </div>
                <div class="result-payout">
                  ¥{entry.totalPayout.toLocaleString()}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- 関連リンク -->
    <section class="related-links">
      <h3>関連ページ</h3>
      <div class="link-grid">
        <a href="/archive" class="link-card">
          📊 全期間の実績
        </a>
        <a href="/archive-jra" class="link-card">
          🏆 中央競馬実績
        </a>
        <a href="/prediction" class="link-card">
          🔮 南関予想を見る
        </a>
        <a href="/prediction-jra" class="link-card">
          🔮 中央予想を見る
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.page-header {
  text-align: center;
  margin-bottom: 2rem;
}

.page-header h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  color: var(--primary-blue);
}

.subtitle {
  font-size: 1.1rem;
  color: var(--text-muted);
}

/* パンくずリスト */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  padding: 1rem;
  background: var(--card-bg);
  border-radius: 8px;
  font-size: 0.9rem;
}

.breadcrumb a {
  color: var(--primary-blue);
  text-decoration: none;
}

.breadcrumb a:hover {
  text-decoration: underline;
}

.breadcrumb span:not(:has(a)) {
  color: var(--text-muted);
}

/* 月間統計サマリー */
.monthly-summary {
  margin-bottom: 3rem;
}

.monthly-summary h2 {
  margin-bottom: 1.5rem;
  color: var(--heading-color);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}

.stat-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
}

.stat-label {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
}

.stat-value {
  font-size: 2rem;
  font-weight: bold;
  color: var(--primary-blue);
  margin-bottom: 0.25rem;
}

.stat-detail {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* 開催別統計 */
.type-stats {
  margin-bottom: 3rem;
}

.type-stats h2 {
  margin-bottom: 1.5rem;
  color: var(--heading-color);
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
}

.type-card {
  background: var(--card-bg);
  border: 2px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
}

.type-card h3 {
  margin-bottom: 1rem;
  color: var(--heading-color);
  font-size: 1.2rem;
}

.type-stats-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.type-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0.75rem;
  background: var(--background);
  border-radius: 8px;
}

.type-stat .label {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-bottom: 0.25rem;
}

.type-stat .value {
  font-size: 1.3rem;
  font-weight: bold;
  color: var(--primary-blue);
}

/* 日別実績リスト */
.daily-results h2 {
  margin-bottom: 1.5rem;
  color: var(--heading-color);
}

.results-group {
  margin-bottom: 2rem;
}

.results-group h3 {
  margin-bottom: 1rem;
  color: var(--heading-color);
  font-size: 1.1rem;
  padding-left: 0.5rem;
  border-left: 4px solid var(--primary-blue);
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.result-item {
  display: grid;
  grid-template-columns: 120px 1fr auto auto;
  gap: 1rem;
  align-items: center;
  padding: 1rem;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-color);
  transition: all 0.3s ease;
}

.result-item:hover {
  background: var(--primary-blue);
  color: white;
  border-color: var(--primary-blue);
  transform: translateX(4px);
}

.result-date {
  font-weight: 600;
}

.result-venue {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.result-item:hover .result-venue {
  color: rgba(255, 255, 255, 0.8);
}

.result-stats {
  display: flex;
  gap: 1rem;
  font-size: 0.9rem;
}

.hit-rate, .return-rate, .races {
  padding: 0.25rem 0.5rem;
  background: var(--background);
  border-radius: 4px;
}

.result-item:hover .hit-rate,
.result-item:hover .return-rate,
.result-item:hover .races {
  background: rgba(255, 255, 255, 0.2);
}

.result-payout {
  font-weight: bold;
  font-size: 1.1rem;
}

/* 関連リンク */
.related-links {
  margin-top: 3rem;
  padding: 2rem;
  background: var(--card-bg);
  border-radius: 12px;
}

.related-links h3 {
  margin-bottom: 1rem;
  color: var(--heading-color);
}

.link-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.link-card {
  padding: 1rem;
  background: var(--background);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-color);
  transition: all 0.3s ease;
  text-align: center;
}

.link-card:hover {
  background: var(--primary-blue);
  color: white;
  border-color: var(--primary-blue);
  transform: translateY(-2px);
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .type-grid {
    grid-template-columns: 1fr;
  }

  .result-item {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .result-stats {
    justify-content: space-between;
  }

  .link-grid {
    grid-template-columns: 1fr;
  }
}
</style>
