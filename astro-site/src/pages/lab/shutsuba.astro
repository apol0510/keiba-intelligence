// 8枠の標準カラー
const bracketColors = {
  1: { bg: '#ffffff', text: '#1a1a1a', name: '白', glow: 'rgba(255,255,255,0.4)' },
  2: { bg: '#1a1a1a', text: '#ffffff', name: '黒', glow: 'rgba(120,120,120,0.5)' },
  3: { bg: '#dc2626', text: '#ffffff', name: '赤', glow: 'rgba(220,38,38,0.5)' },
  4: { bg: '#2563eb', text: '#ffffff', name: '青', glow: 'rgba(37,99,235,0.5)' },
  5: { bg: '#fbbf24', text: '#1a1a1a', name: '黄', glow: 'rgba(251,191,36,0.5)' },
  6: { bg: '#16a34a', text: '#ffffff', name: '緑', glow: 'rgba(22,163,74,0.5)' },
  7: { bg: '#f97316', text: '#ffffff', name: '橙', glow: 'rgba(249,115,22,0.5)' },
  8: { bg: '#ec4899', text: '#ffffff', name: '桃', glow: 'rgba(236,72,153,0.5)' },
};

const roleColors = {
  '◎': '#fbbf24',
  '◯': '#60a5fa',
  '▲': '#34d399',
  '△': '#a78bfa',
  '×': '#94a3b8',
};

// 表示用に事前計算（JSX内の制御フローを避ける）
const horsesView = race.horses.map(h => {
  const bc = bracketColors[h.bracket] ?? bracketColors[1];
  const rc = roleColors[h.role] ?? '#94a3b8';
  const styleVars = `--bracket-bg:${bc.bg};--bracket-text:${bc.text};--bracket-glow:${bc.glow};--role-color:${rc}`;
  const pastRows = (h.pastRaces || []).map(p => {
    let cls = '';
    if (p.rank === 1) cls = 'win';
    else if (p.rank === 2 || p.rank === 3) cls = 'place';
    return { ...p, cls };
  });
  return { ...h, styleVars, pastRows };
});
