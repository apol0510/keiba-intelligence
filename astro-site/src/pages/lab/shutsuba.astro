<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>出馬表デモ — {race.venue}{race.raceNumber}R {race.raceName}</title>
<meta name="robots" content="noindex">
</head>
<body>
  <div class="page">
    <!-- レースヘッダー -->
    <header class="race-header">
      <div class="race-meta">
        <span class="badge-class">{race.raceClass}</span>
        <span class="badge-date">{race.date}</span>
        <span class="badge-time">発走 {race.startTime}</span>
      </div>
      <h1 class="race-title">
        <span class="venue-num">{race.venue}{race.raceNumber}R</span>
        <span class="race-name">{race.raceName}</span>
      </h1>
      <div class="race-conditions">
        <span>{race.trackInfo}</span>
        <span>{race.distance}m</span>
        <span class="weather">☀ {race.weather}</span>
        <span class="track">馬場：{race.trackCondition}</span>
        <span class="field-size">{race.horses.length}頭</span>
      </div>
    </header>

    <!-- 凡例 -->
    <div class="legend">
      <span>枠色:</span>
      {Object.entries(bracketColors).map(([n, c]) => (
        <span class="legend-chip" style={`background:${c.bg};color:${c.text};border:1px solid rgba(255,255,255,0.15)`}>{n}枠 {c.name}</span>
      ))}
    </div>

    <!-- 馬カード一覧 -->
    <ol class="horse-list">
      {horsesView.map(h => (
        <li class="horse-card" style={h.styleVars}>
          <div class="badge-col">
            <div class="bracket-badge">{h.bracket}</div>
            <div class="number-badge">{h.number}</div>
          </div>

          <div class="main-col">
            <div class="row-top">
              <div class="name-block">
                <div class="role-mark">{h.role}</div>
                <div class="horse-name">{h.name}</div>
                <div class="sex-age">{h.sex}{h.age}・{h.weight}kg <span class="hw">({h.horseWeight}kg)</span></div>
              </div>
              <div class="ai-score">
                <div class="ai-label">AI</div>
                <div class="ai-value">{h.aiScore}</div>
              </div>
            </div>

            <div class="row-mid">
              <div class="info-cell">
                <span class="info-label">騎手</span>
                <span class="info-value">{h.jockey}</span>
              </div>
              <div class="info-cell">
                <span class="info-label">厩舎</span>
                <span class="info-value">{h.trainer}</span>
              </div>
              <div class="info-cell pop-cell">
                <span class="info-label">人気</span>
                <span class="info-value pop">{h.popularity}<small>番</small></span>
                <span class="odds">{h.odds.toFixed(1)}倍</span>
              </div>
            </div>

            <div class="pedigree">
              <span class="ped-cell"><small>父</small> {h.sire}</span>
              <span class="ped-cell"><small>母</small> {h.dam}</span>
              <span class="ped-cell"><small>母父</small> {h.damSire}</span>
            </div>

            <details class="past-races">
              <summary>過去走 ({h.pastRows.length}走)</summary>
              <table class="past-table">
                <thead>
                  <tr>
                    <th>日付</th>
                    <th>場</th>
                    <th>レース</th>
                    <th>距離</th>
                    <th>着</th>
                    <th>タイム</th>
                    <th>人気</th>
                  </tr>
                </thead>
                <tbody>
                  {h.pastRows.map(p => (
                    <tr class={p.cls}>
                      <td>{p.date}</td>
                      <td>{p.venue}</td>
                      <td>{p.name}</td>
                      <td>{p.dist}</td>
                      <td><strong>{p.rank}</strong></td>
                      <td>{p.time}</td>
                      <td>{p.pop}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          </div>
        </li>
      ))}
    </ol>

    <footer class="demo-footer">
      <p>※ このページは出馬表UIのデモです。表示されている馬・成績はすべて架空のサンプルデータです。</p>
    </footer>
  </div>
</body>
</html>

<style lang="scss">
  :global(body) {
    margin: 0;
    background: linear-gradient(180deg, #0a0e1a 0%, #131826 50%, #0a0e1a 100%);
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
    min-height: 100vh;
  }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  /* ===== レースヘッダー ===== */
  .race-header {
    background: linear-gradient(135deg, rgba(245,158,11,0.12), rgba(220,38,38,0.08), rgba(37,99,235,0.10));
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  .race-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .badge-class {
    background: linear-gradient(135deg, #fbbf24, #dc2626);
    color: #fff;
    padding: 0.2rem 0.7rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  .badge-date, .badge-time {
    background: rgba(255,255,255,0.08);
    color: #cbd5e1;
    padding: 0.2rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .race-title {
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.5rem;
  }
  .venue-num {
    font-size: 1.75rem;
    font-weight: 800;
    color: #fbbf24;
    letter-spacing: 0.02em;
  }
  .race-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
  }
  .race-conditions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: #94a3b8;
    font-size: 0.9rem;
    & > span {
      &.weather, &.track, &.field-size {
        color: #cbd5e1;
      }
    }
  }

  /* ===== 凡例 ===== */
  .legend {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    background: rgba(255,255,255,0.03);
    border-radius: 10px;
    color: #94a3b8;
    font-size: 0.8rem;
  }
  .legend-chip {
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.75rem;
  }

  /* ===== 馬カード ===== */
  .horse-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }
  .horse-card {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0;
    background: rgba(30, 41, 59, 0.55);
    border: 1px solid rgba(148,163,184,0.18);
    border-radius: 14px;
    overflow: hidden;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 -2px 0 var(--bracket-bg) inset;
    &:hover {
      transform: translateY(-2px);
      border-color: var(--bracket-bg);
      box-shadow:
        0 -2px 0 var(--bracket-bg) inset,
        0 12px 28px var(--bracket-glow);
    }
  }

  /* 左: 枠+馬番バッジ */
  .badge-col {
    background: var(--bracket-bg);
    color: var(--bracket-text);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0;
    gap: 0.4rem;
    border-right: 1px solid rgba(0,0,0,0.1);
  }
  .bracket-badge {
    font-size: 0.7rem;
    font-weight: 700;
    opacity: 0.85;
    letter-spacing: 0.05em;
    &::after {
      content: '枠';
      margin-left: 1px;
      font-size: 0.65rem;
    }
  }
  .number-badge {
    font-size: 1.85rem;
    font-weight: 900;
    line-height: 1;
    font-family: "SF Pro Display", -apple-system, sans-serif;
  }

  /* メイン情報 */
  .main-col {
    padding: 0.85rem 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .row-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .name-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .role-mark {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--role-color);
    line-height: 1;
  }
  .horse-name {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.01em;
  }
  .sex-age {
    font-size: 0.78rem;
    color: #94a3b8;
    & .hw {
      color: #64748b;
      margin-left: 0.25rem;
    }
  }
  .ai-score {
    background: linear-gradient(135deg, rgba(99,102,241,0.18), rgba(168,85,247,0.18));
    border: 1px solid rgba(168,85,247,0.4);
    border-radius: 10px;
    padding: 0.3rem 0.6rem;
    text-align: center;
    min-width: 56px;
  }
  .ai-label {
    font-size: 0.6rem;
    color: #c084fc;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .ai-value {
    font-size: 1.4rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
  }

  /* 中段: 騎手・厩舎・人気 */
  .row-mid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    background: rgba(15,23,42,0.5);
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .info-cell {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .info-label {
    font-size: 0.62rem;
    color: #64748b;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .info-value {
    font-size: 0.88rem;
    color: #e2e8f0;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pop-cell {
    text-align: right;
    .info-value.pop {
      font-size: 1.1rem;
      color: #fbbf24;
      font-weight: 800;
      & small {
        font-size: 0.65rem;
        color: #94a3b8;
        margin-left: 1px;
      }
    }
    .odds {
      font-size: 0.72rem;
      color: #94a3b8;
    }
  }

  /* 血統 */
  .pedigree {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #cbd5e1;
  }
  .ped-cell {
    background: rgba(255,255,255,0.04);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.06);
    & small {
      color: #64748b;
      font-size: 0.7rem;
      margin-right: 0.25rem;
    }
  }

  /* 過去走 */
  .past-races {
    margin-top: 0.25rem;
    summary {
      cursor: pointer;
      font-size: 0.78rem;
      color: #60a5fa;
      padding: 0.3rem 0;
      list-style: none;
      &::-webkit-details-marker { display: none; }
      &::before {
        content: '▶ ';
        font-size: 0.65rem;
        transition: transform 0.2s;
        display: inline-block;
      }
    }
    &[open] summary::before { transform: rotate(90deg); }
  }
  .past-table {
    width: 100%;
    margin-top: 0.4rem;
    border-collapse: collapse;
    font-size: 0.75rem;
    & th, & td {
      padding: 0.3rem 0.4rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      text-align: left;
    }
    & th {
      color: #64748b;
      font-weight: 600;
      font-size: 0.68rem;
      letter-spacing: 0.05em;
    }
    & td { color: #cbd5e1; }
    & tr.win td { background: rgba(251,191,36,0.08); color: #fbbf24; font-weight: 600; }
    & tr.place td { background: rgba(96,165,250,0.06); }
    & td:nth-child(5) strong { font-size: 0.95rem; }
  }

  /* フッター */
  .demo-footer {
    margin-top: 2.5rem;
    padding: 1rem;
    text-align: center;
    color: #64748b;
    font-size: 0.78rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  /* スマホ */
  @media (max-width: 600px) {
