---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import archive from '../../../data/archiveResults.json';
import { summarize, monthlySummaries, formatPercent, formatYen, formatCount, BASIS_NOTE_LINES } from '../../../lib/stats/performance.js';

// 静的化（CDN即時配信）。データはbuild時に確定し、日次データpushの再ビルドで更新される。リクエスト依存なし。
export const prerender = true;

// 🔴 成績は単一源（lib/stats/performance.js）から。archive の旧 5 点基準 betAmount / returnRate は使わない。
const total = summarize(archive);
const allMonths = monthlySummaries(archive).map((m) => ({
  ...m,
  displayMonth: `${m.year}年${m.month}月`,
}));

const pageTitle = '的中実績アーカイブ';
const pageDescription = `南関競馬の的中実績アーカイブ。月ごとの予想結果と配当金額を全件開示し、AIモデルの判定精度を実データでご確認いただけます。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="archive-index-page">
    <div class="container">
      {/* ページヘッダー */}
      <header class="page-header">
        <h1>🏆 的中実績アーカイブ</h1>
        <p class="subtitle">全レースの予想と結果を毎日アーカイブ</p>
        <p class="description">
          的中した日も外した日も、すべての予想結果を記録しています。<br>
          良い結果も思わしくない結果も、等しく可視化しています。
        </p>
      </header>

      {/* 通算（南関のみ・単一源） */}
      <section class="market-total" aria-label="南関の通算成績">
        <span class="market-total-label">南関 通算</span>
        <span>的中率 <b>{formatPercent(total.hitRate)}</b></span>
        <span>回収率 <b>{formatPercent(total.returnRate)}</b></span>
        <span>{formatCount(total.hits)}/{formatCount(total.races)}R・{formatCount(total.days)}日</span>
      </section>

      {/* CTA */}
      <section class="cta-box">
        <p class="cta-text">
          🎯 AI予想モデルの実力を、あなた自身の馬券で確かめてみませんか
        </p>
        <a href="/pricing" class="btn btn-primary">プレミアム予想を見る →</a>
      </section>

      {allMonths.length === 0 ? (
        <div class="no-data">
          <p>まだ的中実績データがありません。</p>
        </div>
      ) : (
        <section class="months-grid">
          {allMonths.map((monthData) => (
            <a href={`/archive/nankan/${monthData.year}/${monthData.month}/`} class="month-card">
              <div class="month-header">
                <h2 class="month-title">{monthData.displayMonth}</h2>
                <div class="month-badge">{monthData.days}日開催</div>
              </div>

              <div class="month-stats">
                <div class="stat-item">
                  <div class="stat-label">的中率</div>
                  <div class="stat-value highlight">{formatPercent(monthData.hitRate)}</div>
                </div>
                <div class="stat-item">
                  <div class="stat-label">回収率</div>
                  <div class={`stat-value ${(monthData.returnRate ?? 0) >= 100 ? 'profit' : 'loss'}`}>
                    {formatPercent(monthData.returnRate)}
                  </div>
                </div>
                <div class="stat-item">
                  <div class="stat-label">的中レース</div>
                  <div class="stat-value">{monthData.hits}/{monthData.races}R</div>
                </div>
                <div class="stat-item">
                  <div class="stat-label">合計配当</div>
                  <div class="stat-value profit">{formatYen(monthData.payout)}</div>
                </div>
              </div>

              <div class="view-button">
                📊 詳細を見る →
              </div>
            </a>
          ))}
        </section>
      )}

      {/* フッターナビ */}
      <footer class="page-footer">
        <a href="/" class="btn-back">← トップページへ戻る</a>
      </footer>

      {/* 注意事項 */}
      <div class="results-notice">
        {BASIS_NOTE_LINES.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  .market-total {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    justify-content: center;
    align-items: baseline;
    margin: 0 auto 1.5rem;
    padding: 12px 16px;
    max-width: 720px;
    border-radius: 12px;
    background: var(--bg-secondary, rgba(0, 0, 0, 0.04));
    font-size: 0.95rem;
  }
  .market-total-label { font-weight: 700; }

  .archive-index-page {
    min-height: 100vh;
    padding: var(--spacing-2xl) 0;
    background: var(--bg-primary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  /* ページヘッダー */
  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    padding: var(--spacing-2xl);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(var(--primary-rgb), 0.3);

    h1 {
      font-size: 2.5rem;
      font-weight: 800;
      background: var(--primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: var(--spacing-md);
    }

    .subtitle {
      font-size: 1.2rem;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-sm);
    }

    .description {
      font-size: 1rem;
      color: var(--text-tertiary);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }
  }

  /* CTA */
  .cta-box {
    background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.1), rgba(139, 92, 246, 0.1));
    border: 1px solid rgba(var(--primary-rgb), 0.3);
    border-radius: var(--radius-lg);
    padding: var(--spacing-2xl);
    text-align: center;
    margin-bottom: var(--spacing-2xl);

    .cta-text {
      font-size: 1.1rem;
      color: var(--text-primary);
      margin-bottom: var(--spacing-lg);
    }
  }

  /* データなし */
  .no-data {
    text-align: center;
    padding: var(--spacing-2xl);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
  }

  /* 月別グリッド */
  .months-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }

  .month-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    text-decoration: none;
    color: inherit;
    display: block;
    transition: all var(--transition-normal);
    cursor: pointer;

    &:hover {
      transform: translateY(-4px);
      border-color: rgba(var(--primary-rgb), 0.5);
      box-shadow: 0 12px 30px rgba(var(--primary-rgb), 0.3);
    }
  }

  .month-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 2px solid var(--border-color);

    .month-title {
      font-size: 1.75rem;
      font-weight: 800;
      background: var(--primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .month-badge {
      background: rgba(var(--primary-rgb), 0.15);
      color: var(--primary-end);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.875rem;
    }
  }

  .month-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .stat-item {
    text-align: center;
    background: rgba(0, 0, 0, 0.2);
    padding: var(--spacing-md);
    border-radius: var(--radius-md);

    .stat-label {
      font-size: 0.75rem;
      color: var(--text-tertiary);
      margin-bottom: var(--spacing-xs);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-primary);

      &.highlight {
        color: #60a5fa;
      }

      &.profit {
        color: #10b981;
      }

      &.loss {
        color: #ef4444;
      }
    }
  }

  /* 情報を見る / 探索: シアン → 藍（旧は単色の半透明） */
  .view-button {
    background: var(--grad-outlook-btn);
    background-size: 180% 180%;
    background-position: 0% 0%;
    color: var(--btn-ink); /* 10.48 / 7.45 */
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
    transition: all var(--transition-normal);
    border: none;

    .month-card:hover & {
      background-position: 100% 100%;
      filter: brightness(1.1);
    }
  }

  /* フッター */
  .page-footer {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--border-color);
    text-align: center;
  }

  .btn-back {
    display: inline-block;
    padding: var(--spacing-md) var(--spacing-xl);
    /* 控えめな補助操作: スレート → 藍（単色にしない） */
    background: var(--grad-tool-btn);
    background-size: 180% 180%;
    background-position: 0% 0%;
    color: var(--btn-ink); /* 14.27 / 13.64 */
    text-decoration: none;
    border-radius: var(--radius-md);
    border: none;
    font-weight: 600;
    transition: all var(--transition-normal);

    &:hover {
      background-position: 100% 100%;
      filter: brightness(1.06);
      transform: translateY(-2px);
    }
  }

  /* レスポンシブ */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .months-grid {
      grid-template-columns: 1fr;
    }

    .month-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);

      .month-title {
        font-size: 1.5rem;
      }
    }

    .stat-item .stat-value {
      font-size: 1.25rem;
    }
  }

  .results-notice {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);

    p {
      font-size: 0.75rem;
      color: rgba(148, 163, 184, 0.6);
      line-height: 1.7;
      margin: 0;
    }
  }
</style>
