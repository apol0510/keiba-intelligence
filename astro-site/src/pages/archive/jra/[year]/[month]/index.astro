---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { sortRacesByVenueAndNumber } from '../../../../../utils/sortRaces.js';
import { judgeLiveHit, VENUE_CODE_TO_NAME } from '../../../../../utils/jraLiveHitJudge.js';

export const prerender = false;

const { year, month } = Astro.params;

// archiveResultsJra.jsonから該当月のデータを取得
const archivePath = join(process.cwd(), 'src', 'data', 'archiveResultsJra.json');
let monthData = [];
let monthStats = {
  totalDays: 0,
  totalRaces: 0,
  totalHitRaces: 0,
  totalBetAmount: 0,
  totalPayout: 0,
  hitRate: 0,
  returnRate: 0,
  hasLive: false,  // 速報モードで暫定表示している日が含まれるか
};

/**
 * archive entry が「broken」(rank/HR取得失敗で payout=0) かつ
 * live-results + 予想データがあれば暫定的中数を再計算する。
 * 副作用: entry.live=true, entry.hitRaces, entry.hitRate, entry.races[].isHit を上書き
 */
function tryEnrichWithLive(entry) {
  // broken の判定: 払戻 / 回収率 が両方 0 (確定 HR が取れていない状態)
  const isBroken = (Number(entry.totalPayout) || 0) === 0
                && (Number(entry.returnRate) || 0) === 0;
  if (!isBroken) return;

  // live-results 取得 (per-date file)
  const livePath = join(process.cwd(), 'src', 'data', 'jraLiveResults', `${entry.date}.json`);
  if (!existsSync(livePath)) return;
  let live;
  try { live = JSON.parse(readFileSync(livePath, 'utf-8')); } catch { return; }
  if (!live || !Array.isArray(live.venues)) return;

  // 予想データ取得 (date.json)
  const [yyyy, mm] = entry.date.split('-');
  const predPath = join(process.cwd(), 'src', 'data', 'predictions', 'jra', yyyy, mm, `${entry.date}.json`);
  if (!existsSync(predPath)) return;
  let pred;
  try { pred = JSON.parse(readFileSync(predPath, 'utf-8')); } catch { return; }

  // 予想を venue+raceNumber で indexing
  const predIndex = new Map();
  for (const v of (pred.venues || [])) {
    for (const r of (v.predictions || [])) {
      const venueName = v.venue || r.raceInfo?.venue;
      const raceNum = r.raceInfo?.raceNumber;
      if (venueName && raceNum != null) {
        predIndex.set(`${venueName}-${raceNum}`, r);
      }
    }
  }

  // live × prediction で各レース判定
  let recomputedHits = 0;
  for (const liveVenue of live.venues || []) {
    const venueName = VENUE_CODE_TO_NAME[liveVenue.venueCode] || liveVenue.venueName;
    for (const liveRace of liveVenue.races || []) {
      const predRace = predIndex.get(`${venueName}-${liveRace.raceNumber}`);
      const judge = judgeLiveHit(liveRace, predRace);
      if (judge.isHit) recomputedHits++;
      // archive races[] の isHit も上書き (表示用)
      const archiveRace = entry.races?.find(
        (r) => r.venue === venueName && r.raceNumber === liveRace.raceNumber
      );
      if (archiveRace) {
        archiveRace.isHit = judge.isHit;
        archiveRace._liveFirst = judge.first;
        archiveRace._liveSecond = judge.second;
      }
    }
  }

  // 集計値を上書き
  entry.hitRaces = recomputedHits;
  if (entry.totalRaces > 0) {
    entry.hitRate = ((recomputedHits / entry.totalRaces) * 100).toFixed(1);
  }
  entry.live = true;  // 表示用バッジフラグ
}

try {
  if (existsSync(archivePath)) {
    const fileContent = readFileSync(archivePath, 'utf-8');
    const allData = JSON.parse(fileContent);

    // 該当月のデータを抽出（日付降順）
    monthData = allData
      .filter(entry => {
        const [entryYear, entryMonth] = entry.date.split('-');
        return entryYear === year && entryMonth === month;
      })
      .sort((a, b) => b.date.localeCompare(a.date));

    // 各エントリを live で enrich (broken なら暫定再計算)
    for (const entry of monthData) {
      tryEnrichWithLive(entry);
      if (entry.live) monthStats.hasLive = true;
    }

    // 月間統計を計算 (live補正後)
    monthData.forEach(entry => {
      monthStats.totalDays++;
      monthStats.totalRaces += entry.totalRaces;
      monthStats.totalHitRaces += entry.hitRaces;
      monthStats.totalBetAmount += entry.betAmount;
      monthStats.totalPayout += entry.totalPayout;
    });

    if (monthStats.totalRaces > 0) {
      monthStats.hitRate = ((monthStats.totalHitRaces / monthStats.totalRaces) * 100).toFixed(1);
    }
    if (monthStats.totalBetAmount > 0) {
      monthStats.returnRate = ((monthStats.totalPayout / monthStats.totalBetAmount) * 100).toFixed(1);
    }
  }
} catch (error) {
  console.error('Error loading archive:', error);
}

const pageTitle = monthData.length > 0
  ? `${year}年${month}月 的中実績アーカイブ`
  : '的中実績が見つかりません';

const pageDescription = monthData.length > 0
  ? `${year}年${month}月の的中実績。開催日数${monthStats.totalDays}日、月間的中率${monthStats.hitRate}%、月間回収率${monthStats.returnRate}%、月間合計配当¥${monthStats.totalPayout.toLocaleString()}`
  : '中央競馬（JRA）の的中実績アーカイブ';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="archive-page">
    <div class="container">
      {monthData.length === 0 ? (
        <div class="no-data">
          <h1>⚠️ データが見つかりません</h1>
          <p>{year}年{month}月の的中実績はまだありません。</p>
          <a href="/results" class="btn-back">的中実績一覧へ戻る</a>
        </div>
      ) : (
        <>
          {/* ページヘッダー */}
          <header class="page-header">
            <h1>{year}年{month}月 的中実績アーカイブ</h1>
          </header>

          {/* 月間サマリー統計 */}
          <section class="summary-section">
            <div class="summary-grid">
              <div class="summary-card">
                <div class="summary-label">開催日数</div>
                <div class="summary-value">{monthStats.totalDays}日</div>
              </div>
              <div class="summary-card">
                <div class="summary-label">月間的中率</div>
                <div class="summary-value highlight">{monthStats.hitRate}%</div>
              </div>
              <div class="summary-card">
                <div class="summary-label">月間回収率</div>
                {monthStats.hasLive && Number(monthStats.totalPayout) === 0 ? (
                  <div class="summary-value pending">確定待ち</div>
                ) : (
                  <div class={`summary-value ${parseFloat(monthStats.returnRate) >= 100 ? 'profit' : 'loss'}`}>
                    {monthStats.returnRate}%
                  </div>
                )}
              </div>
              <div class="summary-card">
                <div class="summary-label">月間合計配当</div>
                {monthStats.hasLive && Number(monthStats.totalPayout) === 0 ? (
                  <div class="summary-value pending">確定待ち</div>
                ) : (
                  <div class="summary-value payout-yen">¥{monthStats.totalPayout.toLocaleString()}</div>
                )}
              </div>
            </div>
            <div class="summary-detail">
              <span>的中レース数: {monthStats.totalHitRaces}/{monthStats.totalRaces}レース</span>
            </div>
          </section>

          {/* 日別結果一覧 */}
          {monthData.map((dayData) => {
            const [, , day] = dayData.date.split('-');

            return (
              <section class="day-section">
                <a href={`/results/${year}/${month}/${day}`} class="day-header-link">
                <div class="day-header">
                  <h2>
                    <span class="day-date">{month}月{day}日</span>
                    <span class="day-venue">{dayData.venue}</span>
                    {dayData.live && <span class="live-badge">速報</span>}
                    <span class="day-detail-link">詳細を見る →</span>
                  </h2>
                  <div class="day-stats">
                    <span class="stat">{dayData.live ? '暫定的中' : '的中'} {dayData.hitRaces}/{dayData.totalRaces}レース</span>
                    <span class="stat">的中率 {dayData.hitRate}%</span>
                    {dayData.betPointsPerRace && (
                      <span class="stat">購入点数 {(Number(dayData.totalRaces) || 0) * (Number(dayData.betPointsPerRace) || 0)}点</span>
                    )}
                    {dayData.totalPayout > 0 && (
                      <span class="stat payout-yen">配当 ¥{dayData.totalPayout.toLocaleString()}</span>
                    )}
                    {dayData.live ? (
                      <span class="stat pending">回収率 確定待ち</span>
                    ) : (
                      <span class={`stat ${dayData.returnRate >= 100 ? 'profit' : 'loss'}`}>
                        回収率 {dayData.returnRate}%
                      </span>
                    )}
                  </div>
                </div>
                </a>

                <div class="races-list">
                  {(() => {
                    // 的中レースのみ: 会場→レース番号順でソート
                    const hitRaces = sortRacesByVenueAndNumber(
                      dayData.races.filter(race => race.isHit),
                      dayData.venues
                    );

                    if (hitRaces.length === 0) {
                      return <div class="no-hits">的中レースなし</div>;
                    }

                    return hitRaces.map((race) => {
                      const payout = race.umatan?.payout || 0;
                      const raceLabel = `${race.venue}${race.raceNumber}R`;
                      // displayName: 特別競走名 or 条件戦名 or 会場名+番号
                      // raceLabel と同一なら中央カラムは空（重複表示しない）
                      const dn = (race.displayName || '').trim();
                      const subName = dn && dn !== raceLabel ? dn : '';
                      return (
                        <div class="race-row hit">
                          <span class="race-number">{raceLabel}</span>
                          <span class="race-name">{subName}</span>
                          <span class="race-result">
                            <span class="hit-badge">✅ 的中</span>
                            {payout > 0 && (
                              <span class="payout">¥{payout.toLocaleString()}</span>
                            )}
                          </span>
                        </div>
                      );
                    });
                  })()}
                </div>
              </section>
            );
          })}

          {/* フッターナビ */}
          <footer class="page-footer">
            <a href="/results" class="btn-back">← 的中実績一覧へ戻る</a>
          </footer>
        </>
      )}
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  .archive-page {
    min-height: 100vh;
    padding: var(--spacing-2xl) 0;
    background: var(--bg-primary);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  /* データなし */
  .no-data {
    text-align: center;
    padding: var(--spacing-2xl);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);

    h1 {
      font-size: 2rem;
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }

    p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-xl);
    }
  }

  /* ページヘッダー */
  .page-header {
    margin-bottom: var(--spacing-2xl);

    h1 {
      font-size: 2rem;
      font-weight: 800;
      background: var(--primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  }

  /* 月間サマリー */
  .summary-section {
    margin-bottom: var(--spacing-2xl);
    padding: var(--spacing-xl);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .summary-card {
    text-align: center;
    padding: var(--spacing-lg);
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-md);

    .summary-label {
      font-size: 0.875rem;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-sm);
      font-weight: 500;
    }

    .summary-value {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text-primary);

      &.highlight {
        color: #60a5fa;
      }

      &.profit {
        color: #10b981;
      }

      &.loss {
        color: #ef4444;
      }

      /* 配当（黄色強調・収益訴求） */
      &.payout-yen {
        color: #fbbf24;
        text-shadow: 0 0 16px rgba(251, 191, 36, 0.35);
      }

      /* 確定待ち (速報モードで HR 未取得時) */
      &.pending {
        color: #94a3b8;
        font-size: 1.25rem;
        font-weight: 600;
      }
    }
  }

  .summary-detail {
    text-align: center;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  /* 日別セクション */
  .day-section {
    margin-bottom: var(--spacing-2xl);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    overflow: hidden;
  }

  .day-header-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: background 0.2s ease;

    &:hover {
      background: rgba(59, 130, 246, 0.05);

      .day-detail-link {
        opacity: 1;
      }
    }
  }

  .day-header {
    padding: var(--spacing-lg);
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-color);

    h2 {
      font-size: 1.5rem;
      margin-bottom: var(--spacing-md);
      display: flex;
      align-items: baseline;
      gap: var(--spacing-md);
      flex-wrap: wrap;

      .day-date {
        font-weight: 800;
        color: #60a5fa;
      }

      .day-venue {
        font-weight: 600;
        font-size: 1.125rem;
        color: var(--text-secondary);
      }

      .day-detail-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: #60a5fa;
        margin-left: auto;
        opacity: 0.6;
        transition: opacity 0.2s ease;
      }
    }
  }

  .day-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    font-size: 0.875rem;

    .stat {
      color: var(--text-secondary);

      &.profit {
        color: #10b981;
        font-weight: 700;
      }

      &.loss {
        color: #ef4444;
        font-weight: 600;
      }

      /* 配当（黄色強調・収益訴求） */
      &.payout-yen {
        color: #fbbf24;
        font-weight: 800;
      }

      /* 確定待ち (速報モード) */
      &.pending {
        color: #94a3b8;
        font-weight: 600;
      }
    }
  }

  /* 速報バッジ */
  .live-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.7rem;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.25) 0%, rgba(245, 158, 11, 0.15) 100%);
    border: 1px solid rgba(251, 191, 36, 0.55);
    border-radius: 999px;
    color: #fbbf24;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    box-shadow: 0 0 8px rgba(251, 191, 36, 0.25);
    margin-left: var(--spacing-sm);
  }

  /* レース一覧 */
  .races-list {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .race-row {
    display: grid;
    grid-template-columns: 110px 1fr 180px;
    align-items: center;
    gap: 16px;
    padding: var(--spacing-md) var(--spacing-lg);
    background: linear-gradient(90deg, rgba(16, 185, 129, 0.15) 0%, rgba(15, 23, 42, 0.6) 100%);
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: var(--radius-md);
    transition: all var(--transition-normal);

    &:hover {
      background: linear-gradient(90deg, rgba(16, 185, 129, 0.22) 0%, rgba(15, 23, 42, 0.75) 100%);
      border-color: rgba(16, 185, 129, 0.5);
    }

    .race-number {
      font-weight: 800;
      color: #fbbf24;
    }

    .race-name {
      min-height: 1em; /* 空でも高さ確保 */
      color: #cbd5e1;
      font-size: 0.9375rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .race-result {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 12px;
      white-space: nowrap;
    }

    /* 的中バッジ（glassmorphism pill） */
    .hit-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0.6rem 1.3rem;
      background: rgba(16, 185, 129, 0.22);
      border: 1px solid rgba(16, 185, 129, 0.5);
      border-radius: 999px;
      color: #6ee7b7;
      font-weight: 700;
      font-size: 0.85rem;
      backdrop-filter: blur(8px) saturate(160%);
      -webkit-backdrop-filter: blur(8px) saturate(160%);
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.18);
      white-space: nowrap;
    }

    /* 配当（黄色強調・収益訴求） */
    .payout {
      font-weight: 800;
      color: #fbbf24;
      font-size: 1.2rem;
      text-shadow: 0 0 12px rgba(251, 191, 36, 0.35);
      min-width: 5rem;
      text-align: right;
    }
  }

  .no-hits {
    padding: var(--spacing-lg);
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  /* フッター */
  .page-footer {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--border-color);
    text-align: center;
  }

  .btn-back {
    display: inline-block;
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--bg-secondary);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    font-weight: 600;
    transition: all var(--transition-normal);

    &:hover {
      background: var(--bg-tertiary);
      transform: translateY(-2px);
    }
  }

  /* レスポンシブ */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.5rem;
    }

    .summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .summary-card .summary-value {
      font-size: 1.5rem;
    }

    .day-header h2 {
      font-size: 1.25rem;
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .day-stats {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .race-row {
      grid-template-columns: 80px 1fr auto;
      gap: 10px;
      padding: var(--spacing-sm) var(--spacing-md);

      .race-name {
        font-size: 0.875rem;
      }

      .race-result {
        gap: 8px;
      }

      .payout {
        font-size: 1rem;
      }
    }
  }
</style>
