---
import BaseLayout from '../../layouts/BaseLayout.astro';
import archiveResults from '../../data/archiveResults.json';
import archiveResultsJra from '../../data/archiveResultsJra.json';
import PerformanceBasisNote from '../../components/PerformanceBasisNote.astro';
import { venueSummary, entriesWithVenue, dayPerformance, formatPercent, formatYen, formatSignedYen } from '../../lib/stats/performance.js';

export const prerender = true;

export async function getStaticPaths() {
  // 会場マッピング
  const venueMapping = {
    // 南関競馬
    'ohi': { name: '大井', type: 'nankan' },
    'kawasaki': { name: '川崎', type: 'nankan' },
    'funabashi': { name: '船橋', type: 'nankan' },
    'urawa': { name: '浦和', type: 'nankan' },
    // 中央競馬
    'tokyo': { name: '東京', type: 'jra' },
    'kyoto': { name: '京都', type: 'jra' },
    'hanshin': { name: '阪神', type: 'jra' },
    'kokura': { name: '小倉', type: 'jra' },
    'nakayama': { name: '中山', type: 'jra' },
    'niigata': { name: '新潟', type: 'jra' },
    'chukyo': { name: '中京', type: 'jra' },
    'fukushima': { name: '福島', type: 'jra' },
    'sapporo': { name: '札幌', type: 'jra' },
    'hakodate': { name: '函館', type: 'jra' },
  };

  return Object.keys(venueMapping).map(slug => ({
    params: { venue: slug }
  }));
}

// 会場マッピング（ページレンダリング用）
const venueMapping = {
  // 南関競馬
  'ohi': { name: '大井', type: 'nankan' },
  'kawasaki': { name: '川崎', type: 'nankan' },
  'funabashi': { name: '船橋', type: 'nankan' },
  'urawa': { name: '浦和', type: 'nankan' },
  // 中央競馬
  'tokyo': { name: '東京', type: 'jra' },
  'kyoto': { name: '京都', type: 'jra' },
  'hanshin': { name: '阪神', type: 'jra' },
  'kokura': { name: '小倉', type: 'jra' },
  'nakayama': { name: '中山', type: 'jra' },
  'niigata': { name: '新潟', type: 'jra' },
  'chukyo': { name: '中京', type: 'jra' },
  'fukushima': { name: '福島', type: 'jra' },
  'sapporo': { name: '札幌', type: 'jra' },
  'hakodate': { name: '函館', type: 'jra' },
};

const { venue } = Astro.params;
const venueInfo = venueMapping[venue];

if (!venueInfo) {
  return Astro.redirect('/404');
}

// 🔴 会場別の成績は単一源（lib/stats/performance.js）から。南関・中央とも **その会場のレースだけ** を数える。
//    （旧実装は JRA でレース保存の点数（無ければ 12 点）を投資にし、さらに ×100 を開催ごとに重ねがけしていた）
const source = venueInfo.type === 'nankan' ? archiveResults : archiveResultsJra;
const data = entriesWithVenue(source, venueInfo.name).sort((a, b) => b.date.localeCompare(a.date));
const total = venueSummary(source, venueInfo.name);
const stats = total.races > 0 ? total : null;

const title = `${venueInfo.name}競馬場 統計 - KEIBA Intelligence`;
const description = stats
  ? `${venueInfo.name}競馬場の${venueInfo.type === 'jra' ? '中央競馬' : '南関競馬'}予想統計。${stats.days}日間、的中率${formatPercent(stats.hitRate)}、回収率${formatPercent(stats.returnRate)}、${stats.hits}/${stats.races}レース的中。`
  : `${venueInfo.name}競馬場の${venueInfo.type === 'jra' ? '中央競馬' : '南関競馬'}予想統計。`;
---

<BaseLayout title={title} description={description}>
  <main class="container">
    <div class="page-header">
      <h1>🏇 {venueInfo.name}競馬場 統計</h1>
      <p class="subtitle">{venueInfo.type === 'jra' ? '中央競馬' : '南関競馬'} 累計データ</p>
    </div>

    <!-- パンくずリスト -->
    <nav class="breadcrumb">
      <a href="/">ホーム</a>
      <span>›</span>
      <a href="/stats">競馬場別統計</a>
      <span>›</span>
      <span>{venueInfo.name}</span>
    </nav>

    {stats ? (
      <>
        <!-- 累計統計 -->
        <section class="venue-stats">
          <h2>📊 累計統計</h2>
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">開催日数</div>
              <div class="stat-value">{stats.days}日</div>
              <div class="stat-detail">{stats.races}レース</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">的中率</div>
              <div class="stat-value">{formatPercent(stats.hitRate)}</div>
              <div class="stat-detail">{stats.hits}/{stats.races}R</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">回収率</div>
              <div class="stat-value">{formatPercent(stats.returnRate)}</div>
              <div class="stat-detail">{formatSignedYen(stats.profit)}</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">投資額</div>
              <div class="stat-value">{formatYen(stats.investment)}</div>
              <div class="stat-detail">払戻 {formatYen(stats.payout)}</div>
            </div>
          </div>
        </section>

        <!-- 日別実績リスト -->
        <section class="daily-list">
          <h2>📅 開催日別実績（直近{Math.min(data.length, 20)}日）</h2>
          <div class="results-list">
            {data.slice(0, 20).map((entry) => {
              const [year, month, day] = entry.date.split('-');
              const dv = dayPerformance(entry, { venue: venueInfo.name });
              return (
                <a href={`/results/${year}/${month}/${day}`} class="result-item">
                  <div class="result-date">{entry.date}</div>
                  <div class="result-stats">
                    <span class="hit-rate">的中率 {formatPercent(dv.hitRate)}</span>
                    <span class="return-rate">回収率 {formatPercent(dv.returnRate)}</span>
                    <span class="races">{dv.hits}/{dv.races}R</span>
                  </div>
                  <div class="result-payout">
                    {formatYen(dv.payout)}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
        <PerformanceBasisNote />
      </>
    ) : (
      <section class="no-data">
        <p>現在、{venueInfo.name}競馬場のデータはありません。</p>
      </section>
    )}

    <!-- 関連リンク -->
    <section class="related-links">
      <h3>関連ページ</h3>
      <div class="link-grid">
        <a href="/stats" class="link-card">
          📊 全競馬場統計
        </a>
        <a href={venueInfo.type === 'jra' ? '/archive/jra' : '/archive'} class="link-card">
          📅 的中実績一覧
        </a>
        <a href={venueInfo.type === 'jra' ? '/prediction/jra' : '/prediction/nankan'} class="link-card">
          🔮 最新予想を見る
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.page-header {
  text-align: center;
  margin-bottom: 2rem;
}

.page-header h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  color: var(--primary-blue);
}

.subtitle {
  font-size: 1.1rem;
  color: var(--text-muted);
}

/* パンくずリスト */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  padding: 1rem;
  background: var(--card-bg);
  border-radius: 8px;
  font-size: 0.9rem;
}

.breadcrumb a {
  color: var(--primary-blue);
  text-decoration: none;
}

.breadcrumb a:hover {
  text-decoration: underline;
}

.breadcrumb span:not(:has(a)) {
  color: var(--text-muted);
}

/* 累計統計 */
.venue-stats {
  margin-bottom: 3rem;
}

.venue-stats h2 {
  margin-bottom: 1.5rem;
  color: var(--heading-color);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}

.stat-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
}

.stat-label {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
}

.stat-value {
  font-size: 2rem;
  font-weight: bold;
  color: var(--primary-blue);
  margin-bottom: 0.25rem;
}

.stat-detail {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* 日別実績リスト */
.daily-list {
  margin-bottom: 3rem;
}

.daily-list h2 {
  margin-bottom: 1.5rem;
  color: var(--heading-color);
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.result-item {
  display: grid;
  grid-template-columns: 120px 1fr auto;
  gap: 1rem;
  align-items: center;
  padding: 1rem;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-color);
  transition: all 0.3s ease;
}

.result-item:hover {
  background: var(--primary-blue);
  color: white;
  border-color: var(--primary-blue);
  transform: translateX(4px);
}

.result-date {
  font-weight: 600;
}

.result-stats {
  display: flex;
  gap: 1rem;
  font-size: 0.9rem;
}

.hit-rate, .return-rate, .races {
  padding: 0.25rem 0.5rem;
  background: var(--background);
  border-radius: 4px;
}

.result-item:hover .hit-rate,
.result-item:hover .return-rate,
.result-item:hover .races {
  background: rgba(255, 255, 255, 0.2);
}

.result-payout {
  font-weight: bold;
  font-size: 1.1rem;
}

/* データなし */
.no-data {
  text-align: center;
  padding: 4rem 2rem;
  background: var(--card-bg);
  border-radius: 12px;
  color: var(--text-muted);
}

/* 関連リンク */
.related-links {
  margin-top: 3rem;
  padding: 2rem;
  background: var(--card-bg);
  border-radius: 12px;
}

.related-links h3 {
  margin-bottom: 1rem;
  color: var(--heading-color);
}

.link-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.link-card {
  padding: 1rem;
  background: var(--background);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-color);
  transition: all 0.3s ease;
  text-align: center;
}

.link-card:hover {
  background: var(--primary-blue);
  color: white;
  border-color: var(--primary-blue);
  transform: translateY(-2px);
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .result-item {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .result-stats {
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .link-grid {
    grid-template-columns: 1fr;
  }
}
</style>
