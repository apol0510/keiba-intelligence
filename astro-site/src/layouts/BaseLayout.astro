---
import AIChat from '../components/AIChat.astro';
import { entitlementFromAstro } from '../lib/auth/entitlement.js';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 同一内容を複数 URL で出す場合に正規 URL を指定する（例: /free-prediction/* → /prediction/*） */
  canonicalPath?: string;
}

const {
  title,
  description = 'AI-Powered Intelligence Dashboard for 南関・中央競馬。的中率71%、回収率186%を誇る競馬予想プラットフォーム。南関4場とJRA全10場に対応。',
  ogImage = '/og-image.png',
  canonicalPath
} = Astro.props;

/*
 * ナビの「ログイン中かどうか」。
 *
 * 🔴 これは **表示だけ**のための値。認可は各ページのサーバー側 entitlement が決める。
 * 🔴 以前は `sessionStorage` を見ていたが、あれはタブ単位の自己申告で、
 *    正本である署名付き Cookie とずれる（ログイン済みでも「ログイン」のままになる）。
 * 🔴 静的ページ（`prerender = true`）では Cookie を読めないので guest として描画し、
 *    読み込み後に `get-session`（Cookie が正本）で上書きする。
 */
const navEnt = entitlementFromAstro(Astro);
const navAuthed = navEnt.authenticated === true;

const siteTitle = `${title} | KEIBA Intelligence`;
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="ja" data-auth={navAuthed ? 'in' : 'out'}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="generator" content={Astro.generator}>

  <!-- SEO -->
  <title>{siteTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(ogImage, Astro.site)}>

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={siteTitle}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={new URL(ogImage, Astro.site)}>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@600;700&display=swap" rel="stylesheet">

  <!-- Global Styles -->
  <style is:global>
    @import '../styles/global.scss';
  </style>

  <!-- Google Analytics (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LRX40ZYJB6"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LRX40ZYJB6');
  </script>
</head>
<body>
  <!-- ナビゲーション -->
  <nav class="main-nav">
    <div class="container">
      <div class="nav-content">
        <a href="/" class="logo">
          <span class="logo-icon">🧠</span>
          <span class="logo-text-group">
            <span class="logo-text">KEIBA Intelligence</span>
            <span class="logo-subtext">競馬インテリジェンス</span>
          </span>
        </a>

        <div class="nav-links">
          <a href="/">ホーム</a>
          <div class="nav-dropdown">
            <span class="nav-dropdown-trigger">無料予想 ▾</span>
            <div class="nav-dropdown-menu">
              <a href="/free-prediction/nankan">南関（無料）</a>
              <a href="/free-prediction/jra">中央（無料）</a>
            </div>
          </div>
          <div class="nav-dropdown">
            <span class="nav-dropdown-trigger">PRO予想 ▾</span>
            <div class="nav-dropdown-menu">
              <a href="/prediction/nankan">南関（PRO）</a>
              <a href="/prediction/jra">中央（PRO）</a>
            </div>
          </div>
          <div class="nav-dropdown">
            <span class="nav-dropdown-trigger">的中実績 ▾</span>
            <div class="nav-dropdown-menu">
              <a href="/archive/nankan">南関</a>
              <a href="/archive/jra">中央</a>
            </div>
          </div>
          <a href="/pricing">料金プラン</a>
          <span id="auth-nav-button">
            <a href="/register" data-auth-out hidden={navAuthed}>無料登録</a>
            <a href="/login" data-auth-out hidden={navAuthed}>ログイン</a>
            <a href="/mypage" data-auth-in hidden={!navAuthed}>マイページ</a>
            <form class="nav-logout" method="POST" action="/.netlify/functions/logout"
                  data-auth-in hidden={!navAuthed}>
              <button type="submit">ログアウト</button>
            </form>
          </span>
        </div>

        <!-- モバイルメニューボタン -->
        <button class="mobile-menu-btn" aria-label="メニュー">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- メインコンテンツ -->
  <main>
    <slot />
  </main>

  <!-- フッター -->
  <footer class="main-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section footer-brand">
          <a href="/" class="footer-logo">
            <span class="footer-logo-icon">🧠</span>
            <span class="footer-logo-text">KEIBA Intelligence</span>
          </a>
          <p class="footer-tagline">AI-Powered Intelligence Dashboard<br>for 南関・中央競馬</p>
          <div class="footer-stats">
            <div class="footer-stat">
              <span class="footer-stat-value">71.1%</span>
              <span class="footer-stat-label">的中率（回収含む）</span>
            </div>
            <div class="footer-stat">
              <span class="footer-stat-value">186.4%</span>
              <span class="footer-stat-label">回収率</span>
            </div>
          </div>
          <a href="/register" class="footer-cta" data-auth-out hidden={navAuthed}>無料会員登録 →</a>
        </div>

        <details class="footer-section footer-acc" open>
          <summary class="footer-acc-summary">
            <span class="footer-acc-title">サービス</span>
            <span class="footer-acc-icon" aria-hidden="true"></span>
          </summary>
          <div class="footer-acc-body">
            <ul>
              <li><a href="/free-prediction/nankan">無料予想（南関）</a></li>
              <li><a href="/free-prediction/jra">無料予想（中央）</a></li>
              <li><a href="/prediction/nankan">有料予想</a></li>
              <li><a href="/pricing">料金プラン</a></li>
              <li><a href="/archive/">的中実績</a></li>
              <li><a href="/about">サイト概要</a></li>
            </ul>
          </div>
        </details>

        <details class="footer-section footer-acc" open>
          <summary class="footer-acc-summary">
            <span class="footer-acc-title">サポート</span>
            <span class="footer-acc-icon" aria-hidden="true"></span>
          </summary>
          <div class="footer-acc-body">
            <ul>
              <li><a href="/faq">よくある質問</a></li>
              <li><a href="/contact">お問い合わせ</a></li>
              <li data-auth-out hidden={navAuthed}><a href="/login">ログイン</a></li>
              <li data-auth-in hidden={!navAuthed}><a href="/mypage">マイページ</a></li>
            </ul>
          </div>
        </details>

        <details class="footer-section footer-acc footer-venues" open>
          <summary class="footer-acc-summary">
            <span class="footer-acc-title">対象競馬場</span>
            <span class="footer-acc-icon" aria-hidden="true"></span>
          </summary>
          <div class="footer-acc-body">
            <div class="footer-venue-group">
              <h5>南関東4場</h5>
              <ul class="footer-venue-list">
                <li>大井競馬場</li>
                <li>川崎競馬場</li>
                <li>船橋競馬場</li>
                <li>浦和競馬場</li>
              </ul>
            </div>
            <div class="footer-venue-group">
              <h5>中央競馬（JRA）全10場</h5>
              <ul class="footer-venue-list">
                <li>東京競馬場</li>
                <li>中山競馬場</li>
                <li>京都競馬場</li>
                <li>阪神競馬場</li>
                <li>中京競馬場</li>
                <li>小倉競馬場</li>
                <li>新潟競馬場</li>
                <li>福島競馬場</li>
                <li>札幌競馬場</li>
                <li>函館競馬場</li>
              </ul>
            </div>
          </div>
        </details>
      </div>

      <!-- ボトムバー -->
      <div class="footer-bottom">
        <p class="copyright">&copy; 2026 KEIBA Intelligence. All rights reserved.</p>
        <ul class="footer-legal">
          <li><a href="/privacy">プライバシーポリシー</a></li>
          <li><a href="/terms">利用規約</a></li>
          <li><a href="/tokushoho">特定商取引法に基づく表記</a></li>
          <li><a href="/contact">お問い合わせ</a></li>
        </ul>
      </div>
    </div>
  </footer>

  <style>
    /* ナビゲーション */
    .main-nav {
      /* 2026-08-28 ライト基調（RENEWAL_2026_08 §9） */
      background: rgba(255, 255, 255, 0.92);
      border-bottom: 1px solid var(--border-color);
      box-shadow: 0 1px 8px rgba(15, 23, 42, 0.05);
      padding: var(--spacing-md) 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(16px) saturate(160%);
      -webkit-backdrop-filter: blur(16px) saturate(160%);
    }

    .nav-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      text-decoration: none;
    }

    .logo-icon {
      font-size: 2rem;
    }

    .logo-text-group {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .logo-text {
      /* 明るいヘッダーでも読めるよう、やや濃いめのcyan系グラデーション */
      background: linear-gradient(135deg, var(--primary-start) 0%, var(--secondary-start) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      /* descender(g等)の見切れ防止 */
      line-height: 1.3;
      padding-bottom: 2px;
    }

    .logo-subtext {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--text-tertiary);
      letter-spacing: 0.08em;
    }

    .nav-links {
      display: flex;
      gap: var(--spacing-sm);
      align-items: center;
    }

    .nav-links a,
    .nav-links .nav-logout button,
    .nav-dropdown-trigger {
      position: relative;
      display: inline-flex;
      align-items: center;
      white-space: nowrap;
      flex-shrink: 0;
      padding: var(--spacing-xs) var(--spacing-md);
      color: var(--text-primary);
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-pill);
      background: #ffffff;
      box-shadow: var(--shadow-sm);
      transition: all var(--transition-base);
    }

    .nav-links a:hover,
    .nav-links .nav-logout button:hover,
    .nav-dropdown-trigger:hover {
      color: var(--text-inverse);
      border-color: var(--primary-start);
      background: var(--primary-gradient);
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
      transform: translateY(-1px);
    }

    /* ログアウトはフォーム送信だが、見た目はほかのナビ項目にそろえる */
    .nav-logout { display: inline-flex; margin: 0; }
    .nav-logout button { font-family: inherit; cursor: pointer; }

    /* 🔴 hidden を効かせる（inline-flex 指定に負けないように） */
    .nav-links [hidden],
    .footer-acc-body [hidden],
    a.footer-cta[hidden] { display: none !important; }

    #auth-nav-button {
      display: flex;
      gap: var(--spacing-sm);
      align-items: center;
    }

    /* ドロップダウンメニュー */
    .nav-dropdown {
      position: relative;
    }

    .nav-dropdown-trigger {
      cursor: pointer;
      user-select: none;
    }

    .nav-dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: var(--spacing-sm);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: var(--spacing-sm) 0;
      min-width: 160px;
      box-shadow: var(--shadow-lg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all var(--transition-fast);
      z-index: 1000;
    }

    .nav-dropdown:hover .nav-dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-dropdown-menu a {
      display: block;
      padding: var(--spacing-xs) var(--spacing-md);
      color: var(--text-secondary);
      font-weight: 500;
      transition: all var(--transition-fast);
      white-space: nowrap;
    }

    .nav-dropdown-menu a:hover {
      background: rgba(59, 130, 246, 0.1);
      color: var(--primary-end);
    }

    .mobile-menu-btn {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: var(--spacing-sm);
    }

    .mobile-menu-btn span {
      display: block;
      width: 25px;
      height: 3px;
      background: var(--text-primary);
      border-radius: 2px;
      transition: all var(--transition-fast);
    }

    /* メインコンテンツ */
    main {
      min-height: calc(100vh - 200px);
      padding: var(--spacing-2xl) 0;
    }

    /* フッター（3層: 主要導線 / 対象競馬場 / リーガル） */
    .main-footer {
      /* 背景画像を暗いオーバーレイ越しに透かせる（テック質感のフッター） */
      background:
        linear-gradient(180deg, rgba(8, 11, 22, 0.93) 0%, rgba(5, 7, 16, 0.96) 100%),
        url('/images/footer_image_pc.png');
      background-size: cover, cover;
      background-position: center, center;
      background-repeat: no-repeat, no-repeat;
      border-top: 1px solid rgba(96, 165, 250, 0.4);
      padding: 48px 0 var(--spacing-lg);
      margin-top: var(--spacing-2xl);
      min-height: 0;
      position: relative;
      overflow: hidden;
    }
    .main-footer::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(96, 165, 250, 0.45) 50%, transparent 100%);
    }

    .footer-content {
      display: grid;
      grid-template-columns: 1.3fr 0.8fr 0.8fr 1.4fr;
      gap: 48px;
      position: relative;
      z-index: 1;
    }

    /* セクション見出し（PC/tablet=通常見出し、mobile=アコーディオンsummary） */
    .footer-acc-summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }
    .footer-acc-summary::-webkit-details-marker { display: none; }
    .footer-acc-summary:focus-visible {
      outline: 2px solid rgba(96, 165, 250, 0.7);
      outline-offset: 2px;
      border-radius: 4px;
    }
    .footer-acc-title {
      color: #6ba0e0;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .footer-acc-icon { display: none; }

    .footer-acc-body { margin-top: var(--spacing-md); display: none; }
    .footer-acc[open] > .footer-acc-body { display: block; }
    .footer-acc-body ul { list-style: none; }
    .footer-acc-body > ul li { margin-bottom: 10px; }
    .footer-acc-body ul li a {
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.875rem;
      transition: color 0.2s ease;
    }
    .footer-acc-body ul li a:hover {
      color: #60a5fa;
    }

    /* PC/tablet: details は open のまま（中身常時表示）。summaryの開閉操作を無効化して常時展開を維持。
       ※ JS無効でも open 属性で全リンク表示・到達可能。mobileのみ JS で折りたたむ。 */
    @media (min-width: 768px) {
      .footer-acc-summary { pointer-events: none; cursor: default; }
    }

    /* ブランド列（軽量化） */
    .footer-brand {
      max-width: 300px;
    }
    .footer-logo {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-sm);
      text-decoration: none;
      margin-bottom: var(--spacing-sm);
    }
    .footer-logo-icon { font-size: 1.4rem; }
    .footer-logo-text {
      font-size: 1.25rem;
      font-weight: 800;
      background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .footer-tagline {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.875rem;
      line-height: 1.7;
      max-width: 280px;
      margin-bottom: var(--spacing-md);
    }
    .footer-stats {
      display: flex;
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-md);
    }
    .footer-stat { display: flex; flex-direction: column; gap: 2px; }
    .footer-stat-value {
      font-size: 1.65rem;
      font-weight: 800;
      background: var(--primary-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
    }
    .footer-stat-label {
      font-size: 0.72rem;
      color: var(--text-tertiary, rgba(255, 255, 255, 0.55));
    }
    .footer-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 44px;
      padding: 0 var(--spacing-lg);
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.875rem;
      /*
       * 🔴 2026-08-31: 黄色の単色をやめてブランドの 2 色グラデーションへ。
       *    フッターは暗いので **明るい版**を使い、文字は濃色にして読みやすくする。
       */
      color: #0b1020;
      background: var(--grad-nav-bright);
      box-shadow: 0 3px 14px rgba(96, 165, 250, 0.45);
      transition: all var(--transition-base);
    }
    .footer-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 22px rgba(129, 190, 255, 0.65);
    }

    /* 対象競馬場（コンパクト2列・会場名は1行=nowrap） */
    .footer-venue-group { margin-bottom: var(--spacing-md); }
    .footer-venue-group:last-child { margin-bottom: 0; }
    .footer-venue-group h5 {
      color: #8e96c4;
      font-size: 0.8rem;
      margin-bottom: 10px;
      font-weight: 600;
    }
    .footer-venue-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 20px;
    }
    .footer-venue-list li {
      color: var(--text-secondary);
      font-size: 0.82rem;
      white-space: nowrap;
    }

    /* リーガル下部バー */
    .footer-bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-sm) var(--spacing-lg);
      margin-top: var(--spacing-xl);
      padding: 18px 0 var(--spacing-sm);
      /* チャットボタン(右下: right24px+幅60px)とリンクが重ならない右余白 */
      padding-right: 96px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
      z-index: 1;
    }
    .copyright {
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.8rem;
      margin: 0;
    }
    .footer-legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      list-style: none;
    }
    .footer-legal li::before { content: none; }
    .footer-legal a {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.8rem;
      transition: color 0.2s ease;
    }
    .footer-legal a:hover { color: #60a5fa; }

    /* レスポンシブ */
    /* タブレット: 2カラム×2段（ブランド/サービス・サポート/対象競馬場） */
    @media (max-width: 1024px) {
      .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }
    }

    /* ナビ: モバイルメニュー切替（768px以下） */
    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }

      .mobile-menu-btn {
        display: flex;
      }
    }

    /* フッター モバイル: アコーディオン（767px以下。768pxは tablet 2カラム維持） */
    @media (max-width: 767px) {
      .main-footer {
        padding-top: 30px;
        /* チャットボタン(bottom:24px+高さ60px=最大84px到達)と下部リンク重なり回避 + iPhone safe area */
        padding-bottom: calc(104px + env(safe-area-inset-bottom));
        /* モバイルは縦長の背景画像に差し替え */
        background:
          linear-gradient(180deg, rgba(8, 11, 22, 0.93) 0%, rgba(5, 7, 16, 0.96) 100%),
          url('/images/footer_image_mobile.png');
        background-size: cover, cover;
        background-position: center, center;
        background-repeat: no-repeat, no-repeat;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 11px;
      }

      /* ブランド圧縮 */
      .footer-brand { max-width: none; margin-bottom: 4px; }
      .footer-logo { margin-bottom: 16px; }
      .footer-tagline { margin-bottom: 16px; max-width: 100%; }
      .footer-stats { gap: 32px; margin-bottom: 16px; }
      .footer-stat-value { font-size: 1.75rem; }
      .footer-stat-label { font-size: 0.7rem; }
      .footer-cta {
        height: 42px;
        max-width: 230px;
        box-shadow: 0 2px 6px rgba(251, 191, 36, 0.18);
      }

      /* アコーディオン = 独立カード */
      .footer-acc {
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(96, 165, 250, 0.18);
        border-radius: 11px;
        transition: background-color 0.2s ease, border-color 0.2s ease;
      }
      .footer-acc[open] {
        background: rgba(255, 255, 255, 0.045);
        border-color: rgba(96, 165, 250, 0.32);
      }
      .footer-acc-summary {
        min-height: 50px;
        padding: 0 15px;
        cursor: pointer;
      }
      .footer-acc-icon {
        display: block;
        position: relative;
        width: 12px;
        height: 12px;
        flex-shrink: 0;
      }
      .footer-acc-icon::before,
      .footer-acc-icon::after {
        content: '';
        position: absolute;
        background: #8fb3e6;
        border-radius: 1px;
      }
      .footer-acc-icon::before { top: 5px; left: 0; width: 12px; height: 2px; }
      .footer-acc-icon::after { top: 0; left: 5px; width: 2px; height: 12px; transition: opacity 0.2s ease; }
      .footer-acc[open] .footer-acc-icon::after { opacity: 0; }

      .footer-acc-body {
        margin-top: 0;
        padding: 4px 16px 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }
      .footer-acc-body > ul li { margin-bottom: 0; }
      .footer-acc-body ul li a {
        display: block;
        padding: 9px 0;
        font-size: 0.95rem;
        line-height: 1.45;
      }

      /* 対象競馬場（mobile） */
      .footer-acc-body .footer-venue-group { margin-bottom: 20px; }
      .footer-venue-list { gap: 11px 22px; }
      .footer-venue-list li { font-size: 0.875rem; text-align: left; }

      /* リーガル: 著作権1行 + リンク2列Grid */
      .footer-bottom {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
        padding: 20px 0;
        padding-right: 0;
      }
      .copyright { text-align: center; margin-bottom: 12px; }
      .footer-legal {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 16px;
        justify-items: center;
      }
      .footer-legal a { font-size: 0.8rem; line-height: 1.5; }
      /* 「特定商取引法に基づく表記」は長いので横2列幅を使う */
      .footer-legal li:nth-child(3) { grid-column: 1 / -1; }
    }
  </style>

  <script>
    // フッターアコーディオン: モバイル(<=767px)のみ折りたたむ。PC/tabletは open のまま常時表示。
    // HTMLは open 付与済みのため JS 無効時は全デバイスで展開（リンク到達可能）。
    (function () {
      const mq = window.matchMedia('(max-width: 767px)');
      const accs = document.querySelectorAll('.footer-acc');
      function apply() {
        accs.forEach((d) => { mq.matches ? d.removeAttribute('open') : d.setAttribute('open', ''); });
      }
      apply();
      mq.addEventListener('change', apply);
    })();

    // モバイルメニュー
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const navLinks = document.querySelector('.nav-links');

    if (menuBtn && navLinks) {
      menuBtn.addEventListener('click', () => {
        navLinks.style.display = navLinks.style.display === 'flex' ? 'none' : 'flex';
        navLinks.style.flexDirection = 'column';
        navLinks.style.position = 'absolute';
        navLinks.style.top = '100%';
        navLinks.style.right = '0';
        navLinks.style.background = 'var(--bg-secondary)';
        navLinks.style.padding = 'var(--spacing-md)';
        navLinks.style.borderRadius = 'var(--radius-md)';
        navLinks.style.boxShadow = 'var(--shadow-lg)';
      });
    }

    /*
     * ナビの表示をログイン状態に合わせる。
     *
     * 🔴 正本は **署名付き Cookie**。`get-session` はそれを検証して返す。
     *    以前は `sessionStorage` を見ていたためタブ単位の自己申告に依存し、
     *    ログイン済みでもナビが「ログイン」のままになっていた（2026-09-02）。
     * 🔴 ここで変わるのは **表示だけ**。有料コンテンツの認可はサーバー側で決まる。
     */
    async function syncAuthNav() {
      let authed = document.documentElement.dataset.auth === 'in';
      try {
        const res = await fetch('/.netlify/functions/get-session', { credentials: 'include' });
        authed = res.ok && (await res.json().catch(() => ({}))).authenticated === true;
      } catch {
        // 通信できなければサーバー描画のままにする
      }
      document.documentElement.dataset.auth = authed ? 'in' : 'out';
      document.querySelectorAll('[data-auth-in]').forEach((el) => { el.hidden = !authed; });
      document.querySelectorAll('[data-auth-out]').forEach((el) => { el.hidden = authed; });
    }

    syncAuthNav();
  </script>

  <!-- AI Chat Widget -->
  <!-- sticky な表見出しをヘッダーの真下に固定するため、ナビの実寸を CSS 変数へ反映する -->
  <script is:inline>
    (function () {
      function syncNavHeight() {
        var nav = document.querySelector('.main-nav');
        if (!nav) return;
        document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
      }
      syncNavHeight();
      window.addEventListener('resize', syncNavHeight);
      window.addEventListener('orientationchange', syncNavHeight);
    })();
  </script>

  <AIChat />
</body>
</html>
