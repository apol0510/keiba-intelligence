{
  "name": "keiba-intelligence",
  "type": "module",
  "version": "1.0.0",
  "description": "AI-Powered Intelligence Dashboard for 南関競馬",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:archive && npm run test:narrative && npm run test:auth && npm run test:billing && npm run test:digest && npm run test:raceday && npm run test:nankan && npm run test:prune-function-data && npm run test:archive-sync && npm run test:shared-checkers && npm run test:workflow-transient && astro build && npm run prune:function-data",
    "preview": "astro preview",
    "astro": "astro",
    "test:nankan-recent-races": "node src/utils/getDisplayRecentRacesForNankan.test.js",
    "test:nankan-injection": "node src/utils/nankanHorseStatsInjection.guard.test.js",
    "test:nankan": "npm run test:nankan-recent-races && npm run test:nankan-injection",
    "prune:function-data": "node scripts/pruneFunctionBundleData.mjs",
    "test:prune-function-data": "node --test scripts/pruneFunctionBundleData.test.mjs",
    "test:archive-sync": "node --test scripts/syncArchiveResults.test.mjs",
    "test:shared-checkers": "node --test scripts/lib/sharedCheckerSupport.test.mjs scripts/checkShared.contract.test.mjs",
    "test:workflow-transient": "node --test scripts/lib/workflowTransientContract.test.mjs",
    "validate:archive": "node scripts/validateArchiveFormat.js",
    "verify:sync": "node scripts/verifyArchiveSync.js",
    "import:prediction": "node scripts/importPrediction.js",
    "import:prediction:jra": "node scripts/importPredictionJra.js",
    "import:results": "node scripts/importResults.js",
    "import:results:jra": "node scripts/importResultsJra.js",
    "import:horse-histories:jra": "node scripts/importHorseHistoriesJra.js",
    "import:recent-horse-histories:nankan": "node scripts/importRecentHorseHistoriesNankan.js",
    "import:entries:nankan": "node scripts/importEntriesNankan.js",
    "import:feature-scores": "node scripts/importFeatureScores.js",
    "rebuild:archive": "node scripts/rebuildArchive.js",
    "test:validation": "node scripts/utils/validatePrediction.test.js",
    "test:computer-index": "node --test src/utils/computerIndexContract.test.mjs",
    "test:narrative": "node --test src/utils/raceNarrative.test.mjs src/utils/frameNumber.test.mjs src/utils/pedigreeName.test.mjs",
    "test:auth": "node --test src/lib/auth/auth.test.mjs src/lib/auth/entitlementRoutes.test.mjs src/lib/auth/previewMode.test.mjs",
    "test:billing": "node --test src/lib/billing/billing.test.mjs",
    "test:digest": "node --test src/lib/digest/digest.test.mjs",
    "test:raceday": "node --test src/lib/prediction/raceDayContract.test.mjs",
    "generate:digest": "node scripts/generateDailyDigest.mjs",
    "test:unsubscribe": "node --test src/lib/unsubscribe/unsubscribe.test.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.5.8",
    "@astrojs/sitemap": "^3.5.0",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "airtable": "^0.12.2",
    "astro": "^5.16.8",
    "sass": "^1.90.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^23.5.0"
  }
}
